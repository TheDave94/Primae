+// BankRenderer.swift
+// PrimaeNative — pitch bake-off phase 2, candidate C3 "PitchBank" (2026-11-24; NOT wired into the study path)
+//
+// The offline half of PitchBank (BAKEOFF-PITCH.md section 2 C3): a `BankRenderer` re-synthesises one voiced phoneme
+// at a fixed pitch factor, off the render thread, as a BANK the live path plays with a small residual shift.
+//
+// A bank is INDEX-PRESERVING: source pitch mark i becomes exactly one output pulse, at bank position
+// M(i) = marks[0] + sum_{j < i} T(j) / pf (`PitchBankLayout`), so "the source's marks, scaled to the new periods" is
+// literal. Every bank therefore has the same marks by index, which is what lets the live path cross-fade two banks
+// grain for grain at one mark (both read source period i, both at the same output F0). Samples before marks[0] (the
+// pre-voicing onset, no pitch) are the source's own, copied unchanged.
+//
+// `WorldBankRenderer` is the default: lane C2's WORLD analysis (`WorldRTAnalysis`: F0 from our marks, CheapTrick,
+// D4C) and C2's per-pulse synthesis (`WorldRT.spawnPulse`, i.e. WORLD's `GetOneFrameSegment`), run offline at full
+// quality:
+//   - double precision throughout;
+//   - the whole N = 2048 minimum-phase response is kept (live C2 keeps 1024 and tapers 128);
+//   - the pulses sit exactly on the scaled source epochs, so the source's own jitter is carried in full (live C2
+//     carries 0.8 of it around a smoothed contour);
+//   - shimmer, the P4 pitch-level compensation, the parameter-domain loop seam and the level calibration are C2's
+//     defaults (`WorldRTTuning.default`).
+// It also returns the bank's APERIODIC part on its own (WORLD synthesises the two parts separately), which lets the
+// live path swap the noise of a repeated period (C1 item 4) exactly instead of estimating the split.
+//
+// WORLD notice: Copyright (c) 2010 M. Morise. All rights reserved. Modified-BSD licence, reproduced in full in
+// `WorldRT/WorldCommon.swift`.
+
+import Accelerate
+import Foundation
+
+/// Where every source mark sits in one bank.
+nonisolated struct PitchBankLayout: Sendable {
+    let pitchFactor: Double
+    /// Bank position of source mark i (fractional samples).
+    let marks: [Double]
+    /// Bank period at mark i: T(i) / pf.
+    let periods: [Double]
+    /// Bank samples (the last pulse plus room for its response).
+    let length: Int
+
+    /// `sourcePeriods`: the period each source mark is re-spaced from (default the analysis' own; PitchBank passes
+    /// `TDPSOLA2.spacingPeriods`, whose attack is flattened to the steady F0).
+    init(analysis a: TDPSOLAAnalysis, pitchFactor pf: Double, sourcePeriods: [Double]? = nil, tail: Int = 4096) {
+        pitchFactor = pf
+        let sp = sourcePeriods ?? a.periods
+        var m = [Double](repeating: 0, count: a.marks.count)
+        var t = m
+        if !a.marks.isEmpty {
+            m[0] = a.marks[0]
+            for i in 0..<a.marks.count {
+                t[i] = sp[i] / pf
+                if i > 0 { m[i] = m[i - 1] + sp[i - 1] / pf }
+            }
+        }
+        marks = m
+        periods = t
+        length = Int(((m.last ?? 0) + (t.last ?? 0)).rounded(.up)) + tail
+    }
+
+    /// Bank time of source position `p`: unchanged before the first mark, linear between marks after it.
+    static func bankTime(_ p: Double, sourceMarks sm: [Double], bankMarks bm: [Double], pitchFactor pf: Double) -> Double {
+        guard let first = sm.first, p > first else { return p }
+        var i = 0
+        while i + 1 < sm.count && sm[i + 1] <= p { i += 1 }
+        return bm[i] + (p - sm[i]) / pf
+    }
+}
+
+/// One bank: the full signal and, when the renderer can split it, its aperiodic part (same length).
+nonisolated struct PitchBankRender: Sendable {
+    let full: [Float]
+    let noise: [Float]?
+}
+
+/// An offline re-synthesis behind PitchBank (any future renderer, e.g. a licence-clean neural one, drops in here).
+/// Built once per source, off the render thread; `render` may take seconds and allocate freely.
+nonisolated protocol BankRenderer: AnyObject, Sendable {
+    static var rendererName: String { get }
+    /// The source's voiced span re-synthesised at `layout.pitchFactor`, source mark i as one pulse at `layout.marks[i]`.
+    func render(_ layout: PitchBankLayout) -> PitchBankRender
+}
+
+/// The default bank renderer: C2's WORLD analysis/synthesis, offline, full quality (see the file header).
+nonisolated final class WorldBankRenderer: BankRenderer, @unchecked Sendable {
+    static var rendererName: String { "WORLD-offline" }
+
+    let analysis: TDPSOLAAnalysis
+    let world: WorldRTAnalysis
+    let tuning: WorldRTTuning
+    let sampleRate: Double
+    /// rms(source loop) / rms(0-cent bank loop), applied to every bank's synthesised part (C2's level calibration).
+    private(set) var calibrationGain: Double = 1
