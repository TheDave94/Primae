@@ -0,0 +1,327 @@
+#!/usr/bin/env python3
+"""Sonification bake-off report generator (BENCH lane, 2026-11-02).
+
+Turns the bench output pulled from the iPad (a directory holding
+bench.csv, manifest.json, run_info.json and wav/) into:
+
+  <dir>/summary.md      per-candidate summary table + gate verdicts
+  <dir>/summary.html    the same, plus per-metric pivots (source x scenario)
+  <dir>/listening.html  a blind MUSHRA-style listening page: per trial a
+                        known reference, then the candidates, the hidden
+                        reference (unprocessed source at rate 1) and the
+                        anchor (NaiveResample) in a random order, 0-100
+                        sliders, results downloadable as JSON.
+
+Standard library only (no numpy). Usage:
+
+  python3 scripts/sonification_bakeoff_report.py <bakeoff_dir> [--all-trials]
+"""
+
+import csv
+import html
+import json
+import os
+import statistics
+import sys
+from collections import defaultdict
+
+# metric -> (aggregation, label, unit, gate) ; gate = (kind, threshold) or None
+SUMMARY = [
+    ("onset_m20_ms", "median", "onset -20 dB (median)", "ms", None),
+    ("onset_m20_ms", "max", "onset -20 dB (max)", "ms", None),
+    ("onset_m20_excess_ms", "median", "onset excess vs source", "ms", None),
+    ("reonset_m20_ms", "median", "re-onset after close", "ms", None),
+    ("onset_rise_10_90_ms", "median", "onset rise 10-90", "ms", None),
+    ("traj_onset_m20_median_ms", "median", "stroke onset (trajectories)", "ms", None),
+    ("f0_err_pct", "maxabs", "phoneme f0 error, fixed rates", "%", ("le", 1.0)),
+    ("f0_err_after_step_pct", "maxabs", "phoneme f0 error after rate step", "%", ("le", 1.0)),
+    ("traj_f0_dev_p95_pct", "median", "phoneme f0 dev p95 (trajectories)", "%", None),
+    ("carrier_cents_err", "maxabs", "carrier pitch error", "cents", ("le", 5.0)),
+    ("carrier_cents_err_after_step", "maxabs", "carrier pitch error after step", "cents", ("le", 5.0)),
+    ("duration_scale_err_pct", "maxabs", "duration scale error", "%", None),
+    ("rate_step_delay90_ms", "median", "rate step to 90 %", "ms", None),
+    ("rate_step_rise_ms", "median", "rate step rise 10-90", "ms", None),
+    ("pitch_step_delay90_ms", "median", "pitch step to 90 %", "ms", None),
+    ("pitch_step_rise_ms", "median", "pitch step rise 10-90", "ms", None),
+    ("traj_pitch_lag_ms", "median", "pitch tracking lag (trajectories)", "ms", None),
+    ("traj_pitch_rms_cents", "median", "pitch tracking RMS at best lag", "cents", None),
+    ("traj_rate_lag_ms", "median", "rate tracking lag (trajectories)", "ms", None),
+    ("lsd_vs_ref_db", "median", "log-spectral distance vs o32", "dB", None),
+    ("modspec_dev_db", "median", "modulation-spectrum deviation vs o32", "dB", None),
+    ("aperiodicity_delta", "median", "aperiodicity delta (phasiness proxy)", "dip", None),
+    ("flux_spike_ratio", "median", "spectral flux spike ratio", "x", None),
+    ("gate_open_click_ratio", "max", "gate-open click ratio", "x", None),
+    ("gate_close_click_ratio", "max", "gate-close click ratio", "x", None),
+    ("param_step_click_ratio", "max", "parameter-step click ratio", "x", None),
+    ("loop_seam_click_ratio", "max", "loop-seam click ratio", "x", None),
+    ("gate_leak_db", "max", "leak while closed", "dB", None),
+    ("level_re_source_db", "median", "level re source", "dB", None),
+    ("cpu_median_us", "median", "CPU per 256 frames (median)", "us", None),
+    ("cpu_p99_us", "max", "CPU per 256 frames (p99, worst)", "us", None),
+    ("cpu_realtime_pct", "median", "CPU % of real time (median)", "%", None),
+    ("claimed_latency_frames", "median", "claimed latency", "frames", None),
+]
+
+PIVOTS = ["onset_m20_ms", "f0_err_pct", "carrier_cents_err", "duration_scale_err_pct",
+          "rate_step_delay90_ms", "pitch_step_delay90_ms", "traj_pitch_lag_ms", "traj_rate_lag_ms",
+          "lsd_vs_ref_db", "cpu_median_us"]
+
+DEFAULT_TRIALS = ("rate_0.5", "rate_1", "rate_2", "gate_cycle", "step_pitch_0to+700",
+                  "traj_A_varying", "traj_F_varying", "traj_I_varying", "traj_L_varying", "traj_M_varying")
+
+ANCHOR = "NaiveResample"
+HIDDEN_REF = "Source"
+
+
+def load_rows(path):
+    rows = []
+    with open(path, newline="", encoding="utf-8") as f:
+        for r in csv.DictReader(f):
+            try:
+                r["value"] = float(r["value"])
+            except ValueError:
+                r["value"] = float("nan")
+            rows.append(r)
+    return rows
+
+
+def aggregate(values, how):
+    vals = [v for v in values if v == v]  # drop NaN
+    if not vals:
+        return None
+    if how == "median":
+        return statistics.median(vals)
+    if how == "max":
+        return max(vals)
+    if how == "maxabs":
+        return max(abs(v) for v in vals)
+    raise ValueError(how)
+
+
+def fmt(v):
+    if v is None:
+        return "-"
+    if abs(v) >= 100:
+        return "%.0f" % v
+    if abs(v) >= 10:
+        return "%.1f" % v
+    return "%.2f" % v
+
+
+def summarise(rows, sample_rate="48000"):
+    rows = [r for r in rows if r["sample_rate"] == sample_rate and r["candidate"] != HIDDEN_REF]
+    candidates = []
+    for r in rows:
+        if r["candidate"] not in candidates:
+            candidates.append(r["candidate"])
+    by = defaultdict(list)
+    nan_onsets = defaultdict(int)
+    for r in rows:
+        by[(r["candidate"], r["metric"])].append(r["value"])
+        if r["metric"] == "onset_m20_ms" and r["value"] != r["value"]:
+            nan_onsets[r["candidate"]] += 1
+    table = []
+    for metric, how, label, unit, gate in SUMMARY:
+        cells = []
+        for c in candidates:
+            v = aggregate(by.get((c, metric), []), how)
+            verdict = ""
+            if gate and v is not None:
+                verdict = "PASS" if v <= gate[1] else "FAIL"
+            cells.append((v, verdict))
+        if all(v is None for v, _ in cells):
+            continue
+        table.append((label + " [" + unit + "]" + (" (gate <= %g)" % gate[1] if gate else ""), how, cells))
+    return candidates, table, nan_onsets
+
+
+def pivot(rows, metric, sample_rate="48000"):
+    data = {}
+    candidates = []
+    keys = []
+    for r in rows:
+        if r["sample_rate"] != sample_rate or r["metric"] != metric:
+            continue
+        k = (r["source"], r["scenario"])
+        if k not in keys:
+            keys.append(k)
+        if r["candidate"] not in candidates:
+            candidates.append(r["candidate"])
+        data[(k, r["candidate"])] = r["value"]
+    return candidates, keys, data
+
+
+def write_summary(d, rows, run_info):
+    out_md = []
+    out_html = ["<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' "
+                "content='width=device-width,initial-scale=1'><title>Bake-off summary</title><style>",
+                "body{font:14px -apple-system,system-ui,sans-serif;margin:16px;background:#fff;color:#1a202c}",
+                "table{border-collapse:collapse;margin:12px 0}td,th{border:1px solid #cbd5e0;padding:3px 6px;"
+                "text-align:right}th:first-child,td:first-child{text-align:left}.FAIL{background:#fed7d7}"
+                ".PASS{background:#c6f6d5}.wrap{overflow-x:auto}</style></head><body>",
+                "<h1>Sonification bake-off</h1>"]
+    out_md.append("# Sonification bake-off summary\n")
+    if run_info:
+        line = ", ".join("%s: %s" % (k, run_info[k]) for k in sorted(run_info))
+        out_md.append(line + "\n")
+        out_html.append("<p>" + html.escape(line) + "</p>")
+    for sr in ("48000", "44100"):
+        candidates, table, nan_onsets = summarise(rows, sr)
+        if not table:
+            continue
+        out_md.append("\n## %s Hz\n" % sr)
+        out_md.append("| metric | agg | " + " | ".join(candidates) + " |")
+        out_md.append("|---|---|" + "---|" * len(candidates))
+        out_html.append("<h2>%s Hz</h2><div class='wrap'><table><tr><th>metric</th><th>agg</th>" % sr
+                        + "".join("<th>%s</th>" % html.escape(c) for c in candidates) + "</tr>")
+        for label, how, cells in table:
+            out_md.append("| %s | %s | " % (label, how)
+                          + " | ".join(fmt(v) + (" " + vd if vd else "") for v, vd in cells) + " |")
+            out_html.append("<tr><td>%s</td><td>%s</td>" % (html.escape(label), how)
+                            + "".join("<td class='%s'>%s</td>" % (vd, fmt(v) + (" " + vd if vd else ""))
+                                      for v, vd in cells) + "</tr>")
+        out_html.append("</table></div>")
+        if nan_onsets:
+            note = "Renders with NO -20 dB onset (never sounded): " + ", ".join(
+                "%s %d" % (c, n) for c, n in sorted(nan_onsets.items()))
+            out_md.append("\n" + note + "\n")
+            out_html.append("<p>" + html.escape(note) + "</p>")
+    out_html.append("<h2>Pivots (48 kHz)</h2>")
+    for metric in PIVOTS:
+        candidates, keys, data = pivot(rows, metric)
+        if not keys:
+            continue
+        out_html.append("<h3>%s</h3><div class='wrap'><table><tr><th>source / scenario</th>" % metric
+                        + "".join("<th>%s</th>" % html.escape(c) for c in candidates) + "</tr>")
+        for k in keys:
+            out_html.append("<tr><td>%s / %s</td>" % (html.escape(k[0]), html.escape(k[1]))
+                            + "".join("<td>%s</td>" % fmt(data.get((k, c))) for c in candidates) + "</tr>")
+        out_html.append("</table></div>")
+    out_html.append("</body></html>")
+    with open(os.path.join(d, "summary.md"), "w", encoding="utf-8") as f:
+        f.write("\n".join(out_md) + "\n")
+    with open(os.path.join(d, "summary.html"), "w", encoding="utf-8") as f:
+        f.write("\n".join(out_html))
+
+
+LISTENING_TEMPLATE = """<!doctype html>
+<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Sonification listening test</title>
+<style>
+:root{--bg:#fff;--fg:#1a202c;--muted:#718096;--line:#cbd5e0;--accent:#2b6cb0}
+@media (prefers-color-scheme: dark){:root{--bg:#1a202c;--fg:#edf2f7;--muted:#a0aec0;--line:#4a5568;--accent:#63b3ed}}
+body{font:15px -apple-system,system-ui,sans-serif;margin:16px;background:var(--bg);color:var(--fg);max-width:820px}
+.trial{border:1px solid var(--line);border-radius:8px;padding:12px;margin:14px 0}
+.item{display:flex;align-items:center;gap:10px;margin:6px 0;flex-wrap:wrap}
+.item b{width:2.5em}
+input[type=range]{flex:1;min-width:160px}
+button{font:inherit;padding:4px 10px;border-radius:6px;border:1px solid var(--line);background:transparent;color:var(--fg)}
+button.ref{border-color:var(--accent);color:var(--accent)}
+.muted{color:var(--muted)}
+</style></head><body>
+<h1>Blind listening test</h1>
+<p class="muted">Per trial: play the <b>reference</b> (the unprocessed recording), then rate every item 0-100
+for how good and natural it sounds as a sound that follows a tracing finger (100 = indistinguishable from the
+reference in quality). The reference is also hidden among the items; one item is a deliberately poor anchor.
+The order is random. Use headphones. Download your results at the end.</p>
+<p><label>Listener: <input id="listener" placeholder="initials"></label></p>
+<div id="trials"></div>
+<p><button id="dl">Download results (JSON)</button> <span id="status" class="muted"></span></p>
+<script>
+const TRIALS = __TRIALS__;
+const HIDDEN_REF = "Source";
+function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
+let saved = {};
+try { saved = JSON.parse(localStorage.getItem("bakeoff-ratings") || "{}"); } catch (e) { saved = {}; }
+const session = {started: new Date().toISOString(), trials: []};
+const container = document.getElementById("trials");
+let current = null;
+function play(src){ if(current){current.pause();} current = new Audio(src); current.play(); }
+TRIALS.forEach((t, ti) => {
+  const order = shuffle(t.items.map(x => x.candidate));
+  const rec = {trial: t.id, scenario: t.scenario, source: t.source, order: order, ratings: {}};
+  session.trials.push(rec);
+  const div = document.createElement("div"); div.className = "trial";
+  div.innerHTML = `<h3>Trial ${ti+1} of ${TRIALS.length}</h3>`;
+  const refBtn = document.createElement("button"); refBtn.className = "ref"; refBtn.textContent = "Play reference";
+  refBtn.onclick = () => play(t.reference); div.appendChild(refBtn);
+  order.forEach((cand, k) => {
+    const item = t.items.find(x => x.candidate === cand);
+    const row = document.createElement("div"); row.className = "item";
+    const label = String.fromCharCode(65 + k);
+    const key = t.id + "|" + cand;
+    const init = saved[key] !== undefined ? saved[key] : 50;
+    rec.ratings[cand] = saved[key] !== undefined ? saved[key] : null;
+    row.innerHTML = `<b>${label}</b>`;
+    const b = document.createElement("button"); b.textContent = "Play"; b.onclick = () => play(item.path);
+    const s = document.createElement("input"); s.type = "range"; s.min = 0; s.max = 100; s.value = init;
+    const v = document.createElement("span"); v.textContent = rec.ratings[cand] === null ? "-" : init;
+    s.oninput = () => { rec.ratings[cand] = Number(s.value); v.textContent = s.value; saved[key] = Number(s.value);
+      try { localStorage.setItem("bakeoff-ratings", JSON.stringify(saved)); } catch (e) {} };
+    row.appendChild(b); row.appendChild(s); row.appendChild(v); div.appendChild(row);
+  });
+  container.appendChild(div);
+});
+document.getElementById("dl").onclick = () => {
+  session.listener = document.getElementById("listener").value;
+  session.finished = new Date().toISOString();
+  const unrated = session.trials.reduce((n, t) => n + Object.values(t.ratings).filter(v => v === null).length, 0);
+  document.getElementById("status").textContent = unrated ? unrated + " item(s) not yet rated" : "complete";
+  const blob = new Blob([JSON.stringify(session, null, 2)], {type: "application/json"});
+  const a = document.createElement("a"); a.href = URL.createObjectURL(blob);
+  a.download = "bakeoff-ratings-" + (session.listener || "anon") + ".json"; a.click();
+};
+</script></body></html>
+"""
+
+
+def write_listening(d, manifest, all_trials):
+    by = defaultdict(dict)
+    for m in manifest:
+        by[(m["scenario"], m["source"])][m["candidate"]] = m["path"]
+    trials = []
+    for (scenario, source), items in sorted(by.items(), key=lambda kv: (kv[0][1], kv[0][0])):
+        if not all_trials and scenario not in DEFAULT_TRIALS:
+            continue
+        if source.startswith("probe"):
+            continue  # the sweep probe is a measuring signal, not a stimulus
+        if HIDDEN_REF not in items or ANCHOR not in items:
+            continue
+        # The known reference: the unprocessed source at rate 1 for this scenario.
+        trials.append({
+            "id": "%s/%s" % (scenario, source),
+            "scenario": scenario,
+            "source": source,
+            "reference": items[HIDDEN_REF],
+            "items": [{"candidate": c, "path": p} for c, p in sorted(items.items())],
+        })
+    page = LISTENING_TEMPLATE.replace("__TRIALS__", json.dumps(trials, indent=1))
+    with open(os.path.join(d, "listening.html"), "w", encoding="utf-8") as f:
+        f.write(page)
+    return len(trials)
+
+
+def main(argv):
+    if len(argv) < 2:
+        print(__doc__)
+        return 2
+    d = argv[1]
+    all_trials = "--all-trials" in argv
+    rows = load_rows(os.path.join(d, "bench.csv"))
+    run_info = {}
+    p = os.path.join(d, "run_info.json")
+    if os.path.exists(p):
+        with open(p, encoding="utf-8") as f:
+            run_info = json.load(f)
+    write_summary(d, rows, run_info)
+    n = 0
+    p = os.path.join(d, "manifest.json")
+    if os.path.exists(p):
+        with open(p, encoding="utf-8") as f:
+            n = write_listening(d, json.load(f), all_trials)
+    print("rows %d; wrote summary.md, summary.html, listening.html (%d trials) in %s" % (len(rows), n, d))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
