diff --git a/PrimaeNativeTests/SonificationBakeoff/PitchMetricSelfTests.swift b/PrimaeNativeTests/SonificationBakeoff/PitchMetricSelfTests.swift
index bb171980..f885b23e 100644
--- a/PrimaeNativeTests/SonificationBakeoff/PitchMetricSelfTests.swift
+++ b/PrimaeNativeTests/SonificationBakeoff/PitchMetricSelfTests.swift
@@ -233,6 +233,38 @@ final class PitchMetricSelfTests: XCTestCase {
         XCTAssertFalse(try XCTUnwrap(gates(b, "traj_pitch_lag").first).pass, "25 ms lag must fail (\(l1) ms)")
     }
 
+    /// Ruling (c), lane C1: the attack gate. A render that follows the commanded height pitch from the first sample
+    /// must read a small attack error; the same render with each stroke's first 50 ms held at 0 cents (the shipped
+    /// engine's unshifted attack) must read hundreds of cents and FAIL. The predicate itself: 5 c passes, above fails,
+    /// unmeasured fails.
+    @MainActor
+    func testAttackGateSeesAnUnshiftedAttack() throws {
+        XCTAssertTrue(PitchGates.attack(rmsCents: 4.9).pass)
+        XCTAssertFalse(PitchGates.attack(rmsCents: 5.1).pass)
+        XCTAssertFalse(PitchGates.attack(rmsCents: nil).pass, "an unmeasured attack must not pass")
+        let ref = PitchSourceRef(syntheticSource(vowel(f0: 200)))
+        let scenario = PitchScenarios.heightTrajectory(letter: "A", strokes: try BakeoffSources.strokes(letter: "A"))
+        guard case .trajectory(_, _, _, let commanded) = scenario.family else { return XCTFail("not a trajectory") }
+        let opens = scenario.openIntervals.map { Double(BakeoffRunner.appliedFrame($0.open, sampleRate: sr)) / sr }
+        func traced(unshiftedAttack: Bool) -> [Float] {
+            BakeoffSynthetic.vowel(seconds: scenario.duration, sampleRate: sr, f0At: { t in
+                if unshiftedAttack, let o = opens.last(where: { $0 <= t }), t - o < 0.05 { return 200 }
+                return 200 * pow(2, BakeoffScenarios.commanded(commanded, at: t) / 1200)
+            }).x
+        }
+        let good = PitchRunner.rows(candidate: "t", render: render(traced(unshiftedAttack: false)), ref: ref,
+                                    scenario: scenario)
+        let bad = PitchRunner.rows(candidate: "t", render: render(traced(unshiftedAttack: true)), ref: ref,
+                                   scenario: scenario)
+        let g = try XCTUnwrap(good.rows.first { $0.metric == "traj_attack_rms_cents" }).value
+        let b = try XCTUnwrap(bad.rows.first { $0.metric == "traj_attack_rms_cents" }).value
+        let badGate = try XCTUnwrap(gates(bad, "traj_attack").first)
+        print("C1ATTACK selftest good=\(g) bad=\(b) goodPass=\(try XCTUnwrap(gates(good, "traj_attack").first).pass)")
