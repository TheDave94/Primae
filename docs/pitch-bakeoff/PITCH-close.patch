+#!/usr/bin/env python3
+"""Collect the bench's renders into the MUSHRA renders root (lane BENCH-P, 2026-11-23). Stdlib only.
+
+usage: python3 scripts/pitch_bakeoff/collect.py <pulled bakeoff dir> <renders root> [--phase1 <phase-1 wav dir>]
+       [--fixed source,anchor_naive,praat_psola,praat_cg03,world,world_g03,ours_AB]
+
+Copies <pulled>/renders/<candidate>/*.wav to <renders root>/<candidate>/, and (with --phase1) the phase-1 fixed
+columns <phase-1 wav>/<method>/<L>__<c>c.wav (+ __traj) to <renders root>/<method>/, so method/build_mushra.py rates
+the phase-2 candidates against the same anchors:
+  python3 <phase-1>/method/build_mushra.py <renders root> <out> --ref source --anchor anchor_naive \\
+      --methods ours,ours_AB,praat_psola,world,<new candidates...>
+An existing file is never overwritten silently: a differing file stops the copy.
+"""
+import argparse, filecmp, os, shutil, sys
+ap = argparse.ArgumentParser()
+ap.add_argument('pulled'); ap.add_argument('root'); ap.add_argument('--phase1')
+ap.add_argument('--fixed', default='source,anchor_naive,praat_psola,praat_cg03,world,world_g03,ours_AB')
+a = ap.parse_args()
+
+def copy_tree(src_dir, dst_dir):
+    n = 0
+    os.makedirs(dst_dir, exist_ok=True)
+    for f in sorted(os.listdir(src_dir)):
+        if not f.endswith('.wav'): continue
+        s, d = os.path.join(src_dir, f), os.path.join(dst_dir, f)
+        if os.path.exists(d) and not filecmp.cmp(s, d, shallow=False):
+            sys.exit(f'refusing to overwrite a different file: {d}')
+        shutil.copyfile(s, d); n += 1
+    return n
+
+total = 0
+rr = os.path.join(a.pulled, 'renders')
+for c in sorted(os.listdir(rr)):
+    if os.path.isdir(os.path.join(rr, c)):
+        k = copy_tree(os.path.join(rr, c), os.path.join(a.root, c)); total += k; print(f'{c}: {k}')
+if a.phase1:
+    for m in a.fixed.split(','):
+        src = os.path.join(a.phase1, m)
+        if not os.path.isdir(src): print(f'phase-1 column missing: {m}'); continue
+        if m == 'ours': sys.exit('phase-1 "ours" (kernel path) would collide with the harness column "ours"')
+        k = copy_tree(src, os.path.join(a.root, m)); total += k; print(f'{m} (phase 1): {k}')
+print('COPIED', total)
