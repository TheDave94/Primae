index 00000000..bb1bd495
--- /dev/null
+++ b/PrimaeNativeTests/SonificationWorldRT/WorldRTRealtimeTests.swift
@@ -0,0 +1,79 @@
+// WorldRTRealtimeTests.swift
+// PrimaeNativeTests — pitch bake-off phase 2, lane C2 "WorldRT" (2026-11-23)
+//
+// Gate 1 (RT safety) and gate 2 (CPU) for the candidate, pure buffers. XCTest
+// for the same reason as SonificationRealtimeTests: the malloc hook is
+// process-global and counts on one thread.
+
+import XCTest
+@testable import PrimaeNative
+
+final class WorldRTRealtimeTests: XCTestCase {
+    static let sr = LiveSonificationKernel.sampleRate
+
+    private func renderers() throws -> [(String, WorldRT)] {
+        try StudySources.all().map { s in
+            (s.name, WorldRT(source: s.samples, sampleRate: Self.sr, kind: s.kind, maxFramesPerRender: 512,
+                             tuning: .default, onset: s.onset))
+        }
+    }
+
+    /// Every source (vocoder, resample and carrier modes): trajectory drive with gate cycles, counted around each
+    /// `render` and setter call. Includes a gamma-warped renderer (the warp path).
+    func testWorldRTAllocatesNothing() throws {
+        var list = try renderers()
+        var g = WorldRTTuning.default
+        g.gamma = 0.3
+        let a = try StudySources.load("A_phoneme1")
+        list.append(("A_phoneme1+gamma", WorldRT(source: a.samples, sampleRate: Self.sr, kind: a.kind,
+                                                 maxFramesPerRender: 512, tuning: g, onset: a.onset)))
+        let out = UnsafeMutablePointer<Float>.allocate(capacity: 512)
+        defer { out.deallocate() }
+        guard RenderThreadAllocationCounter.install() else { return XCTFail("malloc_logger hook unavailable") }
+        defer { RenderThreadAllocationCounter.uninstall() }
+        for (label, r) in list {
+            r.reset()
+            let before = RenderThreadAllocationCounter.allocations
+            for k in 0..<2000 {
+                let rate = Float(0.5 + 1.5 * (0.5 + 0.5 * sin(Double(k) * 0.01)))
+                let cents = Float(1200 * sin(Double(k) * 0.013))
+                RenderThreadAllocationCounter.arm()
+                r.setRate(rate)
+                r.setPitchCents(cents)
+                if k % 300 == 0 { r.setGate(true) }
+                if k % 300 == 200 { r.setGate(false) }
+                r.render(into: out, frames: 256)
+                RenderThreadAllocationCounter.disarm()
+            }
+            XCTAssertEqual(RenderThreadAllocationCounter.allocations - before, 0, "\(label): allocations on the render path")
+        }
+    }
+
+    /// Gate 2: wall time per 256-frame render on a pen-like trajectory (pitch +-600 c at 0.67 Hz, rate 0.5..1.5),
+    /// 3 s per source, after one warm-up pass. Printed as `WORLDRT_CPU` lines (the numbers the lane reports come
+    /// from a Release-Study run on the iPad); asserted only against the hard limit, one buffer (5.8 ms).
+    func testWorldRTCPUPerBuffer() throws {
+        let out = UnsafeMutablePointer<Float>.allocate(capacity: 512)
+        defer { out.deallocate() }
+        let buffers = Int(3.0 * Self.sr / 256)
+        for (label, r) in try renderers() {
+            var times: [Double] = []
+            for pass in 0..<2 {
+                r.reset(); r.setRate(1); r.setPitchCents(0); r.setGate(true)
+                for b in 0..<buffers {
+                    let t = Double(b * 256) / Self.sr
+                    r.setPitchCents(Float(600 * sin(2 * Double.pi * t / 1.5)))
+                    r.setRate(Float(1 + 0.5 * sin(2 * Double.pi * t / 0.9)))
+                    let t0 = DispatchTime.now().uptimeNanoseconds
+                    r.render(into: out, frames: 256)
+                    let dt = Double(DispatchTime.now().uptimeNanoseconds - t0) / 1000
+                    if pass == 1 { times.append(dt) }
+                }
+            }
+            times.sort()
+            let median = times[times.count / 2], p99 = times[times.count * 99 / 100], mx = times[times.count - 1]
+            print(String(format: "WORLDRT_CPU %@ median_us %.1f p99_us %.1f max_us %.1f", label, median, p99, mx))
+            XCTAssertLessThan(mx, 256 / Self.sr * 1e6, "\(label): a buffer took longer than its own duration")
+        }
+    }
+}
