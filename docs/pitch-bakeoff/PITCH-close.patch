+    private let n: Int
+    private let bins: Int
+    private let seamLen: Double
+    private let loopStart: Double
+    private let loopEnd: Double
+    private let loopLen: Double
+    private let noiseTable: [Double]
+    private let dcRemRe: [Double], dcRemIm: [Double]
+
+    /// `source`: the raw file samples (C2 analyses those); `played`: the prepared copy the live path plays (the
+    /// pre-voicing prefix is copied from it); `analysis`: the marks (`TDPSOLAAnalysis` with the recorded onset).
+    init(source: [Float], played: [Float], sampleRate sr: Double, analysis a: TDPSOLAAnalysis,
+         tuning: WorldRTTuning = .default, world: WorldRTAnalysis? = nil) {
+        precondition(a.isVoiced && a.marks.count >= 4, "WorldBankRenderer needs a voiced analysis")
+        analysis = a
+        self.tuning = tuning
+        sampleRate = sr
+        self.played = played
+        let w = world ?? WorldRTAnalysis.analyse(source, sampleRate: sr, marks: a)
+        self.world = w
+        n = w.fftSize
+        bins = n / 2 + 1
+        loopStart = a.loopStart
+        loopEnd = a.loopEnd
+        loopLen = max(1, a.loopEnd - a.loopStart)
+        let before = a.loopStart - a.marks[0] - 2 * w.frameSamples
+        seamLen = max(0, min(tuning.seamSeconds * sr, before, 0.5 * (a.loopEnd - a.loopStart)))
+        var r = WorldCommon.Randn()
+        noiseTable = (0..<(1 << 16)).map { _ in r.next() }
+        // C2's causal DC remover (WORLD's `GetDCRemover` Hann over 1024 samples, unit sum) and its spectrum.
+        let k = 1024
+        var rem = [Double](repeating: 0, count: k)
+        var sum = 0.0
+        for i in 0..<k { rem[i] = 0.5 - 0.5 * cos(2.0 * Double.pi * (Double(i) + 1.0) / (Double(k) + 1.0)); sum += rem[i] }
+        var re = [Double](repeating: 0, count: n / 2 + 1), im = re
+        for b in 0...(n / 2) {
+            var sr0 = 0.0, si0 = 0.0
+            for i in 0..<k {
+                let ph = -2.0 * Double.pi * Double(b) * Double(i) / Double(n)
+                sr0 += rem[i] / sum * cos(ph); si0 += rem[i] / sum * sin(ph)
+            }
+            re[b] = sr0; im[b] = si0
+        }
+        dcRemRe = re; dcRemIm = im
+        if tuning.levelCalibration {
+            let raw = synthesize(PitchBankLayout(analysis: a, pitchFactor: 1), gain: 1)
+            var es = 0.0, ev = 0.0
+            let lo = max(0, Int(a.loopStart.rounded(.up))), hi = min(played.count, raw.full.count, Int(a.loopEnd))
+            if lo < hi {
+                for i in lo..<hi { es += Double(played[i]) * Double(played[i]); ev += Double(raw.full[i]) * Double(raw.full[i]) }
+            }
+            calibrationGain = ev > 0 && es > 0 ? (es / ev).squareRoot() : 1
+        }
+    }
+
+    func render(_ layout: PitchBankLayout) -> PitchBankRender {
+        synthesize(layout, gain: calibrationGain)
+    }
+
+    // MARK: synthesis (WORLD GetOneFrameSegment per source mark)
+
+    private func synthesize(_ layout: PitchBankLayout, gain: Double) -> PitchBankRender {
+        let a = analysis
+        let pf = layout.pitchFactor
+        let len = layout.length + n
+        var full = [Double](repeating: 0, count: len)
+        var ape = [Double](repeating: 0, count: len)
+        let fft = WorldRealFFT(size: n)
+        var spv = [Double](repeating: 0, count: bins), apv = spv
+        var hpRe = spv, hpIm = spv, haRe = spv, haIm = spv, nzRe = spv, nzIm = spv
+        let noiseLen = noiseTable.count
+        for i in 0..<a.marks.count {
+            let t = layout.marks[i]
+            let period = layout.periods[i] * pf   // the source-side period this pulse re-spaces
+            parameters(at: a.marks[i], sp: &spv, ap: &apv)
+            let f0 = sampleRate / period
+            var levelGain = 1.0
+            if tuning.pitchLevelCompensation && pf != 1 {
+                let p0 = harmonicPower(spv, apv, f0), p1 = harmonicPower(spv, apv, f0 * pf)
+                if p0 > 0 && p1 > 0 { levelGain = max(0.5, min(2.0, (p0 / p1).squareRoot())) }
+            }
+            let shim = tuning.shimmerCarry != 0 ? pow(world.shimmer[i], tuning.shimmerCarry) : 1
+            let interval = max(8, period / pf)
+            let ns = max(1, min(n, Int(interval.rounded())))
+            // Aperiodic ratio ap^2; log amplitude of the periodic and aperiodic responses.
+            var logP = [Double](repeating: 0, count: bins), logA = logP
+            let periodicOn = apv[0] * apv[0] <= 0.999
+            for b in 0..<bins {
+                let r = apv[b] * apv[b]
+                logP[b] = 0.5 * log(spv[b] * (1 - r) + WorldConstants.kMySafeGuardMinimum)
+                logA[b] = 0.5 * log(spv[b] * r + 1e-30)
+            }
+            minimumPhase(fft, logP, &hpRe, &hpIm)
+            minimumPhase(fft, logA, &haRe, &haIm)
+            // Noise: the same table segment for mark i in every bank (the banks' aperiodic parts stay correlated).
+            let start = (i &* 40503) % noiseLen
+            var mean = 0.0
+            for j in 0..<ns { mean += noiseTable[(start + j) % noiseLen] }
+            mean /= Double(ns)
+            for j in 0..<n { fft.waveform[j] = j < ns ? noiseTable[(start + j) % noiseLen] - mean : 0 }
+            fft.forward()
+            for b in 0..<bins { nzRe[b] = fft.specRe[b]; nzIm[b] = fft.specIm[b] }
+            // Periodic: sqrt(interval) x shimmer x compensation x Hp, delayed by the fractional position; DC removed.
+            let p = Int(t.rounded(.down))
+            let frac = t - Double(p)
+            let gP = periodicOn ? interval.squareRoot() * shim * levelGain : 0
+            for b in 0..<bins {
+                let ph = -2.0 * Double.pi * Double(b) * frac / Double(n)
+                let c = cos(ph), s = sin(ph)
+                let hr = hpRe[b] * gP, hi = hpIm[b] * gP
+                fft.specRe[b] = hr * c - hi * s
+                fft.specIm[b] = hr * s + hi * c
+            }
+            let dc = fft.specRe[0]
+            for b in 0..<bins { fft.specRe[b] -= dc * dcRemRe[b]; fft.specIm[b] -= dc * dcRemIm[b] }
+            fft.inverse()
+            let scale = gain / Double(n)
+            for j in 0..<n where p + j < len { full[p + j] += fft.waveform[j] * scale }
+            // Aperiodic: Ha x Noise.
+            for b in 0..<bins {
+                fft.specRe[b] = haRe[b] * nzRe[b] - haIm[b] * nzIm[b]
+                fft.specIm[b] = haRe[b] * nzIm[b] + haIm[b] * nzRe[b]
+            }
+            fft.inverse()
+            for j in 0..<n where p + j < len {
+                let v = fft.waveform[j] * scale
+                full[p + j] += v
+                ape[p + j] += v
+            }
+        }
+        // The pre-voicing prefix: the played samples before the first mark, faded out over its last source period
+        // (the synthesised pulses start at the first mark).
+        let m0 = a.marks[0], t0 = a.periods[0]
+        let end = min(played.count, Int(m0.rounded(.up)))
+        for j in 0..<max(0, end) {
+            let d = m0 - Double(j)
+            let w = d >= t0 ? 1.0 : 0.5 - 0.5 * cos(Double.pi * max(0, d) / t0)
+            full[j] += Double(played[j]) * w
+        }
+        return PitchBankRender(full: full.prefix(layout.length).map { Float($0) },
+                               noise: ape.prefix(layout.length).map { Float($0) })
+    }
+
+    /// Envelope and clamped aperiodicity at source position `tau`, with C2's parameter-domain loop seam (positions past
+    /// the loop end read one loop earlier; the last `seamLen` before it blend to one loop earlier, raised cosine).
+    private func parameters(at tau0: Double, sp: inout [Double], ap: inout [Double]) {
+        var tau = tau0
+        if tau >= loopEnd { tau -= loopLen }
+        for b in 0..<bins { sp[b] = 0; ap[b] = 0 }
+        let seamStart = loopEnd - seamLen
+        if seamLen > 0 && tau > seamStart {
+            let u = (tau - seamStart) / seamLen
+            let wb = 0.5 - 0.5 * cos(Double.pi * u)
+            accumulate(tau, 1 - wb, &sp, &ap)
+            accumulate(tau - loopLen, wb, &sp, &ap)
+        } else {
+            accumulate(tau, 1, &sp, &ap)
+        }
+    }
+
+    private func accumulate(_ pos: Double, _ w: Double, _ sp: inout [Double], _ ap: inout [Double]) {
+        let maxF = Double(world.frameCount - 1)
+        let fi = min(maxF, max(0, pos / world.frameSamples))
+        let k0 = Int(fi), k1 = min(world.frameCount - 1, k0 + 1)
+        let t = fi - Double(k0)
+        let s = world.spectrogram, a = world.aperiodicity
+        for b in 0..<bins {
+            let s0 = Double(s[k0 * bins + b]), s1 = Double(s[k1 * bins + b])
+            let a0 = WorldCommon.safeAperiodicity(Double(a[k0 * bins + b]))
+            let a1 = WorldCommon.safeAperiodicity(Double(a[k1 * bins + b]))
+            sp[b] += w * (s0 + (s1 - s0) * t)
+            ap[b] += w * (a0 + (a1 - a0) * t)
+        }
+    }
+
+    /// f0 x sum over harmonics h f0 < fs/2 of sp (1 - ap^2) (C2's `harmonicPower`).
+    private func harmonicPower(_ sp: [Double], _ ap: [Double], _ f0: Double) -> Double {
+        let step = f0 * Double(n) / sampleRate
+        guard step > 0.5 else { return 0 }
+        let last = Double(bins - 1)
+        var q = step, sum = 0.0
+        while q < last {
+            let k0 = Int(q)
+            let f = q - Double(k0)
+            let s = sp[k0] + (sp[k0 + 1] - sp[k0]) * f
+            let a = ap[k0] + (ap[k0 + 1] - ap[k0]) * f
+            sum += s * (1 - a * a)
+            q += step
+        }
+        return sum * f0
+    }
+
+    /// WORLD `GetMinimumPhaseSpectrum` (double): log amplitude (bins 0...N/2) -> minimum-phase spectrum.
+    private func minimumPhase(_ fft: WorldRealFFT, _ logMag: [Double], _ outRe: inout [Double], _ outIm: inout [Double]) {
+        let h = n / 2
+        for k in 0...h { fft.waveform[k] = logMag[k] }
+        for k in 1..<h { fft.waveform[n - k] = logMag[k] }
+        fft.forward()
+        let c0 = fft.specRe[0] / Double(n), ch = fft.specRe[h] / Double(n)
+        var cep = [Double](repeating: 0, count: n)
+        cep[0] = c0
+        for k in 1..<h { cep[k] = 2 * fft.specRe[k] / Double(n) }
+        cep[h] = ch
+        for k in 0..<n { fft.waveform[k] = cep[k] }
+        fft.forward()
+        for k in 0...h {
+            let m = exp(fft.specRe[k])
+            outRe[k] = m * cos(fft.specIm[k])
+            outIm[k] = m * sin(fft.specIm[k])
+        }
+    }
+}
