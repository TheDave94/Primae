@@ -0,0 +1,82 @@
+#!/usr/bin/env python3
+"""Pitch bake-off phase 2 report (lane BENCH-P, 2026-11-23). Stdlib only.
+
+usage: python3 scripts/pitch_bakeoff/report.py <bench dir with bench.csv + gates.csv> [--out summary.md]
+
+Writes a Markdown summary: per candidate, the gate PASS/FAIL counts per gate, every FAILED gate row, and the
+baseline-style table of the headline numbers at rate 1 (held +-300/+-600, steps, sweep, trajectory, CPU).
+"""
+import csv, sys, os, collections, argparse
+
+ap = argparse.ArgumentParser()
+ap.add_argument('dir'); ap.add_argument('--out', default=None)
+a = ap.parse_args()
+rows = list(csv.DictReader(open(os.path.join(a.dir, 'bench.csv'))))
+gates = list(csv.DictReader(open(os.path.join(a.dir, 'gates.csv'))))
+out = []
+P = out.append
+cands = [c for c in dict.fromkeys(r['candidate'] for r in rows) if c != 'Source']
+letters = sorted({r['source'][0] for r in rows})
+
+P('# Pitch bake-off phase 2: bench summary\n')
+P('Source rows: ' + ', '.join(f"{r['source']} {r['metric']}={float(r['value']):.4g}" for r in rows if r['candidate'] == 'Source') + '\n')
+
+P('## Gates: PASS / total per candidate\n')
+by = collections.defaultdict(lambda: [0, 0])
+names = sorted({g['gate'] for g in gates})
+for g in gates:
+    k = (g['candidate'], g['gate']); by[k][1] += 1; by[k][0] += g['pass'] == 'PASS'
+P('| gate | ' + ' | '.join(cands) + ' |'); P('|---|' + '---|' * len(cands))
+for n in names:
+    P(f'| {n} | ' + ' | '.join(f"{by[(c, n)][0]}/{by[(c, n)][1]}" if by[(c, n)][1] else '-' for c in cands) + ' |')
+P('')
+
+def val(c, src, sc, m):
+    for r in rows:
+        if r['candidate'] == c and r['source'] == src and r['scenario'] == sc and r['metric'] == m:
+            return float(r['value'])
+    return None
+
+def fmt(v, d=2):
+    return '-' if v is None else f'{v:.{d}f}'
+
+HEAD = [('f0_err_c', 'f0 c', 2), ('env_warp', 'alpha', 3), ('env_lsd_db', 'LSD', 2), ('env_lsd_frame_db', 'fLSD', 2),
+        ('jitter_ratio', 'jit x', 2), ('shimmer_ratio', 'shim x', 2), ('level_re_0c_db', 'lvl dB', 2),
+        ('f_wobble_db', 'F wob', 2), ('f_comb_acf', 'F acf', 3), ('cpu_median_us', 'cpu med us', 1),
+        ('cpu_max_us', 'cpu max us', 1)]
+for c in cands:
+    P(f'## {c}\n')
+    for rate in ['0.5', '1', '2']:
+        scs = [f'pitch_{x}@{rate}' for x in ('-600', '-300', '0', '+300', '+600')]
+        if not any(val(c, f'{L}_phoneme1', s, 'cpu_median_us') is not None for L in letters for s in scs):
+            continue
+        P(f'### held pitch, rate {rate}\n')
+        P('| src | cents | ' + ' | '.join(h[1] for h in HEAD) + ' |'); P('|---|---|' + '---|' * len(HEAD))
+        for L in letters:
+            for s in scs:
+                vs = [val(c, f'{L}_phoneme1', s, m) for m, _, _ in HEAD]
+                if all(v is None for v in vs): continue
+                P(f'| {L} | {s.split("_")[1].split("@")[0]} | ' + ' | '.join(fmt(v, d) for v, (_, _, d) in zip(vs, HEAD)) + ' |')
+        P('')
+    P('### control: steps, sweep, trajectory (all rates)\n')
+    P('| src | scenario | step90 ms | step click | sweep click | traj lag ms | traj rms c | traj click | onset ms |')
+    P('|---|---|---|---|---|---|---|---|---|')
+    for L in letters:
+        src = f'{L}_phoneme1'
+        for sc in sorted({r['scenario'] for r in rows if r['candidate'] == c and r['source'] == src
+                          and not r['scenario'].startswith('pitch_')}):
+            P(f'| {L} | {sc} | {fmt(val(c, src, sc, "pitch_step_delay90_ms"), 1)} | {fmt(val(c, src, sc, "step_click_ratio"))} | '
+              f'{fmt(val(c, src, sc, "sweep_click_ratio"))} | {fmt(val(c, src, sc, "traj_pitch_lag_ms"), 1)} | '
+              f'{fmt(val(c, src, sc, "traj_pitch_rms_cents"), 1)} | {fmt(val(c, src, sc, "traj_click_ratio"))} | '
+              f'{fmt(val(c, src, sc, "onset_m20_ms"), 1)} |')
+    P('')
+    fails = [g for g in gates if g['candidate'] == c and g['pass'] != 'PASS']
+    P(f'### FAILED gates ({len(fails)})\n')
+    for g in fails:
+        P(f"- {g['source']} {g['scenario']} {g['gate']} = {g['value']} ({g['threshold']})")
+    P('')
+text = '\n'.join(out) + '\n'
+if a.out:
+    open(a.out, 'w').write(text)
+else:
+    sys.stdout.write(text)
