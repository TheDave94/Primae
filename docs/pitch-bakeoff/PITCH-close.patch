@@ -0,0 +1,93 @@
+// PitchBankRealtimeTests.swift
+// PrimaeNativeTests — pitch bake-off phase 2, lane C3 "PitchBank" (2026-11-24)
+//
+// Product gates 1 and 2 for the candidate (BAKEOFF.md; BAKEOFF-PITCH.md section 3), pure buffers:
+//   - RT safety: zero allocations in `render` and the setters on the BANK path (banks ready), under a rate + pitch +
+//     gate drive that crosses banks (the malloc hook of SonificationRealtimeTests);
+//   - CPU per 256 frames (median / p99 / max) on a +-600 c triangle at rate 1 and 2, printed `C3CPU` (the meaningful
+//     numbers come from the Release-Study device run; a loose bound keeps the measurement non-vacuous);
+//   - memory and load time per letter: a fresh bank build per voiced letter (its own cache), printed `C3LOAD`.
+// XCTest (the malloc hook is process-global and counts on one thread).
+
+import XCTest
+@testable import PrimaeNative
+
+final class PitchBankRealtimeTests: XCTestCase {
+
+    static let sr = LiveSonificationKernel.sampleRate
+
+    func testBankPathAllocatesNothing() throws {
+        var renderers: [(String, PitchBank)] = []
+        for name in ["I_phoneme1", "F_phoneme1"] {
+            renderers.append((name, PitchBankTestSupport.make(try StudySources.load(name))))
+        }
+        let out = UnsafeMutablePointer<Float>.allocate(capacity: 512)
+        defer { out.deallocate() }
+        guard RenderThreadAllocationCounter.install() else { return XCTFail("malloc_logger hook unavailable") }
+        defer { RenderThreadAllocationCounter.uninstall() }
+        for (label, r) in renderers {
+            r.reset()
+            let before = RenderThreadAllocationCounter.allocations
+            for k in 0..<2000 {
+                RenderThreadAllocationCounter.arm()
+                r.setRate(Float(0.5 + 1.5 * (0.5 + 0.5 * sin(Double(k) * 0.01))))
+                r.setPitchCents(Float(700 * sin(Double(k) * 0.013)))
+                if k % 300 == 0 { r.setGate(true) }
+                if k % 300 == 200 { r.setGate(false) }
+                r.render(into: out, frames: k % 5 == 0 ? 512 : 256)
+                RenderThreadAllocationCounter.disarm()
+            }
+            XCTAssertEqual(RenderThreadAllocationCounter.allocations - before, 0, "\(label): allocations on the render path")
+            if label.hasPrefix("I") { XCTAssertGreaterThan(r.bankSwitches, 20, "the drive crossed banks") }
+        }
+    }
+
+    func testCPUPerBuffer() throws {
+        let block = 256
+        let blocks = Int(6 * Self.sr) / block
+        let out = UnsafeMutablePointer<Float>.allocate(capacity: block)
+        defer { out.deallocate() }
+        var worstP99 = 0.0
+        for name in StudySources.voicedNames {
+            let r = PitchBankTestSupport.make(try StudySources.load(name))
+            for rate: Float in [1, 2] {
+                r.reset(); r.setRate(rate); r.setGate(true)
+                var t = [Double](); t.reserveCapacity(blocks)
+                for k in 0..<blocks {
+                    let ts = Double(k * block) / Self.sr
+                    let ph = ts.truncatingRemainder(dividingBy: 3.0)
+                    r.setPitchCents(Float(ph < 0.75 ? 800 * ph : ph < 2.25 ? 600 - 800 * (ph - 0.75) : -600 + 800 * (ph - 2.25)))
+                    let t0 = DispatchTime.now().uptimeNanoseconds
+                    r.render(into: out, frames: block)
+                    t.append(Double(DispatchTime.now().uptimeNanoseconds - t0) / 1000)
+                }
+                XCTAssertEqual(r.lastPath, .bank)
+                t.sort()
+                let med = t[t.count / 2], p99 = t[t.count * 99 / 100], mx = t.last!
+                worstP99 = max(worstP99, p99)
+                print(String(format: "C3CPU %@ PitchBank rate %.0f: median %.1f us, p99 %.1f us, max %.1f us per 256 frames",
+                             name, rate, med, p99, mx))
+            }
+        }
+        XCTAssertLessThan(worstP99, 1000, "p99 render time \(worstP99) us per 256 frames")
+    }
+
+    func testLoadTimeAndMemoryPerLetter() throws {
+        for name in StudySources.voicedNames {
+            let s = try StudySources.load(name)
+            let cache = PitchBankCache(capacity: 1)
+            var t = PitchBankTuning.default
+            t.waitForBanks = true
+            let t0 = DispatchTime.now().uptimeNanoseconds
+            let r = PitchBank(source: s.samples, sampleRate: Self.sr, kind: s.kind, maxFramesPerRender: 512,
+                              onset: s.onset, outputGain: 1, tuning: t, cache: cache, cacheKey: "load:\(name)")
+            let wall = Double(DispatchTime.now().uptimeNanoseconds - t0) / 1e9
+            let set = try XCTUnwrap(r.bankSet)
+            let fullOnly = set.views.reduce(0) { $0 + ($1.length + 2 * PitchBankSet.guardFrames) * 4 }
+            print(String(format: "C3LOAD %@: renderer init + 13 banks %.2f s (bank build %.2f s), %.2f MB (%.2f MB without the aperiodic parts), source %.2f s",
+                         name, wall, set.buildSeconds, Double(set.bytes) / 1e6, Double(fullOnly) / 1e6,
+                         Double(s.samples.count) / Self.sr))
+            XCTAssertGreaterThan(set.bytes, 0)
+        }
+    }
+}
