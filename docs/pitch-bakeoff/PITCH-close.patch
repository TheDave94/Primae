index 00000000..3c49416d
--- /dev/null
+++ b/PrimaeNative/Core/Sonification/Candidates/PitchBank/PitchBankSet.swift
@@ -0,0 +1,151 @@
+// PitchBankSet.swift
+// PrimaeNative — pitch bake-off phase 2, candidate C3 "PitchBank" (2026-11-24; NOT wired into the study path)
+//
+// The 13 banks of one phoneme (k = -6...6, 100 cents apart: +-600 cents), built off the render thread by a
+// `BankRenderer`, and the cache that holds them: only the active letter plus the next one prefetched
+// (BAKEOFF-PITCH.md section 2 C3, "Memory").
+//
+// Storage is raw (UnsafeMutablePointer, guard zeros around every bank) so the render thread reads it without touching
+// a Swift array or a class reference: the renderer copies the pointers into its own table (`PitchBankView`).
+
+import Foundation
+
+/// What the render thread reads of one bank (plain pointers; the owning `PitchBankSet` keeps them alive).
+nonisolated struct PitchBankView {
+    var full: UnsafeMutablePointer<Float>
+    var noise: UnsafeMutablePointer<Float>
+    var hasNoise: Bool
+    var marks: UnsafeMutablePointer<Double>
+    var pitchFactor: Double
+    var length: Int
+}
+
+nonisolated final class PitchBankSet: @unchecked Sendable {
+    /// Banks k = -steps...steps, `stepCents` apart.
+    static let steps = 6
+    static let stepCents = 100.0
+    static var count: Int { 2 * steps + 1 }
+    static let guardFrames = 4096
+
+    let rendererName: String
+    let markCount: Int
+    let views: [PitchBankView]
+    /// Bytes held (samples, aperiodic parts, marks).
+    let bytes: Int
+    /// Wall time of the build (renderer construction + 13 banks), seconds.
+    let buildSeconds: Double
+    private var allocations: [UnsafeMutableRawPointer] = []
+
+    /// Bank index (0...count-1) of bank k.
+    static func index(ofStep k: Int) -> Int { k + steps }
+    static func pitchFactor(ofStep k: Int) -> Double { exp2(Double(k) * stepCents / 1200) }
+
+    /// Builds every bank (blocking; call it off the render thread). `makeRenderer` runs first and is timed with the rest.
+    init(analysis a: TDPSOLAAnalysis, sourcePeriods: [Double]? = nil, makeRenderer: () -> any BankRenderer) {
+        let t0 = DispatchTime.now().uptimeNanoseconds
+        let renderer = makeRenderer()
+        rendererName = type(of: renderer).rendererName
+        markCount = a.marks.count
+        var v: [PitchBankView] = []
+        var bytes = 0
+        let g = Self.guardFrames
+        var allocs: [UnsafeMutableRawPointer] = []
+        for k in -Self.steps...Self.steps {
+            let layout = PitchBankLayout(analysis: a, pitchFactor: Self.pitchFactor(ofStep: k), sourcePeriods: sourcePeriods)
+            let r = renderer.render(layout)
+            let n = r.full.count
+            func store(_ x: [Float]) -> UnsafeMutablePointer<Float> {
+                let base = UnsafeMutablePointer<Float>.allocate(capacity: n + 2 * g)
+                base.initialize(repeating: 0, count: n + 2 * g)
+                x.withUnsafeBufferPointer { if let p = $0.baseAddress { (base + g).update(from: p, count: min(n, x.count)) } }
+                allocs.append(UnsafeMutableRawPointer(base))
+                bytes += (n + 2 * g) * MemoryLayout<Float>.size
+                return base + g
+            }
+            let full = store(r.full)
+            let noise = r.noise.map(store)
+            let mk = UnsafeMutablePointer<Double>.allocate(capacity: max(1, layout.marks.count))
+            for i in 0..<layout.marks.count { (mk + i).initialize(to: layout.marks[i]) }
+            allocs.append(UnsafeMutableRawPointer(mk))
+            bytes += layout.marks.count * MemoryLayout<Double>.size
+            v.append(PitchBankView(full: full, noise: noise ?? full, hasNoise: noise != nil, marks: mk,
+                                   pitchFactor: layout.pitchFactor, length: n))
+        }
+        views = v
+        self.bytes = bytes
+        allocations = allocs
+        buildSeconds = Double(DispatchTime.now().uptimeNanoseconds - t0) / 1e9
+    }
+
+    deinit { for p in allocations { p.deallocate() } }
+}
+
+/// Holds the bank sets of at most `capacity` sources (default 2: the active letter plus the next one prefetched),
+/// building them one at a time on a background queue. A renderer keeps its own reference to the set it plays, so an
+/// eviction never frees a bank in use. Thread-safe; never touched by the render thread.
+nonisolated final class PitchBankCache: @unchecked Sendable {
+    static let shared = PitchBankCache(capacity: 2)
+
+    let capacity: Int
+    private let lock = NSLock()
+    private var entries: [(key: String, set: PitchBankSet)] = []   // most recently requested first
+    private var inflight: [String: [@Sendable (PitchBankSet) -> Void]] = [:]
+    private let queue = DispatchQueue(label: "de.flamingistan.primae.pitchbank", qos: .userInitiated)
+
+    init(capacity: Int) { self.capacity = max(1, capacity) }
+
+    /// Keys held, most recent first.
+    var keys: [String] { lock.lock(); defer { lock.unlock() }; return entries.map(\.key) }
+    var bytes: Int { lock.lock(); defer { lock.unlock() }; return entries.reduce(0) { $0 + $1.set.bytes } }
+
+    /// The set for `key` when cached (marked most recent), else nil.
+    func cached(_ key: String) -> PitchBankSet? {
+        lock.lock(); defer { lock.unlock() }
+        guard let i = entries.firstIndex(where: { $0.key == key }) else { return nil }
+        let e = entries.remove(at: i)
+        entries.insert(e, at: 0)
+        return e.set
+    }
+
+    /// Delivers the set for `key` to `completion` (on the cache's queue, or synchronously when cached), building it in
+    /// the background when absent. Requests for a key already building join that build.
+    func request(_ key: String, build: @escaping @Sendable () -> PitchBankSet,
+                 completion: @escaping @Sendable (PitchBankSet) -> Void) {
+        if let s = cached(key) { completion(s); return }
+        lock.lock()
+        if inflight[key] != nil {
+            inflight[key]!.append(completion)
+            lock.unlock()
+            return
+        }
+        inflight[key] = [completion]
+        lock.unlock()
+        queue.async { [self] in
+            let s = build()
+            lock.lock()
+            entries.removeAll { $0.key == key }
+            entries.insert((key, s), at: 0)
+            if entries.count > capacity { entries.removeLast(entries.count - capacity) }
+            let waiting = inflight.removeValue(forKey: key) ?? []
+            lock.unlock()
+            for c in waiting { c(s) }
+        }
+    }
+
+    /// Starts building `key` without waiting (the next letter).
+    func prefetch(_ key: String, build: @escaping @Sendable () -> PitchBankSet) {
+        request(key, build: build) { _ in }
+    }
+
+    /// The set for `key`, building it if needed (blocks the caller; never call it on the render thread).
+    func get(_ key: String, build: @escaping @Sendable () -> PitchBankSet) -> PitchBankSet {
+        if let s = cached(key) { return s }
+        let done = DispatchSemaphore(value: 0)
+        nonisolated(unsafe) var out: PitchBankSet?
+        request(key, build: build) { s in out = s; done.signal() }
+        done.wait()
+        return out!
+    }
+
+    func removeAll() { lock.lock(); entries.removeAll(); lock.unlock() }
+}
