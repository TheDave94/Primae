+// WorldRTTests.swift
+// PrimaeNativeTests — pitch bake-off phase 2, lane C2 "WorldRT" (2026-11-23)
+//
+// The candidate's own regression suite (BAKEOFF-PITCH.md section 2 C2 and the
+// section 3 pitch gates, on the lane's instruments in WorldRTMetrics.swift
+// until BENCH-P's harness lands). Pure buffers on the study's real sources.
+//
+// The WORLD port is pinned against WORLD's own C++ (commit c794856b), not
+// against values recalled from the papers: `WorldRTOracle` holds the output
+// of the reference program `oracle.cpp` (lane notes folder) for a synthetic
+// two-formant pulse train, and the constants are WORLD's
+// `constantnumbers.h` / `InitializeCheapTrickOption` values at that commit.
+
+import Foundation
+import Testing
+@testable import PrimaeNative
+
+nonisolated enum WorldRTOracle {
+    static let fs = 44100.0
+    static let period = 210.25
+    static let positions = [0.1, 0.2, 0.3]
+    static let bins = [0, 5, 10, 20, 33, 50, 100, 200, 400, 600, 800, 1024]
+    /// 0.5 s: decaying 700 Hz and 2500 Hz resonances at every period, plus WORLD randn noise (oracle.cpp).
+    static func signal() -> [Double] {
+        let n = 22050, pi = 3.1415926535897932384
+        var r = WorldCommon.Randn()
+        var x = [Double](repeating: 0, count: n)
+        for i in 0..<n {
+            var v = 0.0
+            var k = 0
+            while Double(k) * period <= Double(i) {
+                let t = (Double(i) - Double(k) * period) / fs
+                v += exp(-t / 0.004) * sin(2 * pi * 700 * t) + 0.5 * exp(-t / 0.002) * sin(2 * pi * 2500 * t)
+                k += 1
+            }
+            x[i] = 0.1 * v + 0.002 * r.next()
+        }
+        return x
+    }
+    /// WORLD C++ CheapTrick, 10 log10(sp) at `bins`, frames at `positions` (oracle.cpp output, 2026-11-23).
+    static let spDB: [[Double]] = [
+        [-21.612868235, -21.817273958, -21.947361931, -18.134372583, -10.868836703, -28.137804568, -31.035535988,
+         -45.657067011, -47.605798313, -55.740467376, -58.263283849, -58.711833702],
+        [-21.540794266, -21.692302530, -21.660455042, -18.235498404, -10.826896989, -28.168350758, -30.686715758,
+         -43.878480130, -56.545866476, -58.317310142, -54.575535410, -48.550867196],
+        [-21.666142672, -21.840950656, -21.795993597, -18.159386116, -10.844592449, -27.651952484, -30.537994532,
+         -45.604046937, -57.945104802, -53.873969518, -52.508035346, -66.994671405],
+    ]
+    /// WORLD C++ D4C amplitude aperiodicity at `bins`.
+    static let ap: [[Double]] = [
+        [0.001000000, 0.001163171, 0.001352967, 0.001830520, 0.002711740, 0.004533528, 0.020552880, 0.124938047,
+         0.660808578, 0.816808874, 0.809350947, 1.000000000],
+        [0.001000000, 0.001164449, 0.001355942, 0.001838578, 0.002731463, 0.004583583, 0.021009229, 0.139885711,
+         0.604920533, 0.785748133, 0.824630817, 1.000000000],
+        [0.001000000, 0.001175812, 0.001382534, 0.001911400, 0.002912259, 0.005051015, 0.025512756, 0.166563591,
+         0.717412102, 0.701185768, 0.817117881, 1.000000000],
+    ]
+}
+
+@Suite("C2 WorldRT: WORLD port against WORLD C++")
+struct WorldRTPortTests {
+    @Test func constantsAreWorldsAtTheReferenceCommit() {
+        #expect(WorldConstants.cheapTrickQ1 == -0.15)
+        // q0 = 1 - 2 q1 (SmoothingWithRecovery's compensation lifter is q0 + 2 q1 cos(2 pi f0 q)).
+        let lift = WorldCheapTrick.lifters(f0: 441, fs: 44100, fftSize: 2048, q1: WorldConstants.cheapTrickQ1)
+        #expect(abs(lift.compensation[0] - 1.0) < 1e-15)          // q0 + 2 q1 at quefrency 0
+        #expect(abs(lift.compensation[50] - 1.6) < 1e-12)         // q0 - 2 q1 where f0 q = 1/2 (50 / 44100 s x 441 Hz)
+        #expect(abs(lift.smoothing[100]) < 1e-12)                  // sinc zero at f0 q = 1
+        #expect(WorldConstants.kFloorF0 == 71.0)
+        #expect(WorldConstants.kDefaultF0 == 500.0)
+        #expect(WorldConstants.kFloorF0D4C == 47.0)
+        #expect(WorldConstants.kThreshold == 0.85)
+        #expect(WorldConstants.kFrequencyInterval == 3000.0)
+        #expect(WorldConstants.kUpperLimit == 15000.0)
+        #expect(WorldConstants.kSafeGuardD4C == 0.000001)
+        #expect(WorldConstants.kMySafeGuardMinimum == 0.000000000001)
+        #expect(WorldCommon.cheapTrickFFTSize(fs: 44100) == 2048)
+        #expect(WorldCommon.d4cFFTSize(fs: 44100) == 4096)
+        #expect(WorldD4C(fs: 44100, fftSize: 2048).numberOfAperiodicities == 5)
+    }
+
+    @Test func cheapTrickMatchesWorldCpp() {
+        let x = WorldRTOracle.signal()
+        let f0 = [Double](repeating: WorldRTOracle.fs / WorldRTOracle.period, count: 3)
+        let sp = WorldCheapTrick(fs: WorldRTOracle.fs).envelopes(x, positions: WorldRTOracle.positions, f0: f0)
+        for i in 0..<3 {
+            for (j, b) in WorldRTOracle.bins.enumerated() {
+                let db = 10 * log10(sp[i][b])
+                #expect(abs(db - WorldRTOracle.spDB[i][j]) < 1e-6, "frame \(i) bin \(b): \(db) vs \(WorldRTOracle.spDB[i][j])")
+            }
+        }
+    }
+
+    @Test func d4cMatchesWorldCpp() {
+        let x = WorldRTOracle.signal()
+        let f0 = [Double](repeating: WorldRTOracle.fs / WorldRTOracle.period, count: 3)
+        let ap = WorldD4C(fs: WorldRTOracle.fs, fftSize: 2048).aperiodicity(x, positions: WorldRTOracle.positions, f0: f0)
+        for i in 0..<3 {
+            for (j, b) in WorldRTOracle.bins.enumerated() {
+                #expect(abs(ap[i][b] - WorldRTOracle.ap[i][j]) < 2e-9, "frame \(i) bin \(b): \(ap[i][b]) vs \(WorldRTOracle.ap[i][j])")
+            }
+        }
+    }
+}
+
+/// Shared renders for the renderer suite.
+nonisolated enum WorldRTFixture {
+    static let sr = LiveSonificationKernel.sampleRate
+    static let voiced = ["A_phoneme1", "I_phoneme1", "L_phoneme1", "M_phoneme1"]
+
+    static func make(_ s: StudySource, _ tuning: WorldRTTuning = .default) -> WorldRT {
+        WorldRT(source: s.samples, sampleRate: sr, kind: s.kind, maxFramesPerRender: 512, tuning: tuning, onset: s.onset)
+    }
+    static func render(_ r: any SonificationRenderer, seconds: Double, rate: Float = 1, cents: Float = 0) -> [Float] {
+        SonificationDriver.steady(r, seconds: seconds, rate: rate, cents: cents)
+    }
+}
+
+@Suite("C2 WorldRT: renderer gates")
+struct WorldRTRendererTests {
+    typealias F = WorldRTFixture
+
+    /// Pitch gate (section 3): voiced F0 within +-5 cents of target at +-300/+-600, rates 0.5/1/2. Two instruments:
+    /// the renderer's own pulse train (mean interval vs the 0-cent render's, all four phonemes) and the output's
+    /// autocorrelation F0 against the 0-cent render at the same rate (same read-head path) for I, L, M. A is
+    /// breathy and the lane's autocorrelation reads it +-6 c on the shipped TDPSOLA as well (C2.md); BENCH-P's
+    /// instrument decides A.
+    @Test(arguments: F.voiced) func voicedF0WithinFiveCents(_ name: String) throws {
+        let s = try StudySources.load(name)
+        let r = F.make(s)
+        let lo = Int(1.0 * F.sr), hi = Int(2.4 * F.sr)
+        for rate: Float in [0.5, 1, 2] {
+            let y0 = F.render(r, seconds: 2.5, rate: rate, cents: 0)
+            let i0 = r.debugMeanInterval
+            let ref = WorldRTMetrics.medianF0(y0, from: lo, to: hi, sampleRate: F.sr)
+            for c: Float in [-600, -300, 300, 600] {
+                let y = F.render(r, seconds: 2.5, rate: rate, cents: c)
+                let pulseCents = 1200 * log2(i0 / r.debugMeanInterval)
+                #expect(abs(pulseCents - Double(c)) < 5, "\(name) rate \(rate) \(c) c: pulse train at \(pulseCents) c")
+                guard name != "A_phoneme1" else { continue }
+                let f = try #require(WorldRTMetrics.medianF0(y, from: lo, to: hi, sampleRate: F.sr))
+                let err = WorldRTMetrics.cents(f, try #require(ref)) - Double(c)
+                #expect(abs(err) < 5, "\(name) rate \(rate) \(c) c: output F0 off by \(err) c")
+            }
+        }
+    }
+
+    /// Level gate (section 3): steady RMS at +-300/+-600 within +-1.5 dB of the 0-cent render (rate 1).
+    @Test(arguments: F.voiced + ["F_phoneme1"]) func levelFlatAcrossCents(_ name: String) throws {
+        let s = try StudySources.load(name)
+        let r = F.make(s)
+        let lo = Int(1.0 * F.sr), hi = Int(2.4 * F.sr)
+        let ref = WorldRTMetrics.rms(F.render(r, seconds: 2.5, cents: 0), lo, hi)
+        for c: Float in [-600, -300, 300, 600] {
+            let d = WorldRTMetrics.dB(WorldRTMetrics.rms(F.render(r, seconds: 2.5, cents: c), lo, hi), ref)
+            #expect(abs(d) <= 1.5, "\(name) \(c) c: \(d) dB")
+            if name == "F_phoneme1" {   // candidate A's thresholds: 0.3 dB down, 1.2 dB up
+                #expect(abs(d) <= (c < 0 ? 0.3 : 1.2), "F \(c) c: \(d) dB")
+            }
+        }
+    }
+
+    /// `levelCalibration`: the vocoder's 0-cent loop level equals the source's over the same span (WORLD alone is
+    /// +0.3..+2.1 dB louder on these phonemes), so the per-file loudness gains (AE-2) still hold.
+    @Test(arguments: F.voiced) func zeroCentLevelIsTheSourceLevel(_ name: String) throws {
+        let s = try StudySources.load(name)
+        let r = F.make(s)
+        let y = F.render(r, seconds: 1.6, cents: 0)
+        let h = r.debugHandover
+        let lo = h.out + h.length + Int(0.05 * F.sr), hi = lo + Int(0.8 * F.sr)
+        let on = r.marks.onset
+        let d = WorldRTMetrics.dB(WorldRTMetrics.rms(y, lo, hi), WorldRTMetrics.rms(s.samples, on + lo, on + hi))
+        #expect(abs(d) <= 0.5, "\(name): vocoder \(d) dB against the source")
+    }
+
+    /// The recorded attack is the shipped one: up to the hand-over, sample for sample the shipped TDPSOLA's output
+    /// (at 0 and +600 cents: neither engine pitches the recorded onset). Onset latency is therefore r27's.
+    @Test(arguments: F.voiced) func attackIsTheShippedAttack(_ name: String) throws {
+        let s = try StudySources.load(name)
+        let r = F.make(s)
+        let shipped = SonificationRendererUnderTest.make(s)
+        let n = r.debugHandover.out
+        #expect(n > 1000)
+        for c: Float in [0, 600] {
+            let a = F.render(r, seconds: Double(n + 512) / F.sr, cents: c)
