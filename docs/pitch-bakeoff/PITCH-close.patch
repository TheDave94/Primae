+// BakeoffCandidates.swift
+// PrimaeNative
+//
+// The single registration list of the sonification bake-offs: r17 (time
+// stretch, 2026-11-02) and phase 2 of the phoneme pitch-shift bake-off
+// (BAKEOFF-PITCH.md, 2026-11-23). A candidate lane appends ITS entries
+// below the marker line and touches nothing else in this file; the bench
+// (`PrimaeNativeTests/SonificationBakeoff/`) iterates this list in order.
+// NOT wired into the study path: nothing outside the bench reads it.
+//
+// An entry is a NAME plus a FACTORY, so one renderer type can be benched
+// under several tuning-flag settings (BAKEOFF-PITCH section 5: "each behind
+// a tuning flag so the bench can A/B them"), e.g.
+//
+//   BakeoffCandidate(name: "TDPSOLA2-g0.3") { s, n in TDPSOLA2(source: s, maxFramesPerRender: n, flags: .init(gamma: 0.3)) },
+//
+// The factory gets the whole `SonificationSource` exactly as production
+// builds it (samples at `LiveSonificationKernel.sampleRate`, kind, the
+// loudness gain the kernel plays it at, the recorded onset), so a
+// candidate can use the same production extras `ours` does. A type that
+// only has the protocol's init registers through `.protocolInit(_:)`.
+// Every renderer still conforms to `SonificationRenderer`, unchanged.
+// Renderers do NOT apply `source.gain`; the bench applies it to the WAVs it
+// writes, the way the kernel applies it at the mixer.
+
+import Foundation
+
+nonisolated struct BakeoffCandidate: Sendable {
+    /// Unique; the bench's `candidate` column and the renders folder name
+    /// (`<renders root>/<name>/<L>__<cents>c.wav`).
+    let name: String
+    /// Builds a fresh renderer for one (source, scenario). Runs off the render thread; may allocate.
+    let make: @Sendable (_ source: SonificationSource, _ maxFramesPerRender: Int) -> any SonificationRenderer
+
+    init(name: String, make: @escaping @Sendable (SonificationSource, Int) -> any SonificationRenderer) {
+        self.name = name
+        self.make = make
+    }
+
+    /// A conformer registered through the protocol's own init (no onset, no gain).
+    /// Generic, so the closure captures no metatype value (a metatype is not Sendable here).
+    static func protocolInit<T: SonificationRenderer>(_ type: T.Type, name: String? = nil) -> BakeoffCandidate {
+        BakeoffCandidate(name: name ?? T.candidateName) { s, maxFrames in
+            T(source: s.samples, sampleRate: LiveSonificationKernel.sampleRate, kind: s.kind,
+              maxFramesPerRender: maxFrames)
+        }
+    }
+
+    /// The SHIPPED engine (protocol r27): TDPSOLA built exactly as `LiveSonificationAudio.makeRenderer`
+    /// builds it (tuning `.default`, recorded onset, output gain). The phase-2 baseline column.
+    static let ours = BakeoffCandidate(name: "ours") { s, _ in LiveSonificationAudio.makeRenderer(s) }
+
+    /// The listening anchor: linear-interpolation varispeed (pitch and rate coupled by construction).
+    static let naive = BakeoffCandidate.protocolInit(NaiveResampleRenderer.self)
+}
+
+nonisolated enum BakeoffCandidates {
+    static let all: [BakeoffCandidate] = [
+        .ours,
+        .naive,
+        // Candidate lanes append below this line.
+    ]
+}
diff --git a/PrimaeNative/Core/Sonification/Candidates/NaiveResample/NaiveResampleRenderer.swift b/PrimaeNative/Core/Sonification/Candidates/NaiveResample/NaiveResampleRenderer.swift
new file mode 100644
index 00000000..ac7b3e41
--- /dev/null
+++ b/PrimaeNative/Core/Sonification/Candidates/NaiveResample/NaiveResampleRenderer.swift
@@ -0,0 +1,93 @@
+// NaiveResampleRenderer.swift
+// PrimaeNative
+//
+// Bake-off candidate "NaiveResample": linear-interpolation varispeed of
+// the looped source. Rate and pitch are NOT independent here: the read
+// increment is `rate * 2^(cents/1200)`, so a faster rate also raises the
+// pitch (the "chipmunk" coupling every other candidate exists to avoid).
+// It is the listening ANCHOR of the blind test and the trivially
+// low-latency reference of the objective bench (no analysis, no look-ahead:
+// claimed latency 0 frames).
+//
+// Gate: a linear 2 ms gain ramp both ways (click-free). When the ramp has
+// fully closed, the read position returns to the source start, so a gate
+// that opens after a full close starts the source from the top (the same
+// convention as the AppleTimePitch adapter).
+// Parameter smoothing: one-pole on the read increment, 5 ms time constant.
+
+import Foundation
+import Synchronization
+
+nonisolated final class NaiveResampleRenderer: SonificationRenderer {
+    static var candidateName: String { "NaiveResample" }
+
+    private let source: UnsafeMutablePointer<Float>
+    private let count: Int
+    private let smoothing: Double
+    private let gainStep: Float
+
+    private let rateTarget = Atomic<UInt32>(Float(1).bitPattern)
+    private let centsTarget = Atomic<UInt32>(Float(0).bitPattern)
+    private let gateTarget = Atomic<Bool>(false)
+
+    // Render-thread state.
+    private var position: Double = 0
+    private var increment: Double = 1
+    private var gain: Float = 0
+
+    let claimedLatencyFrames: Int = 0
+
+    init(source: [Float], sampleRate: Double, kind: SourceKind, maxFramesPerRender: Int) {
+        count = max(source.count, 1)
+        // One guard sample past the end (a copy of the first) so the
+        // interpolation at the seam never reads out of bounds.
+        let storage = UnsafeMutablePointer<Float>.allocate(capacity: count + 1)
+        storage.initialize(repeating: 0, count: count + 1)
+        source.withUnsafeBufferPointer { buf in
+            if let base = buf.baseAddress { storage.update(from: base, count: buf.count) }
+        }
+        storage[count] = storage[0]
+        self.source = storage
+        smoothing = 1 - exp(-1 / (0.005 * sampleRate))
+        gainStep = 1 / Float(max(1, (0.002 * sampleRate).rounded()))
+    }
+
+    deinit { source.deallocate() }
+
+    func setRate(_ rate: Float) { rateTarget.storeFloat(min(max(rate, 0.25), 4)) }
+    func setPitchCents(_ cents: Float) { centsTarget.storeFloat(min(max(cents, -2400), 2400)) }
+    func setGate(_ open: Bool) { gateTarget.store(open, ordering: .relaxed) }
+
+    func render(into out: UnsafeMutablePointer<Float>, frames: Int) {
+        let open = gateTarget.load(ordering: .relaxed)
+        let target = Double(rateTarget.loadFloat()) * pow(2, Double(centsTarget.loadFloat()) / 1200)
+        let end = Double(count)
+        for i in 0..<frames {
+            if gain <= 0 && !open {
+                // Fully closed: park at the top, snap the increment.
+                position = 0
+                increment = target
+                out[i] = 0
+                continue
+            }
+            if gain <= 0 { increment = target }
+            increment += (target - increment) * smoothing
+            let index = Int(position)
+            let frac = Float(position - Double(index))
+            let a = source[index], b = source[index + 1]
+            gain = open ? min(1, gain + gainStep) : max(0, gain - gainStep)
+            out[i] = (a + (b - a) * frac) * gain
+            position += increment
+            if position >= end { position -= end }
+        }
+    }
+
+    func reset() {
+        rateTarget.storeFloat(1)
+        centsTarget.storeFloat(0)
+        gateTarget.store(false, ordering: .relaxed)
+        position = 0
+        increment = 1
+        gain = 0
+    }
+}
diff --git a/PrimaeNativeTests/SonificationBakeoff/BakeoffMetricSelfTests.swift b/PrimaeNativeTests/SonificationBakeoff/BakeoffMetricSelfTests.swift
new file mode 100644
index 00000000..011dbf88
--- /dev/null
+++ b/PrimaeNativeTests/SonificationBakeoff/BakeoffMetricSelfTests.swift
@@ -0,0 +1,213 @@
+// BakeoffMetricSelfTests.swift
+// PrimaeNativeTests — sonification bake-off harness (BENCH lane, 2026-11-02)
+//
+// The metrics are instruments; these tests check each one against a
+// synthetic signal whose true answer is known by construction (a delayed
+// copy, a pitch-shifted copy, a resampled noise with a known rate step, an
+// inserted discontinuity). Cheap and AVAudioEngine-free, so they run in
+// every suite run, CI included; the bench itself
+// (`SonificationBakeoffBench`) is opt-in.
+//
+// XCTest, not Swift Testing: XCTest classes run serially, so nothing here
+// competes with the parallel suites for the CPU.
+
+import XCTest
+@testable import PrimaeNative
+
+final class BakeoffMetricSelfTests: XCTestCase {
+    typealias M = BakeoffMetrics
+    let sr = 48_000.0
+
+    func noise(_ n: Int, seed: UInt32 = 12345) -> [Float] { BakeoffSynthetic.noise(n, seed: seed) }
+    func tone(_ f: Double, count: Int, start: Int = 0) -> [Float] {
+        BakeoffSynthetic.tone(f, count: count, sampleRate: sr, start: start)
+    }
+
+    // MARK: - Onset
+
+    func testOnsetReportsTheDelayOfADelayedCopy() {
+        let gate = 4800
+        let clean = tone(220, count: 48_000, start: gate)
+        let delay = 1234
+        let delayed = [Float](repeating: 0, count: delay) + clean.dropLast(delay)
+        let a = M.onset(clean, gateFrame: gate, openEnd: clean.count, sampleRate: sr)
+        let b = M.onset(delayed, gateFrame: gate, openEnd: delayed.count, sampleRate: sr)
+        let da = try! XCTUnwrap(a.toMinus20dB), db = try! XCTUnwrap(b.toMinus20dB)
+        XCTAssertLessThanOrEqual(da, 240, "a 2 ms attack: the first qualifying 5 ms window ends within 5 ms")
+        XCTAssertEqual(Double(db - da), Double(delay), accuracy: 16, "onset must move by exactly the inserted delay")
+        XCTAssertEqual(Double(try! XCTUnwrap(b.toNonZero) - (try! XCTUnwrap(a.toNonZero))), Double(delay), accuracy: 1)
+    }
+
+    func testOnsetIsNilForSilence() {
+        let x = [Float](repeating: 0, count: 48_000)
+        XCTAssertNil(M.onset(x, gateFrame: 100, openEnd: x.count, sampleRate: sr).toMinus20dB)
+    }
+
+    // MARK: - f0
+
+    func testF0IsAccurateOnAKnownTone() {
+        for f in [110.0, 220.0, 440.0, 880.0] {
+            let x = tone(f, count: 24_000)
+            let m = try! XCTUnwrap(M.medianF0(M.yinTrack(x, start: 0, end: x.count, sampleRate: sr, hop: 480,
+                                                        fmin: 75, fmax: 1900)))
+            XCTAssertEqual(M.cents(m, re: f), 0, accuracy: 1, "f0 of a \(f) Hz tone")
+        }
+    }
+
+    func testF0CatchesAPitchShiftedCopy() {
+        let base = 220.0
+        let ref = try! XCTUnwrap(M.medianF0(M.yinTrack(tone(base, count: 24_000), start: 0, end: 24_000,
+                                                      sampleRate: sr, hop: 480)))
+        for shift in [-50.0, 17.0, 30.0] {
+            let f = base * pow(2, shift / 1200)
+            let m = try! XCTUnwrap(M.medianF0(M.yinTrack(tone(f, count: 24_000), start: 0, end: 24_000,
+                                                        sampleRate: sr, hop: 480)))
+            XCTAssertEqual(M.cents(m, re: ref), shift, accuracy: 1, "the f0 metric must see a \(shift)-cent shift")
+        }
+        // The phoneme gate is +/-1 %: a 1 % shift must read as ~1 %, not 0.
+        let m = try! XCTUnwrap(M.medianF0(M.yinTrack(tone(base * 1.01, count: 24_000), start: 0, end: 24_000,
+                                                    sampleRate: sr, hop: 480)))
+        XCTAssertEqual((m / ref - 1) * 100, 1, accuracy: 0.05)
+    }
+
+    func testNoiseIsUnvoiced() {
+        let x = noise(24_000)
+        XCTAssertLessThan(M.voicedFraction(M.yinTrack(x, start: 0, end: x.count, sampleRate: sr, hop: 480)), 0.2)
+    }
+
+    // MARK: - Local duration scale and its step response
+
+    func testDurationScaleOfAnIdealTSMOnTheSweepProbe() {
+        for r in [0.5, 0.75, 1.0, 1.5, 2.0] {
+            let out = BakeoffSynthetic.idealSweepTSM(count: 192_000, sampleRate: sr) { _ in r }
+            let med = try! XCTUnwrap(M.median(M.localRate(M.sweepTrack(out, from: 0, to: out.count, sampleRate: sr)).map(\.rate)))
+            XCTAssertEqual(med, r, accuracy: r * 0.01, "duration scale at rate \(r)")
+        }
+    }
+
+    func testDurationScaleOfAVarispeedOnTheSweepProbe() {
+        // A varispeed shifts f0 by a constant ratio: a constant position
+        // offset, the slope (the rate) is still read correctly.
+        let probe = BakeoffSynthetic.sweepProbe(sampleRate: sr)
+        for r in [0.75, 1.5] {
+            var out = [Float](repeating: 0, count: 144_000)
+            var pos = 0.0
+            for i in 0..<out.count {
+                let k = Int(pos), f = Float(pos - Double(k))
+                out[i] = probe[k % probe.count] + (probe[(k + 1) % probe.count] - probe[k % probe.count]) * f
+                pos += r
+            }
+            let med = try! XCTUnwrap(M.median(M.localRate(M.sweepTrack(out, from: 0, to: out.count, sampleRate: sr)).map(\.rate)))
+            XCTAssertEqual(med, r, accuracy: r * 0.02, "varispeed duration scale at rate \(r)")
+        }
+    }
+
+    func testRateStepResponseSeesADelayedStep() throws {
+        let step = Int(0.6 * sr)
+        func response(_ stepAt: Int) throws -> M.StepResponse {
+            let out = BakeoffSynthetic.idealSweepTSM(count: Int(1.5 * sr), sampleRate: sr) { $0 < stepAt ? 1 : 2 }
+            let rates = M.localRate(M.sweepTrack(out, from: 0, to: out.count, sampleRate: sr))
+            let series = rates.map { (t: Double($0.frame) / sr, v: $0.rate) }
+            return try XCTUnwrap(M.stepResponse(series, stepTime: Double(step) / sr))
+        }
+        let immediate = try response(step)
+        let late = try response(step + Int(0.1 * sr))
+        XCTAssertLessThan(abs(immediate.delayTo90), 0.07, "an instantaneous step reads within the estimator's resolution")
+        XCTAssertEqual(late.delayTo90 - immediate.delayTo90, 0.1, accuracy: 0.0051, "a step 100 ms late must read 100 ms later")
+    }
+
+    func testPitchStepResponseSeesADelayedStep() throws {
+        let step = Int(0.6 * sr)
+        func toneStep(at s: Int) -> [Float] {
+            var x = [Float](repeating: 0, count: Int(1.5 * sr))
+            var phase = 0.0
+            for i in 0..<x.count {
+                let f = i < s ? 440.0 : 440.0 * pow(2, 700.0 / 1200)
+                phase += 2 * .pi * f / sr
+                x[i] = Float(sin(phase)) * 0.3
+            }
+            return x
+        }
+        func delay90(_ s: Int) throws -> Double {
+            let x = toneStep(at: s)
+            let tr = M.yinTrack(x, start: 0, end: x.count, sampleRate: sr, hop: 48, fmin: 150, fmax: 1900)
+            let series = tr.compactMap { p in p.f0.map { (t: Double(p.frame) / sr, v: M.cents($0, re: 440)) } }
+            return try XCTUnwrap(M.stepResponse(series, stepTime: Double(step) / sr)).delayTo90
+        }
+        let a = try delay90(step), b = try delay90(step + Int(0.05 * sr))
+        XCTAssertEqual(b - a, 0.05, accuracy: 0.006, "a pitch step 50 ms late must read 50 ms later")
+    }
+
+    func testTrackingLagRecoversAKnownLag() throws {
+        let times = stride(from: 0.0, to: 3.0, by: 0.0025).map { $0 }
+        let commanded: (Double) -> Double = { 600 * sin(2 * .pi * $0 / 0.9) }
+        let measured: [Double?] = times.map { commanded($0 - 0.04) }
+        let t = try XCTUnwrap(M.trackingLag(times: times, commanded: commanded, measured: measured))
+        XCTAssertEqual(t.lag, 0.04, accuracy: 0.0026)
+        XCTAssertLessThan(t.rmsAtLag, t.rmsAtZero)
+    }
+
+    // MARK: - Discontinuities and spectra
+
+    func testClickRatioSeesAnInsertedDiscontinuity() {
+        var x = tone(440, count: 48_000)
+        let typical = M.typicalDelta(x, 1000, 40_000)
+        XCTAssertLessThan(M.maxAbsDelta(x, 20_000, 21_000) / typical, 1.5)
+        for i in 20_500..<48_000 { x[i] += 0.4 }
+        XCTAssertGreaterThan(M.maxAbsDelta(x, 20_000, 21_000) / typical, 5)
+    }
+
+    func testLogSpectralDistance() {
+        let x = noise(48_000)
+        let a = M.spectrogram(x, from: 0, to: x.count)
+        XCTAssertEqual(try XCTUnwrap(M.logSpectralDistance(a, a)), 0, accuracy: 1e-9)
+        var y = x
+        for i in 1..<y.count { y[i] = 0.5 * (x[i] + x[i - 1]) }   // low-pass
+        XCTAssertGreaterThan(try XCTUnwrap(M.logSpectralDistance(a, M.spectrogram(y, from: 0, to: y.count))), 3)
+    }
+
+    func testFluxSpikesSeeABurst() {
+        var x = tone(440, count: 48_000)
+        let clean = try! XCTUnwrap(M.fluxSpikes(M.spectrogram(x, from: 0, to: x.count)))
+        for i in 24_000..<24_064 { x[i] += Float(i % 2 == 0 ? 0.5 : -0.5) }
+        let burst = try! XCTUnwrap(M.fluxSpikes(M.spectrogram(x, from: 0, to: x.count)))
+        XCTAssertGreaterThan(burst.ratio, clean.ratio * 3)
+    }
+
+    func testModulationDeviationSeesTremolo() {
+        let steady = tone(440, count: 96_000)
+        var trem = steady
+        for i in 0..<trem.count { trem[i] *= Float(1 + 0.5 * sin(2 * .pi * 8 * Double(i) / sr)) }
+        let a = M.modulationSpectrum(steady, from: 0, to: steady.count, sampleRate: sr)
+        let b = M.modulationSpectrum(trem, from: 0, to: trem.count, sampleRate: sr)
+        XCTAssertEqual(try XCTUnwrap(M.modulationDeviation(a, a)), 0, accuracy: 1e-9)
+        XCTAssertGreaterThan(try XCTUnwrap(M.modulationDeviation(a, b)), 3)
+    }
+
+    // MARK: - Harness plumbing
+
+    func testNaiveResampleRunsThroughTheHarness() throws {
+        let source = BakeoffSource(name: "probe_sweep", letter: nil, kind: .voicedPhoneme, sampleRate: sr,
+                                   samples: BakeoffSynthetic.sweepProbe(sampleRate: sr), voicedFraction: 1,
+                                   isProbe: true)
+        let scenario = BakeoffScenario(name: "rate_1.5", family: .fixedRate(1.5), duration: 3,
+                                       events: [.init(time: 0, kind: .rate(1.5)),
+                                                .init(time: 0.05, kind: .gate(true))])
+        let r = BakeoffRunner.render(NaiveResampleRenderer.self, source: source, scenario: scenario)
+        let gate = BakeoffRunner.appliedFrame(0.05, sampleRate: sr)
+        XCTAssertEqual(M.rms(r.samples, 0, gate), 0, "nothing before the gate opens")
+        let ref = BakeoffRunner.sourceReference(source: source, scenario: scenario)
+        let rows = BakeoffRunner.metrics(candidate: "NaiveResample", render: r, source: source, scenario: scenario,
+                                         sourceRef: ref, reference: nil)
+        XCTAssertEqual(try XCTUnwrap(rows.first { $0.metric == "duration_scale" }).value, 1.5, accuracy: 0.03)
+        let onset = try XCTUnwrap(rows.first { $0.metric == "onset_m20_ms" }).value
+        XCTAssertLessThan(onset, 6, "naive varispeed: -20 dB within the 2 ms ramp + one 5 ms window")
+    }
+
+    func testRegisteredCandidateNamesAreUnique() {
+        let names = BakeoffCandidates.all.map(\.name)
+        XCTAssertEqual(Set(names).count, names.count)
+        XCTAssertTrue(names.contains("ours"), "the shipped engine (the baseline column) must stay registered")
+        XCTAssertTrue(names.contains("NaiveResample"), "the listening anchor must stay registered")
+    }
+}
diff --git a/PrimaeNativeTests/SonificationBakeoff/BakeoffMetrics.swift b/PrimaeNativeTests/SonificationBakeoff/BakeoffMetrics.swift
new file mode 100644
index 00000000..077ce3d4
--- /dev/null
+++ b/PrimaeNativeTests/SonificationBakeoff/BakeoffMetrics.swift
@@ -0,0 +1,459 @@
+// BakeoffMetrics.swift
+// PrimaeNativeTests — sonification bake-off harness (BENCH lane, 2026-11-02)
+//
+// The objective metrics of BAKEOFF.md, "Bench metrics", as pure functions
+// over Float arrays, computed with Accelerate/vDSP. Every metric is
+// mutation-checked by `BakeoffMetricSelfTests` against a synthetic signal
+// whose true answer is known (a delayed copy, a pitch-shifted copy, a
+// resampled noise, an inserted step).
+
+import Accelerate
+import Foundation
+
+enum BakeoffMetrics {
+
+    // MARK: - Basic helpers
+
+    static func rms(_ x: [Float], _ start: Int, _ length: Int) -> Float {
+        let s = max(0, start), e = min(x.count, start + length)
+        guard e > s else { return 0 }
+        var r: Float = 0
+        x.withUnsafeBufferPointer { vDSP_rmsqv($0.baseAddress! + s, 1, &r, vDSP_Length(e - s)) }
+        return r
+    }
+
+    static func dB(_ v: Float) -> Float { 20 * log10(max(v, 1e-12)) }
+
+    static func median(_ v: [Double]) -> Double? {
+        guard !v.isEmpty else { return nil }
+        let s = v.sorted()
+        return s.count % 2 == 1 ? s[s.count / 2] : 0.5 * (s[s.count / 2 - 1] + s[s.count / 2])
+    }
+
+    static func percentile(_ v: [Double], _ p: Double) -> Double? {
+        guard !v.isEmpty else { return nil }
+        let s = v.sorted()
+        let idx = min(s.count - 1, max(0, Int((p / 100 * Double(s.count - 1)).rounded())))
+        return s[idx]
+    }
+
+    /// Windowed RMS envelope: window `win` frames, hop `hop` frames, from
+    /// `start` to `end`. Element k covers `start + k*hop ..< + win`.
+    static func envelope(_ x: [Float], start: Int, end: Int, win: Int, hop: Int) -> [Float] {
+        var out: [Float] = []
+        var i = max(0, start)
+        while i + win <= min(end, x.count) {
+            out.append(rms(x, i, win))
+            i += hop
+        }
+        return out
+    }
+
+    // MARK: - Onset
+
+    struct Onset {
+        /// Frames from the gate frame to the END of the first 5 ms window
+        /// whose RMS is >= -20 dB re the steady level (hop 16). nil = never.
+        let toMinus20dB: Int?
+        /// Frames from the gate frame to the first sample with |x| > 1e-6
+        /// (-120 dBFS: "non-zero" for a renderer that ramps). nil = never.
+        let toNonZero: Int?
+        /// 95th percentile of the 5 ms RMS over the gate-open span.
+        let steadyRMS: Float
+    }
+
+    /// Onset after a gate opens at `gateFrame`; the gate-open span ends at
+    /// `openEnd` (the close, or the render end). Window hop 16 frames.
+    static func onset(_ x: [Float], gateFrame: Int, openEnd: Int, sampleRate: Double) -> Onset {
+        let win = Int((0.005 * sampleRate).rounded())
+        let env = envelope(x, start: gateFrame, end: openEnd, win: win, hop: max(1, win / 4))
+        let steady = Float(percentile(env.map(Double.init), 95) ?? 0)
+        var m20: Int?
+        if steady > 0 {
+            // Reported at the END of the qualifying window (the moment the
+            // criterion is met), scanning windows that start up to one window
+            // before the gate, so a delayed copy reads exactly the delay
+            // later (a start-of-window report is clamped at the gate).
+            let threshold = steady * 0.1
+            var i = max(0, gateFrame - win)
+            while i + win <= min(openEnd, x.count) {
+                if i + win > gateFrame, rms(x, i, win) >= threshold { m20 = i + win - gateFrame; break }
+                i += 16
+            }
+        }
+        var nz: Int?
+        var j = max(0, gateFrame)
+        while j < min(openEnd, x.count) {
+            if abs(x[j]) > 1e-6 { nz = j - gateFrame; break }
+            j += 1
+        }
+        return Onset(toMinus20dB: m20, toNonZero: nz, steadyRMS: steady)
+    }
+
+    /// 10 %-90 % rise time of the 1 ms RMS envelope after `gateFrame`,
+    /// relative to the 95th-percentile level of the following 300 ms.
+    /// Seconds; nil when the level never reaches 90 %.
+    static func riseTime10to90(_ x: [Float], gateFrame: Int, openEnd: Int, sampleRate: Double) -> Double? {
+        let win = max(1, Int((0.001 * sampleRate).rounded()))
+        let hop = max(1, win / 4)
+        let end = min(openEnd, gateFrame + Int(0.3 * sampleRate))
+        let env = envelope(x, start: gateFrame, end: end, win: win, hop: hop)
+        guard let top = percentile(env.map(Double.init), 95), top > 0 else { return nil }
+        guard let i10 = env.firstIndex(where: { Double($0) >= 0.1 * top }),
+              let i90 = env.firstIndex(where: { Double($0) >= 0.9 * top }) else { return nil }
+        return Double(i90 - i10) * Double(hop) / sampleRate
+    }
+
+    // MARK: - f0 (YIN)
+
+    struct PitchFrame {
+        let frame: Int          // window start
+        let f0: Double?         // nil = unvoiced/silent
+        let aperiodicity: Double
+    }
+
+    /// YIN (de Cheveigné & Kawahara 2002): difference function from an
+    /// autocorrelation (vDSP_conv) and running energies, cumulative-mean
+    /// normalisation, absolute threshold 0.15, parabolic interpolation.
+    /// A frame is voiced when its dip is < 0.25 and its RMS is within
+    /// 40 dB of `levelRef`.
+    static func yinTrack(_ x: [Float], start: Int, end: Int, sampleRate: Double,
+                         hop: Int, fmin: Double = 75, fmax: Double = 1000,
+                         window: Int = 1024, levelRef: Float? = nil) -> [PitchFrame] {
+        let tmin = max(2, Int(sampleRate / fmax))
+        let tmax = Int(sampleRate / fmin)
+        let need = window + tmax + 1
+        guard x.count >= need else { return [] }
+        // Prefix sums of squares (Double for precision over long renders).
+        var prefix = [Double](repeating: 0, count: x.count + 1)
+        for i in 0..<x.count { prefix[i + 1] = prefix[i] + Double(x[i]) * Double(x[i]) }
+        let ref = levelRef ?? rms(x, start, end - start)
+        let floorRMS = ref * 0.01
+        var frames: [PitchFrame] = []
+        var corr = [Float](repeating: 0, count: tmax + 1)
+        var d = [Double](repeating: 0, count: tmax + 1)
+        var cmnd = [Double](repeating: 1, count: tmax + 1)
+        var s = max(0, start)
+        while s + need <= min(end, x.count) {
+            x.withUnsafeBufferPointer { buf in
+                let base = buf.baseAddress! + s
+                vDSP_conv(base, 1, base, 1, &corr, 1, vDSP_Length(tmax + 1), vDSP_Length(window))
+            }
+            let e0 = prefix[s + window] - prefix[s]
+            for tau in 0...tmax {
+                let et = prefix[s + tau + window] - prefix[s + tau]
+                d[tau] = max(0, e0 + et - 2 * Double(corr[tau]))
+            }
+            var running = 0.0
+            cmnd[0] = 1
+            for tau in 1...tmax {
+                running += d[tau]
+                cmnd[tau] = running > 0 ? d[tau] * Double(tau) / running : 1
+            }
+            var best = -1
+            var tau = tmin
+            while tau <= tmax {
+                if cmnd[tau] < 0.15 {
+                    while tau + 1 <= tmax && cmnd[tau + 1] < cmnd[tau] { tau += 1 }
+                    best = tau
+                    break
+                }
+                tau += 1
+            }
+            if best < 0 {
+                var m = tmin
+                for t in tmin...tmax where cmnd[t] < cmnd[m] { m = t }
+                best = m
+            }
+            let ap = cmnd[best]
+            var refined = Double(best)
+            if best > 1 && best < tmax {
+                let a = d[best - 1], b = d[best], c = d[best + 1]
+                let den = a - 2 * b + c
+                if den > 0 { refined += 0.5 * (a - c) / den }
+            }
+            let level = Float(sqrt(max(0, e0) / Double(window)))
+            let voiced = ap < 0.25 && level >= floorRMS
+            frames.append(PitchFrame(frame: s, f0: voiced ? sampleRate / refined : nil, aperiodicity: ap))
+            s += hop
+        }
+        return frames
+    }
+
+    static func medianF0(_ frames: [PitchFrame]) -> Double? {
+        median(frames.compactMap(\.f0))
+    }
+
+    static func cents(_ f: Double, re ref: Double) -> Double { 1200 * log2(f / ref) }
+
+    /// Voiced fraction of a track.
+    static func voicedFraction(_ frames: [PitchFrame]) -> Double {
+        frames.isEmpty ? 0 : Double(frames.filter { $0.f0 != nil }.count) / Double(frames.count)
+    }
+
+    // MARK: - Local duration scale (sweep probe)
+
+    struct AlignmentPoint { let frame: Int; let sourcePosition: Double }
+
+    /// WHY A PROBE. The study sources are SUSTAINED sounds (a held vowel,
+    /// a held /f/, a steady tone): there is no landmark in them whose
+    /// position in the output reveals how fast the source was read, and a
+    /// phase vocoder does not even preserve a noise waveform for a
+    /// correlator to find (measured on the iPad: waveform alignment of
+    /// AppleTimePitch output on F_phoneme1 correlated 0.15-0.20). So the
+    /// rate metrics run on a synthetic probe whose PITCH encodes its time:
+    /// a harmonic tone gliding exponentially from `sweepF0` up
+    /// `sweepOctaves` over the loop (`BakeoffSynthetic.sweepProbe`). Every
+    /// candidate holds pitch at cents 0, so the output's f0 at output time t
+    /// says which source time it is playing; the slope is the duration
+    /// scale. A varispeed (NaiveResample) shifts the f0 by a CONSTANT ratio
+    /// at a fixed rate, which offsets the position by a constant and leaves
+    /// the slope right.
+    ///
+    /// Source position (frames, unwrapped across loops) per YIN frame of the
+    /// output, timed at the YIN window centre.
+    static func sweepTrack(_ x: [Float], from: Int, to: Int, sampleRate: Double,
+                           hopSeconds: Double = 0.0025) -> [AlignmentPoint] {
+        let probe = BakeoffSynthetic.self
+        let loop = probe.sweepSeconds * sampleRate
+        let frames = yinTrack(x, start: from, end: to, sampleRate: sampleRate,
+                              hop: max(1, Int(hopSeconds * sampleRate)),
+                              fmin: probe.sweepF0 * 0.8,
+                              fmax: probe.sweepF0 * pow(2, probe.sweepOctaves) * 1.25)
+        var out: [AlignmentPoint] = []
+        var offset = 0.0
+        var last: Double?
+        for f in frames {
+            guard let f0 = f.f0 else { continue }
+            let octaves = log2(f0 / probe.sweepF0)
+            guard octaves > -0.1 && octaves < probe.sweepOctaves + 0.1 else { continue }
+            var p = loop * octaves / probe.sweepOctaves + offset
+            if let l = last, p < l - loop / 2 { offset += loop; p += loop }
+            last = p
+            out.append(AlignmentPoint(frame: f.frame + 512, sourcePosition: p))
+        }
+        return out
+    }
+
+    /// Local duration scale (source frames advanced per output frame) by a
+    /// least-squares slope over +/-`span` neighbouring points (default 20 at
+    /// the 2.5 ms hop = a 100 ms window, longer than a grain hop or a pitch
+    /// period, so the staircase of an OLA algorithm averages to its true
+    /// rate), then a 7-point median. Returns (output frame, rate). The 100 ms
+    /// window is the estimator's time resolution: a step reads as a ~80 ms
+    /// 10-90 % ramp even when instantaneous, equally for every candidate.
+    static func localRate(_ track: [AlignmentPoint], span: Int = 20) -> [(frame: Int, rate: Double)] {
+        guard track.count > 2 * span + 1 else { return [] }
+        var raw: [(Int, Double)] = []
+        for i in span..<(track.count - span) {
+            let seg = track[(i - span)...(i + span)]
+            // Contiguity: skip a window that spans a gap (gate closed,
+            // unvoiced frames) longer than 4 hops.
+            let step = track[i - span + 1].frame - track[i - span].frame
+            if track[i + span].frame - track[i - span].frame > 2 * span * step + 4 * step { continue }
+            let n = Double(seg.count)
+            let mx = seg.reduce(0.0) { $0 + Double($1.frame) } / n
+            let my = seg.reduce(0.0) { $0 + $1.sourcePosition } / n
+            var sxy = 0.0, sxx = 0.0
+            for p in seg {
+                let dx = Double(p.frame) - mx
+                sxy += dx * (p.sourcePosition - my)
+                sxx += dx * dx
+            }
+            guard sxx > 0 else { continue }
+            raw.append((track[i].frame, sxy / sxx))
+        }
+        var out: [(frame: Int, rate: Double)] = []
+        for i in 0..<raw.count {
+            let lo = max(0, i - 3), hi = min(raw.count - 1, i + 3)
+            out.append((raw[i].0, median(raw[lo...hi].map(\.1)) ?? raw[i].1))
+        }
+        return out
+    }
+
+    // MARK: - Step response
+
+    struct StepResponse {
+        let delayTo10: Double   // seconds from the step to 10 %
+        let delayTo90: Double   // seconds from the step to 90 %
+        var rise10to90: Double { delayTo90 - delayTo10 }
+    }
+
+    /// Step response of a measured series (time in seconds) around a step at
+    /// `stepTime`. Start/end levels are the MEASURED medians before the step
+    /// ([step-0.3, step-0.05]) and in [step+settleFrom, step+settleTo], so a
+    /// constant bias does not read as lag. A crossing must hold 3 points.
+    static func stepResponse(_ series: [(t: Double, v: Double)], stepTime: Double,
+                             settleFrom: Double = 0.4, settleTo: Double = 0.75) -> StepResponse? {
+        let pre = series.filter { $0.t >= stepTime - 0.3 && $0.t <= stepTime - 0.05 }.map(\.v)
+        let post = series.filter { $0.t >= stepTime + settleFrom && $0.t <= stepTime + settleTo }.map(\.v)
+        guard let v0 = median(pre), let v1 = median(post), abs(v1 - v0) > 1e-9 else { return nil }
+        let after = series.filter { $0.t >= stepTime }
+        func crossing(_ frac: Double) -> Double? {
+            guard after.count >= 3 else { return nil }
+            for i in 0...(after.count - 3) {
+                let ok = (0..<3).allSatisfy { (after[i + $0].v - v0) / (v1 - v0) >= frac }
+                if ok { return after[i].t - stepTime }
+            }
+            return nil
+        }
+        guard let d10 = crossing(0.1), let d90 = crossing(0.9) else { return nil }
+        return StepResponse(delayTo10: d10, delayTo90: d90)
+    }
+
+    /// Best lag (seconds, >= 0) of `measured` behind `commanded` (both
+    /// sampled on the same time grid `times`), searched 0...maxLag, and the
+    /// RMS error at that lag and at zero lag. Samples where measured is nil
+    /// are skipped.
+    static func trackingLag(times: [Double], commanded: (Double) -> Double, measured: [Double?],
+                            maxLag: Double = 0.3, step: Double = 0.0025) -> (lag: Double, rmsAtLag: Double, rmsAtZero: Double)? {
+        func rmsError(_ lag: Double) -> Double? {
+            var acc = 0.0, n = 0
+            for (i, t) in times.enumerated() {
+                guard let m = measured[i] else { continue }
+                let c = commanded(t - lag)
+                acc += (m - c) * (m - c); n += 1
+            }
+            return n > 10 ? sqrt(acc / Double(n)) : nil
+        }
+        guard let zero = rmsError(0) else { return nil }
+        var bestLag = 0.0, bestErr = zero
+        var lag = step
+        while lag <= maxLag {
+            if let e = rmsError(lag), e < bestErr { bestErr = e; bestLag = lag }
+            lag += step
+        }
+        return (bestLag, bestErr, zero)
+    }
+
+    // MARK: - Discontinuities
+
+    static func maxAbsDelta(_ x: [Float], _ start: Int, _ end: Int) -> Float {
+        let s = max(1, start), e = min(x.count, end)
+        guard e > s else { return 0 }
+        var m: Float = 0
+        for i in s..<e { m = max(m, abs(x[i] - x[i - 1])) }
+        return m
+    }
+
+    /// 99.9th percentile of |Δx| over a span: the signal's own "normal"
+    /// sample-to-sample motion, used to normalise a click.
+    static func typicalDelta(_ x: [Float], _ start: Int, _ end: Int) -> Float {
+        let s = max(1, start), e = min(x.count, end)
+        guard e > s + 100 else { return 0 }
+        var d = [Double](); d.reserveCapacity(e - s)
+        for i in s..<e { d.append(Double(abs(x[i] - x[i - 1]))) }
+        return Float(percentile(d, 99.9) ?? 0)
+    }
+
+    // MARK: - Spectra
+
+    final class RealDFT {
+        let n: Int
+        private let setup: vDSP_DFT_Setup
+        private let window: [Float]
+        init(n: Int) {
+            self.n = n
+            setup = vDSP_DFT_zrop_CreateSetup(nil, vDSP_Length(n), .FORWARD)!
+            window = vDSP.window(ofType: Float.self, usingSequence: .hanningDenormalized,
+                                 count: n, isHalfWindow: false)
+        }
+        deinit { vDSP_DFT_DestroySetup(setup) }
+
+        /// Power spectrum (n/2+1 bins) of `x[start..<start+n]`, Hann window,
+        /// zero-padded past the end of `x`.
+        func power(_ x: [Float], start: Int) -> [Float] {
+            var frame = [Float](repeating: 0, count: n)
+            for i in 0..<n where start + i >= 0 && start + i < x.count { frame[i] = x[start + i] * window[i] }
+            let h = n / 2
+            var ir = [Float](repeating: 0, count: h), ii = [Float](repeating: 0, count: h)
+            for k in 0..<h { ir[k] = frame[2 * k]; ii[k] = frame[2 * k + 1] }
+            var or = [Float](repeating: 0, count: h), oi = [Float](repeating: 0, count: h)
+            vDSP_DFT_Execute(setup, ir, ii, &or, &oi)
+            var p = [Float](repeating: 0, count: h + 1)
+            p[0] = or[0] * or[0]
+            p[h] = oi[0] * oi[0]
+            for k in 1..<h { p[k] = or[k] * or[k] + oi[k] * oi[k] }
+            return p
+        }
+    }
+
+    static func spectrogram(_ x: [Float], from: Int, to: Int, n: Int = 1024, hop: Int = 256) -> [[Float]] {
+        let dft = RealDFT(n: n)
+        var frames: [[Float]] = []
+        var s = from
+        while s + n <= min(to, x.count) {
+            frames.append(dft.power(x, start: s))
+            s += hop
+        }
+        return frames
+    }
+
+    /// Spectral flux (half-wave rectified magnitude difference, summed over
+    /// bins) per frame; returns (max/median ratio, frames above 6x median).
+    static func fluxSpikes(_ spec: [[Float]]) -> (ratio: Double, count: Int)? {
+        guard spec.count > 3 else { return nil }
+        var flux: [Double] = []
+        for i in 1..<spec.count {
+            var f = 0.0
+            for k in 0..<spec[i].count {
+                let d = Double(sqrt(spec[i][k]) - sqrt(spec[i - 1][k]))
+                if d > 0 { f += d }
+            }
+            flux.append(f)
+        }
+        guard let med = median(flux), med > 0, let mx = flux.max() else { return nil }
+        return (mx / med, flux.filter { $0 > 6 * med }.count)
+    }
+
+    /// Log-spectral distance (dB) between two spectrograms, frame by frame
+    /// over the common length, bins up to `maxBin`, each frame floored at
+    /// -80 dB re the frame's reference maximum. Mean over frames.
+    static func logSpectralDistance(_ a: [[Float]], _ b: [[Float]], maxBin: Int? = nil) -> Double? {
+        let n = min(a.count, b.count)
+        guard n > 0 else { return nil }
+        var total = 0.0
+        for i in 0..<n {
+            let bins = min(maxBin ?? a[i].count, a[i].count, b[i].count)
+            let peak = max(a[i].max() ?? 0, b[i].max() ?? 0)
+            let floorP = max(Double(peak) * 1e-8, 1e-20)
+            var acc = 0.0
+            for k in 0..<bins {
+                let pa = max(Double(a[i][k]), floorP), pb = max(Double(b[i][k]), floorP)
+                let diff = 10 * log10(pa / pb)
+                acc += diff * diff
+            }
+            total += sqrt(acc / Double(bins))
+        }
+        return total / Double(n)
+    }
+
+    /// Modulation spectrum: 10 ms-window / 5 ms-hop RMS envelope, mean
+    /// removed, 512-point DFT; bins 1..<count up to `maxHz`, in dB re the
+    /// spectrum's own total power (so overall level does not count).
+    static func modulationSpectrum(_ x: [Float], from: Int, to: Int, sampleRate: Double, maxHz: Double = 50) -> [Double] {
+        let hop = Int((0.005 * sampleRate).rounded())
+        var env = envelope(x, start: from, end: to, win: 2 * hop, hop: hop)
+        guard env.count >= 32 else { return [] }
+        let mean = env.reduce(0, +) / Float(env.count)
+        env = env.map { $0 - mean }
+        let n = 512
+        let p = RealDFT(n: n).power(Array(env.prefix(n)), start: 0)
+        let frameRate = sampleRate / Double(hop)
+        let maxBin = min(p.count - 1, Int(maxHz / (frameRate / Double(n))))
+        guard maxBin >= 2 else { return [] }
+        let band = p[1...maxBin].map(Double.init)
+        let total = band.reduce(0, +)
+        guard total > 0 else { return band.map { _ in -200 } }
+        return band.map { 10 * log10(max($0 / total, 1e-12)) }
+    }
+
+    /// RMS dB difference of two modulation spectra.
+    static func modulationDeviation(_ a: [Double], _ b: [Double]) -> Double? {
+        let n = min(a.count, b.count)
+        guard n > 0 else { return nil }
+        var acc = 0.0
+        for i in 0..<n { acc += (a[i] - b[i]) * (a[i] - b[i]) }
+        return sqrt(acc / Double(n))
+    }
+}
