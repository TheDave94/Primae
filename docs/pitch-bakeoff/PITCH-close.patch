+// PitchBankTests.swift
+// PrimaeNativeTests — pitch bake-off phase 2, lane C3 "PitchBank" (2026-11-24)
+//
+// What the candidate claims, one test per claim (BAKEOFF-PITCH.md section 2 C3):
+//   - the banks are pitched (bank k's loop at f0 x 2^(k/12)) and index-preserving (every bank has the source's marks,
+//     re-spaced by 1/pf);
+//   - the live path plays bank round(cents / 100) (residual <= 50 c);
+//   - a +-600 c sweep crosses the banks without clicks;
+//   - the fallback: a note that starts before the banks are ready is C1 live, bit for bit, and says so (`lastPath`);
+//     the next note after they arrive is on the banks;
+//   - the attack follows the pitch (lane C3 item 7, in PitchBank and in TDPSOLA2 behind `shiftedAttack`);
+//   - determinism; the cache holds the active letter plus one.
+// Banks are built once per source through `PitchBankTestSupport.cache` (the WORLD build is the slow part).
+
+import Testing
+import Foundation
+@testable import PrimaeNative
+
+nonisolated enum PitchBankTestSupport {
+    static let sr = LiveSonificationKernel.sampleRate
+    static let cache = PitchBankCache(capacity: 4)
+
+    static func make(_ s: StudySource, _ edit: (inout PitchBankTuning) -> Void = { _ in }) -> PitchBank {
+        var t = PitchBankTuning.default
+        t.waitForBanks = true
+        edit(&t)
+        return PitchBank(source: s.samples, sampleRate: sr, kind: s.kind, maxFramesPerRender: 512, onset: s.onset,
+                         outputGain: 1, tuning: t, cache: cache, cacheKey: "test:\(s.name)")
+    }
+
+    /// The loop's steady part of a held render.
+    static func steady(_ r: any SonificationRenderer, cents: Float, rate: Float = 1) -> ArraySlice<Float> {
+        SonificationDriver.steady(r, seconds: 2.0, rate: rate, cents: cents)[Int(0.6 * sr)..<Int(1.9 * sr)]
+    }
+}
+
+@Suite("C3 PitchBank", .serialized)
+@MainActor struct PitchBankTests {
+    typealias S = PitchBankTestSupport
+    static let sr = LiveSonificationKernel.sampleRate
+
+    @Test("the banks are pitched (loop f0 = bank 0 x pf_k within 5 c) and index-preserving (marks re-spaced by 1/pf)")
+    func banksArePitchedAndAligned() throws {
+        let s = try StudySources.load("I_phoneme1")
+        let r = S.make(s)
+        let set = try #require(r.bankSet)
+        let a = r.analysis
+        let p = PitchBank.bankPeriods(a, .default)
+        #expect(set.views.count == 13)
+        func loop(_ k: Int) -> ArraySlice<Float> {
+            let v = set.views[PitchBankSet.index(ofStep: k)]
+            let lo = Int(v.marks[a.attackIndex + 20]), hi = Int(v.marks[a.loopEndIndex - 20])
+            return ArraySlice(UnsafeBufferPointer(start: v.full + lo, count: hi - lo))
+        }
+        let f00 = try #require(C1Metrics.medianF0(loop(0)))
+        for k in [-6, -3, 3, 6] {
+            let v = set.views[PitchBankSet.index(ofStep: k)]
+            let pf = PitchBankSet.pitchFactor(ofStep: k)
+            #expect(abs(v.pitchFactor - pf) < 1e-12)
+            for i in 1..<a.marks.count {
+                #expect(abs((v.marks[i] - v.marks[i - 1]) - p[i - 1] / pf) < 1e-9, "bank \(k) mark \(i)")
+            }
+            let f = try #require(C1Metrics.f0Near(loop(k), expected: f00 * pf))
+            let e = C1Metrics.cents(f, f00 * pf)
+            #expect(abs(e) <= 5, "bank \(k): \(f) Hz against \(f00 * pf) Hz, \(e) c")
+        }
+    }
+
+    @Test("the live path plays bank round(cents / 100): residual <= 50 c")
+    func residualWithinFiftyCents() throws {
+        let s = try StudySources.load("I_phoneme1")
+        let r = S.make(s)
+        for c: Float in [-449, -151, 0, 149, 351, 551, 600] {
+            _ = SonificationDriver.steady(r, seconds: 0.4, rate: 1, cents: c)
+            #expect(r.lastPath == .bank)
+            let k = r.debugBanks.current
+            #expect(k == Int((Double(c) / 100).rounded()), "\(c) c plays bank \(k)")
+            #expect(abs(Double(c) - 100 * Double(k)) <= 50)
+        }
+    }
+
+    @Test("a +-600 c triangle (0.75 s per leg) crosses every bank, aligned: no clicks (ratio <= 2.5), F0 tracks")
+    func sweepSwitchesWithoutClicks() throws {
+        let s = try StudySources.load("I_phoneme1")
+        let r = S.make(s)
+        var ev = [ControlEvent(time: 0, rate: 1, cents: 0, gate: true)]
+        var t = 0.0
+        while t < 3.0 {
+            let ph = t.truncatingRemainder(dividingBy: 3.0)
+            let c = ph < 0.75 ? 800 * ph : ph < 2.25 ? 600 - 800 * (ph - 0.75) : -600 + 800 * (ph - 2.25)
+            ev.append(ControlEvent(time: t, cents: Float(c)))
+            t += 256 / Self.sr
+        }
+        r.reset()
+        let switches0 = r.bankSwitches
+        let x = SonificationDriver.render(r, seconds: 3.0, events: ev)
+        #expect(r.bankSwitches - switches0 >= 24, "switches \(r.bankSwitches - switches0)")
+        let cr = try #require(PitchMetrics.localClickRatio(x, from: Int(0.3 * Self.sr), to: Int(2.9 * Self.sr),
+                                                           sampleRate: Self.sr))
+        #expect(cr <= PitchGates.clickRatio, "click ratio \(cr)")
+    }
+
+    @Test("fallback: before the banks are ready a note is C1 live, bit for bit (lastPath .live); after, .bank")
+    func fallbackWhenBanksAreNotReady() throws {
+        let s = try StudySources.load("I_phoneme1")
+        let hold = DispatchSemaphore(value: 0)
+        let cache = PitchBankCache(capacity: 1)
+        let r = PitchBank(source: s.samples, sampleRate: Self.sr, kind: s.kind, maxFramesPerRender: 512,
+                          onset: s.onset, outputGain: 1, cache: cache, cacheKey: "fallback:\(s.name)") { src, played, a in
+            hold.wait()
+            return WorldBankRenderer(source: src, played: played, sampleRate: LiveSonificationKernel.sampleRate,
+                                     analysis: a)
+        }
+        let ref = TDPSOLA2(source: s.samples, sampleRate: Self.sr, kind: s.kind, maxFramesPerRender: 512,
+                           tuning: .default, options: PitchBank.liveOptions, onset: s.onset, outputGain: 1)
+        #expect(!r.banksReady)
+        let x = SonificationDriver.steady(r, seconds: 0.5, rate: 1.2, cents: 300)
+        let y = SonificationDriver.steady(ref, seconds: 0.5, rate: 1.2, cents: 300)
+        #expect(r.lastPath == .live)
+        #expect(x == y, "the fallback note is C1 live")
+        hold.signal()
+        let deadline = Date().addingTimeInterval(600)
+        while !r.banksReady && Date() < deadline { Thread.sleep(forTimeInterval: 0.05) }
+        #expect(r.banksReady)
+        _ = SonificationDriver.steady(r, seconds: 0.3, rate: 1, cents: 300)
+        #expect(r.lastPath == .bank)
+    }
+
+    @Test("the attack follows the pitch: the first 100 ms of voicing at +400 c sit at the steady F0 x pf (+-10 c)",
+          arguments: ["PitchBank", "TDPSOLA2-sa"])
+    func attackFollowsPitch(variant: String) throws {
+        let s = try StudySources.load("I_phoneme1")
+        let make: () -> any SonificationRenderer = variant == "PitchBank"
+            ? { S.make(s) }
+            : { C1Make.make(s, C1Make.with { $0.shiftedAttack = true }) }
+        let r = make()
+        let f0 = try #require(C1Metrics.medianF0(S.steady(r, cents: 0)))
+        let pf = exp2(400.0 / 1200)
+        let x = SonificationDriver.steady(r, seconds: 0.3, rate: 1, cents: 400)
+        let on = Int(0.02 * Self.sr)
+        let f = try #require(C1Metrics.f0Near(x[on..<(on + Int(0.1 * Self.sr) + 4096)], expected: f0 * pf,
+                                              windows: 3, window: 2048))
+        let e = C1Metrics.cents(f, f0 * pf)
+        #expect(abs(e) <= 10, "\(variant): attack \(f) Hz against \(f0 * pf) Hz, \(e) c")
+    }
+
+    @Test("determinism: two instances and a re-open render the bank path bit for bit")
+    func deterministic() throws {
+        let s = try StudySources.load("I_phoneme1")
+        let ev = [ControlEvent(time: 0, rate: 0.8, cents: -250, gate: true), ControlEvent(time: 0.4, cents: 380),
+                  ControlEvent(time: 0.7, rate: 1.6), ControlEvent(time: 0.9, gate: false),
+                  ControlEvent(time: 1.0, cents: 120, gate: true)]
+        let a = S.make(s), b = S.make(s)
+        a.reset(); b.reset()
+        let x = SonificationDriver.render(a, seconds: 1.4, events: ev)
+        let y = SonificationDriver.render(b, seconds: 1.4, events: ev)
+        a.reset()
+        let z = SonificationDriver.render(a, seconds: 1.4, events: ev)
+        #expect(x == y)
+        #expect(x == z)
+        #expect(x.contains { $0 != 0 })
+    }
+
+    @Test("the cache holds the active letter plus one: a third source evicts the least recently used")
+    func cacheHoldsTwo() throws {
+        let s = try StudySources.load("I_phoneme1")
+        let a = TDPSOLAAnalysis.analyse(s.samples, sampleRate: Self.sr, kind: .voicedPhoneme, onset: s.onset)
+        final class Zero: BankRenderer, @unchecked Sendable {
+            static var rendererName: String { "zero" }
+            func render(_ l: PitchBankLayout) -> PitchBankRender { PitchBankRender(full: [0, 0], noise: nil) }
+        }
+        let c = PitchBankCache(capacity: 2)
+        let build: @Sendable () -> PitchBankSet = { PitchBankSet(analysis: a) { Zero() } }
+        _ = c.get("A", build: build)
+        _ = c.get("B", build: build)
+        #expect(c.keys == ["B", "A"])
+        _ = c.get("A", build: build)
+        _ = c.get("C", build: build)
+        #expect(c.keys == ["C", "A"])
+    }
