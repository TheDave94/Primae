+// PitchMetrics.swift
+// PrimaeNativeTests — pitch bake-off harness, phase 2 (lane BENCH-P, 2026-11-23)
+//
+// The pitch-specific metrics of BAKEOFF-PITCH.md section 4.2, ported to
+// Swift/vDSP from the phase-1 analysis (`method/metrics_r27.py`, the r27
+// analysis' own, and `method/measure.py`). Pure functions over Float
+// arrays; Foundation + Accelerate only, so this file (with
+// BakeoffMetrics.swift) also compiles stand-alone for the calibration CLI
+// (`scripts/pitch_bakeoff/calibrate_main.swift`), which runs the SAME code
+// on the phase-1 WAVs and compares it with the phase-1 numbers.
+//
+// Port notes (where a choice was needed):
+// - STFT as scipy.signal.stft's defaults: periodic Hann, `boundary='zeros'`
+//   (nperseg/2 zeros both ends), `padded=True`, spectrum scaling
+//   (Z / sum(window)). LTAS = mean |Z|^2 over frames + 1e-20.
+// - True envelope (Roebel & Rodet 2005) exactly as `true_envelope`: start
+//   from A = 0.5 ln P, iterate target = max(A, V), cepstrum liftered to
+//   `order`, stop when max(A - V) < 0.1 Np (~0.87 dB) or after `iters`.
+//   The liftered cepstrum of a real even log-spectrum needs only c[0...order],
+//   so the two DFTs are matrix products with a cosine basis (exact).
+// - Warp alpha / LSD / frame-wise LSD exactly as `env_compare` and
+//   `framewise_env_lsd` (151 ... 5000 Hz, level-free).
+// - Jitter/shimmer: NOT Praat's cc point process; the output's own marks
+//   chained by normalised cross-correlation (period i = the lag in
+//   [0.75 T, 1.33 T] at which cycle i best matches the next), amplitude =
+//   max |x| over the period, Praat's local-measure filters (period
+//   0.1 ... 20 ms, period factor 1.3, amplitude factor 1.6). Reported as a
+//   RATIO to the source's value by the same instrument; calibrated against
+//   phase-1 Praat on the same WAVs (BENCH-P.md).
+// - F (unvoiced): candidate A's definitions (`UnvoicedPitchShiftTests`,
+//   branch t3/tdpsola-pitch-candidates): power folded on the 5 ms hop
+//   (round(0.005 fs) = 221 at 44.1 kHz) max/min dB; ACF at
+//   hop * |1 - 1/pf|; level re 0 cents.
+
+import Accelerate
+import Foundation
+
+enum PitchMetrics {
+
+    // MARK: - Small helpers
+
+    static func rmsDB(_ x: ArraySlice<Float>) -> Double {
+        guard !x.isEmpty else { return -240 }
+        var s = 0.0
+        for v in x { s += Double(v) * Double(v) }
+        return 20 * log10((s / Double(x.count)).squareRoot() + 1e-12)
+    }
+
+    static func median(_ v: [Double]) -> Double? {
+        guard !v.isEmpty else { return nil }
+        let s = v.sorted()
+        return s.count % 2 == 1 ? s[s.count / 2] : 0.5 * (s[s.count / 2 - 1] + s[s.count / 2])
+    }
+
+    static func cents(_ f: Double, re ref: Double) -> Double { 1200 * log2(f / ref) }
+
+    // MARK: - Real FFT (Double), power spectra
+
+    final class PowerFFT {
+        let n: Int
+        let bins: Int
+        private let log2n: vDSP_Length
+        private let setup: FFTSetupD
+        let window: [Double]
+        let windowSum: Double
+
+        init(n: Int) {
+            precondition(n > 0 && n & (n - 1) == 0, "n must be a power of two")
+            self.n = n
+            bins = n / 2 + 1
+            log2n = vDSP_Length(log2(Double(n)).rounded())
+            setup = vDSP_create_fftsetupD(log2n, FFTRadix(kFFTRadix2))!
+            // Periodic Hann (scipy.signal.get_window('hann', n), fftbins=True).
+            window = (0..<n).map { 0.5 - 0.5 * cos(2 * .pi * Double($0) / Double(n)) }
+            windowSum = window.reduce(0, +)
+        }
+        deinit { vDSP_destroy_fftsetupD(setup) }
+
+        /// |Z|^2 per bin of one frame (already windowed by the caller or not), Z scaled by 1/sum(window).
+        func power(frame: [Double]) -> [Double] {
+            let h = n / 2
+            var re = [Double](repeating: 0, count: h), im = [Double](repeating: 0, count: h)
+            for k in 0..<h { re[k] = frame[2 * k]; im[k] = frame[2 * k + 1] }
+            var out = [Double](repeating: 0, count: bins)
+            re.withUnsafeMutableBufferPointer { rp in
+                im.withUnsafeMutableBufferPointer { ip in
+                    var split = DSPDoubleSplitComplex(realp: rp.baseAddress!, imagp: ip.baseAddress!)
+                    vDSP_fft_zripD(setup, &split, 1, log2n, FFTDirection(kFFTDirection_Forward))
+                    // zrip output is 2x the DFT; DC in realp[0], Nyquist in imagp[0].
+                    let s = 1 / (2 * windowSum)
+                    out[0] = (rp[0] * s) * (rp[0] * s)
+                    out[h] = (ip[0] * s) * (ip[0] * s)
+                    for k in 1..<h {
+                        let a = rp[k] * s, b = ip[k] * s
+                        out[k] = a * a + b * b
+                    }
+                }
+            }
+            return out
+        }
+
+        /// scipy.signal.stft(x, nperseg=n, noverlap=n-hop, window='hann') power frames.
+        func stftPower(_ x: ArraySlice<Float>, hop: Int) -> [[Double]] {
+            let half = n / 2
+            let len = x.count
+            // boundary='zeros' then padded=True: total length so that frames cover everything.
+            let padded = len + 2 * half
+            let extra = (-(padded - n) % hop + hop) % hop
+            let total = padded + extra
+            var buf = [Double](repeating: 0, count: total)
+            var j = half
+            for v in x { buf[j] = Double(v); j += 1 }
+            var frames: [[Double]] = []
+            var s = 0
+            var frame = [Double](repeating: 0, count: n)
+            while s + n <= total {
+                for i in 0..<n { frame[i] = buf[s + i] * window[i] }
+                frames.append(power(frame: frame))
+                s += hop
+            }
+            return frames
+        }
+
+        var frequencies: [Double] { (0..<bins).map { Double($0) } }   // in bins; scale by fs/n
+    }
+
+    /// Long-term average power spectrum (metrics_r27.ltas): mean |Z|^2 over frames + 1e-20, and the bin frequencies.
+    static func ltas(_ x: ArraySlice<Float>, sampleRate: Double, nfft: Int = 4096) -> (f: [Double], p: [Double]) {
+        let fft = PowerFFT(n: nfft)
+        let frames = fft.stftPower(x, hop: nfft / 4)
+        var p = [Double](repeating: 0, count: fft.bins)
+        for fr in frames { for k in 0..<fft.bins { p[k] += fr[k] } }
+        let c = Double(max(1, frames.count))
+        for k in 0..<fft.bins { p[k] = p[k] / c + 1e-20 }
+        let f = (0..<fft.bins).map { Double($0) * sampleRate / Double(nfft) }
+        return (f, p)
+    }
+
+    // MARK: - True envelope (Roebel & Rodet 2005)
+
+    /// Cepstral smoothing operator for an n-point real even log-spectrum, liftered to `order`.
+    final class CepstralLifter {
+        let n: Int, bins: Int, order: Int
+        /// basis[k * bins + m] = cos(2 pi m k / n), k = 0...order, m = 0...n/2.
+        private let basis: [Double]
+        private let wm: [Double]   // forward weights over bins (1, 2, ..., 2, 1) / n
+        private let uk: [Double]   // inverse weights over quefrencies (1, 2, ..., 2)
+
+        init(n: Int, order: Int) {
+            self.n = n
+            bins = n / 2 + 1
+            self.order = order
+            let bins = n / 2 + 1
+            var b = [Double](repeating: 0, count: (order + 1) * bins)
+            for k in 0...order {
+                for m in 0..<bins { b[k * bins + m] = cos(2 * .pi * Double((m * k) % n) / Double(n)) }
+            }
+            basis = b
+            wm = (0..<bins).map { m in (m == 0 || m == bins - 1 ? 1.0 : 2.0) / Double(n) }
+            uk = (0...order).map { $0 == 0 ? 1.0 : 2.0 }
+        }
+
+        /// rfft(lifter(irfft(t))).real, i.e. the cepstrally smoothed `t`.
+        func smooth(_ t: [Double]) -> [Double] {
+            var weighted = [Double](repeating: 0, count: bins)
+            vDSP_vmulD(t, 1, wm, 1, &weighted, 1, vDSP_Length(bins))
+            var c = [Double](repeating: 0, count: order + 1)
+            // c (order+1 x 1) = basis (order+1 x bins) * weighted (bins x 1)
+            vDSP_mmulD(basis, 1, weighted, 1, &c, 1, vDSP_Length(order + 1), 1, vDSP_Length(bins))
+            vDSP_vmulD(c, 1, uk, 1, &c, 1, vDSP_Length(order + 1))
+            var v = [Double](repeating: 0, count: bins)
+            // v (1 x bins) = c^T (1 x order+1) * basis (order+1 x bins)
+            vDSP_mmulD(c, 1, basis, 1, &v, 1, 1, vDSP_Length(bins), vDSP_Length(order + 1))
+            return v
+        }
+    }
+
+    /// `true_envelope(P, order, iters)` of metrics_r27: the envelope in dB of a power spectrum.
+    static func trueEnvelope(_ p: [Double], lifter: CepstralLifter, iters: Int = 60) -> [Double] {
+        let a = p.map { 0.5 * log($0) }
+        var v = [Double](repeating: -.infinity, count: a.count)
+        for _ in 0..<iters {
+            var target = a
+            for i in 0..<a.count where v[i] > target[i] { target[i] = v[i] }
+            v = lifter.smooth(target)
+            var excess = -Double.infinity
+            for i in 0..<a.count { excess = max(excess, a[i] - v[i]) }
+            if excess < 0.1 { break }
+        }
+        let k = 20 / log(10.0)
+        return v.map { $0 * k }
+    }
+
+    /// Cepstral order of the envelope: int(0.5 fs / max(f0max, 100)) (metrics_r27.envelope_db).
+    static func envelopeOrder(sampleRate: Double, f0max: Double) -> Int { Int(0.5 * sampleRate / max(f0max, 100)) }
+
+    /// metrics_r27.envelope_db: true envelope (dB) of the LTAS (nfft 4096) of `x`.
+    static func envelopeDB(_ x: ArraySlice<Float>, sampleRate: Double, f0max: Double = 360) -> (f: [Double], e: [Double]) {
+        let (f, p) = ltas(x, sampleRate: sampleRate)
+        let lifter = CepstralLifter(n: 4096, order: envelopeOrder(sampleRate: sampleRate, f0max: f0max))
+        return (f, trueEnvelope(p, lifter: lifter))
+    }
+
+    /// np.interp(x, xp, fp) for ascending, evenly spaced xp (clamped at both ends).
+    static func interpEven(_ x: Double, x0: Double, dx: Double, _ fp: [Double]) -> Double {
+        let u = (x - x0) / dx
+        if u <= 0 { return fp[0] }
+        let i = Int(u)
+        if i >= fp.count - 1 { return fp[fp.count - 1] }
+        let t = u - Double(i)
+        return fp[i] + t * (fp[i + 1] - fp[i])
+    }
+
+    struct EnvelopeComparison {
+        /// Level-free LSD (dB) at alpha = 1.
+        let lsd: Double
+        /// argmin over alpha in [0.6, 1.6] (201 steps) of LSD(Eb(f) vs Ea(f / alpha)).
+        let warp: Double
+        let lsdAtWarp: Double
+    }
+
+    /// metrics_r27.env_compare(fa, Ea, Eb, lo, hi): `ea` the source envelope, `eb` the output's.
+    static func envelopeCompare(f: [Double], source ea: [Double], output eb: [Double],
+                                lo: Double = 150, hi: Double = 5000,
+                                alphas: [Double] = PitchMetrics.warpGrid) -> EnvelopeComparison {
+        let band = f.indices.filter { f[$0] >= lo && f[$0] <= hi }
+        let dx = f[1] - f[0]
+        func lsd(_ alpha: Double) -> Double {
+            var d = band.map { eb[$0] - interpEven(f[$0] / alpha, x0: f[0], dx: dx, ea) }
+            let m = d.reduce(0, +) / Double(d.count)
+            for i in d.indices { d[i] -= m }
+            return (d.reduce(0) { $0 + $1 * $1 } / Double(d.count)).squareRoot()
+        }
+        let l = alphas.map(lsd)
+        var best = 0
+        for i in l.indices where l[i] < l[best] { best = i }
+        return EnvelopeComparison(lsd: lsd(1), warp: alphas[best], lsdAtWarp: l[best])
+    }
+
+    /// np.linspace(0.6, 1.6, 201).
+    static let warpGrid: [Double] = (0..<201).map { 0.6 + Double($0) * (1.0 / 200) }
+
+    /// measure.framewise_env_lsd(xs, y, f0max): median over output frames of the level-free LSD (151...5000 Hz) of
+    /// each frame's true envelope against the SOURCE's median frame envelope (nfft 2048, hop 1024, 40 iterations).
+    static func framewiseEnvelopeLSD(source xs: ArraySlice<Float>, output y: ArraySlice<Float>, sampleRate: Double,
+                                     f0max: Double = 360, nfft: Int = 2048, hop: Int = 1024) -> Double? {
+        let fft = PowerFFT(n: nfft)
+        let lifter = CepstralLifter(n: nfft, order: envelopeOrder(sampleRate: sampleRate, f0max: f0max))
+        func envs(_ z: ArraySlice<Float>) -> [[Double]] {
+            let frames = fft.stftPower(z, hop: hop).map { $0.map { $0 + 1e-20 } }
+            let sums = frames.map { $0.reduce(0, +) }
+            guard let top = sums.max() else { return [] }
+            return zip(frames, sums).filter { $0.1 > 1e-8 * top }.map { trueEnvelope($0.0, lifter: lifter, iters: 40) }
+        }
+        let es = envs(xs), ey = envs(y)
+        guard !es.isEmpty, !ey.isEmpty else { return nil }
+        let band = (0..<fft.bins).filter {
+            let f = Double($0) * sampleRate / Double(nfft)
+            return f >= 150 && f <= 5000
+        }
+        let ms = band.map { b in median(es.map { $0[b] })! }
+        let per: [Double] = ey.map { e in
+            var d = band.indices.map { e[band[$0]] - ms[$0] }
+            let m = d.reduce(0, +) / Double(d.count)
+            for i in d.indices { d[i] -= m }
+            return (d.reduce(0) { $0 + $1 * $1 } / Double(d.count)).squareRoot()
+        }
+        return median(per)
+    }
+
+    // MARK: - Jitter / shimmer from the signal's own marks
+
+    struct Perturbation {
+        /// Local jitter, percent: mean |T_i - T_{i-1}| / mean T.
+        let jitterPct: Double
+        /// Local shimmer, percent: mean |A_i - A_{i-1}| / mean A.
+        let shimmerPct: Double
+        let periods: Int
+        let meanPeriodFrames: Double
+    }
+
+    /// Cycles chained by normalised cross-correlation. `x` is a steady voiced segment; the local period guess comes
+    /// from YIN (5 ms hop). Nil when fewer than 20 usable period pairs are found.
+    static func perturbation(_ x: ArraySlice<Float>, sampleRate: Double,
+                             fmin: Double = 75, fmax: Double = 700) -> Perturbation? {
+        let y = Array(x)
+        let hop = Int(0.005 * sampleRate)
+        let track = BakeoffMetrics.yinTrack(y, start: 0, end: y.count, sampleRate: sampleRate, hop: hop,
+                                            fmin: fmin, fmax: fmax)
+        let voiced = track.compactMap { p in p.f0.map { (frame: p.frame + 512, period: sampleRate / $0) } }
+        guard voiced.count >= 10 else { return nil }
+        func periodGuess(_ at: Int) -> Double {
+            var best = voiced[0], dist = Int.max
+            for v in voiced where abs(v.frame - at) < dist { dist = abs(v.frame - at); best = v }
+            return best.period
+        }
+        let minP = sampleRate * 0.0001, maxP = sampleRate * 0.02
+        var marks: [Double] = []
+        var periods: [Double] = []
+        var amps: [Double] = []
+        var m = 0
+        while true {
+            let t = periodGuess(m)
+            let w = Int(t.rounded())
+            let lo = Int((0.75 * t).rounded(.down)), hi = Int((1.33 * t).rounded(.up))
+            guard m + hi + w + 2 < y.count, lo > 2 else { break }
+            // Normalised cross-correlation of [m, m+w) against [m+L, m+L+w).
+            var e0 = 0.0
+            for i in 0..<w { e0 += Double(y[m + i]) * Double(y[m + i]) }
+            var r = [Double](repeating: -2, count: hi + 2)
+            for lag in (lo - 1)...(hi + 1) {
+                var c = 0.0, e1 = 0.0
+                for i in 0..<w {
+                    let a = Double(y[m + i]), b = Double(y[m + lag + i])
+                    c += a * b; e1 += b * b
+                }
+                r[lag] = e0 > 0 && e1 > 0 ? c / (e0 * e1).squareRoot() : 0
+            }
+            var best = lo
+            for lag in lo...hi where r[lag] > r[best] { best = lag }
+            var p = Double(best)
+            let a = r[best - 1], b = r[best], c = r[best + 1], den = a - 2 * b + c
+            if den < 0 { p += 0.5 * (a - c) / den }
+            if b > 0.5 {
+                // Peak amplitude over the period.
+                var amp = 0.0
+                for i in m..<(m + best) { amp = max(amp, Double(abs(y[i]))) }
+                marks.append(Double(m)); periods.append(p); amps.append(amp)
+            } else {
+                // A break in periodicity: do not pair across it.
+                marks.append(Double(m)); periods.append(.nan); amps.append(.nan)
+            }
+            m += best
+        }
+        var dj = 0.0, sj = 0.0, nj = 0
+        var ds = 0.0, ss = 0.0, ns = 0
+        for i in 1..<max(1, periods.count) {
+            let t0 = periods[i - 1], t1 = periods[i]
+            guard t0.isFinite, t1.isFinite, t0 >= minP, t0 <= maxP, t1 >= minP, t1 <= maxP,
+                  max(t0, t1) / min(t0, t1) <= 1.3 else { continue }
+            dj += abs(t1 - t0); sj += 0.5 * (t0 + t1); nj += 1
+            let a0 = amps[i - 1], a1 = amps[i]
+            if a0 > 0, a1 > 0, max(a0, a1) / min(a0, a1) <= 1.6 {
+                ds += abs(a1 - a0); ss += 0.5 * (a0 + a1); ns += 1
+            }
+        }
+        guard nj >= 20, ns >= 20 else { return nil }
+        return Perturbation(jitterPct: dj / sj * 100, shimmerPct: ds / ss * 100, periods: nj,
+                            meanPeriodFrames: sj / Double(nj))
+    }
+
+    // MARK: - F (unvoiced): candidate A's definitions
+
+    /// Unvoiced grain hop of the shipped renderer: (0.005 fs).rounded() (221 at 44.1 kHz).
+    static func unvoicedHop(sampleRate: Double) -> Int { Int((0.005 * sampleRate).rounded()) }
+
+    /// Power folded on `period` frames (20 bins): max / min in dB ("mod200", the grain-rate buzz).
+    static func grainRateWobble(_ y: ArraySlice<Float>, period: Int) -> Double {
+        let bins = 20
+        var acc = [Double](repeating: 0, count: bins), cnt = [Double](repeating: 0, count: bins)
+        let lo = y.startIndex
+        for i in y.indices {
+            let b = ((i - lo) % period) * bins / period
+            acc[b] += Double(y[i]) * Double(y[i]); cnt[b] += 1
+        }
+        let p = zip(acc, cnt).map { $0 / max(1, $1) }
+        guard let mx = p.max(), let mn = p.min(), mn > 0 else { return .infinity }
+        return 10 * log10(mx / mn)
+    }
+
+    /// Normalised autocorrelation at a fractional (linearly interpolated) lag.
+    static func acf(_ y: ArraySlice<Float>, lag: Double) -> Double {
+        let l = Int(lag), f = lag - Double(l)
+        var ab = 0.0, aa = 0.0, bb = 0.0
+        var i = y.startIndex
+        while i < y.endIndex - l - 1 {
+            let a = Double(y[i])
+            let b = (1 - f) * Double(y[i + l]) + f * Double(y[i + l + 1])
+            ab += a * b; aa += a * a; bb += b * b
+            i += 1
+        }
+        return aa > 0 && bb > 0 ? ab / (aa * bb).squareRoot() : 0
+    }
+
+    /// The comb lag of a grain stream re-reading resampled noise: hop * |1 - 1/pf| (frames).
+    static func combLag(hop: Int, pitchFactor pf: Double) -> Double { Double(hop) * abs(1 - 1 / pf) }
+
+    // MARK: - Clicks during sweeps
+
+    /// Worst local click ratio: over 5 ms blocks, max |dx| in the block / p99.9 of |dx| over the +-100 ms around it
+    /// (the block's own pitch context, so an upshifted stretch is not read as a click). The r17 gate reads 2.5.
+    static func localClickRatio(_ x: [Float], from: Int, to: Int, sampleRate: Double) -> Double? {
+        let block = Int(0.005 * sampleRate), ctx = Int(0.1 * sampleRate)
+        guard to - from > 2 * ctx + block else { return nil }
+        var d = [Float](repeating: 0, count: x.count)
+        for i in max(1, from - ctx)..<min(x.count, to + ctx) { d[i] = abs(x[i] - x[i - 1]) }
+        var worst = 0.0
+        var b = from
+        while b + block <= to {
+            var mx: Float = 0
+            for i in b..<(b + block) { mx = max(mx, d[i]) }
+            let c0 = max(1, b - ctx), c1 = min(x.count, b + block + ctx)
+            let typical = BakeoffMetrics.percentile(d[c0..<c1].map(Double.init), 99.9) ?? 0
+            if typical > 0 { worst = max(worst, Double(mx) / typical) }
+            b += block
+        }
+        return worst
+    }
+
+    // MARK: - Pitch track in cents (step response, trajectory lag)
+
+    /// YIN f0 track of `x[from..<to]` as (time of window centre, cents re `ref`); hop in seconds.
+    static func centsTrack(_ x: [Float], from: Int, to: Int, ref: Double, sampleRate: Double, hopSeconds: Double,
+                           fmin: Double = 75, fmax: Double = 700, levelRef: Float? = nil) -> [(t: Double, v: Double?)] {
+        BakeoffMetrics.yinTrack(x, start: from, end: to, sampleRate: sampleRate,
+                                hop: max(1, Int(hopSeconds * sampleRate)), fmin: fmin, fmax: fmax,
+                                levelRef: levelRef).map { p in
+            (t: Double(p.frame + 512) / sampleRate, v: p.f0.map { cents($0, re: ref) })
+        }
+    }
+}
diff --git a/PrimaeNativeTests/SonificationBakeoff/PitchRunner.swift b/PrimaeNativeTests/SonificationBakeoff/PitchRunner.swift
new file mode 100644
index 00000000..f869701d
--- /dev/null
+++ b/PrimaeNativeTests/SonificationBakeoff/PitchRunner.swift
@@ -0,0 +1,229 @@
+// PitchRunner.swift
+// PrimaeNativeTests — pitch bake-off harness, phase 2 (lane BENCH-P, 2026-11-23)
+//
+// Turns one render of a PitchScenarios scenario into metric rows
+// (bench.csv) and gate rows (gates.csv). The r17 rows (CPU, onset, gate
+// clicks, level) come from `BakeoffRunner.metrics`; this adds the pitch
+// metrics of BAKEOFF-PITCH.md section 4.2 and evaluates the section 3 gates
+// (`PitchGates`).
+//
+// Source-side references are computed ONCE per source (`PitchSourceRef`)
+// from the steady segment, as measure.py did: the YIN median f0, the true
+// envelope of the long-term spectrum, and the jitter/shimmer of the
+// source's own marks.
+
+import Foundation
+@testable import PrimaeNative
+
+struct PitchGateRow {
+    let candidate: String
+    let source: String
+    let scenario: String
+    let result: PitchGates.Result
+
+    static let header = "candidate,source,scenario,gate,value,threshold,pass"
+    var csv: String {
+        let v = result.value.isFinite ? String(format: "%.6g", result.value) : "nan"
+        return "\(candidate),\(source),\(scenario),\(result.gate),\(v),\(result.threshold),\(result.pass ? "PASS" : "FAIL")"
+    }
+}
+
+/// Per-source references (computed once).
+final class PitchSourceRef {
+    let source: BakeoffSource
+    let steady: ArraySlice<Float>
+    let f0: Double?
+    let envelope: (f: [Double], e: [Double])
+    let perturbation: PitchMetrics.Perturbation?
+    /// Level of each candidate's 0-cent held render per rate ("<candidate>@<rate>"), for level-vs-cents.
+    var zeroLevels: [String: Double] = [:]
+
+    var isVoiced: Bool { source.kind == .voicedPhoneme }
+
+    init(_ source: BakeoffSource) {
+        self.source = source
+        let sr = source.sampleRate
+        steady = source.samples[source.steadyRange]
+        let tr = BakeoffMetrics.yinTrack(Array(steady), start: 0, end: steady.count, sampleRate: sr,
+                                         hop: Int(0.005 * sr), fmin: 75, fmax: 700)
+        f0 = BakeoffMetrics.medianF0(tr)
+        envelope = PitchMetrics.envelopeDB(steady, sampleRate: sr)
+        perturbation = source.kind == .voicedPhoneme ? PitchMetrics.perturbation(steady, sampleRate: sr) : nil
+    }
+}
+
+enum PitchRunner {
+
+    struct Output {
+        var rows: [BakeoffRow] = []
+        var gates: [PitchGateRow] = []
+    }
+
+    // swiftlint:disable:next function_body_length cyclomatic_complexity
+    static func rows(candidate: String, render: BakeoffRender, ref: PitchSourceRef, scenario: BakeoffScenario,
+                     gamma: Double = 0) -> Output {
+        let source = ref.source
+        let sr = source.sampleRate
+        let x = render.samples
+        var out = Output()
+        func add(_ metric: String, _ value: Double?, _ unit: String) {
+            guard let value else { return }
+            out.rows.append(BakeoffRow(candidate: candidate, source: source.name, kind: source.kindLabel,
+                                       sampleRate: Int(sr), scenario: scenario.name, metric: metric,
+                                       value: value, unit: unit))
+        }
+        func gate(_ r: PitchGates.Result?) {
+            guard let r else { return }
+            out.gates.append(PitchGateRow(candidate: candidate, source: source.name, scenario: scenario.name, result: r))
+        }
+        func frame(_ t: Double) -> Int { min(x.count, max(0, Int(t * sr))) }
+
+        switch scenario.family {
+        case .heldPitch(let c, let r):
+            let pf = pow(2, Double(c) / 1200)
+            let key = "\(candidate)@\(PitchScenarios.rateLabel(r))"
+            if ref.isVoiced {
+                let y = x[frame(PitchScenarios.heldRegion.from)..<frame(PitchScenarios.heldRegion.to)]
+                let level = PitchMetrics.rmsDB(y)
+                add("level_db", level, "dBFS")
+                if c == 0 { ref.zeroLevels[key] = level }
+                if let z = ref.zeroLevels[key] {
+                    add("level_re_0c_db", level - z, "dB")
+                    if c != 0 { gate(PitchGates.level(reZeroDB: level - z)) }
+                }
+                let tr = BakeoffMetrics.yinTrack(Array(y), start: 0, end: y.count, sampleRate: sr,
+                                                 hop: Int(0.005 * sr), fmin: 75, fmax: 700)
+                let f0s = tr.compactMap(\.f0).sorted()
+                if let f = BakeoffMetrics.medianF0(tr), let s = ref.f0 {
+                    let e = PitchMetrics.cents(f, re: s * pf)
+                    add("f0_err_c", e, "cents")
+                    gate(PitchGates.f0(errorCents: e))
+                }
+                if f0s.count >= 10 {
+                    add("f0_spread_p10_p90_c", PitchMetrics.cents(f0s[f0s.count * 9 / 10], re: f0s[f0s.count / 10]), "cents")
+                }
+                add("voiced_fraction", BakeoffMetrics.voicedFraction(tr), "frac")
+                let env = PitchMetrics.envelopeDB(y, sampleRate: sr)
+                let cmp = PitchMetrics.envelopeCompare(f: env.f, source: ref.envelope.e, output: env.e)
+                add("env_warp", cmp.warp, "x")
+                add("env_lsd_db", cmp.lsd, "dB")
+                add("env_lsd_warped_db", cmp.lsdAtWarp, "dB")
+                gate(PitchGates.warp(alpha: cmp.warp, pitchFactor: pf, gamma: gamma))
+                if let letter = source.letter { gate(PitchGates.envelopeLSD(cmp.lsd, letter: letter, cents: Int(c))) }
+                add("env_lsd_frame_db", PitchMetrics.framewiseEnvelopeLSD(source: ref.steady, output: y, sampleRate: sr), "dB")
+                if let p = PitchMetrics.perturbation(y, sampleRate: sr) {
+                    add("jitter_pct", p.jitterPct, "%")
+                    add("shimmer_pct", p.shimmerPct, "%")
+                    if let s = ref.perturbation {
+                        add("jitter_ratio", p.jitterPct / s.jitterPct, "x")
+                        add("shimmer_ratio", p.shimmerPct / s.shimmerPct, "x")
+                        gate(PitchGates.microVariation("jitter_ratio", ratio: p.jitterPct / s.jitterPct))
+                        gate(PitchGates.microVariation("shimmer_ratio", ratio: p.shimmerPct / s.shimmerPct))
+                    }
+                }
+            } else {
+                // F: candidate A's region and definitions.
+                let y = x[frame(0.3)..<frame(2.4)]
+                let level = PitchMetrics.rmsDB(y)
+                add("level_db", level, "dBFS")
+                if c == 0 { ref.zeroLevels[key] = level }
+                let hop = PitchMetrics.unvoicedHop(sampleRate: sr)
+                let wobble = PitchMetrics.grainRateWobble(y, period: hop)
+                add("f_wobble_db", wobble, "dB")
+                if c != 0 { gate(PitchGates.fWobble(wobble)) }
+                if let z = ref.zeroLevels[key] {
+                    add("level_re_0c_db", level - z, "dB")
+                    if c != 0 { gate(PitchGates.fLevel(reZeroDB: level - z, cents: c)) }
+                }
+                if c != 0 {
+                    let acf = PitchMetrics.acf(y, lag: PitchMetrics.combLag(hop: hop, pitchFactor: pf))
+                    add("f_comb_acf", acf, "r")
+                    if c > 0 { gate(PitchGates.fComb(acf)) }
+                }
+                let env = PitchMetrics.envelopeDB(y, sampleRate: sr)
+                let cmp = PitchMetrics.envelopeCompare(f: env.f, source: ref.envelope.e, output: env.e, lo: 500, hi: 16000)
+                add("env_warp", cmp.warp, "x")
+                add("env_lsd_db", cmp.lsd, "dB")
+            }
+
+        case .pitchStepRated(let a, let b, let at, _):
+            let stepFrame = BakeoffRunner.appliedFrame(at, sampleRate: sr)
+            let stepT = Double(stepFrame) / sr
+            if ref.isVoiced, let s = ref.f0 {
+                let tr = PitchMetrics.centsTrack(x, from: frame(0.1), to: x.count, ref: s, sampleRate: sr, hopSeconds: 0.001)
+                let series = tr.compactMap { p in p.v.map { (t: p.t, v: $0) } }
+                if let r = BakeoffMetrics.stepResponse(series, stepTime: stepT) {
+                    add("pitch_step_delay10_ms", r.delayTo10 * 1000, "ms")
+                    add("pitch_step_delay90_ms", r.delayTo90 * 1000, "ms")
+                    add("pitch_step_rise_ms", r.rise10to90 * 1000, "ms")
+                    gate(PitchGates.step90(ms: r.delayTo90 * 1000))
+                } else {
+                    gate(PitchGates.step90(ms: nil))
+                }
+                if let pre = PitchMetrics.median(series.filter { $0.t >= stepT - 0.3 && $0.t <= stepT - 0.05 }.map(\.v)) {
+                    add("cents_err_before_step", pre - Double(a), "cents")
+                }
+                if let post = PitchMetrics.median(series.filter { $0.t >= stepT + 0.4 && $0.t <= stepT + 0.75 }.map(\.v)) {
+                    add("cents_err_after_step", post - Double(b), "cents")
+                }
+            }
+            if let cr = PitchMetrics.localClickRatio(x, from: stepFrame - Int(0.05 * sr), to: stepFrame + Int(0.3 * sr),
+                                                     sampleRate: sr) {
+                add("step_click_ratio", cr, "x")
+                gate(PitchGates.clicks("step_click", ratio: cr))
+            }
+
+        case .pitchSweep(_, let commanded):
+            if let cr = PitchMetrics.localClickRatio(x, from: frame(0.05), to: frame(PitchScenarios.sweepSeconds - 0.05),
+                                                     sampleRate: sr) {
+                add("sweep_click_ratio", cr, "x")
+                gate(PitchGates.clicks("sweep_click", ratio: cr))
+            }
+            if ref.isVoiced, let s = ref.f0 {
+                let lag = trackingLag(x, from: frame(0.05), to: frame(PitchScenarios.sweepSeconds), ref: s, sr: sr,
+                                      commanded: commanded)
+                add("traj_pitch_lag_ms", lag.map { $0.lag * 1000 }, "ms")
+                add("traj_pitch_rms_cents", lag?.rmsAtLag, "cents")
+                gate(PitchGates.trajectoryLag(ms: lag.map { $0.lag * 1000 }))
+            }
+
+        case .trajectory(_, _, _, let commanded) where scenario.name.hasSuffix("_height"):
+            var worstClick = 0.0
+            var times: [Double] = [], measured: [Double?] = []
+            for iv in scenario.openIntervals {
+                let o = BakeoffRunner.appliedFrame(iv.open, sampleRate: sr)
+                let cl = min(x.count, BakeoffRunner.appliedFrame(iv.close, sampleRate: sr))
+                if let cr = PitchMetrics.localClickRatio(x, from: o + Int(0.03 * sr), to: cl - Int(0.01 * sr), sampleRate: sr) {
+                    worstClick = max(worstClick, cr)
+                }
+                if ref.isVoiced, let s = ref.f0 {
+                    for p in PitchMetrics.centsTrack(x, from: o, to: cl, ref: s, sampleRate: sr, hopSeconds: 0.0025) {
+                        times.append(p.t); measured.append(p.v)
+                    }
+                }
+            }
+            add("traj_click_ratio", worstClick, "x")
+            gate(PitchGates.clicks("traj_click", ratio: worstClick))
+            if ref.isVoiced {
+                let lag = BakeoffMetrics.trackingLag(times: times,
+                                                     commanded: { BakeoffScenarios.commanded(commanded, at: $0) },
+                                                     measured: measured)
+                add("traj_pitch_lag_ms", lag.map { $0.lag * 1000 }, "ms")
+                add("traj_pitch_rms_cents", lag?.rmsAtLag, "cents")
+                add("traj_pitch_rms_cents_zero_lag", lag?.rmsAtZero, "cents")
+                gate(PitchGates.trajectoryLag(ms: lag.map { $0.lag * 1000 }))
+            }
+
+        default:
+            break
+        }
+        return out
+    }
+
+    static func trackingLag(_ x: [Float], from: Int, to: Int, ref: Double, sr: Double,
+                            commanded: [(t: Double, v: Double)]) -> (lag: Double, rmsAtLag: Double, rmsAtZero: Double)? {
+        let tr = PitchMetrics.centsTrack(x, from: from, to: to, ref: ref, sampleRate: sr, hopSeconds: 0.0025)
+        return BakeoffMetrics.trackingLag(times: tr.map(\.t), commanded: { BakeoffScenarios.commanded(commanded, at: $0) },
+                                          measured: tr.map(\.v))
+    }
+}
diff --git a/PrimaeNativeTests/SonificationBakeoff/PitchScenarios.swift b/PrimaeNativeTests/SonificationBakeoff/PitchScenarios.swift
new file mode 100644
index 00000000..4dee08f6
--- /dev/null
+++ b/PrimaeNativeTests/SonificationBakeoff/PitchScenarios.swift
@@ -0,0 +1,120 @@
+// PitchScenarios.swift
+// PrimaeNativeTests — pitch bake-off harness, phase 2 (lane BENCH-P, 2026-11-23)
+//
+// The scenarios of BAKEOFF-PITCH.md section 4.1, for the five study phonemes
+// (A F I L M) at rates 0.5 / 1 / 2:
+//
+//   pitch_<c>@<r>            held pitch c in {-600, -300, 0, +300, +600} cents
+//   step_pitch_<a>to<b>@<r>  pitch step 0 -> +600, 0 -> -600, +600 -> -600 at 1.0 s
+//   sweep_pm600_0.75s@<r>    the phase-1 triangle (method/ours_driver_main.swift):
+//                            0 -> +600 (0.75 s) -> -600 (2.25 s) -> 0 (3.0 s),
+//                            cents written before every 256-frame buffer
+//   traj_<L>_height          the letter's strokes.json at child speed (200 pt/s),
+//                            120 Hz writes: height -> cents through the r26 mapping
+//                            (`PitchCoupling(scope: .both, spanCents: 1200)` for the
+//                            phoneme arm = `SpatialSonification.pitchCents(forNormalizedY:
+//                            spanCents: 1200)`, +-600), velocity -> rate through
+//                            `TouchDispatcher.mapVelocityToSpeed` (EMA alpha 0.22)
+//   gate_cycle               the r17 onset / re-onset scenario at 0 cents, rate 1
+//
+// The held, step and sweep scenarios open the gate at t = 0 (the first
+// buffer), as the phase-1 driver did, so `pitch_<c>@1` and `sweep_..@1` are
+// the WAVs `method/build_mushra.py` reads (`<L>__<c>c.wav`, `<L>__traj.wav`).
+
+import CoreGraphics
+import Foundation
+@testable import PrimaeNative
+
+enum PitchScenarios {
+
+    /// 0 first: the level-vs-cents rows are relative to the 0-cent render of the same candidate and rate.
+    static let cents: [Float] = [0, -600, -300, 300, 600]
+    static let rates: [Float] = [0.5, 1, 2]
+    static let heldSeconds = 2.5          // gate open 0 ... 2.5 s, then 0.3 s of tail (phase-1 driver)
+    static let tailSeconds = 0.3
+    /// Analysis region of a held render (phase-1 measure.py, LIVE methods).
+    static let heldRegion: (from: Double, to: Double) = (0.6, 2.4)
+    static let stepTime = 1.0
+    static let steps: [(from: Float, to: Float)] = [(0, 600), (0, -600), (600, -600)]
+    static let sweepSeconds = 3.0
+    static let sweepPeak: Float = 600
+    static let sweepRiseSeconds = 0.75
+    /// The r26 phoneme-arm coupling: both arms, one octave (+-600).
+    static let heightCoupling = PitchCoupling(scope: .both, spanCents: 1200)
+
+    static func label(_ v: Float) -> String { BakeoffScenarios.label(v) }
+    static func rateLabel(_ r: Float) -> String { String(format: "%g", Double(r)) }
+
+    /// The phase-1 triangle: cents at time t (seconds since the gate opened).
+    static func sweepCents(_ t: Double) -> Float {
+        let s = Double(sweepPeak) / sweepRiseSeconds   // 800 c/s
+        if t < sweepRiseSeconds { return Float(s * t) }
+        if t < sweepSeconds - sweepRiseSeconds { return Float(Double(sweepPeak) - s * (t - sweepRiseSeconds)) }
+        return Float(-Double(sweepPeak) + s * (t - (sweepSeconds - sweepRiseSeconds)))
+    }
+
+    static func held(cents c: Float, rate r: Float) -> BakeoffScenario {
+        BakeoffScenario(name: "pitch_\(label(c))@\(rateLabel(r))", family: .heldPitch(cents: c, rate: r),
+                        duration: heldSeconds + tailSeconds,
+                        events: [.init(time: 0, kind: .rate(r)), .init(time: 0, kind: .cents(c)),
+                                 .init(time: 0, kind: .gate(true)), .init(time: heldSeconds, kind: .gate(false))])
+    }
+
+    static func step(from a: Float, to b: Float, rate r: Float) -> BakeoffScenario {
+        BakeoffScenario(name: "step_pitch_\(label(a))to\(label(b))@\(rateLabel(r))",
+                        family: .pitchStepRated(from: a, to: b, at: stepTime, rate: r), duration: stepTime + 1.0,
+                        events: [.init(time: 0, kind: .rate(r)), .init(time: 0, kind: .cents(a)),
+                                 .init(time: 0, kind: .gate(true)), .init(time: stepTime, kind: .cents(b))])
+    }
+
+    static func sweep(rate r: Float, sampleRate: Double) -> BakeoffScenario {
+        var events: [BakeoffEvent] = [.init(time: 0, kind: .rate(r)), .init(time: 0, kind: .gate(true))]
+        var curve: [(t: Double, v: Double)] = []
+        let dt = Double(BakeoffRunner.bufferFrames) / sampleRate
+        var k = 0
+        while Double(k) * dt < sweepSeconds {
+            // Exactly at a buffer start, so it lands before that buffer (as the phase-1 driver set it).
+            let t = Double(k * BakeoffRunner.bufferFrames) / sampleRate
+            let c = sweepCents(t)
+            events.append(.init(time: t, kind: .cents(c)))
+            curve.append((t, Double(c)))
+            k += 1
+        }
+        events.append(.init(time: sweepSeconds, kind: .gate(false)))
+        return BakeoffScenario(name: "sweep_pm600_0.75s@\(rateLabel(r))", family: .pitchSweep(rate: r, commandedCents: curve),
+                               duration: sweepSeconds + tailSeconds, events: events)
+    }
+
+    static let gateCycle = BakeoffScenario(
+        name: "gate_cycle", family: .gateCycle, duration: 1.5,
+        events: [.init(time: 0, kind: .rate(1)), .init(time: 0, kind: .cents(0)),
+                 .init(time: BakeoffScenarios.gateOpenTime, kind: .gate(true)),
+                 .init(time: 0.55, kind: .gate(false)), .init(time: 0.75, kind: .gate(true)),
+                 .init(time: 1.25, kind: .gate(false))])
+
+    /// The pen tracing `letter` at child speed with the r26 height coupling (phoneme arm).
+    static func heightTrajectory(letter: String, strokes: LetterStrokes) -> BakeoffScenario {
+        let base = BakeoffScenarios.trajectory(letter: letter, strokes: strokes, profile: .steady, drivePitch: false,
+                                               centsForY: { y in
+            heightCoupling.cents(forNormalizedY: CGFloat(y), arm: .phoneme) ?? 0
+        })
+        return BakeoffScenario(name: "traj_\(letter)_height", family: base.family, duration: base.duration,
+                               events: base.events)
+    }
+
+    /// Every pitch scenario for one phoneme source (`letter` drives its own trajectory).
+    static func standard(letter: String?, sampleRate: Double, rates: [Float] = PitchScenarios.rates,
+                         includeTrajectory: Bool = true) throws -> [BakeoffScenario] {
+        var out: [BakeoffScenario] = []
+        for r in rates {
+            for c in cents { out.append(held(cents: c, rate: r)) }
+            for s in steps { out.append(step(from: s.from, to: s.to, rate: r)) }
+            out.append(sweep(rate: r, sampleRate: sampleRate))
+        }
+        out.append(gateCycle)
+        if includeTrajectory, let letter {
+            out.append(heightTrajectory(letter: letter, strokes: try BakeoffSources.strokes(letter: letter)))
+        }
+        return out
+    }
+}
diff --git a/PrimaeNativeTests/SonificationBakeoff/SonificationBakeoffBench.swift b/PrimaeNativeTests/SonificationBakeoff/SonificationBakeoffBench.swift
new file mode 100644
index 00000000..63f2fd64
--- /dev/null
+++ b/PrimaeNativeTests/SonificationBakeoff/SonificationBakeoffBench.swift
@@ -0,0 +1,182 @@
+// SonificationBakeoffBench.swift
+// PrimaeNativeTests — sonification bake-off harness (BENCH lane 2026-11-02; pitch phase 2, lane BENCH-P 2026-11-23)
+//
+// THE BENCH. Opt-in: it runs only when the test process has `PRIMAE_BAKEOFF`
+// in its environment, so an ordinary suite run (CI, a device run of the
+// whole target) skips it. With `xcodebuild test-without-building` the
+// variable goes into the .xctestrun file (BENCH-P.md has the exact plutil +
+// pull commands).
+//
+//   pitch        phase 2 (BAKEOFF-PITCH section 4): the five study phonemes x
+//                PitchScenarios.standard (held / steps / sweep at rates 0.5, 1, 2,
+//                gate cycle, height trajectory), 44.1 kHz, every registered
+//                candidate; metric rows, gate rows and the MUSHRA renders.
+//   pitch-quick  the same, rate 1 only, A and F only.
+//   full, quick  the r17 time-stretch scenarios (rates, rate steps, gate cycle,
+//                trajectories; carrier pitch), now at 44.1 kHz only and without the
+//                AppleTimePitch-o32 reference (not re-applied, see BENCH-P.md).
+//
+// Optional `PRIMAE_BAKEOFF_CANDIDATES` = comma-separated candidate names.
+//
+// Output, in the test host's container, Documents/bakeoff/:
+//   bench.csv      candidate,source,kind,sample_rate,scenario,metric,value,unit
+//   gates.csv      candidate,source,scenario,gate,value,threshold,pass   (pitch modes)
+//   run_info.json  device, OS, build flavour, mode, candidates, timings
+//   renders/<candidate>/<L>__<cents>c.wav, <L>__traj.wav (the phase-1 sweep), <L>__height.wav
+//                  (pitch modes; rate 1; times the file's loudness gain, float32: method/build_mushra.py reads them)
+//   wav/<scenario>/<source>/<candidate>.wav     (r17 modes)
+// bench.csv and gates.csv are also attached to the xcresult.
+
+import XCTest
+@testable import PrimaeNative
+
+final class SonificationBakeoffBench: XCTestCase {
+
+    @MainActor
+    func testRunBench() throws {
+        let env = ProcessInfo.processInfo.environment
+        guard let mode = env["PRIMAE_BAKEOFF"], ["pitch", "pitch-quick", "full", "quick"].contains(mode) else {
+            throw XCTSkip("bench is opt-in: set PRIMAE_BAKEOFF=pitch|pitch-quick|full|quick in the test environment")
+        }
+        let filter = env["PRIMAE_BAKEOFF_CANDIDATES"].map {
+            Set($0.split(separator: ",").map { $0.trimmingCharacters(in: .whitespaces) })
+        }
+        let candidates = BakeoffCandidates.all.filter { filter?.contains($0.name) ?? true }
+        XCTAssertFalse(candidates.isEmpty, "no registered candidate matches PRIMAE_BAKEOFF_CANDIDATES")
+
+        let docs = try FileManager.default.url(for: .documentDirectory, in: .userDomainMask,
+                                               appropriateFor: nil, create: true)
+        let root = docs.appendingPathComponent("bakeoff", isDirectory: true)
+        try? FileManager.default.removeItem(at: root)
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)
+        let started = Date()
+        let csvURL = root.appendingPathComponent("bench.csv")
+        let gatesURL = root.appendingPathComponent("gates.csv")
+
+        if mode.hasPrefix("pitch") {
+            try runPitch(quick: mode == "pitch-quick", candidates: candidates, root: root, csvURL: csvURL,
+                         gatesURL: gatesURL)
+        } else {
+            try runR17(quick: mode == "quick", candidates: candidates, root: root, csvURL: csvURL)
+        }
+
+        var machine = utsname()
+        uname(&machine)
+        let model = withUnsafeBytes(of: &machine.machine) { String(decoding: $0.prefix { $0 != 0 }, as: UTF8.self) }
+        #if DEBUG
+        let flavour = "DEBUG (-Onone test target; candidate module per its own configuration)"
+        #else
+        let flavour = "non-DEBUG (optimised)"
+        #endif
+        let info: [String: Any] = [
+            "date": ISO8601DateFormatter().string(from: started),
+            "seconds": Date().timeIntervalSince(started),
+            "mode": mode,
+            "device": model,
+            "os": ProcessInfo.processInfo.operatingSystemVersionString,
+            "build": flavour,
+            "candidates": candidates.map(\.name),
+            "buffer_frames": BakeoffRunner.bufferFrames,
+            "sample_rate": LiveSonificationKernel.sampleRate,
+        ]
+        try JSONSerialization.data(withJSONObject: info, options: [.prettyPrinted, .sortedKeys])
+            .write(to: root.appendingPathComponent("run_info.json"))
+
+        for url in [csvURL, gatesURL] where FileManager.default.fileExists(atPath: url.path) {
+            let attachment = XCTAttachment(contentsOfFile: url)
+            attachment.name = url.lastPathComponent
+            attachment.lifetime = .keepAlways
+            add(attachment)
+        }
+        print("BAKEOFF wrote \(root.path) in \(Int(Date().timeIntervalSince(started))) s")
+    }
+
+    /// The MUSHRA file name of a rate-1 pitch render, or nil when the scenario is not exported.
+    static func renderName(scenario: BakeoffScenario, letter: String) -> String? {
+        switch scenario.family {
+        case .heldPitch(let c, let r) where r == 1:
+            return c == 0 ? "\(letter)__0c.wav" : "\(letter)__\(String(format: "%+d", Int(c)))c.wav"
+        case .pitchSweep(let r, _) where r == 1:
+            return "\(letter)__traj.wav"
+        case .trajectory where scenario.name.hasSuffix("_height"):
+            return "\(letter)__height.wav"
+        default:
+            return nil
+        }
+    }
+
+    @MainActor
+    private func runPitch(quick: Bool, candidates: [BakeoffCandidate], root: URL, csvURL: URL, gatesURL: URL) throws {
+        var csv = BakeoffRow.header + "\n"
+        var gates = PitchGateRow.header + "\n"
+        let letters = quick ? ["A", "F"] : TrainedLetterSubset.studyLetters
+        let sources = try BakeoffSources.pitchSources(letters: letters)
+        for source in sources {
+            let ref = PitchSourceRef(source)
+            csv += BakeoffRow(candidate: "Source", source: source.name, kind: source.kindLabel,
+                              sampleRate: Int(source.sampleRate), scenario: "-", metric: "voiced_fraction",
+                              value: source.voicedFraction, unit: "frac").csv + "\n"
+            if let f0 = ref.f0 {
+                csv += BakeoffRow(candidate: "Source", source: source.name, kind: source.kindLabel,
+                                  sampleRate: Int(source.sampleRate), scenario: "-", metric: "f0_hz",
+                                  value: f0, unit: "Hz").csv + "\n"
+            }
+            if let p = ref.perturbation {
+                for (m, v) in [("jitter_pct", p.jitterPct), ("shimmer_pct", p.shimmerPct)] {
+                    csv += BakeoffRow(candidate: "Source", source: source.name, kind: source.kindLabel,
+                                      sampleRate: Int(source.sampleRate), scenario: "-", metric: m,
+                                      value: v, unit: "%").csv + "\n"
+                }
+            }
+            let scenarios = try PitchScenarios.standard(letter: source.letter, sampleRate: source.sampleRate,
+                                                        rates: quick ? [1] : PitchScenarios.rates)
+            for scenario in scenarios {
+                let sourceRef = BakeoffRunner.sourceReference(source: source, scenario: scenario)
+                for candidate in candidates {
+                    let render = BakeoffRunner.render(candidate, source: source, scenario: scenario)
+                    let r17 = BakeoffRunner.metrics(candidate: candidate.name, render: render, source: source,
+                                                    scenario: scenario, sourceRef: sourceRef, reference: nil)
+                    let pitch = PitchRunner.rows(candidate: candidate.name, render: render, ref: ref, scenario: scenario)
+                    for row in r17 + pitch.rows { csv += row.csv + "\n" }
+                    for g in pitch.gates { gates += g.csv + "\n" }
+                    if let letter = source.letter, let name = Self.renderName(scenario: scenario, letter: letter) {
+                        try BakeoffWAV.writeFloat(render.samples.map { $0 * source.gain }, sampleRate: source.sampleRate,
+                                                  to: root.appendingPathComponent("renders/\(candidate.name)/\(name)"))
+                    }
+                }
+            }
+            // Flush per source so a killed run still leaves data.
+            try csv.write(to: csvURL, atomically: true, encoding: .utf8)
+            try gates.write(to: gatesURL, atomically: true, encoding: .utf8)
+        }
+    }
+
+    private func runR17(quick: Bool, candidates: [BakeoffCandidate], root: URL, csvURL: URL) throws {
+        var csv = BakeoffRow.header + "\n"
+        let sr = LiveSonificationKernel.sampleRate
+        var sources = try BakeoffSources.all(sampleRate: sr)
+        if quick { sources = sources.filter { ["A_phoneme1", "F_phoneme1", "spatial_carrier", "probe_sweep"].contains($0.name) } }
+        for source in sources {
+            let trajLetters = quick ? ["A"] : TrainedLetterSubset.studyLetters
+            var scenarios = try BakeoffScenarios.standard(for: source, includeTrajectories: true,
+                                                          trajectoryLetters: trajLetters)
+            if quick && source.kind != .carrier {
+                scenarios = scenarios.filter { !$0.name.hasPrefix("traj_") || $0.name.hasPrefix("traj_A_") }
+            }
+            for scenario in scenarios {
+                let sourceRef = BakeoffRunner.sourceReference(source: source, scenario: scenario)
+                try BakeoffWAV.write(sourceRef.samples, sampleRate: sr,
+                                     to: root.appendingPathComponent("wav/\(scenario.name)/\(source.name)/Source.wav"))
+                for candidate in candidates {
+                    let render = BakeoffRunner.render(candidate, source: source, scenario: scenario)
+                    let rows = BakeoffRunner.metrics(candidate: candidate.name, render: render, source: source,
+                                                     scenario: scenario, sourceRef: sourceRef, reference: nil)
+                    for row in rows { csv += row.csv + "\n" }
+                    try BakeoffWAV.write(render.samples, sampleRate: sr, to: root.appendingPathComponent(
+                        "wav/\(scenario.name)/\(source.name)/\(candidate.name).wav"))
+                }
+            }
+            try csv.write(to: csvURL, atomically: true, encoding: .utf8)
+        }
+    }
+}
