+// WorldCheapTrick.swift
+// PrimaeNative — pitch bake-off phase 2, candidate C2 "WorldRT" (2026-11-23)
+//
+// A Swift port of WORLD's CheapTrick spectral-envelope estimator (`cheaptrick.cpp`,
+// https://github.com/mmorise/World at commit c794856b537758a3d300757db2e5e31685a822c2;
+// M. Morise, "CheapTrick, a spectral envelope estimator for high-quality speech
+// synthesis", Speech Communication 67, 2015). Function for function, same order of
+// operations, double precision, the same deterministic `randn` safeguard noise.
+// Init-time only.
+//
+// Copyright (c) 2010  M. Morise. All rights reserved.
+// Redistribution and use in source and binary forms, with or without modification, are
+// permitted provided that the conditions of the modified-BSD licence reproduced in full in
+// `WorldCommon.swift` are met (retain this notice; reproduce it in binary distributions'
+// documentation; no endorsement by the author's name). THIS SOFTWARE IS PROVIDED BY THE
+// COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES ARE
+// DISCLAIMED (full text in `WorldCommon.swift`).
+
+import Foundation
+
+nonisolated final class WorldCheapTrick {
+    let fs: Double
+    let fftSize: Int
+    let q1: Double
+    let f0Floor: Double
+    private let forward: WorldRealFFT
+    private let inverse: WorldRealFFT
+    private var randn = WorldCommon.Randn()
+
+    init(fs: Double, q1: Double = WorldConstants.cheapTrickQ1, fftSize: Int? = nil) {
+        self.fs = fs
+        self.q1 = q1
+        self.fftSize = fftSize ?? WorldCommon.cheapTrickFFTSize(fs: fs)
+        f0Floor = WorldCommon.cheapTrickF0Floor(fs: fs, fftSize: self.fftSize)
+        forward = WorldRealFFT(size: self.fftSize)
+        inverse = WorldRealFFT(size: self.fftSize)
+    }
+
+    /// `CheapTrick`: one envelope (power, bins 0...N/2) per (position s, f0 Hz). `f0 <= floor` -> kDefaultF0, as WORLD.
+    /// The `randn` state runs on across frames in call order, as in one WORLD `CheapTrick` call.
+    func envelopes(_ x: [Double], positions: [Double], f0: [Double]) -> [[Double]] {
+        randn = WorldCommon.Randn()
+        var out: [[Double]] = []
+        out.reserveCapacity(positions.count)
+        for i in 0..<positions.count {
+            let current = f0[i] <= f0Floor ? WorldConstants.kDefaultF0 : f0[i]
+            out.append(generalBody(x, f0: current, position: positions[i]))
+        }
+        return out
+    }
+
+    /// `CheapTrickGeneralBody`.
+    func generalBody(_ x: [Double], f0: Double, position: Double) -> [Double] {
+        getWindowedWaveform(x, f0: f0, position: position)
+        getPowerSpectrum(f0: f0)
+        forward.waveform.withUnsafeMutableBufferPointer { w in
+            WorldCommon.linearSmoothing(w.baseAddress!, width: f0 * 2.0 / 3.0, fs: fs, fftSize: fftSize,
+                                        output: w.baseAddress!)
+        }
+        // AddInfinitesimalNoise
+        for i in 0...(fftSize / 2) { forward.waveform[i] += abs(randn.next()) * WorldConstants.kEps }
+        return smoothingWithRecovery(f0: f0)
+    }
+
+    /// `GetWindowedWaveform` + `SetParametersForGetWindowedWaveform`: Hann over 3 periods, unit energy, DC-free.
+    private func getWindowedWaveform(_ x: [Double], f0: Double, position: Double) {
+        let half = WorldCommon.matlabRound(1.5 * fs / f0)
+        let len = half * 2 + 1
+        let origin = WorldCommon.matlabRound(position * fs + 0.001)
+        var window = [Double](repeating: 0, count: len)
+        var average = 0.0
+        for i in 0..<len {
+            let pos = Double(i - half) / 1.5 / fs
+            window[i] = 0.5 * cos(WorldConstants.kPi * pos * f0) + 0.5
+            average += window[i] * window[i]
+        }
+        average = average.squareRoot()
+        for i in 0..<len { window[i] /= average }
+        var w1 = 0.0, w2 = 0.0
+        for i in 0..<len {
+            let safe = min(x.count - 1, max(0, origin + i - half))
+            forward.waveform[i] = x[safe] * window[i] + randn.next() * WorldConstants.kMySafeGuardMinimum
+            w1 += forward.waveform[i]; w2 += window[i]
+        }
+        let coef = w1 / w2
+        for i in 0..<len { forward.waveform[i] -= window[i] * coef }
+        // GetPowerSpectrum zeroes the rest.
+        for i in len..<fftSize { forward.waveform[i] = 0 }
+    }
+
+    /// `GetPowerSpectrum`: |FFT|^2 with DC correction; written into `forward.waveform[0...N/2]` as WORLD does.
+    private func getPowerSpectrum(f0: Double) {
+        forward.forward()
+        for i in 0...(fftSize / 2) {
+            forward.waveform[i] = forward.specRe[i] * forward.specRe[i] + forward.specIm[i] * forward.specIm[i]
+        }
+        forward.waveform.withUnsafeMutableBufferPointer { w in
+            WorldCommon.dcCorrection(w.baseAddress!, f0: f0, fs: fs, fftSize: fftSize)
+        }
+    }
+
+    /// `SmoothingWithRecovery`: log, cepstrum, smoothing lifter x compensation lifter (q0 = 1 - 2 q1, q1), back.
+    private func smoothingWithRecovery(f0: Double) -> [Double] {
+        let h = fftSize / 2
+        var smoothing = [Double](repeating: 0, count: h + 1)
+        var compensation = [Double](repeating: 0, count: h + 1)
+        smoothing[0] = 1
+        compensation[0] = (1.0 - 2.0 * q1) + 2.0 * q1
+        for i in 1...h {
+            let quefrency = Double(i) / fs
+            smoothing[i] = sin(WorldConstants.kPi * f0 * quefrency) / (WorldConstants.kPi * f0 * quefrency)
+            compensation[i] = (1.0 - 2.0 * q1) + 2.0 * q1 * cos(2.0 * WorldConstants.kPi * quefrency * f0)
+        }
+        for i in 0...h { forward.waveform[i] = log(forward.waveform[i]) }
+        for i in 1..<h { forward.waveform[fftSize - i] = forward.waveform[i] }
+        forward.forward()
+        for i in 0...h {
+            inverse.specRe[i] = forward.specRe[i] * smoothing[i] * compensation[i] / Double(fftSize)
+            inverse.specIm[i] = 0
+        }
+        inverse.inverse()
+        var envelope = [Double](repeating: 0, count: h + 1)
+        for i in 0...h { envelope[i] = exp(inverse.waveform[i]) }
+        return envelope
+    }
+
+    /// The two lifters for one f0 (exposed for the constant-pinning test).
+    static func lifters(f0: Double, fs: Double, fftSize: Int, q1: Double) -> (smoothing: [Double], compensation: [Double]) {
+        let h = fftSize / 2
+        var s = [Double](repeating: 1, count: h + 1), c = [Double](repeating: 0, count: h + 1)
+        c[0] = (1.0 - 2.0 * q1) + 2.0 * q1
+        for i in 1...h {
+            let q = Double(i) / fs
+            s[i] = sin(WorldConstants.kPi * f0 * q) / (WorldConstants.kPi * f0 * q)
+            c[i] = (1.0 - 2.0 * q1) + 2.0 * q1 * cos(2.0 * WorldConstants.kPi * q * f0)
+        }
+        return (s, c)
+    }
+}
