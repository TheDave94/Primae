+import Accelerate
+import Foundation
+import Synchronization
+
+/// WorldRT's knobs. Every one is a tuning flag the bench can A/B (BAKEOFF-PITCH.md section 2 C2).
+nonisolated struct WorldRTTuning: Sendable, Equatable {
+    /// One-pole time constant of the rate and pitch smoothing, seconds (the shipped r17 value).
+    var smoothingSeconds: Double = 0.002
+    /// Linear gate ramp, seconds (the shipped value).
+    var gateRampSeconds: Double = 0.002
+    /// Gain on the source's own period-to-period deviation carried into the pulse intervals (0 = WORLD's smooth F0).
+    var jitterCarry: Double = 0.8
+    /// Exponent on the source's own per-period relative peak amplitude applied to each pulse (0 = off).
+    var shimmerCarry: Double = 0.5
+    /// Partial formant co-shift: envelope and aperiodicity are read at f / pf^gamma (0 = strict preservation).
+    var gamma: Double = 0
+    /// Parameter-domain loop crossfade, seconds (capped by the material before the loop start).
+    var seamSeconds: Double = 0.1
+    /// Attack -> vocoder crossfade after the loop start, in source periods.
+    var handoverPeriods: Double = 2
+    /// true: vocode from the third mark (only the pre-voicing samples play as recorded).
+    var vocodedAttack: Bool = false
+    /// Scale the vocoder so that its 0-cent, rate-1 loop level equals the source's (measured once at init over the
+    /// first `calibrationSeconds` after the hand-over). WORLD's resynthesis of the study phonemes is +0.3..+2.1 dB
+    /// louder than the source (MEASURED, phase-1 offline WORLD and this port alike); uncalibrated, that is a step at
+    /// the attack hand-over and a loudness offset against the per-file gains (AE-2), which assume the source level.
+    var levelCalibration: Bool = true
+    var calibrationSeconds: Double = 0.5
+    /// P4 knob. Keep the periodic part's power constant across the pitch shift: each pulse is scaled by
+    /// sqrt(f0 sum_h E(h f0) / (f0' sum_h E'(h f0'))), E = sp (1 - ap^2) at the source F0 and E' the (warped) envelope at
+    /// the shifted F0 (limited to +-6 dB). WORLD itself loses up to 4 dB at +600 cents on the study phonemes (MEASURED:
+    /// the harmonics move above the low first formant of I/M and sample less of the envelope's energy). false = WORLD.
+    var pitchLevelCompensation: Bool = true
+
+    static let `default` = WorldRTTuning()
+}
+
+nonisolated final class WorldRT: SonificationRenderer, @unchecked Sendable {
+    static var candidateName: String { "WorldRT" }
+
+    enum Mode: Sendable { case vocoder, resample, carrier }
+
+    let kind: SourceKind
+    let mode: Mode
+    let tuning: WorldRTTuning
+    let sampleRate: Double
+    let maxFramesPerRender: Int
+    /// The mark analysis shared with TDPSOLA (exposed for tests and the bench).
+    let marks: TDPSOLAAnalysis
+    /// The source-filter analysis (vocoder mode only).
+    let world: WorldRTAnalysis?
+
+    // MARK: parameters (any thread)
+    private let rateBits = Atomic<UInt32>(Float(1).bitPattern)
+    private let centsBits = Atomic<UInt32>(Float(0).bitPattern)
+    private let gateBits = Atomic<UInt32>(0)
+    private let resetToken = Atomic<UInt32>(0)
+
+    private struct State {
+        var playing = false
+        var now = 0                // output samples since the gate opened from silence
+        var tau = 0.0              // parameter read-head (source samples)
+        var rate: Float = 1
+        var cents: Float = 0
+        var gateGain: Float = 0
+        var gateTarget: Float = 0
+        var nextPulse = 0.0        // output time of the next pulse
+        var pulseCount = 0
+        var noiseIndex = 0
+        var markCursor = 0
+        var appliedReset: UInt32 = 0
+        var lastInterval = 0.0
+        var intervalSum = 0.0
+    }
+    private let state: UnsafeMutablePointer<State>
+
+    // Shared
+    private static let guardFrames = 4096
+    private let srcBase: UnsafeMutablePointer<Float>    // the prepared (TDPSOLA-identical) copy, guard zeros around
+    private let src: UnsafeMutablePointer<Float>
+    private let count: Int
+    private let smoothCoef: Float
+    private let gateStep: Float
+    private let onsetFrame: Int
+    private let loopStart: Double
+    private let loopEnd: Double
+    private let loopLen: Double
+
+    // Vocoder
+    private let n: Int                  // FFT size
+    private let bins: Int
+    private let log2n: vDSP_Length
+    private let fftSetup: FFTSetup
+    private let frameSamples: Double
+    private let frameCount: Int
+    private let sp: UnsafeMutablePointer<Float>        // frames x bins
+    private let ap: UnsafeMutablePointer<Float>        // frames x bins, already GetSafeAperiodicity-clamped
+    private let f0Frames: UnsafeMutablePointer<Double>
+    private let markPos: UnsafeMutablePointer<Double>
+    private let markJitter: UnsafeMutablePointer<Double>
+    private let markShimmer: UnsafeMutablePointer<Double>
+    private let markCount: Int
+    private let fallbackF0: Double
+    private let handoverOut: Int      // output time where the attack hands over (H - onset)
+    private let handoverLen: Int
+    private let firstPulseOut: Double
+    private let firstPulseMark: Int
+    /// The loop's first and last mark: the jitter/shimmer walk wraps between them.
+    private let loopFirstMark: Int
+    private let loopLastMark: Int
+    private let seamLen: Double
+    private let maxPeriod: Double
+    /// `levelCalibration`'s gain (1 when off); the vocoder output is scaled by it.
+    private(set) var calibrationGain: Float = 1
+    // scratch (render thread)
+    private let wSp: UnsafeMutablePointer<Float>, wAp: UnsafeMutablePointer<Float>
+    private let tSp: UnsafeMutablePointer<Float>, tAp: UnsafeMutablePointer<Float>
+    private let logP: UnsafeMutablePointer<Float>, logA: UnsafeMutablePointer<Float>
+    private let hpRe: UnsafeMutablePointer<Float>, hpIm: UnsafeMutablePointer<Float>
+    private let haRe: UnsafeMutablePointer<Float>, haIm: UnsafeMutablePointer<Float>
+    private let nzRe: UnsafeMutablePointer<Float>, nzIm: UnsafeMutablePointer<Float>
+    private let timeBuf: UnsafeMutablePointer<Float>
+    private let splitRe: UnsafeMutablePointer<Float>, splitIm: UnsafeMutablePointer<Float>
+    private let mag: UnsafeMutablePointer<Float>, sinB: UnsafeMutablePointer<Float>, cosB: UnsafeMutablePointer<Float>
+    private let dcRemRe: UnsafeMutablePointer<Float>, dcRemIm: UnsafeMutablePointer<Float>
+    private let taper: UnsafeMutablePointer<Float>
+    private static let keep = 1024
+    private static let taperLen = 128
+    private static let ringSize = 4096
+    private let ring: UnsafeMutablePointer<Float>
+    private static let noiseLen = 1 << 16
+    private let noise: UnsafeMutablePointer<Float>
+
+    // Resample (F)
+    private static let sincZeros = 8
+    private static let sincRes = 256
+    private let sincTable: UnsafeMutablePointer<Float>
+    private let readHi: Double
+
+    // Carrier
+    private let carrier: TDPSOLA?
+
+    convenience init(source: [Float], sampleRate: Double, kind: SourceKind, maxFramesPerRender: Int) {
+        self.init(source: source, sampleRate: sampleRate, kind: kind, maxFramesPerRender: maxFramesPerRender,
+                  tuning: .default)
+    }
+
+    /// `onset`/`outputGain` as TDPSOLA's (the recorded attack is prepared exactly as the shipped renderer prepares it).
+    init(source: [Float], sampleRate: Double, kind: SourceKind, maxFramesPerRender: Int,
+         tuning: WorldRTTuning, onset: RecordedOnset? = nil, outputGain: Float = 1) {
+        self.kind = kind
+        self.tuning = tuning
+        self.sampleRate = sampleRate
+        self.maxFramesPerRender = maxFramesPerRender
+        let shipped = TDPSOLATuning.default
+        let a = TDPSOLAAnalysis.analyse(source, sampleRate: sampleRate, kind: kind,
+                                        unvoicedHopSeconds: shipped.unvoicedHopSeconds, onset: onset)
+        marks = a
+        let m: Mode = kind == .carrier ? .carrier : (a.isVoiced ? .vocoder : .resample)
+        mode = m
+        carrier = m == .carrier
+            ? TDPSOLA(source: source, sampleRate: sampleRate, kind: kind, maxFramesPerRender: maxFramesPerRender,
+                      tuning: shipped, onset: onset, outputGain: outputGain)
+            : nil
+
+        // The prepared copy, exactly as TDPSOLA.init builds it (SEAM2, TDQ, recorded onset, onset ceiling).
+        var played = source
+        var effLoopEnd = a.loopEnd
+        if kind != .carrier {
+            let preBlend = a.recordedOnset?.preBlendPeriods ?? TDPSOLALoopSeam.preBlendMarks
+            if let prep = TDPSOLALoopSeam.prepare(played, sampleRate: sampleRate, analysis: a,
+                                                  crossfade: shipped.loopCrossfadeSeconds,
+                                                  flattenDB: shipped.loopFlattenDB, preBlendMarks: preBlend) {
+                played = prep.samples; effLoopEnd = prep.loopEnd
+            }
+            let preTDQ = played
+            played = TDPSOLADeclick.process(played, sampleRate: sampleRate, analysis: a, cap: shipped.pulseCrestCap)
+            if a.recordedOnset != nil {
+                TDPSOLA.keepRecordedOnset(&played, preTDQ, a, preBlend: preBlend)
+                played = TDPSOLAOnsetCeiling.limit(played, gain: outputGain, ceiling: TDPSOLAOnsetCeiling.ceiling,
+                                                   taper: TDPSOLAOnsetCeiling.taperFrames(sampleRate: sampleRate),
+                                                   in: 0..<Int(a.loopStart))
+            }
+        }
+        count = source.count
+        let g = Self.guardFrames
+        srcBase = .allocate(capacity: count + 2 * g)
+        srcBase.initialize(repeating: 0, count: count + 2 * g)
+        src = srcBase + g
+        let srcPtr = src, nSrc = count
+        played.withUnsafeBufferPointer { b in if let p = b.baseAddress { srcPtr.update(from: p, count: nSrc) } }
+        readHi = Double(count) + Double(g - 4)
+        smoothCoef = tuning.smoothingSeconds > 0 ? Float(1 - exp(-1 / (tuning.smoothingSeconds * sampleRate))) : 1
+        gateStep = Float(1 / max(1, (tuning.gateRampSeconds * sampleRate).rounded()))
+        onsetFrame = a.onset
+        state = .allocate(capacity: 1)
+        state.initialize(to: State())
+
+        // Sinc table (r28 candidate A: Kaiser beta 8, 8 zero crossings, 256 per unit).
+        let tn = Self.sincZeros * Self.sincRes + 2
+        sincTable = .allocate(capacity: tn)
+        for i in 0..<tn {
+            let t = Double(i) / Double(Self.sincRes)
+            let r = t / Double(Self.sincZeros)
+            let sinc = t == 0 ? 1 : sin(Double.pi * t) / (Double.pi * t)
+            let win = r < 1 ? Self.besselI0(8 * (1 - r * r).squareRoot()) / Self.besselI0(8) : 0
+            (sincTable + i).initialize(to: Float(sinc * win))
+        }
+
+        // Vocoder state (allocated minimally for the other modes).
+        let w: WorldRTAnalysis? = m == .vocoder ? WorldRTAnalysis.analyse(source, sampleRate: sampleRate, marks: a) : nil
+        world = w
+        n = w?.fftSize ?? 2
+        bins = n / 2 + 1
+        log2n = vDSP_Length(max(1, Int(log2(Double(n)).rounded())))
+        fftSetup = vDSP_create_fftsetup(log2n, FFTRadix(kFFTRadix2))!
+        frameSamples = w?.frameSamples ?? 1
+        frameCount = w?.frameCount ?? 1
+        let fb = max(1, frameCount * bins)
+        sp = .allocate(capacity: fb); ap = .allocate(capacity: fb)
+        sp.initialize(repeating: 0, count: fb); ap.initialize(repeating: 1, count: fb)
+        f0Frames = .allocate(capacity: frameCount); f0Frames.initialize(repeating: 0, count: frameCount)
+        markCount = max(1, w?.marks.count ?? 1)
+        markPos = .allocate(capacity: markCount); markPos.initialize(repeating: 0, count: markCount)
+        markJitter = .allocate(capacity: markCount); markJitter.initialize(repeating: 0, count: markCount)
+        markShimmer = .allocate(capacity: markCount); markShimmer.initialize(repeating: 1, count: markCount)
+        if let w {
+            for i in 0..<(frameCount * bins) {
+                sp[i] = w.spectrogram[i]
+                ap[i] = Float(WorldCommon.safeAperiodicity(Double(w.aperiodicity[i])))
+            }
+            for k in 0..<frameCount { f0Frames[k] = w.f0[k] }
+            for i in 0..<w.marks.count {
+                markPos[i] = w.marks[i]; markJitter[i] = w.jitter[i]; markShimmer[i] = w.shimmer[i]
+            }
+        }
+        fallbackF0 = a.medianPeriod > 0 ? sampleRate / a.medianPeriod : 200
+        maxPeriod = a.periods.max() ?? 0
+
+        // Loop and attack hand-over.
+        if m == .vocoder {
+            loopStart = a.loopStart
+            loopEnd = a.loopEnd
+            let hMark = tuning.vocodedAttack ? min(2, a.attackIndex) : a.attackIndex
+            let h = a.marks[hMark]
+            let t = a.periods[hMark]
+            handoverOut = max(0, Int(h.rounded(.up)) - a.onset)   // every sample before it precedes the mark
+            handoverLen = max(1, Int((tuning.handoverPeriods * t).rounded()))
+            // First pulse: the mark about three periods before the hand-over, so the vocoder is settled there.
+            var k = hMark
+            while k > 0 && a.marks[k] > h - 3 * t { k -= 1 }
+            if a.marks[k] < Double(a.onset) { k = min(hMark, k + 1) }
+            firstPulseMark = k
+            loopFirstMark = a.attackIndex
+            loopLastMark = a.loopEndIndex
+            firstPulseOut = a.marks[k] - Double(a.onset)
+            let before = a.loopStart - a.marks[0] - 2 * frameSamples
+            seamLen = max(0, min(tuning.seamSeconds * sampleRate, before, 0.5 * (a.loopEnd - a.loopStart)))
+        } else {
+            loopStart = a.loopStart
+            loopEnd = effLoopEnd
+            handoverOut = 0; handoverLen = 1; firstPulseOut = 0; firstPulseMark = 0; seamLen = 0
+            loopFirstMark = 0; loopLastMark = 0
+        }
+        loopLen = max(1, loopEnd - loopStart)
+
+        func buf(_ c: Int) -> UnsafeMutablePointer<Float> {
+            let p = UnsafeMutablePointer<Float>.allocate(capacity: c); p.initialize(repeating: 0, count: c); return p
+        }
+        wSp = buf(bins); wAp = buf(bins); tSp = buf(bins); tAp = buf(bins)
+        logP = buf(bins); logA = buf(bins)
+        hpRe = buf(bins); hpIm = buf(bins); haRe = buf(bins); haIm = buf(bins); nzRe = buf(bins); nzIm = buf(bins)
+        timeBuf = buf(max(2, n)); splitRe = buf(max(1, n / 2)); splitIm = buf(max(1, n / 2))
+        mag = buf(bins); sinB = buf(bins); cosB = buf(bins)
+        dcRemRe = buf(bins); dcRemIm = buf(bins)
+        taper = buf(Self.taperLen)
+        for i in 0..<Self.taperLen { taper[i] = Float(0.5 + 0.5 * cos(Double.pi * (Double(i) + 0.5) / Double(Self.taperLen))) }
+        ring = buf(Self.ringSize)
+        noise = buf(m == .vocoder ? Self.noiseLen : 1)
+        if m == .vocoder {
+            // WORLD's randn, seeded as `randn_reseed`: one deterministic white-noise stream per renderer.
+            var r = WorldCommon.Randn()
+            for i in 0..<Self.noiseLen { noise[i] = Float(r.next()) }
+            // Causal DC remover: WORLD's `GetDCRemover` Hann, over the kept half, normalised to unit sum; its spectrum.
+            let k = Self.keep
+            var rem = [Double](repeating: 0, count: n)
+            var sum = 0.0
+            for i in 0..<k { rem[i] = 0.5 - 0.5 * cos(2.0 * Double.pi * (Double(i) + 1.0) / (Double(k) + 1.0)); sum += rem[i] }
+            for i in 0..<k { rem[i] /= sum }
+            for b in 0..<bins {
+                var re = 0.0, im = 0.0
+                for i in 0..<k {
+                    let ph = -2.0 * Double.pi * Double(b) * Double(i) / Double(n)
+                    re += rem[i] * cos(ph); im += rem[i] * sin(ph)
+                }
+                dcRemRe[b] = Float(re); dcRemIm[b] = Float(im)
+            }
+            if tuning.levelCalibration { calibrationGain = calibrate() }
+        }
+    }
+
+    /// `levelCalibration`: renders the vocoder at rate 1 / 0 cents (init, off the render thread) and returns
+    /// rms(source) / rms(vocoder) over the same source span after the hand-over. Leaves the renderer reset.
+    private func calibrate() -> Float {
+        let start = handoverOut + handoverLen + Int(0.02 * sampleRate)
+        let len = Int(tuning.calibrationSeconds * sampleRate)
+        let srcEnd = onsetFrame + start + len
+        guard len > 0, srcEnd < Int(loopEnd) else { return 1 }
+        let savedRate = rateBits.load(ordering: .relaxed), savedCents = centsBits.load(ordering: .relaxed)
+        rateBits.store(Float(1).bitPattern, ordering: .relaxed)
+        centsBits.store(Float(0).bitPattern, ordering: .relaxed)
+        gateBits.store(1, ordering: .relaxed)
+        let total = start + len
+        let out = UnsafeMutablePointer<Float>.allocate(capacity: total)
+        defer { out.deallocate() }
+        var pos = 0
+        while pos < total {
+            let m = min(256, total - pos)
+            render(into: out + pos, frames: m)
+            pos += m
+        }
+        var es = 0.0, ev = 0.0
+        for i in start..<total {
+            let a = Double(src[onsetFrame + i]), b = Double(out[i])
+            es += a * a; ev += b * b
+        }
+        reset()
+        gateBits.store(0, ordering: .relaxed)
+        rateBits.store(savedRate, ordering: .relaxed)
+        centsBits.store(savedCents, ordering: .relaxed)
+        // Apply the pending reset now so the next render starts clean.
+        state.pointee = State()
+        state.pointee.appliedReset = resetToken.load(ordering: .relaxed)
+        guard ev > 0, es > 0 else { return 1 }
+        return Float((es / ev).squareRoot())
+    }
+
+    deinit {
+        srcBase.deallocate(); state.deinitialize(count: 1); state.deallocate(); sincTable.deallocate()
+        vDSP_destroy_fftsetup(fftSetup)
+        sp.deallocate(); ap.deallocate(); f0Frames.deallocate()
+        markPos.deallocate(); markJitter.deallocate(); markShimmer.deallocate()
+        for p in [wSp, wAp, tSp, tAp, logP, logA, hpRe, hpIm, haRe, haIm, nzRe, nzIm, timeBuf, splitRe, splitIm,
+                  mag, sinB, cosB, dcRemRe, dcRemIm, taper, ring, noise] { p.deallocate() }
+    }
+
+    private static func besselI0(_ x: Double) -> Double {
+        var sum = 1.0, term = 1.0, k = 1.0
+        while term > 1e-12 * sum { term *= (x / (2 * k)) * (x / (2 * k)); sum += term; k += 1 }
+        return sum
+    }
+
+    // MARK: SonificationRenderer
+
+    func setRate(_ rate: Float) {
+        carrier?.setRate(rate)
+        rateBits.store(min(2, max(0.5, rate.isFinite ? rate : 1)).bitPattern, ordering: .relaxed)
+    }
+    func setPitchCents(_ cents: Float) {
+        carrier?.setPitchCents(cents)
+        centsBits.store(min(1200, max(-1200, cents.isFinite ? cents : 0)).bitPattern, ordering: .relaxed)
+    }
+    func setGate(_ open: Bool) {
+        carrier?.setGate(open)
+        gateBits.store(open ? 1 : 0, ordering: .relaxed)
+    }
+    func reset() {
+        carrier?.reset()
+        gateBits.store(0, ordering: .relaxed)
+        _ = resetToken.wrappingAdd(1, ordering: .relaxed)
+    }
+
+    /// Onset is immediate (the recorded attack). Pitch acts at the next pulse (<= one period, two at -1200 cents),
+    /// rate at the next sample's frame interpolation; plus the smoothing time constant.
+    var claimedLatencyFrames: Int {
+        if let carrier { return carrier.claimedLatencyFrames }
+        let smoothing = tuning.smoothingSeconds * sampleRate
+        if mode == .resample { return Int((Double(Self.sincZeros) * 2 + smoothing).rounded(.up)) }
+        return Int((2 * maxPeriod + smoothing).rounded(.up))
+    }
+
+    func render(into out: UnsafeMutablePointer<Float>, frames: Int) {
+        if let carrier { carrier.render(into: out, frames: frames); return }
+        let st = state
+        let token = resetToken.load(ordering: .relaxed)
+        if token != st.pointee.appliedReset {
+            st.pointee = State()
+            st.pointee.appliedReset = token
+        }
+        let gateOpen = gateBits.load(ordering: .relaxed) != 0
+        st.pointee.gateTarget = gateOpen ? 1 : 0
+        if gateOpen && !st.pointee.playing { startPlayback() }
+        guard st.pointee.playing else {
+            out.update(repeating: 0, count: frames)
+            return
+        }
+        if mode == .vocoder { renderVocoder(out, frames) } else { renderResample(out, frames) }
+    }
+
+    private func startPlayback() {
+        let st = state
+        st.pointee.playing = true
+        st.pointee.now = 0
+        st.pointee.tau = Double(onsetFrame)
+        st.pointee.rate = Float(bitPattern: rateBits.load(ordering: .relaxed))
+        st.pointee.cents = Float(bitPattern: centsBits.load(ordering: .relaxed))
+        st.pointee.nextPulse = firstPulseOut
+        st.pointee.pulseCount = 0
+        st.pointee.noiseIndex = 0
+        st.pointee.markCursor = firstPulseMark
+        st.pointee.lastInterval = 0
+        st.pointee.intervalSum = 0
+        ring.update(repeating: 0, count: Self.ringSize)
+    }
+
+    // MARK: vocoder
+
+    private func renderVocoder(_ out: UnsafeMutablePointer<Float>, _ frames: Int) {
+        let st = state
+        let coef = smoothCoef, step = gateStep
+        let rateTarget = Float(bitPattern: rateBits.load(ordering: .relaxed))
+        let centsTarget = Float(bitPattern: centsBits.load(ordering: .relaxed))
+        let gateTarget = st.pointee.gateTarget
+        var rate = st.pointee.rate, cents = st.pointee.cents
+        var gg = st.pointee.gateGain
+        var now = st.pointee.now
+        var tau = st.pointee.tau
+        let hOut = handoverOut, hLen = handoverLen, onset = onsetFrame
+        let mask = Self.ringSize - 1
+        let lEnd = loopEnd, lLen = loopLen
+        let calGain = calibrationGain
+        var playing = true
+        var i = 0
+        while i < frames {
+            if rate != rateTarget || cents != centsTarget {
+                rate += (rateTarget - rate) * coef
+                if abs(rateTarget - rate) < 1e-6 { rate = rateTarget }
+                cents += (centsTarget - cents) * coef
+                if abs(centsTarget - cents) < 1e-4 { cents = centsTarget }
+            }
+            while st.pointee.nextPulse < Double(now + 1) {
+                spawnPulse(at: st.pointee.nextPulse, now: now, tau: tau, cents: cents)
+            }
+            let v = ring[now & mask] * calGain
+            ring[now & mask] = 0
+            var y: Float
+            if now < hOut {
+                y = src[onset + now]
+            } else if now < hOut + hLen {
+                let u = (Double(now - hOut) + 0.5) / Double(hLen)
+                let wv = Float(0.5 - 0.5 * cos(Double.pi * u))
+                y = src[onset + now] * (1 - wv) + v * wv
+            } else {
+                y = v
+            }
+            if gg != gateTarget {
+                if gg < gateTarget { gg = min(gateTarget, gg + step) } else { gg = max(gateTarget, gg - step) }
+            }
+            out[i] = y * gg
+            if gg == 0 && gateTarget == 0 { playing = false }
+            // Parameter read-head: rate 1 through the attack, then at the rate.
+            tau += now < hOut ? 1 : Double(rate)
+            if tau >= lEnd { tau -= lLen }
+            now += 1
+            i += 1
+            if !playing {
+                if i < frames { (out + i).update(repeating: 0, count: frames - i) }
+                break
+            }
+        }
+        st.pointee.rate = rate
+        st.pointee.cents = cents
+        st.pointee.gateGain = gg
+        st.pointee.now = now
+        st.pointee.tau = tau
+        st.pointee.playing = playing
+    }
+
+    /// Envelope and (clamped) aperiodicity at source position `pos`, accumulated with weight `w` into wSp / wAp.
+    @inline(__always) private func accumulateFrames(_ pos: Double, _ w: Float) {
+        var fi = pos / frameSamples
+        if fi < 0 { fi = 0 }
+        let maxF = Double(frameCount - 1)
+        if fi > maxF { fi = maxF }
+        let k0 = Int(fi)
+        let k1 = min(frameCount - 1, k0 + 1)
+        var t = Float(fi - Double(k0))
+        let nb = vDSP_Length(bins)
+        vDSP_vintb(sp + k0 * bins, 1, sp + k1 * bins, 1, &t, tSp, 1, nb)
+        vDSP_vintb(ap + k0 * bins, 1, ap + k1 * bins, 1, &t, tAp, 1, nb)
+        var ww = w
+        vDSP_vsma(tSp, 1, &ww, wSp, 1, wSp, 1, nb)
+        vDSP_vsma(tAp, 1, &ww, wAp, 1, wAp, 1, nb)
+    }
+
+    @inline(__always) private func f0At(_ pos: Double) -> Double {
+        var fi = pos / frameSamples
+        if fi < 0 { fi = 0 }
+        let maxF = Double(frameCount - 1)
+        if fi > maxF { fi = maxF }
+        let k0 = Int(fi)
+        let k1 = min(frameCount - 1, k0 + 1)
+        let t = fi - Double(k0)
+        let a = f0Frames[k0], b = f0Frames[k1]
+        if a <= 0 && b <= 0 { return fallbackF0 }
+        if a <= 0 { return b }
+        if b <= 0 { return a }
+        return a + (b - a) * t
+    }
+
+    /// Envelope and aperiodicity (amplitude) at the read-head into wSp / wAp, with the parameter-domain loop seam:
+    /// over the last `seamLen` before the loop end the parameters blend (raised cosine) to those one loop length earlier,
+    /// so at the wrap they already equal the loop start's. Returns F0 (Hz), blended in log.
+    @inline(__always) private func fetchParameters(_ tau: Double) -> Double {
+        wSp.update(repeating: 0, count: bins)
+        wAp.update(repeating: 0, count: bins)
+        let seamStart = loopEnd - seamLen
+        if seamLen > 0 && tau > seamStart {
+            let u = (tau - seamStart) / seamLen
+            let wb = 0.5 - 0.5 * cos(Double.pi * u)
+            let other = tau - loopLen
+            accumulateFrames(tau, Float(1 - wb))
+            accumulateFrames(other, Float(wb))
+            let fa = f0At(tau), fb = f0At(other)
+            return exp((1 - wb) * log(fa) + wb * log(fb))
+        }
+        accumulateFrames(tau, 1)
+        return f0At(tau)
+    }
+
+    /// One WORLD pulse (`GetOneFrameSegment`), overlap-added at output time `t` (>= now).
+    @inline(never) private func spawnPulse(at t: Double, now: Int, tau: Double, cents: Float) {
+        let st = state
+        let pf = exp2(Double(cents) / 1200)
+        let nb = vDSP_Length(bins)
+        var n32 = Int32(bins)
+
+        let f0 = fetchParameters(tau)
+        // Micro-variation: one source period per pulse, in order, wrapping inside the loop's marks. Walking the marks
+        // per PULSE (not per read-head position) keeps the period-to-period statistics independent of pitch and rate:
+        // indexed by position, +600 c re-used each mark for ~1.4 pulses (jitter x0.6) and -600 c skipped marks.
+        let mi = st.pointee.markCursor
+        st.pointee.markCursor = mi + 1 > loopLastMark ? loopFirstMark : mi + 1
+        let jit = markJitter[mi] * tuning.jitterCarry
+        let shim = tuning.shimmerCarry != 0 ? pow(markShimmer[mi], tuning.shimmerCarry) : 1
+
+        // P4: the periodic power at the source F0 before the warp (aperiodicity still in amplitude).
+        let compensate = tuning.pitchLevelCompensation && pf != 1
+        let refPower = compensate ? harmonicPower(f0) : 0
+
+        // Optional formant co-shift: read envelope and aperiodicity at k / beta.
+        if tuning.gamma != 0 && pf != 1 {
+            let beta = pow(pf, tuning.gamma)
+            let last = bins - 1
+            for k in 0..<bins {
+                let q = Double(k) / beta
+                if q >= Double(last) { tSp[k] = wSp[last]; tAp[k] = wAp[last]; continue }
+                let k0 = Int(q)
+                let f = Float(q - Double(k0))
+                tSp[k] = wSp[k0] + (wSp[k0 + 1] - wSp[k0]) * f
+                tAp[k] = wAp[k0] + (wAp[k0 + 1] - wAp[k0]) * f
+            }
+            wSp.update(from: tSp, count: bins)
+            wAp.update(from: tAp, count: bins)
+        }
+
+        var levelGain = 1.0
+        if compensate {
+            let newPower = harmonicPower(f0 * pf)
+            if newPower > 0 && refPower > 0 { levelGain = max(0.5, min(2.0, (refPower / newPower).squareRoot())) }
+        }
+
+        // Interval to the next pulse (output samples).
+        let interval = max(8, (sampleRate / (f0 * pf)) * (1 + jit))
+        let noiseSize = max(1, Int(interval.rounded()))
+        st.pointee.nextPulse = t + interval
+        st.pointee.lastInterval = interval
+        st.pointee.intervalSum += interval
+        st.pointee.pulseCount += 1
+
+        // aperiodic ratio = ap^2 (WORLD `GetAperiodicRatio` squares the interpolated, clamped amplitude).
+        vDSP_vsq(wAp, 1, wAp, 1, nb)
+        let periodicOn = wAp[0] <= 0.999
+        // log(sp * ap^2) / 2 and log(sp * (1 - ap^2) + 1e-12) / 2.
+        vDSP_vmul(wSp, 1, wAp, 1, logA, 1, nb)
+        vDSP_vsub(logA, 1, wSp, 1, logP, 1, nb)   // sp - sp*ap^2 = sp (1 - ap^2)
+        var guardMin = Float(WorldConstants.kMySafeGuardMinimum)
+        vDSP_vsadd(logP, 1, &guardMin, logP, 1, nb)
+        var tiny: Float = 1e-30
+        vDSP_vsadd(logA, 1, &tiny, logA, 1, nb)
+        vvlogf(logP, logP, &n32)
+        vvlogf(logA, logA, &n32)
+        var half: Float = 0.5
+        vDSP_vsmul(logP, 1, &half, logP, 1, nb)
+        vDSP_vsmul(logA, 1, &half, logA, 1, nb)
+        minimumPhase(logP, hpRe, hpIm)
+        minimumPhase(logA, haRe, haIm)
+
+        // Noise: the next `noiseSize` samples of the stream, mean removed (`GetNoiseSpectrum`).
+        timeBuf.update(repeating: 0, count: n)
+        var ni = st.pointee.noiseIndex
+        let ns = min(noiseSize, n)
+        var mean: Float = 0
+        for j in 0..<ns {
+            timeBuf[j] = noise[ni]
+            mean += noise[ni]
+            ni += 1
+            if ni >= Self.noiseLen { ni = 0 }
+        }
+        st.pointee.noiseIndex = ni
+        mean /= Float(ns)
+        for j in 0..<ns { timeBuf[j] -= mean }
+        forwardReal(timeBuf, nzRe, nzIm)
+
+        // Y = sqrt(ns) * shimmer * Hp * e^{-i w frac} + Ha * Noise, then the periodic DC removed.
+        let p = Int(t.rounded(.down))
+        let frac = t - Double(p)
+        let gainP = periodicOn ? Float(Double(noiseSize).squareRoot() * shim * levelGain) : 0
+        let dw = -2.0 * Double.pi * frac / Double(n)
+        let cR = cos(dw), cI = sin(dw)
+        var zr = 1.0, zi = 0.0
+        for k in 0..<bins {
+            let hr = hpRe[k] * gainP, hi = hpIm[k] * gainP
+            let sr = Float(zr), si = Float(zi)
+            let pr = hr * sr - hi * si, pim = hr * si + hi * sr
+            let ar = haRe[k] * nzRe[k] - haIm[k] * nzIm[k]
+            let aim = haRe[k] * nzIm[k] + haIm[k] * nzRe[k]
+            hpRe[k] = pr + ar
+            hpIm[k] = pim + aim
+            let nzr = zr * cR - zi * cI
+            zi = zr * cI + zi * cR
+            zr = nzr
+        }
+        let dc = hpRe[0] - (haRe[0] * nzRe[0] - haIm[0] * nzIm[0])   // the periodic part's DC bin
+        var negDC = -dc
+        vDSP_vsma(dcRemRe, 1, &negDC, hpRe, 1, hpRe, 1, nb)
+        vDSP_vsma(dcRemIm, 1, &negDC, hpIm, 1, hpIm, 1, nb)
+        inverseReal(hpRe, hpIm, timeBuf)
+
+        // Overlap-add the causal half, tapered, into the ring at the pulse (WORLD divides by fft_size).
+        let mask = Self.ringSize - 1
+        let scale = 1 / Float(n)
+        let keep = Self.keep, tl = Self.taperLen
+        var base = p
+        if base < now { base = now }
+        for j in 0..<keep {
+            var v = timeBuf[j] * scale
+            if j >= keep - tl { v *= taper[j - (keep - tl)] }
+            ring[(base + j) & mask] += v
+        }
+    }
+
+    /// f0 x sum over harmonics h f0 < fs/2 of sp (1 - ap^2), read from wSp / wAp (ap as amplitude), linear in bins.
+    @inline(__always) private func harmonicPower(_ f0: Double) -> Double {
+        let step = f0 * Double(n) / sampleRate
+        guard step > 0.5 else { return 0 }
+        let last = Double(bins - 1)
+        var q = step, sum = 0.0
+        while q < last {
+            let k0 = Int(q)
+            let f = Float(q - Double(k0))
+            let s = wSp[k0] + (wSp[k0 + 1] - wSp[k0]) * f
+            let a = wAp[k0] + (wAp[k0 + 1] - wAp[k0]) * f
+            sum += Double(s * (1 - a * a))
+            q += step
+        }
+        return sum * f0
+    }
+
+    /// FFTW-convention r2c on `x` (length N): re/im for k = 0...N/2.
+    @inline(__always) private func forwardReal(_ x: UnsafeMutablePointer<Float>, _ re: UnsafeMutablePointer<Float>,
+                                               _ im: UnsafeMutablePointer<Float>) {
+        let h = n / 2
+        var s = DSPSplitComplex(realp: splitRe, imagp: splitIm)
+        x.withMemoryRebound(to: DSPComplex.self, capacity: h) { vDSP_ctoz($0, 2, &s, 1, vDSP_Length(h)) }
+        vDSP_fft_zrip(fftSetup, &s, 1, log2n, FFTDirection(kFFTDirection_Forward))
+        var halfS: Float = 0.5
+        re[0] = splitRe[0] * 0.5; im[0] = 0
+        re[h] = splitIm[0] * 0.5; im[h] = 0
+        vDSP_vsmul(splitRe + 1, 1, &halfS, re + 1, 1, vDSP_Length(h - 1))
+        vDSP_vsmul(splitIm + 1, 1, &halfS, im + 1, 1, vDSP_Length(h - 1))
+    }
+
+    /// FFTW-convention c2r (unscaled) from re/im k = 0...N/2 into `x` (length N).
+    @inline(__always) private func inverseReal(_ re: UnsafeMutablePointer<Float>, _ im: UnsafeMutablePointer<Float>,
+                                               _ x: UnsafeMutablePointer<Float>) {
+        let h = n / 2
+        splitRe[0] = re[0]; splitIm[0] = re[h]
+        (splitRe + 1).update(from: re + 1, count: h - 1)
+        (splitIm + 1).update(from: im + 1, count: h - 1)
+        var s = DSPSplitComplex(realp: splitRe, imagp: splitIm)
+        vDSP_fft_zrip(fftSetup, &s, 1, log2n, FFTDirection(kFFTDirection_Inverse))
+        x.withMemoryRebound(to: DSPComplex.self, capacity: h) { vDSP_ztoc(&s, 1, $0, 2, vDSP_Length(h)) }
+    }
+
+    /// WORLD `GetMinimumPhaseSpectrum`: `logMag` (bins 0...N/2, log amplitude) -> the minimum-phase spectrum.
+    /// Cepstrum of the mirrored log spectrum, folded (c0, 2 c1..c_{N/2-1}, c_{N/2}, 0...), forward FFT, complex exp.
+    private func minimumPhase(_ logMag: UnsafeMutablePointer<Float>, _ outRe: UnsafeMutablePointer<Float>,
+                              _ outIm: UnsafeMutablePointer<Float>) {
+        let h = n / 2
+        timeBuf.update(from: logMag, count: h + 1)
+        for k in 1..<h { timeBuf[n - k] = logMag[k] }
+        forwardReal(timeBuf, outRe, outIm)        // real (symmetric input): N * cepstrum
+        let invN = 1 / Float(n)
+        timeBuf[0] = outRe[0] * invN
+        var two = 2 * invN
+        vDSP_vsmul(outRe + 1, 1, &two, timeBuf + 1, 1, vDSP_Length(h - 1))
+        timeBuf[h] = outRe[h] * invN
+        (timeBuf + h + 1).update(repeating: 0, count: n - h - 1)
+        forwardReal(timeBuf, outRe, outIm)        // the minimum-phase log spectrum
+        var n32 = Int32(h + 1)
+        vvexpf(mag, outRe, &n32)
+        vvsincosf(sinB, cosB, outIm, &n32)
+        vDSP_vmul(mag, 1, cosB, 1, outRe, 1, vDSP_Length(h + 1))
+        vDSP_vmul(mag, 1, sinB, 1, outIm, 1, vDSP_Length(h + 1))
+    }
+
+    // MARK: resample (F)
+
+    private func renderResample(_ out: UnsafeMutablePointer<Float>, _ frames: Int) {
+        let st = state
+        let coef = smoothCoef, step = gateStep
+        let centsTarget = Float(bitPattern: centsBits.load(ordering: .relaxed))
+        let gateTarget = st.pointee.gateTarget
+        var cents = st.pointee.cents
+        var pf = exp2(Double(cents) / 1200)
+        var gg = st.pointee.gateGain
+        var pos = st.pointee.tau
+        let lStart = loopStart, lEnd = loopEnd, lLen = loopLen
+        var playing = true
+        var i = 0
+        while i < frames {
+            if cents != centsTarget {
+                cents += (centsTarget - cents) * coef
+                if abs(centsTarget - cents) < 1e-4 { cents = centsTarget }
+                pf = exp2(Double(cents) / 1200)
+            }
+            let y: Float
+            if pos < lStart || pf == 1 {
+                y = Self.readExact(src, pos)
+            } else {
+                y = readBandLimited(pos, min(1, 1 / pf))
+            }
+            if gg != gateTarget {
+                if gg < gateTarget { gg = min(gateTarget, gg + step) } else { gg = max(gateTarget, gg - step) }
+            }
+            out[i] = y * gg
+            if gg == 0 && gateTarget == 0 { playing = false }
+            pos += pos < lStart ? 1 : pf
+            if pos >= lEnd { pos -= lLen }
+            i += 1
+            if !playing {
+                if i < frames { (out + i).update(repeating: 0, count: frames - i) }
+                break
+            }
+        }
+        st.pointee.cents = cents
+        st.pointee.gateGain = gg
+        st.pointee.tau = pos
+        st.pointee.playing = playing
+    }
+
+    /// Linear read (exact at integer positions, which is every position at 0 cents).
+    @inline(__always) private static func readExact(_ s: UnsafeMutablePointer<Float>, _ pos: Double) -> Float {
+        let fl = pos.rounded(.down)
+        let k = Int(fl)
+        let t = Float(pos - fl)
+        if t == 0 { return s[k] }
+        return s[k] + (s[k + 1] - s[k]) * t
+    }
+
+    /// r28 candidate A's band-limited read (windowed sinc at `cut` x the source Nyquist, unity DC gain).
+    @inline(__always) private func readBandLimited(_ pos: Double, _ cut: Double) -> Float {
+        let lim = Double(Self.guardFrames - 4 - 2 * Self.sincZeros - 2)
+        let p = min(readHi - Double(2 * Self.sincZeros + 2), max(-lim, pos))
+        let halfW = Double(Self.sincZeros) / cut
+        var k = Int((p - halfW).rounded(.down)) + 1
+        let kEnd = Int((p + halfW).rounded(.down))
+        let scale = cut * Double(Self.sincRes)
+        let tab = sincTable, x0 = src
+        var acc: Float = 0
+        while k <= kEnd {
+            let u = abs(Double(k) - p) * scale
+            let i = Int(u)
+            let f = Float(u - Double(i))
+            acc += x0[k] * (tab[i] + (tab[i &+ 1] - tab[i]) * f)
+            k &+= 1
+        }
+        return acc * Float(cut)
+    }
+
+    // MARK: diagnostics (single-threaded tests and benches only)
+
+    /// Pulses spawned since the gate opened, and the last pulse interval (output samples).
+    var debugPulseCount: Int { state.pointee.pulseCount }
+    var debugLastInterval: Double { state.pointee.lastInterval }
+    /// Mean pulse interval since the gate opened (output samples).
+    var debugMeanInterval: Double { state.pointee.pulseCount > 0 ? state.pointee.intervalSum / Double(state.pointee.pulseCount) : 0 }
+    var debugLoopBounds: (start: Double, end: Double) { (loopStart, loopEnd) }
+    var debugHandover: (out: Int, length: Int) { (handoverOut, handoverLen) }
+    /// The parameter read-head (source samples).
+    var debugReadHead: Double { state.pointee.tau }
+    /// The seam-blended power envelope the next pulse would use at read-head `tau` (vocoder mode; clobbers scratch).
+    func debugEnvelope(at tau: Double) -> [Float] {
+        guard mode == .vocoder else { return [] }
+        _ = fetchParameters(tau)
+        return Array(UnsafeBufferPointer(start: wSp, count: bins))
+    }
+}
