+// ---------------------------------------------------------------------------
+
+import Accelerate
+import Foundation
+
+/// `world/constantnumbers.h` (the values this port uses) and the CheapTrick option default.
+nonisolated enum WorldConstants {
+    static let kPi = 3.1415926535897932384
+    static let kMySafeGuardMinimum = 0.000000000001
+    static let kEps = 0.00000000000000022204460492503131
+    static let kFloorF0 = 71.0
+    static let kDefaultF0 = 500.0
+    static let kLog2 = 0.69314718055994529
+    static let kHanning = 1
+    static let kBlackman = 2
+    static let kFrequencyInterval = 3000.0
+    static let kUpperLimit = 15000.0
+    static let kThreshold = 0.85
+    static let kFloorF0D4C = 47.0
+    static let kSafeGuardD4C = 0.000001
+    /// `InitializeCheapTrickOption`: `option->q1 = -0.15` (cheaptrick.cpp). q0 is `1 - 2 q1` in `SmoothingWithRecovery`.
+    static let cheapTrickQ1 = -0.15
+    /// WORLD's default frame period (ms), as used by pyworld in phase 1.
+    static let framePeriodSeconds = 0.005
+}
+
+nonisolated enum WorldCommon {
+    /// `matlab_round`.
+    @inline(__always) static func matlabRound(_ x: Double) -> Int { x > 0 ? Int(x + 0.5) : Int(x - 0.5) }
+
+    /// `GetFFTSizeForCheapTrick(fs, f0_floor)`.
+    static func cheapTrickFFTSize(fs: Double, f0Floor: Double = WorldConstants.kFloorF0) -> Int {
+        Int(pow(2.0, 1.0 + Double(Int(log(3.0 * fs / f0Floor + 1) / WorldConstants.kLog2))))
+    }
+    /// `GetF0FloorForCheapTrick(fs, fft_size)`.
+    static func cheapTrickF0Floor(fs: Double, fftSize: Int) -> Double { 3.0 * fs / (Double(fftSize) - 3.0) }
+    /// D4C's own FFT size (`D4C`, d4c.cpp).
+    static func d4cFFTSize(fs: Double) -> Int {
+        Int(pow(2.0, 1.0 + Double(Int(log(4.0 * fs / WorldConstants.kFloorF0D4C + 1) / WorldConstants.kLog2))))
+    }
+
+    /// `randn` / `randn_reseed` (matlabfunctions.cpp): xorshift128, sum of 12 uniforms.
+    struct Randn {
+        var x: UInt32 = 123456789, y: UInt32 = 362436069, z: UInt32 = 521288629, w: UInt32 = 88675123
+        @inline(__always) private mutating func step() {
+            let t = x ^ (x << 11)
+            x = y; y = z; z = w
+            w = (w ^ (w >> 19)) ^ (t ^ (t >> 8))
+        }
+        mutating func next() -> Double {
+            step()
+            var tmp = w >> 4
+            for _ in 0..<11 { step(); tmp &+= w >> 4 }
+            return Double(tmp) / 268435456.0 - 6.0
+        }
+    }
+
+    /// `histc` (matlabfunctions.cpp), 1-based indices as in WORLD.
+    static func histc(_ x: [Double], _ edges: [Double]) -> [Int] {
+        let xLength = x.count, edgesLength = edges.count
+        var index = [Int](repeating: 0, count: edgesLength)
+        var count = 1
+        var i = 0
+        while i < edgesLength {
+            index[i] = 1
+            if edges[i] >= x[0] { break }
+            i += 1
+        }
+        while i < edgesLength {
+            if edges[i] < x[count] {
+                index[i] = count
+            } else {
+                index[i] = count; count += 1; i -= 1
+            }
+            if count == xLength { break }
+            i += 1
+        }
+        count -= 1
+        i += 1
+        while i < edgesLength { index[i] = count; i += 1 }
+        return index
+    }
+
+    /// `interp1` (matlabfunctions.cpp): linear interpolation of (x, y) at xi.
+    static func interp1(_ x: [Double], _ y: [Double], _ xi: [Double]) -> [Double] {
+        var h = [Double](repeating: 0, count: x.count - 1)
+        for i in 0..<(x.count - 1) { h[i] = x[i + 1] - x[i] }
+        let k = histc(x, xi)
+        var yi = [Double](repeating: 0, count: xi.count)
+        for i in 0..<xi.count {
+            let s = (xi[i] - x[k[i] - 1]) / h[k[i] - 1]
+            yi[i] = y[k[i] - 1] + s * (y[k[i]] - y[k[i] - 1])
+        }
+        return yi
+    }
+
+    /// `interp1Q` (matlabfunctions.cpp): y sampled on a uniform grid x0 + n * shift, read at xi.
+    static func interp1Q(_ x0: Double, _ shift: Double, _ y: UnsafePointer<Double>, _ xLength: Int,
+                         _ xi: UnsafePointer<Double>, _ xiLength: Int, _ yi: UnsafeMutablePointer<Double>) {
+        var deltaY = [Double](repeating: 0, count: xLength)
+        for i in 0..<(xLength - 1) { deltaY[i] = y[i + 1] - y[i] }
+        deltaY[xLength - 1] = 0
+        for i in 0..<xiLength {
+            let q = (xi[i] - x0) / shift
+            let base = Int(q)            // static_cast<int>: truncation toward zero
+            let fraction = q - Double(base)
+            yi[i] = y[base] + deltaY[base] * fraction
+        }
+    }
+
+    /// `DCCorrection` (common.cpp). In place is allowed (the replica is computed first).
+    static func dcCorrection(_ input: UnsafeMutablePointer<Double>, f0: Double, fs: Double, fftSize: Int) {
+        let upperLimit = 2 + Int(f0 * Double(fftSize) / fs)
+        var axis = [Double](repeating: 0, count: upperLimit)
+        for i in 0..<upperLimit { axis[i] = Double(i) * fs / Double(fftSize) }
+        let upperLimitReplica = upperLimit - 1
+        var replica = [Double](repeating: 0, count: upperLimit)
+        axis.withUnsafeBufferPointer { ax in
+            replica.withUnsafeMutableBufferPointer { rp in
+                interp1Q(f0 - ax[0], -fs / Double(fftSize), input, upperLimit + 1,
+                         ax.baseAddress!, upperLimitReplica, rp.baseAddress!)
+            }
+        }
+        for i in 0..<upperLimitReplica { input[i] = input[i] + replica[i] }
+    }
+
+    /// `LinearSmoothing` (common.cpp): rectangular smoothing of width `width` Hz on bins 0...N/2. In place allowed.
+    static func linearSmoothing(_ input: UnsafeMutablePointer<Double>, width: Double, fs: Double, fftSize: Int,
+                                output: UnsafeMutablePointer<Double>) {
+        let half = fftSize / 2
+        let boundary = Int(width * Double(fftSize) / fs) + 1
+        let mLen = half + boundary * 2 + 1
+        var mirroringSpectrum = [Double](repeating: 0, count: mLen)
+        var mirroringSegment = [Double](repeating: 0, count: mLen)
+        var frequencyAxis = [Double](repeating: 0, count: half + 1)
+        // SetParametersForLinearSmoothing
+        for i in 0..<boundary { mirroringSpectrum[i] = input[boundary - i] }
+        for i in boundary..<(half + boundary) { mirroringSpectrum[i] = input[i - boundary] }
+        var i = half + boundary
+        while i <= half + boundary * 2 {
+            mirroringSpectrum[i] = input[half - (i - (half + boundary))]
+            i += 1
+        }
+        mirroringSegment[0] = mirroringSpectrum[0] * fs / Double(fftSize)
+        for i in 1..<mLen {
+            mirroringSegment[i] = mirroringSpectrum[i] * fs / Double(fftSize) + mirroringSegment[i - 1]
+        }
+        for i in 0...half { frequencyAxis[i] = Double(i) / Double(fftSize) * fs - width / 2.0 }
+
+        var low = [Double](repeating: 0, count: half + 1)
+        var high = [Double](repeating: 0, count: half + 1)
+        let origin = -(Double(boundary) - 0.5) * fs / Double(fftSize)
+        let interval = fs / Double(fftSize)
+        mirroringSegment.withUnsafeBufferPointer { seg in
+            frequencyAxis.withUnsafeBufferPointer { fa in
+                low.withUnsafeMutableBufferPointer { lp in
+                    interp1Q(origin, interval, seg.baseAddress!, mLen, fa.baseAddress!, half + 1, lp.baseAddress!)
+                }
+            }
+        }
+        for i in 0...half { frequencyAxis[i] += width }
+        mirroringSegment.withUnsafeBufferPointer { seg in
+            frequencyAxis.withUnsafeBufferPointer { fa in
+                high.withUnsafeMutableBufferPointer { hp in
+                    interp1Q(origin, interval, seg.baseAddress!, mLen, fa.baseAddress!, half + 1, hp.baseAddress!)
+                }
+            }
+        }
+        for i in 0...half { output[i] = (high[i] - low[i]) / width }
+    }
+
+    /// `NuttallWindow` (common.cpp).
+    static func nuttallWindow(_ n: Int) -> [Double] {
+        (0..<n).map { i in
+            let t = Double(i) / (Double(n) - 1.0)
+            return 0.355768 - 0.487396 * cos(2.0 * WorldConstants.kPi * t)
+                + 0.144232 * cos(4.0 * WorldConstants.kPi * t) - 0.012604 * cos(6.0 * WorldConstants.kPi * t)
+        }
+    }
+
+    /// `GetSafeAperiodicity` (common.h).
+    @inline(__always) static func safeAperiodicity(_ x: Double) -> Double { max(0.001, min(0.999999999999, x)) }
+}
+
+/// FFTW-convention real FFT on vDSP (double precision; analysis only).
+/// `forward`: r2c, unscaled: spectrum[k] = sum x[n] e^{-i 2 pi k n / N}, k = 0...N/2.
+/// `inverse`: c2r, unscaled: x[n] = sum over the full Hermitian spectrum (no 1/N), as FFTW.
+nonisolated final class WorldRealFFT {
+    let n: Int
+    private let log2n: vDSP_Length
+    private let setup: FFTSetupD
+    private var re: [Double], im: [Double]
+    /// Time-domain buffer (length N), the `waveform` of WORLD's ForwardRealFFT/InverseRealFFT.
+    var waveform: [Double]
+    /// Spectrum k = 0...N/2 (real and imaginary parts).
+    var specRe: [Double], specIm: [Double]
+
+    init(size: Int) {
+        n = size
+        log2n = vDSP_Length(Int(log2(Double(size)).rounded()))
+        setup = vDSP_create_fftsetupD(log2n, FFTRadix(kFFTRadix2))!
+        re = [Double](repeating: 0, count: size / 2)
+        im = re
+        waveform = [Double](repeating: 0, count: size)
+        specRe = [Double](repeating: 0, count: size / 2 + 1)
+        specIm = specRe
+    }
+    deinit { vDSP_destroy_fftsetupD(setup) }
+
+    /// waveform -> spec (r2c).
+    func forward() {
+        let h = n / 2
+        re.withUnsafeMutableBufferPointer { rp in
+            im.withUnsafeMutableBufferPointer { ip in
+                var s = DSPDoubleSplitComplex(realp: rp.baseAddress!, imagp: ip.baseAddress!)
+                waveform.withUnsafeBufferPointer { wp in
+                    wp.baseAddress!.withMemoryRebound(to: DSPDoubleComplex.self, capacity: h) {
+                        vDSP_ctozD($0, 2, &s, 1, vDSP_Length(h))
+                    }
+                }
+                vDSP_fft_zripD(setup, &s, 1, log2n, FFTDirection(kFFTDirection_Forward))
+            }
+        }
+        specRe[0] = re[0] * 0.5; specIm[0] = 0
+        specRe[h] = im[0] * 0.5; specIm[h] = 0
+        for k in 1..<h { specRe[k] = re[k] * 0.5; specIm[k] = im[k] * 0.5 }
+    }
+
+    /// spec -> waveform (c2r, unscaled).
+    func inverse() {
+        let h = n / 2
+        re[0] = specRe[0]; im[0] = specRe[h]
+        for k in 1..<h { re[k] = specRe[k]; im[k] = specIm[k] }
+        re.withUnsafeMutableBufferPointer { rp in
+            im.withUnsafeMutableBufferPointer { ip in
+                var s = DSPDoubleSplitComplex(realp: rp.baseAddress!, imagp: ip.baseAddress!)
+                vDSP_fft_zripD(setup, &s, 1, log2n, FFTDirection(kFFTDirection_Inverse))
+                waveform.withUnsafeMutableBufferPointer { wp in
+                    wp.baseAddress!.withMemoryRebound(to: DSPDoubleComplex.self, capacity: h) {
+                        vDSP_ztocD(&s, 1, $0, 2, vDSP_Length(h))
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/PrimaeNative/Core/Sonification/Candidates/WorldRT/WorldD4C.swift b/PrimaeNative/Core/Sonification/Candidates/WorldRT/WorldD4C.swift
