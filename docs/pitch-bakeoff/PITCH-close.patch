@@ -0,0 +1,217 @@
+// WorldD4C.swift
+// PrimaeNative — pitch bake-off phase 2, candidate C2 "WorldRT" (2026-11-23)
+//
+// A Swift port of WORLD's D4C band-aperiodicity estimator, including D4C LoveTrain
+// (`d4c.cpp`, https://github.com/mmorise/World at commit c794856b537758a3d300757db2e5e31685a822c2;
+// M. Morise, "D4C, a band-aperiodicity estimator for high-quality speech synthesis",
+// Speech Communication 84, 2016). Function for function, same order of operations,
+// double precision, the same deterministic `randn` safeguard noise. Init-time only.
+//
+// Copyright (c) 2010  M. Morise. All rights reserved.
+// Redistribution and use in source and binary forms, with or without modification, are
+// permitted provided that the conditions of the modified-BSD licence reproduced in full in
+// `WorldCommon.swift` are met (retain this notice; reproduce it in binary distributions'
+// documentation; no endorsement by the author's name). THIS SOFTWARE IS PROVIDED BY THE
+// COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES ARE
+// DISCLAIMED (full text in `WorldCommon.swift`).
+
+import Foundation
+
+nonisolated final class WorldD4C {
+    let fs: Double
+    /// The synthesis/CheapTrick FFT size the aperiodicity is expressed on (bins 0...N/2).
+    let fftSize: Int
+    let threshold: Double
+    let d4cFFTSize: Int
+    let numberOfAperiodicities: Int
+    private let fft: WorldRealFFT
+    private let loveFFT: WorldRealFFT
+    private let window: [Double]
+    private let windowLength: Int
+    private var randn = WorldCommon.Randn()
+    /// LoveTrain's value per frame of the last `aperiodicity` call (diagnostic: <= threshold = judged unvoiced).
+    private(set) var lastAperiodicity0: [Double] = []
+
+    init(fs: Double, fftSize: Int, threshold: Double = WorldConstants.kThreshold) {
+        self.fs = fs
+        self.fftSize = fftSize
+        self.threshold = threshold
+        d4cFFTSize = WorldCommon.d4cFFTSize(fs: fs)
+        fft = WorldRealFFT(size: d4cFFTSize)
+        let lowest = 40.0
+        loveFFT = WorldRealFFT(size: Int(pow(2.0, 1.0 + Double(Int(log(3.0 * fs / lowest + 1) / WorldConstants.kLog2)))))
+        numberOfAperiodicities = Int(min(WorldConstants.kUpperLimit, fs / 2.0 - WorldConstants.kFrequencyInterval)
+                                     / WorldConstants.kFrequencyInterval)
+        windowLength = Int(WorldConstants.kFrequencyInterval * Double(d4cFFTSize) / fs) * 2 + 1
+        window = WorldCommon.nuttallWindow(windowLength)
+    }
+
+    /// `D4C`: amplitude aperiodicity (bins 0...N/2 of `fftSize`) per (position s, f0 Hz; 0 = unvoiced).
+    func aperiodicity(_ x: [Double], positions: [Double], f0: [Double]) -> [[Double]] {
+        randn = WorldCommon.Randn()
+        let h = fftSize / 2
+        var ap = [[Double]](repeating: [Double](repeating: 1.0 - WorldConstants.kMySafeGuardMinimum, count: h + 1),
+                            count: positions.count)
+        let a0 = loveTrain(x, positions: positions, f0: f0)
+        lastAperiodicity0 = a0
+        var coarse = [Double](repeating: 0, count: numberOfAperiodicities + 2)
+        coarse[0] = -60.0
+        coarse[numberOfAperiodicities + 1] = -WorldConstants.kMySafeGuardMinimum
+        var coarseAxis = [Double](repeating: 0, count: numberOfAperiodicities + 2)
+        for i in 0...numberOfAperiodicities { coarseAxis[i] = Double(i) * WorldConstants.kFrequencyInterval }
+        coarseAxis[numberOfAperiodicities + 1] = fs / 2.0
+        let axis = (0...h).map { Double($0) * fs / Double(fftSize) }
+        for i in 0..<positions.count {
+            if f0[i] == 0 || a0[i] <= threshold { continue }
+            let c = generalBody(x, f0: max(WorldConstants.kFloorF0D4C, f0[i]), position: positions[i])
+            for j in 0..<numberOfAperiodicities { coarse[j + 1] = c[j] }
+            let db = WorldCommon.interp1(coarseAxis, coarse, axis)
+            ap[i] = db.map { pow(10.0, $0 / 20.0) }
+        }
+        return ap
+    }
+
+    // MARK: D4C LoveTrain
+
+    private func loveTrain(_ x: [Double], positions: [Double], f0: [Double]) -> [Double] {
+        let lowest = 40.0
+        let n = loveFFT.n
+        let b0 = Int(ceil(100.0 * Double(n) / fs))
+        let b1 = Int(ceil(4000.0 * Double(n) / fs))
+        let b2 = Int(ceil(7900.0 * Double(n) / fs))
+        var out = [Double](repeating: 0, count: positions.count)
+        for i in 0..<positions.count {
+            if f0[i] == 0 { out[i] = 0; continue }
+            out[i] = loveTrainSub(x, f0: max(f0[i], lowest), position: positions[i], b0: b0, b1: b1, b2: b2)
+        }
+        return out
+    }
+
+    private func loveTrainSub(_ x: [Double], f0: Double, position: Double, b0: Int, b1: Int, b2: Int) -> Double {
+        let n = loveFFT.n
+        let windowLength = WorldCommon.matlabRound(1.5 * fs / f0) * 2 + 1
+        windowedWaveform(x, f0: f0, position: position, type: WorldConstants.kBlackman, ratio: 3.0,
+                         into: &loveFFT.waveform)
+        for i in windowLength..<n { loveFFT.waveform[i] = 0 }
+        loveFFT.forward()
+        var power = [Double](repeating: 0, count: n)
+        for i in (b0 + 1)..<(n / 2 + 1) {
+            power[i] = loveFFT.specRe[i] * loveFFT.specRe[i] + loveFFT.specIm[i] * loveFFT.specIm[i]
+        }
+        for i in b0...b2 { power[i] += power[i - 1] }
+        return power[b1] / power[b2]
+    }
+
+    // MARK: D4C general body
+
+    /// `D4CGeneralBody`: the coarse aperiodicity (dB) at 3, 6, ... kHz, F0-revised.
+    func generalBody(_ x: [Double], f0: Double, position: Double) -> [Double] {
+        let h = d4cFFTSize / 2
+        let staticCentroid = getStaticCentroid(x, f0: f0, position: position)
+        let smoothed = getSmoothedPowerSpectrum(x, f0: f0, position: position)
+        var sgd = [Double](repeating: 0, count: h + 1)
+        // GetStaticGroupDelay
+        for i in 0...h { sgd[i] = staticCentroid[i] / smoothed[i] }
+        sgd.withUnsafeMutableBufferPointer { p in
+            WorldCommon.linearSmoothing(p.baseAddress!, width: f0 / 2.0, fs: fs, fftSize: d4cFFTSize, output: p.baseAddress!)
+        }
+        var smoothedGD = [Double](repeating: 0, count: h + 1)
+        sgd.withUnsafeMutableBufferPointer { p in
+            smoothedGD.withUnsafeMutableBufferPointer { q in
+                WorldCommon.linearSmoothing(p.baseAddress!, width: f0, fs: fs, fftSize: d4cFFTSize, output: q.baseAddress!)
+            }
+        }
+        for i in 0...h { sgd[i] -= smoothedGD[i] }
+        var coarse = getCoarseAperiodicity(sgd)
+        for i in 0..<numberOfAperiodicities { coarse[i] = min(0.0, coarse[i] + (f0 - 100) / 50.0) }
+        return coarse
+    }
+
+    /// `GetWindowedWaveform` (d4c.cpp): F0-adaptive Hann (type 1) or Blackman (type 2), DC-free; writes [0, 2h].
+    private func windowedWaveform(_ x: [Double], f0: Double, position: Double, type: Int, ratio: Double,
+                                  into waveform: inout [Double]) {
+        let half = WorldCommon.matlabRound(ratio * fs / f0 / 2.0)
+        let len = half * 2 + 1
+        let origin = WorldCommon.matlabRound(position * fs + 0.001)
+        var window = [Double](repeating: 0, count: len)
+        for i in 0..<len {
+            let pos = (2.0 * Double(i - half) / ratio) / fs
+            if type == WorldConstants.kHanning {
+                window[i] = 0.5 * cos(WorldConstants.kPi * pos * f0) + 0.5
+            } else {
+                window[i] = 0.42 + 0.5 * cos(WorldConstants.kPi * pos * f0) + 0.08 * cos(WorldConstants.kPi * pos * f0 * 2)
+            }
+        }
+        var w1 = 0.0, w2 = 0.0
+        for i in 0..<len {
+            let safe = min(x.count - 1, max(0, origin + i - half))
+            waveform[i] = x[safe] * window[i] + randn.next() * WorldConstants.kSafeGuardD4C
+            w1 += waveform[i]; w2 += window[i]
+        }
+        let coef = w1 / w2
+        for i in 0..<len { waveform[i] -= window[i] * coef }
+    }
+
+    /// `GetCentroid`.
+    private func getCentroid(_ x: [Double], f0: Double, position: Double) -> [Double] {
+        let n = d4cFFTSize, h = n / 2
+        for i in 0..<n { fft.waveform[i] = 0 }
+        windowedWaveform(x, f0: f0, position: position, type: WorldConstants.kBlackman, ratio: 4.0, into: &fft.waveform)
+        let lim = WorldCommon.matlabRound(2.0 * fs / f0) * 2
+        var power = 0.0
+        for i in 0...lim { power += fft.waveform[i] * fft.waveform[i] }
+        let r = power.squareRoot()
+        for i in 0...lim { fft.waveform[i] /= r }
+        fft.forward()
+        let tr = fft.specRe, ti = fft.specIm
+        for i in 0..<n { fft.waveform[i] *= Double(i) + 1.0 }
+        fft.forward()
+        var centroid = [Double](repeating: 0, count: h + 1)
+        for i in 0...h { centroid[i] = fft.specRe[i] * tr[i] + ti[i] * fft.specIm[i] }
+        return centroid
+    }
+
+    /// `GetStaticCentroid`.
+    private func getStaticCentroid(_ x: [Double], f0: Double, position: Double) -> [Double] {
+        let c1 = getCentroid(x, f0: f0, position: position - 0.25 / f0)
+        let c2 = getCentroid(x, f0: f0, position: position + 0.25 / f0)
+        var s = zip(c1, c2).map { $0 + $1 }
+        s.withUnsafeMutableBufferPointer { p in WorldCommon.dcCorrection(p.baseAddress!, f0: f0, fs: fs, fftSize: d4cFFTSize) }
+        return s
+    }
+
+    /// `GetSmoothedPowerSpectrum`.
+    private func getSmoothedPowerSpectrum(_ x: [Double], f0: Double, position: Double) -> [Double] {
+        let n = d4cFFTSize, h = n / 2
+        for i in 0..<n { fft.waveform[i] = 0 }
+        windowedWaveform(x, f0: f0, position: position, type: WorldConstants.kHanning, ratio: 4.0, into: &fft.waveform)
+        fft.forward()
+        var p = [Double](repeating: 0, count: h + 1)
+        for i in 0...h { p[i] = fft.specRe[i] * fft.specRe[i] + fft.specIm[i] * fft.specIm[i] }
+        p.withUnsafeMutableBufferPointer { q in
+            WorldCommon.dcCorrection(q.baseAddress!, f0: f0, fs: fs, fftSize: n)
+            WorldCommon.linearSmoothing(q.baseAddress!, width: f0, fs: fs, fftSize: n, output: q.baseAddress!)
+        }
+        return p
+    }
+
+    /// `GetCoarseAperiodicity`.
+    private func getCoarseAperiodicity(_ sgd: [Double]) -> [Double] {
+        let n = d4cFFTSize, h = n / 2
+        let boundary = WorldCommon.matlabRound(Double(n) * 8.0 / Double(windowLength))
+        let halfWindow = windowLength / 2
+        for i in 0..<n { fft.waveform[i] = 0 }
+        var out = [Double](repeating: 0, count: numberOfAperiodicities)
+        var power = [Double](repeating: 0, count: h + 1)
+        for i in 0..<numberOfAperiodicities {
+            let center = Int(WorldConstants.kFrequencyInterval * Double(i + 1) * Double(n) / fs)
+            for j in 0...(halfWindow * 2) { fft.waveform[j] = sgd[center - halfWindow + j] * window[j] }
+            fft.forward()
+            for j in 0...h { power[j] = fft.specRe[j] * fft.specRe[j] + fft.specIm[j] * fft.specIm[j] }
+            power.sort()
+            for j in 1...h { power[j] += power[j - 1] }
+            out[i] = 10 * log10(power[h - boundary - 1] / power[h])
+        }
+        return out
+    }
+}
