--- /dev/null
+++ b/PrimaeNative/Core/Sonification/Candidates/PitchBank/PitchBank.swift
@@ -0,0 +1,561 @@
+// PitchBank.swift
+// PrimaeNative — pitch bake-off phase 2, candidate C3 "PitchBank" (2026-11-24; NOT wired into the study path)
+//
+// BAKEOFF-PITCH.md section 2 C3: pre-rendered pitch banks played by a live residual PSOLA.
+//
+//   Init      The C1 live renderer (`TDPSOLA2`, default options + item 7 shifted attack) is built at once: it is the
+//             fallback and it plays F and the carrier. For a voiced phoneme the 13 banks (`PitchBankSet`, k = -6...6,
+//             100 cents apart, rendered by a `BankRenderer`, default `WorldBankRenderer` = C2 offline) are requested
+//             from a `PitchBankCache` on a background queue; when they arrive their pointers are copied into the
+//             renderer's table and a ready flag is published (release/acquire).
+//   Live      A note that starts with the banks ready plays them; one that starts before they are ready plays C1 live
+//             to its end (`lastPath`). The bank path is TDPSOLA2's voiced PSOLA in SOURCE time (read-head at the
+//             rate, marks by index, spacing T(i) / pf), each grain read from bank k = round(cents / 100) at that
+//             bank's position of the same mark, so the bank already carries pf_k and PSOLA adds only the residual
+//             (|cents - 100 k| <= 50 c, plus the smoothing). Window cap (item 2) and noise swap (item 4, on the
+//             bank's own aperiodic part) as C1; no GCI snap (a bank's marks are exact by construction).
+//   Switch    When k changes, a cross-fade starts at the next grain's mark and lasts two output periods. Every grain
+//             reads both banks at the same mark during it: both are then at the same output F0 by construction
+//             (same schedule), so the fade is aligned at a mark and does not beat. Equal-power (the spec) or
+//             linear (`PitchBankTuning.crossfade`).
+//   Attack    The banks carry the attack pitched (bank k's attack is re-synthesised at pf_k), and the grains run
+//             through it in its own timing (read-head at 1 to the loop start, as C1 item 7): the attack follows the
+//             pitch. The pre-voicing transient is the recorded one (bank prefix, flat first grain).
+//
+// Real-time contract as TDPSOLA2: render and the setters allocate nothing, take no lock, touch no Swift array or
+// class reference (the bank table and the state are raw pointers allocated in init; the fallback is reached through
+// an unowned(unsafe) reference).
+
+import Foundation
+import Synchronization
+
+nonisolated struct PitchBankTuning: Sendable, Equatable {
+    enum Crossfade: Sendable, Equatable { case equalPower, linear }
+    /// Bank cross-fade shape. Equal-power is the spec; linear is the amplitude fade for correlated inputs.
+    var crossfade: Crossfade = .equalPower
+    /// Cross-fade length in output periods.
+    var crossfadePeriods: Double = 2
+    /// C1 item 2: grain halves capped at one bank period.
+    var windowCap = true
+    /// C1 item 4: a repeated / skipped period plays its periodic part with another period's aperiodic part.
+    var noiseSwap = true
+    /// The attack at the steady F0 x pf, as C1 item 7's `attackFlatF0`: the banks' attack pulses
+    /// are laid out on the flattened periods. false = the attack keeps its own intonation x pf.
+    var flatAttack = true
+    /// Share of each loop period's deviation from its 5-mark mean the banks keep (C2's `jitterCarry` knob; 1 = the
+    /// marks' own periods). The marks' spread is part jitter, part mark error.
+    var jitterCarry: Double = 0.8
+    /// Wait in init until the banks are built (benches; never in the app).
+    var waitForBanks = false
+
+    static let `default` = PitchBankTuning()
+}
+
+nonisolated final class PitchBank: SonificationRenderer, @unchecked Sendable {
+    static var candidateName: String { "PitchBank" }
+
+    enum Path: UInt32, Sendable { case none = 0, bank = 1, live = 2 }
+
+    let kind: SourceKind
+    let tuning: PitchBankTuning
+    let sampleRate: Double
+    /// The C1 live renderer: the fallback for voiced notes, the renderer for F and the carrier.
+    let live: TDPSOLA2
+    /// The marks the banks were laid out from (TDPSOLA2's coarse analysis, the recorded onset applied).
+    let analysis: TDPSOLAAnalysis
+    let usesBanks: Bool
+
+    // MARK: parameters (any thread)
+    private let rateBits = Atomic<UInt32>(Float(1).bitPattern)
+    private let centsBits = Atomic<UInt32>(Float(0).bitPattern)
+    private let gateBits = Atomic<UInt32>(0)
+    private let resetToken = Atomic<UInt32>(0)
+    private let ready = Atomic<UInt32>(0)
+    private let pathBits = Atomic<UInt32>(0)
+    private let switchCount = Atomic<UInt32>(0)
+
+    /// Which renderer played the most recent note (bank path or C1 live). Readable from any thread.
+    var lastPath: Path { Path(rawValue: pathBits.load(ordering: .relaxed)) ?? .none }
+    /// True once the banks are installed.
+    var banksReady: Bool { ready.load(ordering: .acquiring) != 0 }
+    /// Bank switches (cross-fades started) since init (diagnostics).
+    var bankSwitches: Int { Int(switchCount.load(ordering: .relaxed)) }
+    /// The bank playing and the one being faded to (-1 = none), as bank steps k (single-threaded tests only).
+    var debugBanks: (current: Int, next: Int) {
+        let st = state.pointee
+        return (st.cur - PitchBankSet.steps, st.nxt < 0 ? -1000 : st.nxt - PitchBankSet.steps)
+    }
+    /// The installed set (off the render thread only).
+    var bankSet: PitchBankSet? { setLock.lock(); defer { setLock.unlock() }; return installedSet }
+    private let setLock = NSLock()
+    private var installedSet: PitchBankSet?
+
+    // MARK: render-thread storage
+    private struct Grain {
+        var outCenter: Double
+        var leftW: Double
+        var rightW: Double
+        var mark: Int
+        var noise: Int = -1      // >= 0: aperiodic part read at this mark instead
+        var flatLeft = false
+    }
+    private struct State {
+        var playing = false
+        var onBank = false
+        var onLive = false
+        var now = 0.0
+        var s = 0.0
+        var attackActive = false
+        var attackEnd = 0.0
+        var rate: Float = 1
+        var cents: Float = 0
+        var gateGain: Float = 0
+        var gateTarget: Float = 0
+        var grainCount = 0
+        var cursor = 0
+        var lowMark = 0
+        var cur = 0
+        var nxt = -1
+        var xfStart = 0.0
+        var xfLen = 1.0
+        var appliedReset: UInt32 = 0
+        var rng: UInt64 = 0
+        var recent0 = -1
+        var recent1 = -1
+    }
+    private static let maxGrains = 8
+    private static let windowSize = 1024
+    private let state: UnsafeMutablePointer<State>
+    private let grains: UnsafeMutablePointer<Grain>
+    private let window: UnsafeMutablePointer<Float>
+    private let table: UnsafeMutablePointer<PitchBankView>
+    private let marks: UnsafeMutablePointer<Double>     // source marks
+    private let periods: UnsafeMutablePointer<Double>   // spacing periods (source periods; attack flattened)
+    private let markCount: Int
+    private let attackIndex: Int
+    private let loopEndIndex: Int
+    private let firstMark: Int
+    private let onsetFrame: Double
+    private let loopEnd: Double
+    private let loopLen: Double
+    private let smoothCoef: Float
+    private let gateStep: Float
+    private let rngSeed: UInt64
+    private unowned(unsafe) let liveRef: TDPSOLA2
+
+    convenience init(source: [Float], sampleRate: Double, kind: SourceKind, maxFramesPerRender: Int) {
+        self.init(source: source, sampleRate: sampleRate, kind: kind, maxFramesPerRender: maxFramesPerRender,
+                  onset: nil, outputGain: 1)
+    }
+
+    /// As production builds TDPSOLA (`onset`, `outputGain`), plus the bank cache, its key and the bank renderer.
+    /// `makeBankRenderer` defaults to C2 offline (`WorldBankRenderer`).
+    init(source: [Float], sampleRate: Double, kind: SourceKind, maxFramesPerRender: Int,
+         onset: RecordedOnset?, outputGain: Float, tuning: PitchBankTuning = .default,
+         liveOptions: TDPSOLA2Options = PitchBank.liveOptions,
+         cache: PitchBankCache = .shared, cacheKey: String? = nil,
+         makeBankRenderer: (@Sendable (_ source: [Float], _ played: [Float], _ analysis: TDPSOLAAnalysis) -> any BankRenderer)? = nil) {
+        self.kind = kind
+        self.tuning = tuning
+        self.sampleRate = sampleRate
+        let l = TDPSOLA2(source: source, sampleRate: sampleRate, kind: kind, maxFramesPerRender: maxFramesPerRender,
+                         tuning: .default, options: liveOptions, onset: onset, outputGain: outputGain)
+        live = l
+        liveRef = l
+        let a = l.coarseAnalysis
+        analysis = a
+        usesBanks = kind == .voicedPhoneme && a.isVoiced && a.marks.count >= 4
+        state = .allocate(capacity: 1); state.initialize(to: State())
+        grains = .allocate(capacity: Self.maxGrains)
+        window = .allocate(capacity: Self.windowSize + 2)
+        for i in 0...(Self.windowSize + 1) {
+            let u = min(1.0, Double(i) / Double(Self.windowSize))
+            (window + i).initialize(to: Float(0.5 + 0.5 * cos(Double.pi * u)))
+        }
+        let dummy = UnsafeMutablePointer<Float>.allocate(capacity: 1)
+        dummy.initialize(to: 0)
+        let dummyM = UnsafeMutablePointer<Double>.allocate(capacity: 1)
+        dummyM.initialize(to: 0)
+        table = .allocate(capacity: PitchBankSet.count)
+        table.initialize(repeating: PitchBankView(full: dummy, noise: dummy, hasNoise: false, marks: dummyM,
+                                                  pitchFactor: 1, length: 0), count: PitchBankSet.count)
+        dummyFull = dummy; dummyMarks = dummyM
+        onsetBank = .allocate(capacity: PitchBankSet.count)
+        onsetBank.initialize(repeating: Double(a.onset), count: PitchBankSet.count)
+        markCount = a.marks.count
+        let sp = Self.bankPeriods(a, tuning)
+        marks = .allocate(capacity: max(1, markCount)); periods = .allocate(capacity: max(1, markCount))
+        for i in 0..<markCount { (marks + i).initialize(to: a.marks[i]); (periods + i).initialize(to: sp[i]) }
+        attackIndex = a.attackIndex
+        loopEndIndex = a.loopEndIndex
+        firstMark = usesBanks ? TDPSOLA2.attackFirstMark(a) : 0
+        onsetFrame = Double(a.onset)
+        loopEnd = a.loopEnd
+        loopLen = max(1, a.loopEnd - a.loopStart)
+        let td = TDPSOLATuning.default
+        smoothCoef = td.smoothingSeconds > 0 ? Float(1 - exp(-1 / (td.smoothingSeconds * sampleRate))) : 1
+        gateStep = Float(1 / max(1, (td.gateRampSeconds * sampleRate).rounded()))
+        var hsh: UInt64 = 0xcbf29ce484222325
+        for v in source { hsh = (hsh ^ UInt64(v.bitPattern)) &* 0x100000001b3 }
+        rngSeed = hsh == 0 ? 0x9E3779B97F4A7C15 : hsh
+
+        guard usesBanks else { return }
+        let played = l.playedSamples
+        let src = source, sr = sampleRate
+        let make: @Sendable ([Float], [Float], TDPSOLAAnalysis) -> any BankRenderer = makeBankRenderer ?? { s, p, an in
+            WorldBankRenderer(source: s, played: p, sampleRate: sr, analysis: an)
+        }
+        let key = (cacheKey ?? "\(source.count)-\(hsh)") + "|flat\(tuning.flatAttack)|jc\(tuning.jitterCarry)"
+        let build: @Sendable () -> PitchBankSet = { PitchBankSet(analysis: a, sourcePeriods: sp) { make(src, played, a) } }
+        if tuning.waitForBanks {
+            install(cache.get(key, build: build))
+        } else {
+            cache.request(key, build: build) { [weak self] s in self?.install(s) }
+        }
+    }
+    private let dummyFull: UnsafeMutablePointer<Float>
+    /// Bank time of the onset, per bank (written by `install` before the ready flag).
+    private let onsetBank: UnsafeMutablePointer<Double>
+    private let dummyMarks: UnsafeMutablePointer<Double>
+
+    /// The period each source mark is re-spaced from: the attack flattened (`flatAttack`), the loop's deviations about
+    /// a 5-mark mean scaled by `jitterCarry`.
+    static func bankPeriods(_ a: TDPSOLAAnalysis, _ t: PitchBankTuning) -> [Double] {
+        var p = TDPSOLA2.spacingPeriods(a, flatAttack: t.flatAttack)
+        guard t.jitterCarry != 1, a.isVoiced else { return p }
+        let m = a.periods.count
+        for i in a.attackIndex..<m {
+            let lo = max(a.attackIndex, i - 2), hi = min(m - 1, i + 2)
+            var sum = 0.0
+            for j in lo...hi { sum += a.periods[j] }
+            let mean = sum / Double(hi - lo + 1)
+            p[i] = mean + t.jitterCarry * (a.periods[i] - mean)
+        }
+        return p
+    }
+
+    /// The live options: C1's default plus item 7 (the attack follows the pitch on the fallback too).
+    static var liveOptions: TDPSOLA2Options { var o = TDPSOLA2Options.default; o.shiftedAttack = true; return o }
+
+    private func install(_ s: PitchBankSet) {
+        guard s.markCount == markCount, s.views.count == PitchBankSet.count else { return }
+        setLock.lock()
+        let first = installedSet == nil
+        if first { installedSet = s }
+        setLock.unlock()
+        guard first else { return }
+        for i in 0..<PitchBankSet.count {
+            let v = s.views[i]
+            table[i] = v
+            onsetBank[i] = PitchBankLayout.bankTime(onsetFrame, sourceMarks: analysis.marks,
+                                                    bankMarks: Array(UnsafeBufferPointer(start: v.marks, count: markCount)),
+                                                    pitchFactor: v.pitchFactor)
+        }
+        ready.store(1, ordering: .releasing)
+    }
+
+    deinit {
+        state.deinitialize(count: 1); state.deallocate()
+        grains.deallocate(); window.deallocate(); table.deallocate()
+        marks.deallocate(); periods.deallocate(); dummyFull.deallocate(); dummyMarks.deallocate()
+        onsetBank.deallocate()
+    }
+
+    // MARK: SonificationRenderer
+
+    func setRate(_ rate: Float) {
+        liveRef.setRate(rate)
+        rateBits.store(min(2, max(0.5, rate.isFinite ? rate : 1)).bitPattern, ordering: .relaxed)
+    }
+    func setPitchCents(_ cents: Float) {
+        liveRef.setPitchCents(cents)
+        centsBits.store(min(1200, max(-1200, cents.isFinite ? cents : 0)).bitPattern, ordering: .relaxed)
+    }
+    func setGate(_ open: Bool) {
+        liveRef.setGate(open)
+        gateBits.store(open ? 1 : 0, ordering: .relaxed)
+    }
+    func reset() {
+        liveRef.reset()
+        gateBits.store(0, ordering: .relaxed)
+        _ = resetToken.wrappingAdd(1, ordering: .relaxed)
+    }
+    var claimedLatencyFrames: Int { live.claimedLatencyFrames }
+
+    func render(into out: UnsafeMutablePointer<Float>, frames: Int) {
+        let st = state
+        let token = resetToken.load(ordering: .relaxed)
+        if token != st.pointee.appliedReset {
+            st.pointee = State()
+            st.pointee.appliedReset = token
+        }
+        let gateOpen = gateBits.load(ordering: .relaxed) != 0
+        // The path is chosen when a note starts from silence. A note that is not on the banks (F, the carrier, or the
+        // banks not ready at its onset) is C1 live to its end.
+        if !st.pointee.onBank && !st.pointee.onLive && gateOpen {
+            if usesBanks && ready.load(ordering: .acquiring) != 0 {
+                st.pointee.onBank = true
+                startPlayback()
+            } else {
+                st.pointee.onLive = true
+                pathBits.store(Path.live.rawValue, ordering: .relaxed)
+            }
+        }
+        if st.pointee.onLive {
+            liveRef.render(into: out, frames: frames)
+            if !liveRef.isPlaying { st.pointee.onLive = false }
+            return
+        }
+        guard st.pointee.onBank else {
+            out.update(repeating: 0, count: frames)
+            return
+        }
+        renderBank(out, frames, gateOpen: gateOpen)
+    }
+
+    // MARK: bank path
+
+    private func renderBank(_ out: UnsafeMutablePointer<Float>, _ frames: Int, gateOpen: Bool) {
+        let st = state
+        let rateTarget = Float(bitPattern: rateBits.load(ordering: .relaxed))
+        let centsTarget = Float(bitPattern: centsBits.load(ordering: .relaxed))
+        st.pointee.gateTarget = gateOpen ? 1 : 0
+        if gateOpen && !st.pointee.playing { startPlayback() }
+        let coef = smoothCoef, step = gateStep
+        let gateTarget = st.pointee.gateTarget
+        let g = grains, w = window, tab = table
+        let equalPower = tuning.crossfade == .equalPower
+        var rate = st.pointee.rate, cents = st.pointee.cents
+        var gg = st.pointee.gateGain
+        var now = st.pointee.now, s = st.pointee.s
+        var attackActive = st.pointee.attackActive
+        var n = st.pointee.grainCount
+        var playing = true
+        var i = 0
+        while i < frames {
+            if rate != rateTarget || cents != centsTarget {
+                rate += (rateTarget - rate) * coef
+                if abs(rateTarget - rate) < 1e-6 { rate = rateTarget }
+                cents += (centsTarget - cents) * coef
+                if abs(centsTarget - cents) < 1e-4 { cents = centsTarget }
+            }
+            while g[n - 1].outCenter <= now { n = spawnNext(count: n, now: now, s: s, rate: rate, cents: cents,
+                                                            inAttack: attackActive) }
+            // Cross-fade weights (bank a = cur, bank b = nxt).
+            var nxt = st.pointee.nxt
+            if nxt >= 0 && now >= st.pointee.xfStart + st.pointee.xfLen {
+                st.pointee.cur = nxt; st.pointee.nxt = -1; nxt = -1
+            }
+            let ba = tab + st.pointee.cur
+            var wa: Float = 1, wb: Float = 0
+            if nxt >= 0 && now > st.pointee.xfStart {
+                let u = (now - st.pointee.xfStart) / st.pointee.xfLen
+                if equalPower {
+                    wa = Float(cos(0.5 * Double.pi * u)); wb = Float(sin(0.5 * Double.pi * u))
+                } else {
+                    wa = Float(1 - u); wb = Float(u)
+                }
+            }
+            let bb = tab + max(0, nxt)
+            var y: Float = 0
+            var gi = 0
+            while gi < n {
+                let gr = g[gi]
+                let x = now - gr.outCenter
+                var wt: Float = 0
+                if x < 0 {
+                    if gr.flatLeft { wt = 1 } else if -x < gr.leftW { wt = Self.windowAt(w, -x / gr.leftW) }
+                } else if x < gr.rightW {
+                    wt = Self.windowAt(w, x / gr.rightW)
+                } else if gi < n - 1 {
+                    var k = gi
+                    while k < n - 1 { g[k] = g[k + 1]; k += 1 }
+                    n -= 1
+                    continue
+                }
+                if wt > 0 {
+                    var v = Self.grainSample(ba, gr, x) * wa
+                    if wb > 0 { v += Self.grainSample(bb, gr, x) * wb }
+                    y += wt * v
+                }
+                gi += 1
+            }
+            if gg != gateTarget {
+                if gg < gateTarget { gg = min(gateTarget, gg + step) } else { gg = max(gateTarget, gg - step) }
+            }
+            out[i] = y * gg
+            if gg == 0 && gateTarget == 0 { playing = false }
+            if attackActive {
+                s += 1
+                if now + 1 >= st.pointee.attackEnd { attackActive = false }
+            } else {
+                s += Double(rate)
+            }
+            if s >= loopEnd { s -= loopLen }
+            now += 1
+            i += 1
+            if !playing {
+                if i < frames { (out + i).update(repeating: 0, count: frames - i) }
+                break
+            }
+        }
+        st.pointee.rate = rate
+        st.pointee.cents = cents
+        st.pointee.gateGain = gg
+        st.pointee.now = now
+        st.pointee.s = s
+        st.pointee.attackActive = attackActive
+        st.pointee.grainCount = n
+        st.pointee.playing = playing
+        if !playing { st.pointee.onBank = false }
+    }
+
+    /// Grain `gr` read from bank `b` at output offset `x` (inc 1: the bank already carries pf_k).
+    @inline(__always) private static func grainSample(_ b: UnsafeMutablePointer<PitchBankView>, _ gr: Grain,
+                                                      _ x: Double) -> Float {
+        let v = b.pointee
+        let p = v.marks[gr.mark] + x
+        if gr.noise >= 0 && v.hasNoise {
+            let q = v.marks[gr.noise] + x
+            return cubic(v.full, p, v.length) - cubic(v.noise, p, v.length) + cubic(v.noise, q, v.length)
+        }
+        return cubic(v.full, p, v.length)
+    }
+
+    @inline(__always) private static func cubic(_ b: UnsafeMutablePointer<Float>, _ pos: Double, _ len: Int) -> Float {
+        let lim = Double(PitchBankSet.guardFrames - 4)
+        let p = min(Double(len) + lim, max(-lim, pos))
+        let fl = p.rounded(.down)
+        let k = Int(fl)
+        let t = Float(p - fl)
+        if t == 0 { return b[k] }
+        let y0 = b[k &- 1], y1 = b[k], y2 = b[k &+ 1], y3 = b[k &+ 2]
+        let c1 = 0.5 * (y2 - y0)
+        let c2 = y0 - 2.5 * y1 + 2 * y2 - 0.5 * y3
+        let c3 = 0.5 * (y3 - y0) + 1.5 * (y1 - y2)
+        return ((c3 * t + c2) * t + c1) * t + y1
+    }
+
+    @inline(__always) private static func windowAt(_ window: UnsafeMutablePointer<Float>, _ u: Double) -> Float {
+        let p = u * Double(Self.windowSize)
+        if !(p < Double(Self.windowSize)) { return 0 }
+        let k = Int(p)
+        let t = Float(p - Double(k))
+        return window[k] + (window[k &+ 1] - window[k]) * t
+    }
+
+    @inline(__always) private static func bankIndex(_ cents: Float) -> Int {
+        let k = Int((Double(cents) / PitchBankSet.stepCents).rounded())
+        return min(PitchBankSet.steps, max(-PitchBankSet.steps, k)) + PitchBankSet.steps
+    }
+
+    private func startPlayback() {
+        let st = state
+        let rate = Float(bitPattern: rateBits.load(ordering: .relaxed))
+        let cents = Float(bitPattern: centsBits.load(ordering: .relaxed))
+        let k = Self.bankIndex(cents)
+        let v = table[k]
+        // The flat grain: the bank from the onset to the attack's first mark (the recorded pre-voicing transient and
+        // the first pulse at pf_k); its output time and the source read-head follow from the bank's own timing.
+        let m0 = firstMark
+        let tA = v.marks[m0] - onsetBank[k]
+        grains[0] = Grain(outCenter: tA, leftW: 0, rightW: periods[m0] / v.pitchFactor, mark: m0, flatLeft: true)
+        st.pointee.grainCount = 1
+        st.pointee.now = 0
+        st.pointee.s = marks[m0] - tA
+        st.pointee.attackEnd = marks[attackIndex] - st.pointee.s
+        st.pointee.attackActive = st.pointee.attackEnd > 0
+        st.pointee.cursor = m0
+        st.pointee.lowMark = m0
+        st.pointee.cur = k
+        st.pointee.nxt = -1
+        st.pointee.playing = true
+        st.pointee.rate = rate
+        st.pointee.cents = cents
+        st.pointee.rng = rngSeed
+        st.pointee.recent0 = -1
+        st.pointee.recent1 = -1
+        pathBits.store(Path.bank.rawValue, ordering: .relaxed)
+    }
+
+    @inline(never) private func spawnNext(count n0: Int, now: Double, s: Double, rate: Float, cents: Float,
+                                          inAttack: Bool) -> Int {
+        let st = state
+        var n = n0
+        if n >= Self.maxGrains {
+            var k = 0
+            while k < n - 1 { grains[k] = grains[k + 1]; k += 1 }
+            n -= 1
+        }
+        let li = n - 1
+        let last = grains[li]
+        let pf = exp2(Double(cents) / 1200)
+        let spacing = periods[last.mark] / pf
+        let tN = last.outCenter + spacing
+        let dt = tN - now
+        var sPred = inAttack ? s + dt : s + Double(rate) * dt
+        if !inAttack {
+            while sPred >= loopEnd { sPred -= loopLen }
+            while sPred < loopEnd - loopLen { sPred += loopLen }
+        }
+        let mark = nearestMark(sPred)
+        // Bank switch: the target bank for these cents; a cross-fade starts at this grain's mark.
+        let target = Self.bankIndex(cents)
+        if st.pointee.nxt < 0 && target != st.pointee.cur {
+            st.pointee.nxt = target
+            st.pointee.xfStart = tN
+            st.pointee.xfLen = max(1, tuning.crossfadePeriods * spacing)
+            _ = switchCount.wrappingAdd(1, ordering: .relaxed)
+        }
+        var halfW = spacing
+        if tuning.windowCap {
+            var pfB = table[st.pointee.cur].pitchFactor
+            if st.pointee.nxt >= 0 { pfB = max(pfB, table[st.pointee.nxt].pitchFactor) }
+            halfW = min(spacing, min(periods[last.mark], periods[mark]) / pfB)
+        }
+        grains[li].rightW = halfW
+        var gr = Grain(outCenter: tN, leftW: halfW, rightW: halfW, mark: mark)
+        if tuning.noiseSwap && mark >= attackIndex {
+            let natural = mark == (last.mark == loopEndIndex ? attackIndex : last.mark + 1)
+            var pick = mark
+            if !natural { pick = drawNoise(around: mark); gr.noise = pick }
+            st.pointee.recent1 = st.pointee.recent0
+            st.pointee.recent0 = pick
+        }
+        grains[n] = gr
+        return n + 1
+    }
+
+    /// C1 item 4's draw: a loop mark within +-8 of `m`, not one of the last two picks; xorshift64*.
+    private func drawNoise(around m: Int) -> Int {
+        let st = state
+        let lo = max(attackIndex, m - 8), hi = min(loopEndIndex, m + 8)
+        let r0 = st.pointee.recent0, r1 = st.pointee.recent1
+        var c = 0
+        var j = lo
+        while j <= hi { if j != r0 && j != r1 && j != m { c += 1 }; j += 1 }
+        guard c > 0 else { return m }
+        var x = st.pointee.rng
+        x ^= x >> 12; x ^= x << 25; x ^= x >> 27
+        st.pointee.rng = x
+        var k = Int((x &* 2685821657736338717) >> 33) % c
+        j = lo
+        while j <= hi {
+            if j != r0 && j != r1 && j != m { if k == 0 { return j }; k -= 1 }
+            j += 1
+        }
+        return m
+    }
+
+    private func nearestMark(_ pos: Double) -> Int {
+        let st = state
+        let first = min(st.pointee.lowMark, attackIndex), last = loopEndIndex
+        var c = st.pointee.cursor
+        if c < first || c > last || pos < marks[c] - periods[c] { c = first }
+        while c < last && marks[c + 1] <= pos { c += 1 }
+        st.pointee.cursor = c
+        if c >= attackIndex { st.pointee.lowMark = attackIndex }
+        if c == last { return pos - marks[last] > 0.5 * periods[last] ? attackIndex : last }
+        return (pos - marks[c]) <= (marks[c + 1] - pos) ? c : c + 1
+    }
+}
