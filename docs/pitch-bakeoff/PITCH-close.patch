--- /dev/null
+++ b/PrimaeNative/Core/Sonification/Candidates/WorldRT/WorldRTAnalysis.swift
@@ -0,0 +1,125 @@
+// WorldRTAnalysis.swift
+// PrimaeNative — pitch bake-off phase 2, candidate C2 "WorldRT" (2026-11-23)
+//
+// Init-time (off the render thread) source-filter analysis of one voiced
+// phoneme for the live WORLD-style renderer (BAKEOFF-PITCH.md section 2 C2).
+//
+// 1. F0 from OUR pitch marks (`TDPSOLAAnalysis`), not from a ported Harvest:
+//    the same marks C1 uses. Each mark's period T_i; a smooth contour
+//    Tbar_i = mean of T_{i-2..i+2}; the frame F0 (5 ms frames, WORLD's
+//    `frame_period`) is 1 / Tbar interpolated linearly between the period
+//    midpoints. A frame outside the marked span is unvoiced (F0 0).
+// 2. CheapTrick (WorldCheapTrick.swift) and D4C incl. LoveTrain
+//    (WorldD4C.swift) per frame, as WORLD computes them from that F0.
+// 3. Micro-variation WORLD loses (phase 1 MEASURED its jitter and shimmer at
+//    about x0.5 of the source): per mark, the relative period deviation
+//    d_i = T_i / Tbar_i - 1 (jitter) and the relative peak amplitude
+//    a_i = P_i / mean(P_{i-2..i+2}) (shimmer), P_i = max |x| over the period
+//    centred on the mark. The renderer can carry both into the synthesis.
+//
+// Storage is Float, frames x (N/2 + 1), N = CheapTrick's FFT size (2048 at
+// 44.1 kHz): about 4 MB for a 2.5 s phoneme (envelope + aperiodicity).
+
+import Foundation
+
+nonisolated struct WorldRTAnalysis: @unchecked Sendable {
+    let sampleRate: Double
+    let fftSize: Int
+    /// Frame period in source samples (5 ms).
+    let frameSamples: Double
+    let frameCount: Int
+    /// F0 (Hz) per frame; 0 = unvoiced.
+    let f0: [Double]
+    /// CheapTrick power envelope, frame-major, (N/2 + 1) per frame.
+    let spectrogram: [Float]
+    /// D4C amplitude aperiodicity, frame-major, (N/2 + 1) per frame.
+    let aperiodicity: [Float]
+    /// LoveTrain value per frame (<= 0.85: D4C judged the frame unvoiced and left it fully aperiodic).
+    let loveTrain: [Double]
+    /// Marks and their periods (source samples), the smooth period contour, jitter and shimmer per mark.
+    let marks: [Double]
+    let periods: [Double]
+    let smoothPeriods: [Double]
+    let jitter: [Double]
+    let shimmer: [Double]
+
+    var binCount: Int { fftSize / 2 + 1 }
+
+    /// Frames judged unvoiced by D4C LoveTrain although they lie inside the marked (voiced) span.
+    var loveTrainRejectedVoicedFrames: Int {
+        var n = 0
+        for k in 0..<frameCount where f0[k] > 0 && loveTrain[k] <= WorldConstants.kThreshold { n += 1 }
+        return n
+    }
+
+    static func analyse(_ source: [Float], sampleRate sr: Double, marks a: TDPSOLAAnalysis) -> WorldRTAnalysis {
+        precondition(a.isVoiced && a.marks.count >= 4, "WorldRTAnalysis needs a voiced analysis")
+        let x = source.map(Double.init)
+        let marks = a.marks, periods = a.periods
+        let m = marks.count
+        var smooth = [Double](repeating: 0, count: m)
+        for i in 0..<m {
+            let lo = max(0, i - 2), hi = min(m - 1, i + 2)
+            var s = 0.0
+            for j in lo...hi { s += periods[j] }
+            smooth[i] = s / Double(hi - lo + 1)
+        }
+        var jitter = [Double](repeating: 0, count: m)
+        for i in 0..<m { jitter[i] = max(-0.1, min(0.1, periods[i] / smooth[i] - 1)) }
+        var peak = [Double](repeating: 0, count: m)
+        for i in 0..<m {
+            let lo = max(0, Int((marks[i] - 0.5 * periods[i]).rounded()))
+            let hi = min(source.count, Int((marks[i] + 0.5 * periods[i]).rounded()))
+            var p = 0.0
+            if lo < hi { for j in lo..<hi { p = max(p, abs(x[j])) } }
+            peak[i] = p
+        }
+        var shimmer = [Double](repeating: 1, count: m)
+        for i in 0..<m {
+            let lo = max(0, i - 2), hi = min(m - 1, i + 2)
+            var s = 0.0
+            for j in lo...hi { s += peak[j] }
+            let mean = s / Double(hi - lo + 1)
+            shimmer[i] = mean > 0 ? max(0.5, min(2.0, peak[i] / mean)) : 1
+        }
+
+        // Frame F0 from the smooth contour, linear between period midpoints.
+        let frameSamples = WorldConstants.framePeriodSeconds * sr
+        let frameCount = Int(Double(source.count) / frameSamples) + 1
+        let mids = (0..<m).map { marks[$0] + 0.5 * periods[$0] }
+        var f0 = [Double](repeating: 0, count: frameCount)
+        let first = marks[0], last = marks[m - 1] + periods[m - 1]
+        var j = 0
+        for k in 0..<frameCount {
+            let t = Double(k) * frameSamples
+            guard t >= first && t < last else { continue }
+            while j < m - 2 && mids[j + 1] <= t { j += 1 }
+            let p: Double
+            if t <= mids[0] { p = smooth[0] }
+            else if t >= mids[m - 1] { p = smooth[m - 1] }
+            else {
+                let u = (t - mids[j]) / max(1e-9, mids[j + 1] - mids[j])
+                p = smooth[j] * (1 - u) + smooth[j + 1] * u
+            }
+            f0[k] = sr / p
+        }
+        let positions = (0..<frameCount).map { Double($0) * WorldConstants.framePeriodSeconds }
+
+        let ct = WorldCheapTrick(fs: sr)
+        let sp = ct.envelopes(x, positions: positions, f0: f0)
+        let d4c = WorldD4C(fs: sr, fftSize: ct.fftSize)
+        let ap = d4c.aperiodicity(x, positions: positions, f0: f0)
+        let bins = ct.fftSize / 2 + 1
+        var spF = [Float](repeating: 0, count: frameCount * bins)
+        var apF = [Float](repeating: 0, count: frameCount * bins)
+        for k in 0..<frameCount {
+            for b in 0..<bins {
+                spF[k * bins + b] = Float(sp[k][b])
+                apF[k * bins + b] = Float(ap[k][b])
+            }
+        }
+        return WorldRTAnalysis(sampleRate: sr, fftSize: ct.fftSize, frameSamples: frameSamples, frameCount: frameCount,
+                               f0: f0, spectrogram: spF, aperiodicity: apF, loveTrain: d4c.lastAperiodicity0,
+                               marks: marks, periods: periods, smoothPeriods: smooth, jitter: jitter, shimmer: shimmer)
+    }
+}
diff --git a/PrimaeNativeTests/SonificationWorldRT/WorldRTMetrics.swift b/PrimaeNativeTests/SonificationWorldRT/WorldRTMetrics.swift
