@@ -0,0 +1,111 @@
+// calibrate_main.swift — lane BENCH-P (2026-11-23)
+//
+// Runs the bench's OWN metric code (PitchMetrics.swift + BakeoffMetrics.swift, compiled stand-alone) on the phase-1
+// WAVs and prints them next to the phase-1 numbers (results.csv: Praat / scipy), so the Swift port is calibrated
+// against the instrument the phase-1 gates were stated in. Also emits the Swift-measured Praat-PSOLA envelope LSD per
+// (letter, cents), the reference the "envelope distance" gate is relative to (`PitchGates.praatLSD`).
+//
+// Build + run (macOS, no Xcode project needed):
+//   swiftc -O -parse-as-library PrimaeNativeTests/SonificationBakeoff/PitchMetrics.swift \
+//     PrimaeNativeTests/SonificationBakeoff/BakeoffMetrics.swift scripts/pitch_bakeoff/calibrate_main.swift -o <out>/calib
+//   <out>/calib <phase-1 folder (has wav/ and results.csv)> PrimaeNative/Resources/ [methods]
+import AVFoundation
+import Foundation
+
+@main
+struct Calibrate {
+    static let sr = 44_100.0
+    static let onset: [String: Int] = ["A": 18601, "F": 7887, "I": 4250, "L": 5800, "M": 6737]
+    static let gain: [String: Float] = ["A": 1.976714, "F": 2.9889367, "I": 1.8927121, "L": 1.89108, "M": 1.8769827]
+    static let live: Set<String> = ["ours", "ours_AB"]
+
+    static func load(_ path: String) -> [Float]? {
+        guard let f = try? AVAudioFile(forReading: URL(fileURLWithPath: path)),
+              let b = AVAudioPCMBuffer(pcmFormat: f.processingFormat, frameCapacity: AVAudioFrameCount(f.length)),
+              (try? f.read(into: b)) != nil, abs(f.processingFormat.sampleRate - sr) < 1 else { return nil }
+        let ch = Int(f.processingFormat.channelCount)
+        var x = [Float](repeating: 0, count: Int(b.frameLength))
+        for c in 0..<ch { for i in x.indices { x[i] += b.floatChannelData![c][i] / Float(ch) } }
+        return x
+    }
+
+    static func csv(_ path: String) -> [String: [String: String]] {
+        guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return [:] }
+        let lines = text.split(separator: "\n").map(String.init)
+        let head = lines[0].split(separator: ",", omittingEmptySubsequences: false).map(String.init)
+        var out: [String: [String: String]] = [:]
+        for l in lines.dropFirst() {
+            let v = l.split(separator: ",", omittingEmptySubsequences: false).map(String.init)
+            var d: [String: String] = [:]
+            for (k, x) in zip(head, v) { d[k] = x }
+            out["\(d["phoneme"]!)|\(d["method"]!)|\(d["cents"]!)"] = d
+        }
+        return out
+    }
+
+    static func f(_ v: Double?) -> String { v.map { String(format: "%.3f", $0) } ?? "-" }
+    static func f(_ s: String?) -> String { s.flatMap(Double.init).map { String(format: "%.3f", $0) } ?? "-" }
+
+    static func main() {
+        let a = CommandLine.arguments
+        let phase1 = a[1], res = a[2]
+        let methods = a.count > 3 ? a[3].split(separator: ",").map(String.init)
+            : ["source", "ours", "ours_AB", "praat_psola", "world", "world_g03", "praat_cg03", "anchor_naive", "psola_v2"]
+        let ref = csv(phase1 + "/results.csv")
+        print("L,method,cents,metric,swift,phase1")
+        for L in ["A", "F", "I", "L", "M"] {
+            guard var xs = load(res + "Letters/\(L)/\(L)_phoneme1.wav") else { print("missing source \(L)"); continue }
+            for i in xs.indices { xs[i] *= gain[L]! }
+            let ls = Double(xs.count) / sr
+            let s0 = Int((Double(onset[L]!) / sr + 0.08) * sr), s1 = Int((ls - 0.1) * sr)
+            let steady = xs[s0..<s1]
+            let srcEnv = PitchMetrics.envelopeDB(steady, sampleRate: sr)
+            let srcPert = L == "F" ? nil : PitchMetrics.perturbation(steady, sampleRate: sr)
+            let srcF0 = BakeoffMetrics.medianF0(BakeoffMetrics.yinTrack(Array(steady), start: 0, end: steady.count,
+                                                                        sampleRate: sr, hop: 220, fmin: 75, fmax: 700))
+            var base: [String: Double] = [:]
+            for m in methods {
+                for c in [0, -600, -300, 300, 600] {
+                    let name = c == 0 ? "\(L)__0c.wav" : String(format: "\(L)__%+dc.wav", c)
+                    guard let x = load("\(phase1)/wav/\(m)/\(name)") else { continue }
+                    let lx = Double(x.count) / sr
+                    let y: ArraySlice<Float> = live.contains(m)
+                        ? x[Int(0.6 * sr)..<min(x.count, Int(2.4 * sr))]
+                        : x[s0..<max(s0 + 1, Int((min(ls, lx) - 0.1) * sr))]
+                    let key = "\(L)|\(m)|\(c)"
+                    let r = ref[key]
+                    func row(_ metric: String, _ v: Double?, _ col: String) {
+                        print("\(L),\(m),\(c),\(metric),\(f(v)),\(f(r?[col]))")
+                    }
+                    let lvl = PitchMetrics.rmsDB(y)
+                    if c == 0 { base[m] = lvl }
+                    row("level_d_db", lvl - (base[m] ?? lvl), "level_d_db")
+                    let pf = pow(2, Double(c) / 1200)
+                    let env = PitchMetrics.envelopeDB(y, sampleRate: sr)
+                    if L == "F" {
+                        let cmp = PitchMetrics.envelopeCompare(f: env.f, source: srcEnv.e, output: env.e, lo: 500, hi: 16000)
+                        row("env_warp", cmp.warp, "env_warp"); row("env_lsd_db", cmp.lsd, "env_lsd_db")
+                        let hop = PitchMetrics.unvoicedHop(sampleRate: sr)
+                        row("f_wobble_db", PitchMetrics.grainRateWobble(y, period: hop), "mod200_db")
+                        if c != 0 { row("f_comb_acf", PitchMetrics.acf(y, lag: PitchMetrics.combLag(hop: hop, pitchFactor: pf)), "acf_max") }
+                    } else {
+                        let cmp = PitchMetrics.envelopeCompare(f: env.f, source: srcEnv.e, output: env.e)
+                        row("env_warp", cmp.warp, "env_warp"); row("env_lsd_db", cmp.lsd, "env_lsd_db")
+                        row("env_lsd_frame_db", PitchMetrics.framewiseEnvelopeLSD(source: steady, output: y, sampleRate: sr), "env_lsd_frame_db")
+                        let tr = BakeoffMetrics.yinTrack(Array(y), start: 0, end: y.count, sampleRate: sr, hop: 220, fmin: 75, fmax: 700)
+                        if let f0 = BakeoffMetrics.medianF0(tr), let s = srcF0 { row("f0_err_c", PitchMetrics.cents(f0, re: s * pf), "f0_err_c") }
+                        if let p = PitchMetrics.perturbation(y, sampleRate: sr) {
+                            row("jitter", p.jitterPct, "jitter"); row("shimmer", p.shimmerPct, "shimmer")
+                            if let sp = srcPert {
+                                let sj = Double(ref["\(L)|source|0"]?["jitter"] ?? "") ?? .nan
+                                let ssh = Double(ref["\(L)|source|0"]?["shimmer"] ?? "") ?? .nan
+                                print("\(L),\(m),\(c),jitter_ratio,\(f(p.jitterPct / sp.jitterPct)),\(f(Double(r?["jitter"] ?? "").map { $0 / sj }))")
+                                print("\(L),\(m),\(c),shimmer_ratio,\(f(p.shimmerPct / sp.shimmerPct)),\(f(Double(r?["shimmer"] ?? "").map { $0 / ssh }))")
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
