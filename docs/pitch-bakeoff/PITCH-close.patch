+// TDPSOLA2Sinc.swift
+// PrimaeNative — pitch bake-off phase 2, candidate C1 "TDPSOLA2" (2026-11-23; NOT wired into the study path)
+//
+// The band-limited interpolator of r27 candidate A (branch t3/tdpsola-pitch-candidates, 5dcc4b4f): a Kaiser-windowed
+// sinc, beta 8, 8 zero crossings, tabulated at 256 entries per unit and read with linear interpolation between
+// entries. Factored out of the renderer so the unvoiced F branch (item 1), the formant co-shift gamma (item 6), the
+// harmonic/noise bank reads and the init-time 16 kHz decimation of the epoch refinement (item 5) share ONE kernel.
+//
+// Real-time contract: `read` allocates nothing and touches no Swift array (the table is an UnsafeMutablePointer
+// owned by the caller and filled once, off the render thread, by `makeTable`).
+
+import Foundation
+
+nonisolated enum TDPSOLA2Sinc {
+    static let zeros = 8
+    static let res = 256
+    static let beta = 8.0
+    static var tableCount: Int { zeros * res + 2 }
+
+    /// The tabulated kernel, sinc(t) * Kaiser(t / zeros), t = i / res. Caller owns (and deallocates) the pointer.
+    static func makeTable() -> UnsafeMutablePointer<Float> {
+        let tn = tableCount
+        let p = UnsafeMutablePointer<Float>.allocate(capacity: tn)
+        for i in 0..<tn {
+            let t = Double(i) / Double(res)
+            let r = t / Double(zeros)
+            let sinc = t == 0 ? 1 : sin(Double.pi * t) / (Double.pi * t)
+            let win = r < 1 ? besselI0(beta * (1 - r * r).squareRoot()) / besselI0(beta) : 0
+            (p + i).initialize(to: Float(sinc * win))
+        }
+        return p
+    }
+
+    static func besselI0(_ x: Double) -> Double {
+        var sum = 1.0, term = 1.0, k = 1.0
+        while term > 1e-12 * sum { term *= (x / (2 * k)) * (x / (2 * k)); sum += term; k += 1 }
+        return sum
+    }
+
+    /// floor(v) without the trapping `Int(Double)` (see TDPSOLA.floorInt). Exact for |v| < 2^51.
+    @inline(__always) static func floorInt(_ v: Double) -> Int {
+        let fl = v.rounded(.down)
+        return Int(truncatingIfNeeded: (fl + 0x1.8p52).bitPattern) &- Int(truncatingIfNeeded: (0x1.8p52 as Double).bitPattern)
+    }
+
+    /// Band-limited read of `base` at fractional `pos`, low-passed at `cut` x the Nyquist of `base` (unity DC gain).
+    /// The caller guarantees base[floor(pos - zeros/cut) ... floor(pos + zeros/cut)] is readable.
+    @inline(__always) static func read(_ base: UnsafePointer<Float>, _ table: UnsafePointer<Float>,
+                                       _ pos: Double, _ cut: Double) -> Float {
+        let half = Double(zeros) / cut
+        var k = floorInt(pos - half) &+ 1
+        let kEnd = floorInt(pos + half)
+        let scale = cut * Double(res)
+        var acc: Float = 0
+        while k <= kEnd {
+            let u = abs(Double(k) - pos) * scale
+            let i = floorInt(u)
+            let f = Float(u - Double(i))
+            acc += base[k] * (table[i] + (table[i &+ 1] - table[i]) * f)
+            k &+= 1
+        }
+        return acc * Float(cut)
+    }
+}
diff --git a/PrimaeNativeTests/Sonification/TDPSOLA2/C1Metrics.swift b/PrimaeNativeTests/Sonification/TDPSOLA2/C1Metrics.swift
new file mode 100644
index 00000000..cc95dfca
--- /dev/null
+++ b/PrimaeNativeTests/Sonification/TDPSOLA2/C1Metrics.swift
@@ -0,0 +1,281 @@
+// C1Metrics.swift
+// PrimaeNativeTests — pitch bake-off phase 2, lane C1 "TDPSOLA2" (2026-11-23)
+//
+// The lane's own instruments, used until lane BENCH-P's harness lands (BAKEOFF-PITCH.md section 4; BENCH-P owns the
+// definitions, and these are to be replaced by its API). Ported from the phase-1 analysis scripts
+// (`method/metrics_r27.py`, `method/measure.py`), Foundation + Accelerate only, no test framework, so the same file
+// also builds into the lane's macOS render driver:
+//   - long-term spectrum (Hann, nfft 4096, 75 % overlap) and its Roebel-Rodet true envelope (cepstral order
+//     0.5 fs / 360 Hz = 61, iterate max(A, V) until the largest excess < 0.1 neper, <= 60 iterations);
+//   - envelope comparison over 150-5000 Hz: level-free LSD at alpha = 1, and the warp alpha in [0.6, 1.6]
+//     (201 steps) minimising the LSD of out(f) against src(f / alpha);
+//   - f0 (normalised autocorrelation, 70-500 Hz; SonificationMetrics.f0's rule) and its median;
+//   - mark-based period jitter / peak shimmer (marks from `TDPSOLAAnalysis` on the signal itself);
+//   - an autocorrelation HNR (Boersma 1993's r / (1 - r) at the strongest lag near the period, 40 ms frames).
+// Jitter, shimmer and HNR here are NOT Praat's numbers (no Praat on this seat); compare them only as ratios
+// against the source or another render measured the same way.
+
+import Foundation
+import Accelerate
+@testable import PrimaeNative
+
+nonisolated enum C1Metrics {
+    static let sr = 44100.0
+    static let nfft = 4096
+
+    static func rms(_ x: ArraySlice<Float>) -> Double {
+        guard !x.isEmpty else { return 0 }
+        var s = 0.0
+        for v in x { s += Double(v) * Double(v) }
+        return (s / Double(x.count)).squareRoot()
+    }
+    static func dB(_ a: Double, _ ref: Double) -> Double { a <= 0 || ref <= 0 ? -300 : 20 * log10(a / ref) }
+    static func cents(_ f: Double, _ ref: Double) -> Double { 1200 * log2(f / ref) }
+
+    // MARK: f0
+
+    static func f0(_ x: ArraySlice<Float>, from: Int, window: Int = 4096) -> Double? {
+        let b = x.startIndex + from
+        guard from >= 0, b + window + Int(sr / 70) + 2 <= x.endIndex else { return nil }
+        let minLag = Int(sr / 500), maxLag = Int(sr / 70)
+        var e0 = 0.0
+        for i in 0..<window { e0 += Double(x[b + i]) * Double(x[b + i]) }
+        guard e0 > 1e-9 else { return nil }
+        var r = [Double](repeating: 0, count: maxLag + 2)
+        for lag in (minLag - 1)...(maxLag + 1) {
+            var c = 0.0, e1 = 0.0
+            for i in 0..<window {
+                let p = Double(x[b + i]), q = Double(x[b + i + lag])
+                c += p * q; e1 += q * q
+            }
+            r[lag] = e1 > 0 ? c / (e0 * e1).squareRoot() : 0
+        }
+        var best = -2.0
+        for lag in minLag...maxLag { best = max(best, r[lag]) }
+        guard best > 0.3 else { return nil }
+        for lag in minLag...maxLag where r[lag] >= 0.9 * best && r[lag] >= r[lag - 1] && r[lag] >= r[lag + 1] {
+            let p = r[lag - 1], q = r[lag], s = r[lag + 1]
+            let d = p - 2 * q + s
+            return sr / (Double(lag) + (d != 0 ? 0.5 * (p - s) / d : 0))
+        }
+        return nil
+    }
+
+    /// f0 near `expected` (lags within +-15 %), same rule otherwise; raw pointers (fast in -Onone).
+    static func f0Near(_ x: ArraySlice<Float>, expected: Double, windows k: Int = 7, window: Int = 4096) -> Double? {
+        let maxLag = Int(sr / (expected / 1.15)) + 1, minLag = max(2, Int(sr / (expected * 1.15)))
+        let span = x.count - window - maxLag - 2
+        guard span > 0 else { return nil }
+        let a = Array(x)
+        var v: [Double] = []
+        a.withUnsafeBufferPointer { b in
+            let p = b.baseAddress!
+            for w in 0..<k {
+                let from = span * w / (k - 1)
+                var e0 = 0.0
+                for i in 0..<window { e0 += Double(p[from + i]) * Double(p[from + i]) }
+                guard e0 > 1e-9 else { continue }
+                var r = [Double](repeating: 0, count: maxLag + 2)
+                for lag in (minLag - 1)...(maxLag + 1) {
+                    var cc = 0.0, e1 = 0.0
+                    var i = 0
+                    while i < window { let q = Double(p[from + i + lag]); cc += Double(p[from + i]) * q; e1 += q * q; i &+= 1 }
+                    r[lag] = e1 > 0 ? cc / (e0 * e1).squareRoot() : 0
+                }
+                var best = minLag
+                for lag in minLag...maxLag where r[lag] > r[best] { best = lag }
+                guard r[best] > 0.3, best > minLag, best < maxLag else { continue }
+                let l = r[best - 1], m = r[best], h = r[best + 1]
+                let d = l - 2 * m + h
+                v.append(sr / (Double(best) + (d != 0 ? 0.5 * (l - h) / d : 0)))
+            }
+        }
+        guard v.count >= (k + 1) / 2 else { return nil }
+        v.sort()
+        return v[v.count / 2]
+    }
+
+    /// Median f0 over `k` windows spread through the slice.
+    static func medianF0(_ x: ArraySlice<Float>, windows k: Int = 9) -> Double? {
+        let window = 4096
+        let span = x.count - window - Int(sr / 70) - 2
+        guard span > 0 else { return nil }
+        let v = (0..<k).compactMap { f0(x, from: span * $0 / (k - 1), window: window) }.sorted()
+        guard v.count >= (k + 1) / 2 else { return nil }
+        return v[v.count / 2]
+    }
+
+    // MARK: true envelope
+
+    /// Long-term power spectrum, bins 0 ... nfft/2.
+    static func ltas(_ x: ArraySlice<Float>) -> [Double] {
+        let n = nfft, half = n / 2, hop = n / 4
+        let log2n = vDSP_Length(log2(Double(n)))
+        guard let setup = vDSP_create_fftsetup(log2n, FFTRadix(kFFTRadix2)) else { return [] }
+        defer { vDSP_destroy_fftsetup(setup) }
+        let win = (0..<n).map { Float(0.5 - 0.5 * cos(2 * Double.pi * Double($0) / Double(n))) }
+        var acc = [Double](repeating: 0, count: half + 1)
+        var frames = 0
+        var re = [Float](repeating: 0, count: half), im = [Float](repeating: 0, count: half)
+        var frame = [Float](repeating: 0, count: n)
+        var start = x.startIndex
+        while start + n <= x.endIndex {
+            for i in 0..<n { frame[i] = x[start + i] * win[i] }
+            re.withUnsafeMutableBufferPointer { rp in
+                im.withUnsafeMutableBufferPointer { ip in
+                    var split = DSPSplitComplex(realp: rp.baseAddress!, imagp: ip.baseAddress!)
+                    frame.withUnsafeBufferPointer { fp in
+                        fp.baseAddress!.withMemoryRebound(to: DSPComplex.self, capacity: half) {
+                            vDSP_ctoz($0, 2, &split, 1, vDSP_Length(half))
+                        }
+                    }
+                    vDSP_fft_zrip(setup, &split, 1, log2n, FFTDirection(FFT_FORWARD))
+                }
+            }
+            acc[0] += Double(re[0]) * Double(re[0])
+            acc[half] += Double(im[0]) * Double(im[0])
+            for k in 1..<half { acc[k] += Double(re[k]) * Double(re[k]) + Double(im[k]) * Double(im[k]) }
+            frames += 1
+            start += hop
+        }
+        return acc.map { $0 / Double(max(1, frames)) + 1e-20 }
+    }
+
+    /// Roebel-Rodet true envelope (dB) of a power spectrum with bins 0 ... n/2. (Raw pointers: the device test build
+    /// is -Onone, where array subscripts in this 15 M multiply-add loop cost seconds per envelope.)
+    static func trueEnvelope(_ P: [Double], order: Int, iters: Int = 60) -> [Double] {
+        let nb = P.count, n = 2 * (nb - 1)
+        let A = UnsafeMutablePointer<Double>.allocate(capacity: nb)
+        let V = UnsafeMutablePointer<Double>.allocate(capacity: nb)
+        let T = UnsafeMutablePointer<Double>.allocate(capacity: nb)
+        let cosT = UnsafeMutablePointer<Double>.allocate(capacity: n)
+        let c = UnsafeMutablePointer<Double>.allocate(capacity: order + 1)
+        defer { A.deallocate(); V.deallocate(); T.deallocate(); cosT.deallocate(); c.deallocate() }
+        for k in 0..<nb { A[k] = 0.5 * log(P[k]); V[k] = -Double.infinity }
+        for m in 0..<n { cosT[m] = cos(2 * Double.pi * Double(m) / Double(n)) }
+        for _ in 0..<iters {
+            for k in 0..<nb { T[k] = max(A[k], V[k]) }
+            var q = 0
+            while q <= order {
+                var s = T[0] + (q % 2 == 0 ? 1 : -1) * T[nb - 1]
+                var idx = 0, k = 1
+                while k < nb - 1 { idx &+= q; if idx >= n { idx &-= n }; s += 2 * T[k] * cosT[idx]; k &+= 1 }
+                c[q] = s / Double(n)
+                q &+= 1
+            }
+            var maxEx = -Double.infinity
+            var k = 0
+            while k < nb {
+                var v = c[0]
+                var idx = 0, qq = 1
+                while qq <= order { idx &+= k; if idx >= n { idx &-= n }; v += 2 * c[qq] * cosT[idx]; qq &+= 1 }
+                V[k] = v
+                maxEx = max(maxEx, A[k] - v)
+                k &+= 1
+            }
+            if maxEx < 0.1 { break }
+        }
+        return (0..<nb).map { V[$0] * 20 / log(10) }
+    }
+
+    static func envelope(_ x: ArraySlice<Float>, f0max: Double = 360) -> [Double] {
+        trueEnvelope(ltas(x), order: Int(0.5 * sr / max(f0max, 100)))
+    }
+
+    /// (LSD at alpha 1, best alpha, LSD at best alpha), level-free, over lo...hi Hz. `src` and `out` are envelopes (dB).
+    static func compare(src Ea: [Double], out Eb: [Double], lo: Double = 150, hi: Double = 5000)
+        -> (lsd: Double, alpha: Double, lsdWarped: Double) {
+        let df = sr / Double(nfft)
+        let band = (0..<Ea.count).filter { Double($0) * df >= lo && Double($0) * df <= hi }
+        func lsd(_ alpha: Double) -> Double {
+            var d = [Double](); d.reserveCapacity(band.count)
+            for k in band {
+                let f = Double(k) * df / alpha
+                let p = f / df
+                let i = min(Ea.count - 2, max(0, Int(p)))
+                let t = min(1, max(0, p - Double(i)))
+                d.append(Eb[k] - (Ea[i] + (Ea[i + 1] - Ea[i]) * t))
+            }
+            let m = d.reduce(0, +) / Double(d.count)
+            return (d.reduce(0) { $0 + ($1 - m) * ($1 - m) } / Double(d.count)).squareRoot()
+        }
+        var bestA = 1.0, bestL = Double.infinity
+        for k in 0..<201 {
+            let a = 0.6 + Double(k) * 0.005
+            let l = lsd(a)
+            if l < bestL { bestL = l; bestA = a }
+        }
+        return (lsd(1), bestA, bestL)
+    }
+
+    // MARK: micro-variation
+
+    /// Mark-based (jitter, shimmer) in percent: mean |T[k+1] - T[k]| / mean T, and mean |A[k+1] - A[k]| / mean A with
+    /// A[k] the peak |x| within +-T/2 of mark k. Marks from the renderer's own analysis run on `x`.
+    static func jitterShimmer(_ x: [Float]) -> (jitter: Double, shimmer: Double)? {
+        let a = TDPSOLAAnalysis.analyse(x, sampleRate: sr, kind: .voicedPhoneme)
+        guard a.isVoiced, a.marks.count > 20 else { return nil }
+        let m = a.marks
+        var t: [Double] = [], amp: [Double] = []
+        for k in 1..<(m.count - 1) {
+            t.append(m[k + 1] - m[k])
+            let h = Int(0.5 * (m[k + 1] - m[k]))
+            let c = Int(m[k])
+            var p: Float = 0
+            for i in max(0, c - h)..<min(x.count, c + h) { p = max(p, abs(x[i])) }
+            amp.append(Double(p))
+        }
+        func rel(_ v: [Double]) -> Double {
+            var d = 0.0
+            for k in 1..<v.count { d += abs(v[k] - v[k - 1]) }
+            let mean = v.reduce(0, +) / Double(v.count)
+            return 100 * (d / Double(v.count - 1)) / mean
+        }
+        return (rel(t), rel(amp))
+    }
+
+    /// Autocorrelation HNR (dB), mean over 40 ms frames (hop 10 ms) whose best r in [T/1.25, 1.25 T] is > 0.
+    static func acHNR(_ x: ArraySlice<Float>, f0: Double) -> Double {
+        let w = Int(0.04 * sr), hop = Int(0.01 * sr)
+        let T = sr / f0
+        let lo = Int(T / 1.25), hi = Int(T * 1.25) + 1
+        var vals: [Double] = []
+        var s = x.startIndex
+        while s + w + hi < x.endIndex {
+            var best = -1.0
+            var e0 = 0.0
+            for i in 0..<w { e0 += Double(x[s + i]) * Double(x[s + i]) }
+            for lag in lo...hi {
+                var c = 0.0, e1 = 0.0
+                for i in 0..<w { let q = Double(x[s + i + lag]); c += Double(x[s + i]) * q; e1 += q * q }
+                let r = e0 > 0 && e1 > 0 ? c / (e0 * e1).squareRoot() : 0
+                best = max(best, r)
+            }
+            if best > 0 { let r = min(best, 0.999999); vals.append(10 * log10(r / (1 - r))) }
+            s += hop
+        }
+        return vals.isEmpty ? -.infinity : vals.reduce(0, +) / Double(vals.count)
+    }
+
+    // MARK: driving a renderer
+
+    /// Steady render: gate open at 0 with fixed rate and cents, 256-frame buffers.
+    static func steady(_ r: any SonificationRenderer, seconds: Double, rate: Float, cents: Float) -> [Float] {
+        r.reset()
+        r.setRate(rate); r.setPitchCents(cents); r.setGate(true)
+        let total = Int(seconds * sr)
+        var out = [Float](repeating: 0, count: total)
+        out.withUnsafeMutableBufferPointer { b in
+            var pos = 0
+            while pos < total { let n = min(256, total - pos); r.render(into: b.baseAddress! + pos, frames: n); pos += n }
+        }
+        return out
+    }
+
+    /// FNV-1a over the bit patterns (device/macOS render identity).
+    static func hash(_ x: [Float]) -> UInt64 {
+        var h: UInt64 = 0xcbf29ce484222325
+        for v in x { h = (h ^ UInt64(v.bitPattern)) &* 0x100000001b3 }
+        return h
+    }
+}
diff --git a/PrimaeNativeTests/Sonification/TDPSOLA2/TDPSOLA2BranchTests.swift b/PrimaeNativeTests/Sonification/TDPSOLA2/TDPSOLA2BranchTests.swift
new file mode 100644
index 00000000..956eb81b
--- /dev/null
+++ b/PrimaeNativeTests/Sonification/TDPSOLA2/TDPSOLA2BranchTests.swift
@@ -0,0 +1,198 @@
+// TDPSOLA2BranchTests.swift
+// PrimaeNativeTests — pitch bake-off phase 2, lane C1 "TDPSOLA2", items 1 and 2 (2026-11-23)
+//
+// Item 1 is r27 candidate A as is, item 2 candidate B generalised; their r27 candidate suites
+// (`UnvoicedPitchShiftTests`, `VoicedDownshiftWindowTests`, branch t3/tdpsola-pitch-candidates, 5dcc4b4f / a601f528)
+// are ported here onto TDPSOLA2 with their thresholds unchanged (BAKEOFF-PITCH.md section 3, "F"), plus the two
+// cases the generalisation adds: an upshift with even periods is untouched, and with the formant ratio beta of item 6
+// a downshifted grain still holds one SOURCE period.
+
+import Testing
+import Foundation
+@testable import PrimaeNative
+
+@Suite("C1 item 1: a pitch-shifted F is a clean resample (candidate A's suite)")
+nonisolated struct TDPSOLA2UnvoicedTests {
+
+    static let sr = LiveSonificationKernel.sampleRate
+    static let shifts: [Float] = [-600, -300, 300, 600]
+
+    static func renderF(cents: Float, rate: Float = 1) throws -> [Float] {
+        SonificationDriver.steady(C1Make.make(try StudySources.load("F_phoneme1")), seconds: 2.5, rate: rate, cents: cents)
+    }
+    static var region: Range<Int> { Int(0.3 * sr)..<Int(2.4 * sr) }
+
+    static func grainRateWobble(_ y: [Float], period: Int) -> Double {
+        let bins = 20
+        var acc = [Double](repeating: 0, count: bins), cnt = [Double](repeating: 0, count: bins)
+        for i in region {
+            let b = ((i - region.lowerBound) % period) * bins / period
+            acc[b] += Double(y[i]) * Double(y[i]); cnt[b] += 1
+        }
+        let p = zip(acc, cnt).map { $0 / $1 }
+        return 10 * log10(p.max()! / p.min()!)
+    }
+
+    static func acf(_ y: [Float], lag: Double) -> Double {
+        let l = Int(lag), f = lag - Double(l)
+        var ab = 0.0, aa = 0.0, bb = 0.0
+        for i in region.lowerBound..<(region.upperBound - l - 1) {
+            let a = Double(y[i])
+            let b = (1 - f) * Double(y[i + l]) + f * Double(y[i + l + 1])
+            ab += a * b; aa += a * a; bb += b * b
+        }
+        return ab / (aa * bb).squareRoot()
+    }
+
+    @Test("no 200 Hz grain-rate buzz: power folded on the unvoiced hop varies by <= 1 dB at +-300 and +-600 cents")
+    func noGrainRateBuzz() throws {
+        let h = C1Make.make(try StudySources.load("F_phoneme1")).analysis.unvoicedHop
+        #expect(h == 221, "precondition: the hop the bounds were measured at")
+        for c in Self.shifts {
+            let w = Self.grainRateWobble(try Self.renderF(cents: c), period: h)
+            #expect(w <= 1.0, "F at \(c) cents: grain-rate wobble \(w) dB (shipped r27: ~3 dB)")
+        }
+    }
+
+    @Test("level holds: downshift within 0.3 dB of the 0-cent render, upshift within 1.2 dB")
+    func levelHolds() throws {
+        let r0 = SonificationMetrics.rms(try Self.renderF(cents: 0)[Self.region])
+        for c in Self.shifts {
+            let d = SonificationMetrics.dB(SonificationMetrics.rms(try Self.renderF(cents: c)[Self.region]), r0)
+            let bound = c < 0 ? 0.3 : 1.2
+            #expect(abs(d) <= bound, "F at \(c) cents: level \(d) dB re 0 cents (bound \(bound); shipped r27 -1.9)")
+        }
+    }
+
+    @Test("no upshift comb: the normalised autocorrelation at hop * (1 - 1/pf) stays below 0.1")
+    func noUpshiftComb() throws {
+        let h = Double(C1Make.make(try StudySources.load("F_phoneme1")).analysis.unvoicedHop)
+        for c in Self.shifts where c > 0 {
+            let pf = exp2(Double(c) / 1200)
+            let r = Self.acf(try Self.renderF(cents: c), lag: h * (1 - 1 / pf))
+            #expect(abs(r) < 0.1, "F at \(c) cents: ACF \(r) at the comb lag (shipped r27: 0.26 / 0.36)")
+        }
+    }
+
+    @Test("rate still does not move F: a shifted F renders bit-identically at rates 0.5, 1 and 2")
+    func rateDoesNotMoveShiftedF() throws {
+        for c in [Float(-600), 600] {
+            let a = try Self.renderF(cents: c, rate: 1)
+            for rt in [Float(0.5), 2] {
+                let b = try Self.renderF(cents: c, rate: rt)
+                #expect(a.count == b.count && zip(a, b).allSatisfy { $0.bitPattern == $1.bitPattern },
+                        "F at \(c) cents: rate \(rt) changed the render")
+            }
+        }
+    }
+}
+
+@Suite("C1 item 2: a voiced grain holds one source period (candidate B's suite, generalised)")
+nonisolated struct TDPSOLA2WindowTests {
+
+    static let sr = LiveSonificationKernel.sampleRate
+    static let period = 200
+
+    /// Candidate B's instrument: a 3 s train of 17-sample Hann blips (peak 0.5) every `period` frames, marks exactly on
+    /// the blips (analysis built by hand), `.bakeoff` tuning (no seam, no limiter). Items 3-5 off: this isolates the
+    /// window.
+    static func pulseTrain(_ o: TDPSOLA2Options) -> TDPSOLA2 {
+        let n = Int(3 * sr)
+        var x = [Float](repeating: 0, count: n)
+        var marks: [Double] = []
+        var m = 1000
+        while m + 2 * period < n {
+            for j in -8...8 { x[m + j] = Float(0.5 * (0.5 + 0.5 * cos(Double.pi * Double(j) / 9))) }
+            marks.append(Double(m))
+            m += period
+        }
+        let periods = [Double](repeating: Double(period), count: marks.count)
+        let attack = 3, loopEndIndex = marks.count - 4
+        let a = TDPSOLAAnalysis(onset: 0, isVoiced: true, voicedFraction: 1, medianPeriod: Double(period),
+                                marks: marks, periods: periods, attackIndex: attack, loopEndIndex: loopEndIndex,
+                                loopStart: marks[attack], loopEnd: marks[loopEndIndex] + Double(period),
+                                unvoicedHop: 221)
+        var opts = o
+        opts.pulseDensityExponent = 0; opts.harmonicNoiseSwap = false; opts.gciSnap = false
+        return TDPSOLA2(source: x, sampleRate: sr, kind: .voicedPhoneme, maxFramesPerRender: 512, analysis: a,
+                        tuning: .bakeoff, options: opts)
+    }
+
+    static func peaks(_ y: [Float]) -> [Float] {
+        var p: [Float] = []
+        for i in Int(0.4 * sr)..<Int(1.4 * sr) {
+            let v = abs(y[i])
+            guard v > 0.002 else { continue }
+            if ((i - 4)...(i + 4)).allSatisfy({ $0 == i || abs(y[$0]) < v || ($0 > i && abs(y[$0]) == v) }) { p.append(v) }
+        }
+        return p
+    }
+
+    static func checkNoEcho(_ y: [Float], cents: Float, label: String) throws {
+        let p = Self.peaks(y)
+        let main = try #require(p.max())
+        #expect(main > 0.45, "\(label): precondition: the main pulses play at full weight (\(main))")
+        let worst = p.filter { $0 < 0.5 * main }.max() ?? 0
+        #expect(worst < 0.02 * main, "\(label) \(cents) cents: secondary peak \(worst / main) of the main pulse")
+        let mains = p.filter { $0 >= 0.5 * main }.count
+        let expected = 1.0 * Self.sr / (Double(Self.period) / exp2(Double(cents) / 1200))
+        #expect(abs(Double(mains) - expected) <= 2, "\(label) \(cents) cents: \(mains) main pulses in 1 s, expected \(expected)")
+    }
+
+    @Test("-600 and -300 cents: no echo of a neighbouring source pulse (every secondary peak < 2 % of the main pulse)",
+          arguments: [Float(-600), -300])
+    func noOriginalPeriodEcho(cents: Float) throws {
+        try Self.checkNoEcho(SonificationDriver.steady(Self.pulseTrain(.default), seconds: 1.5, rate: 1, cents: cents),
+                             cents: cents, label: "gamma 0")
+    }
+
+    @Test("with the formant ratio of item 6 (gamma 0.5) a downshifted grain still holds one SOURCE period",
+          arguments: [Float(-600), -300])
+    func noEchoWithGamma(cents: Float) throws {
+        let o = C1Make.with { $0.formantGamma = 0.5 }
+        try Self.checkNoEcho(SonificationDriver.steady(Self.pulseTrain(o), seconds: 1.5, rate: 1, cents: cents),
+                             cents: cents, label: "gamma 0.5")
+    }
+
+    @Test("gamma 1 at -600 / -300 is a continuous resample: a sine with marks keeps a flat envelope (the cap is T / beta)",
+          arguments: [Float(-600), -300])
+    func gammaOneIsContinuous(cents: Float) throws {
+        // A sine of exactly one period per mark: at gamma 1 every grain is read at pf and spaced at T / pf, so
+        // consecutive grains are in phase and their halves (width T / beta = spacing) sum to 1. A cap of one OUTPUT
+        // period T instead of T / beta would leave gaps between the grains.
+        let n = Int(3 * Self.sr)
+        let x = (0..<n).map { Float(0.5 * sin(2 * Double.pi * Double($0) / Double(Self.period))) }
+        var marks: [Double] = []
+        var m = 1000
+        while m + 2 * Self.period < n { marks.append(Double(m)); m += Self.period }
+        let a = TDPSOLAAnalysis(onset: 0, isVoiced: true, voicedFraction: 1, medianPeriod: Double(Self.period),
+                                marks: marks, periods: [Double](repeating: Double(Self.period), count: marks.count),
+                                attackIndex: 3, loopEndIndex: marks.count - 4, loopStart: marks[3],
+                                loopEnd: marks[marks.count - 4] + Double(Self.period), unvoicedHop: 221)
+        let o = C1Make.with { $0.formantGamma = 1; $0.harmonicNoiseSwap = false; $0.gciSnap = false }
+        let r = TDPSOLA2(source: x, sampleRate: Self.sr, kind: .voicedPhoneme, maxFramesPerRender: 512, analysis: a,
+                         tuning: .bakeoff, options: o)
+        let y = SonificationDriver.steady(r, seconds: 1.5, rate: 1, cents: cents)
+        let outT = Int((Double(Self.period) / exp2(Double(cents) / 1200)).rounded())
+        var lo = Double.infinity, hi = 0.0
+        var i = Int(0.4 * Self.sr)
+        while i + outT < Int(1.4 * Self.sr) {
+            var pk: Float = 0
+            for k in i..<(i + outT) { pk = max(pk, abs(y[k])) }
+            lo = min(lo, Double(pk)); hi = max(hi, Double(pk))
+            i += outT
+        }
+        #expect(20 * log10(hi / lo) < 0.5, "\(cents) cents, gamma 1: per-period peak varies \(20 * log10(hi / lo)) dB")
+        #expect(abs(20 * log10(hi / 0.5)) < 0.5, "\(cents) cents, gamma 1: level \(hi) (source peak 0.5; no density gain at gamma 1)")
+    }
+
+    @Test("upshift with even periods is untouched by the cap (+300, +600: bit-identical to the cap off)")
+    func upshiftUntouched() throws {
+        var off = TDPSOLA2Options.default; off.voicedWindowCap = false
+        for c in [Float(300), 600] {
+            let a = SonificationDriver.steady(Self.pulseTrain(.default), seconds: 1.5, rate: 1, cents: c)
+            let b = SonificationDriver.steady(Self.pulseTrain(off), seconds: 1.5, rate: 1, cents: c)
+            #expect(zip(a, b).allSatisfy { $0.bitPattern == $1.bitPattern }, "\(c) cents: the cap changed an upshift")
+        }
+    }
+}
diff --git a/PrimaeNativeTests/Sonification/TDPSOLA2/TDPSOLA2EpochTests.swift b/PrimaeNativeTests/Sonification/TDPSOLA2/TDPSOLA2EpochTests.swift
new file mode 100644
index 00000000..048c3a3f
--- /dev/null
+++ b/PrimaeNativeTests/Sonification/TDPSOLA2/TDPSOLA2EpochTests.swift
@@ -0,0 +1,121 @@
+// TDPSOLA2EpochTests.swift
+// PrimaeNativeTests — pitch bake-off phase 2, lane C1 "TDPSOLA2", item 5 (2026-11-23)
+//
+// The SEDREAMS-style epoch refinement on a synthetic voice whose glottal closures are known: an impulse train
+// (closures with 0.5 % period jitter) through a two-formant all-pole tract. The coarse marks handed to the refiner
+// are the closures moved by a constant offset plus +-3 samples of noise (waveform-consistent marks are a constant
+// phase away from the closures, and less exact). Pinned:
+//   - the snap lands on the closures and is adopted (it LOWERS the marks' jitter here). "On the closures" is a
+//     precision claim plus a bounded bias: the LP residual of a band-limited signal peaks a constant ~5 samples
+//     (0.11 ms) after the closure (measured: signed error p5 3.8, median 5.1, p95 6.6 samples), which no PSOLA grain
+//     can hear (every mark moves alike); what matters is that the marks follow each period's closure;
+//   - the guard refuses a snap that raises the jitter (perfectly regular coarse marks: jitter 0) and keeps the marks;
+//   - the phase fallback moves a refused set by the median offset only when that offset is >= 0.15 period.
+
+import Testing
+import Foundation
+@testable import PrimaeNative
+
+@Suite("C1 item 5: epoch (GCI) refinement")
+nonisolated struct TDPSOLA2EpochTests {
+
+    static let sr = 44100.0
+    static let period = 189.0   // ~233 Hz, A's period
+
+    struct LCG {
+        var s: UInt64
+        mutating func next() -> Double {
+            s = s &* 6364136223846793005 &+ 1442695040888963407
+            return Double(s >> 11) / Double(1 << 53)
+        }
+    }
+
+    /// (signal, true closure instants).
+    static func voice(seed: UInt64 = 5) -> ([Float], [Double]) {
+        var rng = LCG(s: seed)
+        let n = Int(2.5 * sr)
+        var e = [Double](repeating: 0, count: n)
+        var gci: [Double] = []
+        var t = 600.0
+        while t < Double(n - 600) {
+            gci.append(t)
+            // A fractional impulse: linear split between the two neighbouring samples (negative-going closure).
+            let k = Int(t), f = t - Double(k)
+            e[k] -= 1 - f; e[k + 1] -= f
+            t += period * (1 + 0.005 * (2 * rng.next() - 1))
+        }
+        // Two resonators (F1 700 Hz, F2 1200 Hz, bandwidths 80 / 100 Hz) in cascade, plus a little noise.
+        func resonate(_ x: [Double], f: Double, bw: Double) -> [Double] {
+            let r = exp(-Double.pi * bw / sr), th = 2 * Double.pi * f / sr
+            let a1 = 2 * r * cos(th), a2 = -r * r
+            var y = [Double](repeating: 0, count: x.count)
+            for i in 0..<x.count { y[i] = x[i] + a1 * (i > 0 ? y[i - 1] : 0) + a2 * (i > 1 ? y[i - 2] : 0) }
+            return y
+        }
+        let y = resonate(resonate(e, f: 700, bw: 80), f: 1200, bw: 100)
+        let peak = y.map { abs($0) }.max()!
+        return (y.map { Float(0.5 * $0 / peak + 0.002 * (2 * rng.next() - 1)) }, gci)
+    }
+
+    static func analysis(marks: [Double]) -> TDPSOLAAnalysis {
+        var periods = [Double](repeating: 0, count: marks.count)
+        for i in 0..<(marks.count - 1) { periods[i] = marks[i + 1] - marks[i] }
+        periods[marks.count - 1] = periods[marks.count - 2]
+        let ai = 3, ei = marks.count - 4
+        return TDPSOLAAnalysis(onset: 0, isVoiced: true, voicedFraction: 1, medianPeriod: period, marks: marks,
+                               periods: periods, attackIndex: ai, loopEndIndex: ei, loopStart: marks[ai],
+                               loopEnd: marks[ei] + periods[ei], unvoicedHop: 221)
+    }
+
+    @Test("the snap follows the closures (spread about the bias <= 1.5 / p95 4 samples, bias <= 0.25 ms) and is adopted")
+    func snapFindsClosures() throws {
+        let (x, gci) = Self.voice()
+        var rng = LCG(s: 9)
+        let coarse = gci.map { $0 + 40 + 6 * (rng.next() - 0.5) }
+        let (a, rep) = TDPSOLA2Epochs.refine(x, sampleRate: Self.sr, analysis: Self.analysis(marks: coarse), guardRatio: 1.2)
+        print("C1GCI synthetic: \(rep.reason) gcis \(rep.gciCount) matched \(rep.matched)/\(rep.markCount) offset \(rep.medianOffset) jitter \(rep.jitterBefore) -> \(rep.jitterAfter) polarity \(rep.polarity)")
+        #expect(rep.applied, "refused: \(rep.reason)")
+        let signed = zip(a.marks, gci).map { $0 - $1 }.sorted()
+        let bias = signed[signed.count / 2]
+        let err = signed.map { abs($0 - bias) }.sorted()
+        let med = err[err.count / 2], p95 = err[err.count * 95 / 100]
+        print("C1GCI synthetic: mark - closure: bias \(bias); |error - bias| median \(med), p95 \(p95), max \(err.last!)")
+        #expect(abs(bias) <= 0.25e-3 * Self.sr, "bias \(bias) samples")
+        #expect(med <= 1.5, "median |error - bias| \(med) samples")
+        #expect(p95 <= 4, "p95 |error - bias| \(p95) samples")
+        #expect(a.loopStart == a.marks[a.attackIndex] && a.loopEnd == a.marks[a.loopEndIndex] + a.periods[a.loopEndIndex],
+                "the loop bounds follow the moved marks")
+    }
+
+    @Test("the guard keeps the old marks when the snap would raise their jitter")
+    func guardRefuses() throws {
+        let (x, gci) = Self.voice()
+        // Perfectly regular coarse marks (jitter 0) near the jittered closures: any snap raises the jitter.
+        let coarse = (0..<gci.count).map { gci[0] + 40 + Double($0) * Self.period }
+        let a0 = Self.analysis(marks: coarse)
+        let (a, rep) = TDPSOLA2Epochs.refine(x, sampleRate: Self.sr, analysis: a0, guardRatio: 1.2)
+        #expect(!rep.applied, "the snap was adopted: \(rep.reason)")
+        #expect(a.marks == a0.marks, "refused, yet the marks moved")
+    }
+
+    @Test("phase fallback: a refused set moves by the median GCI offset only when it is >= 0.15 period")
+    func phaseFallback() throws {
+        let (x, gci) = Self.voice()
+        for (offset, expectMove) in [(60.0, true), (12.0, false)] {
+            let coarse = (0..<gci.count).map { gci[0] + offset + Double($0) * Self.period }
+            let a0 = Self.analysis(marks: coarse)
+            // Through the renderer, as the option is applied there.
+            let r = TDPSOLA2(source: x, sampleRate: Self.sr, kind: .voicedPhoneme, maxFramesPerRender: 512, analysis: a0,
+                             tuning: .bakeoff, options: C1Make.with { $0.harmonicNoiseSwap = false })
+            let rep = try #require(r.epochReport)
+            #expect(rep.applied == expectMove, "offset \(offset): applied \(rep.applied) (\(rep.reason))")
+            let shift = r.analysis.marks[10] - coarse[10]
+            if expectMove {
+                #expect(abs(shift + offset) <= 3, "offset \(offset): marks moved by \(shift)")
+                #expect(rep.jitterAfter <= rep.jitterBefore + 1e-9, "a constant shift changed the jitter")
+            } else {
+                #expect(shift == 0, "offset \(offset): marks moved by \(shift)")
+            }
+        }
+    }
+}
diff --git a/PrimaeNativeTests/Sonification/TDPSOLA2/TDPSOLA2HarmonicNoiseTests.swift b/PrimaeNativeTests/Sonification/TDPSOLA2/TDPSOLA2HarmonicNoiseTests.swift
new file mode 100644
index 00000000..8a9e768d
--- /dev/null
+++ b/PrimaeNativeTests/Sonification/TDPSOLA2/TDPSOLA2HarmonicNoiseTests.swift
@@ -0,0 +1,118 @@
+// TDPSOLA2HarmonicNoiseTests.swift
+// PrimaeNativeTests — pitch bake-off phase 2, lane C1 "TDPSOLA2", item 4 (2026-11-23)
+//
+// The harmonic/noise split (Stylianou 2001; Bailly 1999) and the noise swap:
+//   - the bank: h_i + n_i is the analysis grain g_i, and a strictly periodic source has no noise part;
+//   - the swap does what it is for: on a "voiced" source of pure noise (marks by hand), an upshift re-plays periods;
+//     without the swap a re-played grain repeats its noise exactly (the output correlates with itself one output
+//     period later), with it the repeat carries another period's noise. What stays correlated is the harmonic
+//     estimate: on pure noise h_i is the 1-2-3-2-1 mean of five grains (19/81 of a grain's energy) and neighbouring
+//     grains share four of them, so the swap cannot reach zero here (measured macOS: 0.222 -> 0.125, x0.56);
+//   - determinism (product gate 4): the draws are seeded per source and re-seeded at every onset, so two instances,
+//     a reset and a gate re-open all reproduce the same output bit for bit.
+
+import Testing
+import Foundation
+@testable import PrimaeNative
+
+@Suite("C1 item 4: harmonic/noise split and noise swap")
+nonisolated struct TDPSOLA2HarmonicNoiseTests {
+
+    static let sr = LiveSonificationKernel.sampleRate
+    static let period = 200
+
+    struct LCG {
+        var s: UInt64
+        mutating func next() -> Float {
+            s = s &* 6364136223846793005 &+ 1442695040888963407
+            return Float(Double(s >> 11) / Double(1 << 53) * 2 - 1)
+        }
+    }
+
+    static func handAnalysis(count n: Int) -> TDPSOLAAnalysis {
+        var marks: [Double] = []
+        var m = 1000.0
+        while m + 2 * Double(period) < Double(n) { marks.append(m); m += Double(period) }
+        return TDPSOLAAnalysis(onset: 0, isVoiced: true, voicedFraction: 1, medianPeriod: Double(period), marks: marks,
+                               periods: [Double](repeating: Double(period), count: marks.count), attackIndex: 3,
+                               loopEndIndex: marks.count - 4, loopStart: marks[3],
+                               loopEnd: marks[marks.count - 4] + Double(period), unvoicedHop: 221)
+    }
+
+    @Test("the bank: h_i + n_i == g_i, and a periodic source's noise part is ~0")
+    func bankReconstructs() throws {
+        let n = Int(2 * Self.sr)
+        var rng = LCG(s: 7)
+        let noisy = (0..<n).map { _ in 0.3 * rng.next() }
+        let periodic = (0..<n).map { i in Float(0.4 * sin(2 * Double.pi * Double(i % Self.period) / Double(Self.period))) }
+        let a = Self.handAnalysis(count: n)
+        for (label, x) in [("noise", noisy), ("periodic", periodic)] {
+            let bank = x.withUnsafeBufferPointer {
+                TDPSOLA2HarmonicNoise($0.baseAddress!, count: n, marks: a.marks, periods: a.periods,
+                                      first: a.attackIndex, last: a.loopEndIndex)
+            }
+            var maxRec: Float = 0, maxN: Float = 0, maxG: Float = 0
+            for i in a.attackIndex...a.loopEndIndex {
+                let h = bank.harmonic(i), nz = bank.noise(i)
+                for k in 0..<bank.slotLength {
+                    let d = Double(k - bank.radius)            // marks are integers here: offset from the mark
+                    let t = Double(Self.period)
+                    let g: Float = abs(d) < t ? x[Int(a.marks[i]) + Int(d)] * Float(0.5 + 0.5 * cos(Double.pi * d / t)) : 0
+                    maxRec = max(maxRec, abs(h[k] + nz[k] - g))
+                    maxN = max(maxN, abs(nz[k])); maxG = max(maxG, abs(g))
+                }
+            }
+            #expect(maxRec < 1e-6, "\(label): |h + n - g| up to \(maxRec)")
+            if label == "periodic" { #expect(maxN < 1e-4 * maxG, "periodic: noise part up to \(maxN) (grain peak \(maxG))") }
+            else { #expect(maxN > 0.1 * maxG, "noise: the split left no noise part (\(maxN))") }
+        }
+    }
+
+    /// Normalised autocorrelation of the steady output at `lag`.
+    static func acf(_ y: [Float], lag: Int) -> Double {
+        var ab = 0.0, aa = 0.0, bb = 0.0
+        for i in Int(0.4 * sr)..<Int(1.9 * sr) {
+            let a = Double(y[i]), b = Double(y[i + lag])
+            ab += a * b; aa += a * a; bb += b * b
+        }
+        return ab / (aa * bb).squareRoot()
+    }
+
+    @Test("upshift +600 on a noise 'voice': without the swap a re-played grain repeats its noise; with it, it does not")
+    func swapBreaksRepeatedNoise() throws {
+        let n = Int(3 * Self.sr)
+        var rng = LCG(s: 11)
+        let x = (0..<n).map { _ in 0.3 * rng.next() }
+        let a = Self.handAnalysis(count: n)
+        func render(_ hn: Bool) -> [Float] {
+            let o = C1Make.with { $0.harmonicNoiseSwap = hn; $0.gciSnap = false; $0.pulseDensityExponent = 0 }
+            let r = TDPSOLA2(source: x, sampleRate: Self.sr, kind: .voicedPhoneme, maxFramesPerRender: 512, analysis: a,
+                             tuning: .bakeoff, options: o)
+            return SonificationDriver.steady(r, seconds: 2, rate: 1, cents: 600)
+        }
+        let lag = Int((Double(Self.period) / exp2(0.5)).rounded())    // one output period at +600
+        let plain = Self.acf(render(false), lag: lag), swapped = Self.acf(render(true), lag: lag)
+        print("C1HN acf at one output period: no swap \(plain), swap \(swapped)")
+        #expect(plain > 0.15, "instrument: without the swap the repeats must show (\(plain))")
+        #expect(swapped < 0.7 * plain, "the swap left the repeated noise correlated: \(swapped) (no swap \(plain))")
+    }
+
+    @Test("determinism: two instances, a reset and a gate re-open reproduce the output bit for bit",
+          arguments: StudySources.voicedNames)
+    func deterministic(name: String) throws {
+        let s = try StudySources.load(name)
+        let a = SonificationDriver.steady(C1Make.make(s), seconds: 1.5, rate: 0.7, cents: 450)
+        let r = C1Make.make(s)
+        let b = SonificationDriver.steady(r, seconds: 1.5, rate: 0.7, cents: 450)
+        let c = SonificationDriver.steady(r, seconds: 1.5, rate: 0.7, cents: 450)   // after reset()
+        let d = SonificationDriver.render(r, seconds: 2.2, events: [ControlEvent(time: 0, rate: 0.7, cents: 450, gate: true),
+                                                                   ControlEvent(time: 0.3, gate: false),
+                                                                   ControlEvent(time: 0.7, gate: true)])
+        #expect(a.elementsEqual(b) { $0.bitPattern == $1.bitPattern }, "\(name): two instances differ")
+        #expect(b.elementsEqual(c) { $0.bitPattern == $1.bitPattern }, "\(name): reset did not reproduce")
+        // The re-open at 0.7 s (after the 2 ms close ramp) restarts at the source start with the same draws.
+        let start = SonificationDriver.appliedFrame(0.7)
+        let tail = Array(d[start..<(start + Int(1.4 * Self.sr))])
+        #expect(tail.elementsEqual(a[0..<tail.count]) { $0.bitPattern == $1.bitPattern }, "\(name): re-open differs")
+    }
+}
diff --git a/PrimaeNativeTests/Sonification/TDPSOLA2/TDPSOLA2IdentityTests.swift b/PrimaeNativeTests/Sonification/TDPSOLA2/TDPSOLA2IdentityTests.swift
new file mode 100644
index 00000000..7ce53f9f
--- /dev/null
+++ b/PrimaeNativeTests/Sonification/TDPSOLA2/TDPSOLA2IdentityTests.swift
@@ -0,0 +1,136 @@
+// TDPSOLA2IdentityTests.swift
+// PrimaeNativeTests — pitch bake-off phase 2, lane C1 "TDPSOLA2" (2026-11-23)
+//
+// The candidate is a copy of the shipped renderer with items 1-6 behind options. These pin the copy:
+//   - every option off (`TDPSOLA2Options.r27`) IS the shipped TDPSOLA, bit for bit, for every study source under a
+//     drive that moves rate AND pitch (the phoneme arm is height-coupled from r26) with gate cycles and odd buffers;
+//   - the carrier is untouched by every option (items 1-6 apply to phonemes only);
+//   - with the default options, 0 cents at rate 1 is still the shipped output for every phoneme whose marks item 5
+//     left alone (the H/N swap reads the source on a grain that continues its predecessor), and differs exactly
+//     where item 5 moved the marks.
+
+import Testing
+import Foundation
+@testable import PrimaeNative
+
+nonisolated enum C1Make {
+    static let sr = LiveSonificationKernel.sampleRate
+    /// As production builds TDPSOLA (`LiveSonificationAudio.makeRenderer`, at the test sources' gain 1), plus options.
+    static func make(_ s: StudySource, _ o: TDPSOLA2Options = .default) -> TDPSOLA2 {
+        TDPSOLA2(source: s.samples, sampleRate: sr, kind: s.kind, maxFramesPerRender: LiveSonificationKernel.chunkFrames,
+                 tuning: .default, options: o, onset: s.onset, outputGain: 1)
+    }
+    static var noEpochs: TDPSOLA2Options { var o = TDPSOLA2Options.default; o.gciSnap = false; return o }
+    static func with(_ f: (inout TDPSOLA2Options) -> Void) -> TDPSOLA2Options { var o = TDPSOLA2Options.default; f(&o); return o }
+}
+
+@Suite("C1 TDPSOLA2: the copy is the shipped renderer where it should be")
+nonisolated struct TDPSOLA2IdentityTests {
+
+    struct LCG {
+        var s: UInt64
+        mutating func next() -> Double {
+            s = s &* 6364136223846793005 &+ 1442695040888963407
+            return Double(s >> 11) / Double(1 << 53)
+        }
+    }
+
+    /// (buffers, frames per buffer, rate, cents, gate): fixed rates, pitch extremes at two rates, gate cycles (a
+    /// re-open inside the fade included), then a seeded random walk of rate AND cents with odd buffer sizes.
+    static func script(sampleRate sr: Double) -> [(Int, Int, Float, Float, Bool)] {
+        let B = 256
+        var rng = LCG(s: 2026_11_23)
+        var sc: [(Int, Int, Float, Float, Bool)] = []
+        for rt in [Float(0.5), 1, 2] { sc.append((Int(0.6 * sr) / B, B, rt, 0, true)) }
+        for c in [Float(-1200), -600, -300, 300, 600, 1200] {
+            sc.append((Int(0.3 * sr) / B, B, 0.5, c, true))
+            sc.append((Int(0.3 * sr) / B, B, 1.7, c, true))
+        }
+        for _ in 0..<3 { sc.append((Int(0.25 * sr) / B, B, 1, 300, true)); sc.append((Int(0.08 * sr) / B, B, 1, 300, false)) }
+        sc.append((1, B, 1, 0, true)); sc.append((1, B, 1, 0, false)); sc.append((1, B, 1, -450, true))
+        let sizes = [1, 37, 255, 256, 300, 512]
+        for _ in 0..<700 {
+            let rt = Float(0.5 + 1.5 * rng.next())
+            let c = Float(-700 + 1400 * rng.next())
+            let g = rng.next() > 0.04
+            sc.append((1 + Int(rng.next() * 3), sizes[Int(rng.next() * Double(sizes.count)) % sizes.count], rt, c, g))
+        }
+        return sc
+    }
+
+    static func drive(_ r: any SonificationRenderer, _ sc: [(Int, Int, Float, Float, Bool)]) -> [Float] {
+        var out: [Float] = []
+        let buf = UnsafeMutablePointer<Float>.allocate(capacity: 512)
+        defer { buf.deallocate() }
+        r.reset()
+        for (nb, frames, rt, c, g) in sc {
+            r.setRate(rt); r.setPitchCents(c); r.setGate(g)
+            for _ in 0..<nb {
+                r.render(into: buf, frames: frames)
+                out.append(contentsOf: UnsafeBufferPointer(start: buf, count: frames))
+            }
+        }
+        return out
+    }
+
+    static func firstDifference(_ a: [Float], _ b: [Float]) -> Int? {
+        if a.count != b.count { return min(a.count, b.count) }
+        return a.indices.first { a[$0].bitPattern != b[$0].bitPattern }
+    }
+
+    @Test("every option off is the shipped TDPSOLA, bit for bit, under a rate + pitch + gate drive",
+          arguments: StudySources.names)
+    func r27OptionsAreTheShippedRenderer(name: String) throws {
+        let s = try StudySources.load(name)
+        let sc = Self.script(sampleRate: C1Make.sr)
+        let shipped = Self.drive(SonificationRendererUnderTest.make(s), sc)
+        let c1 = Self.drive(C1Make.make(s, .r27), sc)
+        #expect(shipped.count > 400_000, "precondition: the drive is long (\(shipped.count))")
+        let d = Self.firstDifference(shipped, c1)
+        #expect(d == nil, "\(name): first difference at frame \(d ?? -1)")
+    }
+
+    @Test("the carrier is untouched by the default options (items 1-6 are phoneme-only)")
+    func carrierUntouched() throws {
+        let s = try StudySources.load("spatial_carrier")
+        let sc = Self.script(sampleRate: C1Make.sr)
+        let shipped = Self.drive(SonificationRendererUnderTest.make(s), sc)
+        let g = C1Make.with { $0.formantGamma = 0.5 }
+        for o in [TDPSOLA2Options.default, g] {
+            let d = Self.firstDifference(shipped, Self.drive(C1Make.make(s, o), sc))
+            #expect(d == nil, "carrier, gamma \(o.formantGamma): first difference at frame \(d ?? -1)")
+        }
+    }
+
+    @Test("default options at 0 cents / rate 1: the shipped output wherever item 5 kept the marks",
+          arguments: ["A_phoneme1", "F_phoneme1", "I_phoneme1", "L_phoneme1", "M_phoneme1"])
+    func zeroCentsRateOne(name: String) throws {
+        let s = try StudySources.load(name)
+        let shipped = SonificationDriver.steady(SonificationRendererUnderTest.make(s), seconds: 3, rate: 1, cents: 0)
+        // Items 1-4 and 6 (gamma 0) leave 0 cents / rate 1 bit-identical.
+        let d0 = Self.firstDifference(shipped, SonificationDriver.steady(C1Make.make(s, C1Make.noEpochs), seconds: 3,
+                                                                         rate: 1, cents: 0))
+        #expect(d0 == nil, "\(name) without item 5: first difference at frame \(d0 ?? -1)")
+        // Item 5 changes it exactly where it moved the marks.
+        let r = C1Make.make(s)
+        let moved = r.epochReport?.applied ?? false
+        let d = Self.firstDifference(shipped, SonificationDriver.steady(r, seconds: 3, rate: 1, cents: 0))
+        #expect((d == nil) == !moved, "\(name): marks moved \(moved), first difference \(d ?? -1); \(r.epochReport?.reason ?? "-")")
+    }
+}
+
+@Suite("C1 TDPSOLA2: the device renders what the lane's macOS driver rendered")
+nonisolated struct TDPSOLA2RenderHashTests {
+    /// FNV-1a of a 2 s render (default options, rate 0.8, +450 c, gain 1), computed by the lane's macOS driver (-O and
+    /// -Onone alike, 2026-11-23). Equal on the iPad = the harness WAVs (rendered on macOS) are what the device plays.
+    static let expected: [String: UInt64] = ["A_phoneme1": 0x95b25a3e6fab38d8, "F_phoneme1": 0xef0be5da24eb9951,
+                                             "I_phoneme1": 0x784ed7c9d50a04ee]
+
+    @Test("render hash equals the macOS driver's", arguments: ["A_phoneme1", "F_phoneme1", "I_phoneme1"])
+    func hashMatches(name: String) throws {
