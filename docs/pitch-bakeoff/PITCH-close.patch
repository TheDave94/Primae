index 00000000..de16b251
--- /dev/null
+++ b/PrimaeNativeTests/SonificationWorldRT/WorldRTMetrics.swift
@@ -0,0 +1,119 @@
+// WorldRTMetrics.swift
+// PrimaeNativeTests — pitch bake-off phase 2, lane C2 "WorldRT" (2026-11-23)
+//
+// The lane's own instruments until BENCH-P's harness lands (BAKEOFF-PITCH.md section 4 owns the definitive metric
+// definitions). Pure functions over sample arrays; compiled into the macOS lane driver as well, so they import
+// nothing but Foundation and the module under test.
+
+import Foundation
+@testable import PrimaeNative
+
+nonisolated enum WorldRTMetrics {
+    static func rms(_ x: [Float], _ lo: Int, _ hi: Int) -> Double {
+        let a = max(0, lo), b = min(x.count, hi)
+        guard a < b else { return 0 }
+        var s = 0.0
+        for i in a..<b { s += Double(x[i]) * Double(x[i]) }
+        return (s / Double(b - a)).squareRoot()
+    }
+
+    static func dB(_ a: Double, _ ref: Double) -> Double { a <= 0 || ref <= 0 ? -300 : 20 * log10(a / ref) }
+
+    /// f0 (Hz) of x[from..<from+window]: normalised autocorrelation, 70-700 Hz, first local maximum within 90 % of
+    /// the best, parabola-refined (the shipped `SonificationMetrics.f0` method with the band widened for +600 c).
+    static func f0(_ x: [Float], from: Int, window: Int, sampleRate: Double) -> Double? {
+        let minLag = Int(sampleRate / 700), maxLag = Int(sampleRate / 70)
+        guard from >= 0, from + window + maxLag + 2 <= x.count else { return nil }
+        var e0 = 0.0
+        for i in 0..<window { e0 += Double(x[from + i]) * Double(x[from + i]) }
+        guard e0 > 1e-9 else { return nil }
+        var r = [Double](repeating: 0, count: maxLag + 2)
+        for lag in (minLag - 1)...(maxLag + 1) {
+            var c = 0.0, e1 = 0.0
+            for i in 0..<window {
+                let a = Double(x[from + i]), b = Double(x[from + i + lag])
+                c += a * b; e1 += b * b
+            }
+            r[lag] = e1 > 0 ? c / (e0 * e1).squareRoot() : 0
+        }
+        var best = -2.0
+        for lag in minLag...maxLag { best = max(best, r[lag]) }
+        guard best > 0.3 else { return nil }
+        for lag in minLag...maxLag where r[lag] >= 0.9 * best && r[lag] >= r[lag - 1] && r[lag] >= r[lag + 1] {
+            let a = r[lag - 1], b = r[lag], c = r[lag + 1]
+            let d = a - 2 * b + c
+            let off = d != 0 ? 0.5 * (a - c) / d : 0
+            return sampleRate / (Double(lag) + off)
+        }
+        return nil
+    }
+
+    /// Median f0 over nine 4096-sample windows spread through [from, to).
+    static func medianF0(_ x: [Float], from: Int, to: Int, sampleRate: Double) -> Double? {
+        let window = 4096
+        let span = to - from - window - Int(sampleRate / 70) - 2
+        guard span > 0 else { return nil }
+        let v = (0..<9).compactMap { k in f0(x, from: from + span * k / 8, window: window, sampleRate: sampleRate) }.sorted()
+        guard v.count >= 5 else { return nil }
+        return v[v.count / 2]
+    }
+
+    static func cents(_ f: Double, _ ref: Double) -> Double { 1200 * log2(f / ref) }
+
+    /// Local jitter and shimmer of x[from..<to] from its own epochs (`TDPSOLAAnalysis` marks on the segment):
+    /// jitter = mean |T_i - T_{i+1}| / mean T; shimmer = mean |P_i - P_{i+1}| / mean P, P = max |x| over the period
+    /// centred on the mark. The same instrument on source and output, so their RATIO is the reading.
+    static func jitterShimmer(_ x: [Float], from: Int, to: Int, sampleRate: Double) -> (jitter: Double, shimmer: Double)? {
+        let seg = Array(x[max(0, from)..<min(x.count, to)])
+        let a = TDPSOLAAnalysis.analyse(seg, sampleRate: sampleRate, kind: .voicedPhoneme)
+        guard a.isVoiced, a.marks.count > 20 else { return nil }
+        let m = a.marks, n = m.count
+        var periods: [Double] = [], peaks: [Double] = []
+        for i in 1..<(n - 1) {
+            let t = m[i + 1] - m[i]
+            periods.append(t)
+            let lo = Int((m[i] - 0.5 * (m[i] - m[i - 1])).rounded()), hi = Int((m[i] + 0.5 * t).rounded())
+            var p: Float = 0
+            for j in max(0, lo)..<min(seg.count, hi) { p = max(p, abs(seg[j])) }
+            peaks.append(Double(p))
+        }
+        func local(_ v: [Double]) -> Double {
+            var d = 0.0
+            for i in 0..<(v.count - 1) { d += abs(v[i] - v[i + 1]) }
+            let mean = v.reduce(0, +) / Double(v.count)
+            return mean > 0 ? d / Double(v.count - 1) / mean : 0
+        }
+        return (local(periods), local(peaks))
+    }
+
+    /// Click ratio at sample `t`: the largest |first difference| in the 5 ms window centred on `t`, over the 95th
+    /// percentile of the same in consecutive 5 ms windows from 100 to 600 ms after `t` (the r17 bench's click gate
+    /// is <= 2.5 on its own detector; this is the lane's stand-in until BENCH-P lands).
+    static func clickRatio(_ y: [Float], at t: Int, sampleRate: Double) -> Double {
+        let w = Int(0.005 * sampleRate)
+        func maxDiff(_ lo: Int) -> Float {
+            var m: Float = 0
+            for i in max(1, lo)..<min(y.count, lo + w) { m = max(m, abs(y[i] - y[i - 1])) }
+            return m
+        }
+        let local = maxDiff(t - w / 2)
+        var ref: [Float] = []
+        var i = t + Int(0.1 * sampleRate)
+        while i + w < min(y.count, t + Int(0.6 * sampleRate)) { ref.append(maxDiff(i)); i += w }
+        guard !ref.isEmpty else { return .infinity }
+        ref.sort()
+        let p95 = ref[ref.count * 95 / 100]
+        return p95 > 0 ? Double(local / p95) : .infinity
+    }
+
+    /// Short-window f0 track: (time in samples at the window centre, Hz), window 1024, hop 64.
+    static func f0Track(_ x: [Float], from: Int, to: Int, sampleRate: Double) -> [(Int, Double)] {
+        var out: [(Int, Double)] = []
+        var i = from
+        while i + 1024 + Int(sampleRate / 70) + 2 < min(to, x.count) {
+            if let f = f0(x, from: i, window: 1024, sampleRate: sampleRate) { out.append((i + 512, f)) }
+            i += 64
+        }
+        return out
+    }
+}
