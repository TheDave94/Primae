--- /dev/null
+++ b/PrimaeNativeTests/SonificationBakeoff/BakeoffScenarios.swift
@@ -0,0 +1,222 @@
+// BakeoffScenarios.swift
+// PrimaeNativeTests — sonification bake-off harness (BENCH lane, 2026-11-02)
+//
+// A scenario is a timed list of parameter writes (rate, pitch cents, gate)
+// applied to a renderer between 256-frame render calls, i.e. the way a
+// touch-thread write lands at the next I/O callback.
+//
+// Families (BAKEOFF.md / the BENCH brief):
+//   rate_<r>         fixed rate r in {0.5, 0.75, 1, 1.5, 2}, pitch 0
+//   pitch_<c>        carrier only: fixed cents in {-1200, -700, 0, +700, +1200}, rate 1
+//   step_rate_<a>to<b>   rate step at 0.6 s (phonemes + carrier)
+//   step_pitch_0to<c>    carrier only: pitch step at 0.6 s
+//   gate_cycle       open / close / reopen / close, rate 1
+//   traj_<L>_<profile>   real-trajectory drive from the letter's strokes.json
+//                    at child speed, parameters written at 120 Hz
+//
+// Trajectories reproduce the app's mapping, not an approximation of it:
+// velocity (pt/s) -> EMA with TouchDispatcher's alpha 0.22 ->
+// `TouchDispatcher.mapVelocityToSpeed`; height ->
+// `SpatialSonification.pitchCents(forNormalizedY:)` (carrier only; the
+// phoneme arm gets no pitch drive, ArmCoupling). Two stated
+// approximations: the letter's normalised y stands in for the canvas's
+// normalised y (the glyph box fills ~the canvas height), and the letter is
+// drawn in a 600 pt box (a 13-inch canvas, ~70 % fill). The playback
+// activation threshold and the B17/B18 lift/throttle refinements are not
+// modelled: the gate opens at the stroke's first sample.
+
+import CoreGraphics
+import Foundation
+@testable import PrimaeNative
+
+struct BakeoffEvent {
+    enum Kind { case rate(Float), cents(Float), gate(Bool) }
+    let time: Double
+    let kind: Kind
+}
+
+struct BakeoffScenario {
+    enum Family {
+        case fixedRate(Float)
+        case fixedPitch(Float)
+        case rateStep(from: Float, to: Float, at: Double)
+        case pitchStep(to: Float, at: Double)
+        case gateCycle
+        case trajectory(letter: String, profile: String, commandedRate: [(t: Double, v: Double)],
+                        commandedCents: [(t: Double, v: Double)])
+        // Pitch bake-off, phase 2 (PitchScenarios).
+        case heldPitch(cents: Float, rate: Float)
+        case pitchStepRated(from: Float, to: Float, at: Double, rate: Float)
+        case pitchSweep(rate: Float, commandedCents: [(t: Double, v: Double)])
+    }
+    let name: String
+    let family: Family
+    let duration: Double
+    let events: [BakeoffEvent]
+
+    /// Gate-open intervals (seconds) implied by the events.
+    var openIntervals: [(open: Double, close: Double)] {
+        var out: [(Double, Double)] = []
+        var openAt: Double?
+        for e in events {
+            if case .gate(let g) = e.kind {
+                if g, openAt == nil { openAt = e.time }
+                if !g, let o = openAt { out.append((o, e.time)); openAt = nil }
+            }
+        }
+        if let o = openAt { out.append((o, duration)) }
+        return out
+    }
+}
+
+enum BakeoffScenarios {
+
+    static let gateOpenTime = 0.05
+    static let fixedRates: [Float] = [0.5, 0.75, 1, 1.5, 2]
+    static let carrierCents: [Float] = [-1200, -700, 0, 700, 1200]
+    static let stepTime = 0.6
+
+    static func standard(for source: BakeoffSource, includeTrajectories: Bool,
+                         trajectoryLetters: [String]) throws -> [BakeoffScenario] {
+        var out: [BakeoffScenario] = []
+        let loopSeconds = Double(source.samples.count) / source.sampleRate
+        for r in fixedRates {
+            // At least ~1.6 output loops (a seam inside the render) and 1.5 s.
+            let d = gateOpenTime + max(1.5, min(8, 1.6 * loopSeconds / Double(r)))
+            out.append(BakeoffScenario(name: "rate_\(label(r))", family: .fixedRate(r), duration: d,
+                                       events: [.init(time: 0, kind: .rate(r)), .init(time: 0, kind: .cents(0)),
+                                                .init(time: gateOpenTime, kind: .gate(true))]))
+        }
+        if source.kind == .carrier {
+            for c in carrierCents {
+                out.append(BakeoffScenario(name: "pitch_\(label(c))", family: .fixedPitch(c), duration: 1.5,
+                                           events: [.init(time: 0, kind: .rate(1)), .init(time: 0, kind: .cents(c)),
+                                                    .init(time: gateOpenTime, kind: .gate(true))]))
+            }
+            for c: Float in [700, -700] {
+                out.append(BakeoffScenario(name: "step_pitch_0to\(label(c))", family: .pitchStep(to: c, at: stepTime),
+                                           duration: stepTime + 0.9,
+                                           events: [.init(time: 0, kind: .rate(1)), .init(time: 0, kind: .cents(0)),
+                                                    .init(time: gateOpenTime, kind: .gate(true)),
+                                                    .init(time: stepTime, kind: .cents(c))]))
+            }
+        }
+        for (a, b): (Float, Float) in [(1, 2), (1, 0.5)] {
+            out.append(BakeoffScenario(name: "step_rate_\(label(a))to\(label(b))",
+                                       family: .rateStep(from: a, to: b, at: stepTime), duration: stepTime + 0.9,
+                                       events: [.init(time: 0, kind: .rate(a)), .init(time: 0, kind: .cents(0)),
+                                                .init(time: gateOpenTime, kind: .gate(true)),
+                                                .init(time: stepTime, kind: .rate(b))]))
+        }
+        out.append(BakeoffScenario(name: "gate_cycle", family: .gateCycle, duration: 1.5,
+                                   events: [.init(time: 0, kind: .rate(1)), .init(time: 0, kind: .cents(0)),
+                                            .init(time: gateOpenTime, kind: .gate(true)),
+                                            .init(time: 0.55, kind: .gate(false)),
+                                            .init(time: 0.75, kind: .gate(true)),
+                                            .init(time: 1.25, kind: .gate(false))]))
+        if includeTrajectories {
+            let letters: [String] = source.kind == .carrier ? trajectoryLetters : [source.letter].compactMap { $0 }
+            for letter in letters {
+                let strokes = try BakeoffSources.strokes(letter: letter)
+                for profile in SpeedProfile.allCases {
+                    out.append(trajectory(letter: letter, strokes: strokes, profile: profile,
+                                          drivePitch: source.kind == .carrier))
+                }
+            }
+        }
+        return out
+    }
+
+    /// "0.5", "1", "2" for rates; "+700", "-1200", "0" for cents (>= 100 in magnitude).
+    static func label(_ v: Float) -> String {
+        abs(v) >= 100 ? String(format: "%+d", Int(v)) : String(format: "%g", Double(v))
+    }
+
+    // MARK: - Trajectories
+
+    enum SpeedProfile: String, CaseIterable {
+        /// LetterTracer.childSpeed: a slow, steady 200 pt/s.
+        case steady
+        /// Child-like: each stroke starts slow (50 pt/s) and swings
+        /// 50...350 pt/s with a 0.8 s period (accelerate, decelerate).
+        case varying
+
+        func speed(at t: Double) -> Double {
+            switch self {
+            case .steady: return 200
+            case .varying: return 200 * (1 + 0.75 * sin(2 * .pi * t / 0.8 - .pi / 2))
+            }
+        }
+    }
+
+    static let letterBoxPoints: Double = 600
+    static let parameterRate: Double = 120
+    static let penUpSeconds = 0.3
+    static let velocityAlpha: Double = 0.22
+
+    /// `centsForY` (pitch phase 2): the height -> cents mapping to drive (normalised y, 0 = top); nil = the r17
+    /// rule (the carrier's two-octave mapping when `drivePitch`, else 0).
+    static func trajectory(letter: String, strokes: LetterStrokes, profile: SpeedProfile,
+                           drivePitch: Bool, centsForY: ((Double) -> Float)? = nil) -> BakeoffScenario {
+        var events: [BakeoffEvent] = []
+        var rateCurve: [(t: Double, v: Double)] = []
+        var centsCurve: [(t: Double, v: Double)] = []
+        var t = gateOpenTime
+        let dt = 1 / parameterRate
+        for stroke in strokes.strokes {
+            let pts = stroke.checkpoints.map { CGPoint(x: $0.x * letterBoxPoints, y: $0.y * letterBoxPoints) }
+            guard pts.count >= 2 else { continue }
+            var cum: [Double] = [0]
+            for i in 1..<pts.count { cum.append(cum[i - 1] + Double(hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y))) }
+            let total = cum.last!
+            func point(at s: Double) -> CGPoint {
+                let s = min(max(0, s), total)
+                var i = 1
+                while i < cum.count - 1 && cum[i] < s { i += 1 }
+                let seg = cum[i] - cum[i - 1]
+                let f = seg > 0 ? (s - cum[i - 1]) / seg : 0
+                return CGPoint(x: pts[i - 1].x + (pts[i].x - pts[i - 1].x) * f,
+                               y: pts[i - 1].y + (pts[i].y - pts[i - 1].y) * f)
+            }
+            var s = 0.0, local = 0.0
+            var prev = point(at: 0)
+            var smoothed = 0.0
+            var first = true
+            while s < total {
+                s += profile.speed(at: local) * dt
+                local += dt
+                let p = point(at: s)
+                let v = Double(hypot(p.x - prev.x, p.y - prev.y)) / dt
+                smoothed = first ? v : smoothed + velocityAlpha * (v - smoothed)
+                prev = p
+                let rate = TouchDispatcher.mapVelocityToSpeed(CGFloat(smoothed))
+                let cents = centsForY.map { $0(Double(p.y / letterBoxPoints)) }
+                    ?? (drivePitch ? SpatialSonification.pitchCents(forNormalizedY: p.y / letterBoxPoints) : 0)
+                events.append(.init(time: t, kind: .rate(rate)))
+                events.append(.init(time: t, kind: .cents(cents)))
+                rateCurve.append((t, Double(rate)))
+                centsCurve.append((t, Double(cents)))
+                if first { events.append(.init(time: t, kind: .gate(true))); first = false }
+                t += dt
+            }
+            events.append(.init(time: t, kind: .gate(false)))
+            t += penUpSeconds
+        }
+        return BakeoffScenario(name: "traj_\(letter)_\(profile.rawValue)",
+                               family: .trajectory(letter: letter, profile: profile.rawValue,
+                                                   commandedRate: rateCurve, commandedCents: centsCurve),
+                               duration: t + 0.05, events: events)
+    }
+
+    /// Piecewise-constant lookup of a commanded curve (the value written last at or before `t`).
+    static func commanded(_ curve: [(t: Double, v: Double)], at t: Double) -> Double {
+        guard !curve.isEmpty else { return 0 }
+        var lo = 0, hi = curve.count - 1
+        if t < curve[0].t { return curve[0].v }
+        while lo < hi {
+            let mid = (lo + hi + 1) / 2
+            if curve[mid].t <= t { lo = mid } else { hi = mid - 1 }
+        }
+        return curve[lo].v
+    }
+}
diff --git a/PrimaeNativeTests/SonificationBakeoff/BakeoffSources.swift b/PrimaeNativeTests/SonificationBakeoff/BakeoffSources.swift
new file mode 100644
index 00000000..e9bb63d6
--- /dev/null
+++ b/PrimaeNativeTests/SonificationBakeoff/BakeoffSources.swift
@@ -0,0 +1,242 @@
+// BakeoffSources.swift
+// PrimaeNativeTests — sonification bake-off harness (BENCH lane, 2026-11-02)
+//
+// Sources: every bundled `<L>_phoneme1.*` asset the letter repository
+// reports (the study letters A F I L M at least) plus the spatial arm's
+// `spatial_carrier.wav`, decoded to mono Float32 and resampled to the bench
+// rate (48 kHz, and the 44.1 kHz variant the assets are authored at).
+// Resampling uses AVAudioConverter (mastering quality) over the loop tiled
+// three times, keeping the middle copy, so the loop seam carries no
+// converter edge transient.
+//
+// Also: a minimal 16-bit PCM WAV writer (no AVAudioFile, so the format of
+// what David listens to is exactly what is written here).
+
+import AVFAudio
+import Foundation
+@testable import PrimaeNative
+
+struct BakeoffSource {
+    /// e.g. "A_phoneme1", "spatial_carrier".
+    let name: String
+    /// The letter whose strokes drive this source's trajectories (nil = carrier).
+    let letter: String?
+    let kind: SourceKind
+    let sampleRate: Double
+    let samples: [Float]
+    /// Fraction of YIN frames voiced; how `kind` was decided for a phoneme.
+    let voicedFraction: Double
+    /// The synthetic sweep probe (rate metrics only; not a study asset).
+    var isProbe: Bool = false
+    /// Pitch phase 2: the loudness gain the kernel plays this file at (`AudioEngine.loudnessGain`), applied to the
+    /// exported WAVs only; and the file's recorded onset (`PhonemeOnsets`).
+    var gain: Float = 1
+    var onset: RecordedOnset? = nil
+
+    /// The source exactly as production hands it to a renderer (`SonificationSource.load`): every phoneme is
+    /// `.voicedPhoneme` (TDPSOLA's own analysis downgrades F); `kind` above is the BENCH's YIN classification, which
+    /// picks the metric family.
+    var sonification: SonificationSource {
+        SonificationSource(key: "bench:\(name)", samples: samples, kind: kind == .carrier ? .carrier : .voicedPhoneme,
+                           gain: gain, onset: onset)
+    }
+
+    /// Pitch phase 2: the steady segment the source-side references are taken from (measure.py: recorded onset
+    /// + 80 ms ... end - 100 ms; without an onset, 100 ms ... end - 100 ms).
+    var steadyRange: Range<Int> {
+        let from = (onset?.attackEndFrame ?? 0) + Int(((onset == nil ? 0.1 : 0.08) * sampleRate).rounded(.down))
+        let to = samples.count - Int(0.1 * sampleRate)
+        return min(from, max(0, to - 1))..<max(from + 1, to)
+    }
+
+    var kindLabel: String {
+        switch kind {
+        case .voicedPhoneme: return "voiced"
+        case .unvoicedPhoneme: return "unvoiced"
+        case .carrier: return "carrier"
+        }
+    }
+}
+
+enum BakeoffSources {
+
+    enum LoadError: Error { case missing(String), decode(String) }
+
+    /// Decode `url` to mono Float32 at `sampleRate`.
+    static func loadMono(url: URL, sampleRate: Double) throws -> [Float] {
+        let file = try AVAudioFile(forReading: url)
+        let fmt = file.processingFormat
+        guard let buf = AVAudioPCMBuffer(pcmFormat: fmt, frameCapacity: AVAudioFrameCount(file.length)) else {
+            throw LoadError.decode(url.lastPathComponent)
+        }
+        try file.read(into: buf)
+        let n = Int(buf.frameLength)
+        let channels = Int(fmt.channelCount)
+        guard let data = buf.floatChannelData else { throw LoadError.decode(url.lastPathComponent) }
+        var mono = [Float](repeating: 0, count: n)
+        for c in 0..<channels {
+            for i in 0..<n { mono[i] += data[c][i] / Float(channels) }
+        }
+        if abs(fmt.sampleRate - sampleRate) < 0.5 { return mono }
+        return try resampleLoop(mono, from: fmt.sampleRate, to: sampleRate)
+    }
+
+    private final class FeedState { var fed = false }
+
+    static func resampleLoop(_ loop: [Float], from: Double, to: Double) throws -> [Float] {
+        let tiled = loop + loop + loop
+        guard let inFmt = AVAudioFormat(standardFormatWithSampleRate: from, channels: 1),
+              let outFmt = AVAudioFormat(standardFormatWithSampleRate: to, channels: 1),
+              let conv = AVAudioConverter(from: inFmt, to: outFmt),
+              let inBuf = AVAudioPCMBuffer(pcmFormat: inFmt, frameCapacity: AVAudioFrameCount(tiled.count)) else {
+            throw LoadError.decode("converter")
+        }
+        conv.sampleRateConverterQuality = AVAudioQuality.max.rawValue
+        conv.sampleRateConverterAlgorithm = AVSampleRateConverterAlgorithm_Mastering
+        tiled.withUnsafeBufferPointer { inBuf.floatChannelData![0].update(from: $0.baseAddress!, count: tiled.count) }
+        inBuf.frameLength = AVAudioFrameCount(tiled.count)
+        let capacity = AVAudioFrameCount(Double(tiled.count) * to / from) + 8192
+        guard let outBuf = AVAudioPCMBuffer(pcmFormat: outFmt, frameCapacity: capacity) else {
+            throw LoadError.decode("converter out")
+        }
+        let state = FeedState()
+        var error: NSError?
+        let status = conv.convert(to: outBuf, error: &error) { _, outStatus in
+            if state.fed { outStatus.pointee = .endOfStream; return nil }
+            state.fed = true
+            outStatus.pointee = .haveData
+            return inBuf
+        }
+        if status == .error || error != nil { throw LoadError.decode("convert: \(String(describing: error))") }
+        let produced = Int(outBuf.frameLength)
+        let m = Int((Double(loop.count) * to / from).rounded())
+        guard produced >= 2 * m else { throw LoadError.decode("short conversion \(produced) < \(2 * m)") }
+        let p = outBuf.floatChannelData![0]
+        return Array(UnsafeBufferPointer(start: p + m, count: m))
+    }
+
+    /// Every phoneme1 asset + the carrier at `sampleRate`.
+    static func all(sampleRate: Double) throws -> [BakeoffSource] {
+        var out: [BakeoffSource] = []
+        let repo = LetterRepository(resources: BundleLetterResourceProvider(), cache: NullLetterCache(),
+                                    weight: .regular)
+        let letters = (try? repo.loadBundledLettersOnly().get()) ?? []
+        var seen = Set<String>()
+        for letter in letters.sorted(by: { $0.name < $1.name }) {
+            for file in letter.phonemeAudioFiles where file.contains("_phoneme1") {
+                let stem = ((file as NSString).lastPathComponent as NSString).deletingPathExtension
+                guard !seen.contains(stem) else { continue }
+                guard let url = PrimaeBundle.audioURL(for: file) else { throw LoadError.missing(file) }
+                seen.insert(stem)
+                let samples = try loadMono(url: url, sampleRate: sampleRate)
+                let track = BakeoffMetrics.yinTrack(samples, start: 0, end: samples.count,
+                                                    sampleRate: sampleRate, hop: Int(0.01 * sampleRate))
+                let vf = BakeoffMetrics.voicedFraction(track)
+                out.append(BakeoffSource(name: stem, letter: letter.baseLetter,
+                                         kind: vf >= 0.5 ? .voicedPhoneme : .unvoicedPhoneme,
+                                         sampleRate: sampleRate, samples: samples, voicedFraction: vf))
+            }
+        }
+        // The five study letters at least, even if the repository missed one.
+        for letter in TrainedLetterSubset.studyLetters where !seen.contains("\(letter)_phoneme1") {
+            guard let url = PrimaeBundle.resourceURL(firstOf: PrimaeBundle.layouts(
+                dir: "Letters/\(letter)", name: "\(letter)_phoneme1", ext: "wav")) else {
+                throw LoadError.missing("\(letter)_phoneme1")
+            }
+            seen.insert("\(letter)_phoneme1")
+            let samples = try loadMono(url: url, sampleRate: sampleRate)
+            let track = BakeoffMetrics.yinTrack(samples, start: 0, end: samples.count,
+                                                sampleRate: sampleRate, hop: Int(0.01 * sampleRate))
+            let vf = BakeoffMetrics.voicedFraction(track)
+            out.append(BakeoffSource(name: "\(letter)_phoneme1", letter: letter,
+                                     kind: vf >= 0.5 ? .voicedPhoneme : .unvoicedPhoneme,
+                                     sampleRate: sampleRate, samples: samples, voicedFraction: vf))
+        }
+        guard let carrierURL = SpatialSonification.carrierToneURL() else {
+            throw LoadError.missing(SpatialSonification.carrierToneFile)
+        }
+        let carrier = try loadMono(url: carrierURL, sampleRate: sampleRate)
+        let ctrack = BakeoffMetrics.yinTrack(carrier, start: 0, end: carrier.count,
+                                             sampleRate: sampleRate, hop: Int(0.01 * sampleRate))
+        out.append(BakeoffSource(name: "spatial_carrier", letter: nil, kind: .carrier,
+                                 sampleRate: sampleRate, samples: carrier,
+                                 voicedFraction: BakeoffMetrics.voicedFraction(ctrack)))
+        // The rate metrics' probe (BakeoffMetrics.sweepTrack), driven like a
+        // voiced phoneme (pitch held), trajectories from the letter A.
+        out.append(BakeoffSource(name: "probe_sweep", letter: "A", kind: .voicedPhoneme,
+                                 sampleRate: sampleRate, samples: BakeoffSynthetic.sweepProbe(sampleRate: sampleRate),
+                                 voicedFraction: 1, isProbe: true))
+        return out
+    }
+}
+
+extension BakeoffSources {
+    /// Pitch phase 2: the five study phonemes (A F I L M) as production decodes them (44.1 kHz, the kernel rate),
+    /// with their loudness gain and recorded onset; `kind` from YIN (F: unvoiced).
+    @MainActor
+    static func pitchSources(letters: [String] = TrainedLetterSubset.studyLetters) throws -> [BakeoffSource] {
+        try letters.map { letter in
+            let name = "\(letter)_phoneme1"
+            guard let url = PrimaeBundle.resourceURL(firstOf: PrimaeBundle.layouts(dir: "Letters/\(letter)", name: name,
+                                                                                   ext: "wav")) else {
+                throw LoadError.missing(name)
+            }
+            let sr = LiveSonificationKernel.sampleRate
+            let samples = try SonificationSource.decodeMono(url: url, sampleRate: sr)
+            let track = BakeoffMetrics.yinTrack(samples, start: 0, end: samples.count, sampleRate: sr,
+                                                hop: Int(0.01 * sr))
+            let vf = BakeoffMetrics.voicedFraction(track)
+            return BakeoffSource(name: name, letter: letter, kind: vf >= 0.5 ? .voicedPhoneme : .unvoicedPhoneme,
+                                 sampleRate: sr, samples: samples, voicedFraction: vf,
+                                 gain: AudioEngine.loudnessGain(forFileAt: url),
+                                 onset: PhonemeOnsets.onset(forFileNamed: url.lastPathComponent))
+        }
+    }
+
+    /// The Regular-weight stroke geometry of `letter` (the same
+    /// `strokes.json` the app loads and `LetterTracer` traces).
+    static func strokes(letter: String) throws -> LetterStrokes {
+        guard let url = PrimaeBundle.resourceURL(firstOf: PrimaeBundle.layouts(
+            dir: "Letters/Regular/\(letter)", name: "strokes", ext: "json")) else {
+            throw LoadError.missing("Letters/Regular/\(letter)/strokes.json")
+        }
+        return try JSONDecoder().decode(LetterStrokes.self, from: Data(contentsOf: url))
+    }
+}
+
+enum BakeoffWAV {
+    /// 32-bit float mono WAV (WAVE_FORMAT_IEEE_FLOAT), unclipped: the pitch renders keep their level for
+    /// `method/build_mushra.py`, which loudness-matches and scales per trial itself.
+    static func writeFloat(_ x: [Float], sampleRate: Double, to url: URL) throws {
+        var data = Data()
+        func u32(_ v: UInt32) { var le = v.littleEndian; data.append(Data(bytes: &le, count: 4)) }
+        func u16(_ v: UInt16) { var le = v.littleEndian; data.append(Data(bytes: &le, count: 2)) }
+        let sr = UInt32(sampleRate.rounded())
+        let bytes = UInt32(x.count * 4)
+        data.append(contentsOf: Array("RIFF".utf8)); u32(36 + bytes)
+        data.append(contentsOf: Array("WAVE".utf8))
+        data.append(contentsOf: Array("fmt ".utf8)); u32(16); u16(3); u16(1); u32(sr); u32(sr * 4); u16(4); u16(32)
+        data.append(contentsOf: Array("data".utf8)); u32(bytes)
+        x.withUnsafeBytes { data.append(contentsOf: $0) }
+        try FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+        try data.write(to: url)
+    }
+
+    /// 16-bit PCM mono WAV, hard-clipped at full scale.
+    static func write(_ x: [Float], sampleRate: Double, to url: URL) throws {
+        var data = Data()
+        func u32(_ v: UInt32) { var le = v.littleEndian; data.append(Data(bytes: &le, count: 4)) }
+        func u16(_ v: UInt16) { var le = v.littleEndian; data.append(Data(bytes: &le, count: 2)) }
+        let sr = UInt32(sampleRate.rounded())
+        let bytes = UInt32(x.count * 2)
+        data.append(contentsOf: Array("RIFF".utf8)); u32(36 + bytes)
+        data.append(contentsOf: Array("WAVE".utf8))
+        data.append(contentsOf: Array("fmt ".utf8)); u32(16); u16(1); u16(1); u32(sr); u32(sr * 2); u16(2); u16(16)
+        data.append(contentsOf: Array("data".utf8)); u32(bytes)
+        var pcm = [Int16](repeating: 0, count: x.count)
+        for i in 0..<x.count { pcm[i] = Int16(max(-32767, min(32767, (x[i] * 32767).rounded()))) }
+        pcm.withUnsafeBytes { data.append(contentsOf: $0) }
+        try FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+        try data.write(to: url)
+    }
+}
diff --git a/PrimaeNativeTests/SonificationBakeoff/BakeoffSynthetic.swift b/PrimaeNativeTests/SonificationBakeoff/BakeoffSynthetic.swift
new file mode 100644
index 00000000..db05522c
--- /dev/null
+++ b/PrimaeNativeTests/SonificationBakeoff/BakeoffSynthetic.swift
@@ -0,0 +1,153 @@
+// BakeoffSynthetic.swift
+// PrimaeNativeTests — sonification bake-off harness (BENCH lane, 2026-11-02)
+//
+// Synthetic signals with a known answer, for mutation-checking the metrics
+// (`BakeoffMetricSelfTests`). Foundation only.
+
+import Foundation
+
+enum BakeoffSynthetic {
+
+    /// Deterministic white noise in -0.5...0.5 (LCG; identical every run).
+    static func noise(_ n: Int, seed: UInt32 = 12345) -> [Float] {
+        var s = seed
+        return (0..<n).map { _ in
+            s = s &* 1_664_525 &+ 1_013_904_223
+            return Float(s >> 8) / Float(1 << 24) - 0.5
+        }
+    }
+
+    /// Harmonic tone (3 partials) at `f` Hz with a 2 ms attack starting at `start`.
+    static func tone(_ f: Double, count: Int, sampleRate: Double, start: Int = 0, amplitude: Float = 0.3) -> [Float] {
+        var x = [Float](repeating: 0, count: count)
+        let ramp = Int(0.002 * sampleRate)
+        for i in start..<count {
+            let t = Double(i - start) / sampleRate
+            let s = sin(2 * .pi * f * t) + 0.5 * sin(4 * .pi * f * t) + 0.25 * sin(6 * .pi * f * t)
+            let g = Float(min(1, Double(i - start) / Double(ramp)))
+            x[i] = Float(s) * amplitude * g / 1.75
+        }
+        return x
+    }
+
+    // MARK: - Sweep probe (the rate metrics' source)
+
+    static let sweepF0 = 120.0
+    static let sweepOctaves = 2.0
+    static let sweepSeconds = 2.0
+
+    /// A harmonic tone (3 partials, 0.3 peak) gliding exponentially from
+    /// 120 Hz to 480 Hz over 2 s, phase-continuous, with 10 ms fades at the
+    /// loop seam. Voice-like in range and spectrum, so a PSOLA candidate can
+    /// mark it; its pitch is its clock (`BakeoffMetrics.sweepTrack`).
+    static func sweepProbe(sampleRate: Double) -> [Float] {
+        let n = Int(sweepSeconds * sampleRate)
+        let fade = Int(0.01 * sampleRate)
+        var x = [Float](repeating: 0, count: n)
+        var phase = 0.0
+        for i in 0..<n {
+            let t = Double(i) / sampleRate
+            let f = sweepF0 * pow(2, sweepOctaves * t / sweepSeconds)
+            phase += 2 * .pi * f / sampleRate
+            let s = sin(phase) + 0.5 * sin(2 * phase) + 0.25 * sin(3 * phase)
+            let g = min(1, Double(min(i, n - 1 - i)) / Double(fade))
+            x[i] = Float(s * g * 0.3 / 1.75)
+        }
+        return x
+    }
+
+    /// What a PERFECT time-scale modification outputs for the sweep probe:
+    /// the source is read at `rate(outputFrame)` (source seconds per output
+    /// second) while the pitch at each instant is the source's pitch at the
+    /// read position, phase integrated in output time (a sinusoidal-model
+    /// TSM, exact for this signal). The known answer for the rate metrics.
+    static func idealSweepTSM(count: Int, sampleRate: Double, rate: (Int) -> Double) -> [Float] {
+        var x = [Float](repeating: 0, count: count)
+        var s = 0.0, phase = 0.0
+        for i in 0..<count {
+            let pos = s.truncatingRemainder(dividingBy: sweepSeconds)
+            let f = sweepF0 * pow(2, sweepOctaves * pos / sweepSeconds)
+            phase += 2 * .pi * f / sampleRate
+            let edge = min(pos, sweepSeconds - pos)
+            let g = min(1, edge / 0.01)
+            x[i] = Float((sin(phase) + 0.5 * sin(2 * phase) + 0.25 * sin(3 * phase)) * g * 0.3 / 1.75)
+            s += rate(i) / sampleRate
+        }
+        return x
+    }
+}
+
+// MARK: - Pitch phase 2 (lane BENCH-P): a source-filter vowel with a known answer
+
+extension BakeoffSynthetic {
+
+    /// A vowel by construction: band-limited glottal impulses (16-tap Hann-windowed sinc at the exact, fractional
+    /// pulse time) through a FIXED cascade of formant resonators (700/80, 1220/90, 2600/120 Hz; Klatt). Changing
+    /// `f0` moves the harmonics under the SAME envelope (an ideal envelope-preserving shift: warp alpha 1);
+    /// resampling the output moves the envelope with them (alpha = the resampling factor).
+    /// `f0At(t)` gives the instantaneous f0 (Hz) at time t (s); `jitter` / `shimmer` are the standard deviations of an
+    /// i.i.d. relative perturbation of each period / pulse amplitude (deterministic LCG). Returns the signal and the
+    /// periods (s) and amplitudes actually used.
+    static func vowel(seconds: Double, sampleRate sr: Double, f0At: (Double) -> Double, jitter: Double = 0,
+                      shimmer: Double = 0, seed: UInt32 = 777) -> (x: [Float], periods: [Double], amps: [Double]) {
+        let n = Int(seconds * sr)
+        var e = [Double](repeating: 0, count: n + 32)
+        var state = seed
+        func gauss() -> Double {   // Box-Muller over the LCG
+            state = state &* 1_664_525 &+ 1_013_904_223
+            let u1 = max(1e-12, Double(state) / 4_294_967_296)
+            state = state &* 1_664_525 &+ 1_013_904_223
+            let u2 = Double(state) / 4_294_967_296
+            return (-2 * log(u1)).squareRoot() * cos(2 * .pi * u2)
+        }
+        var t = 0.01
+        var periods: [Double] = [], amps: [Double] = []
+        while t * sr < Double(n) {
+            let a = 1 + shimmer * gauss()
+            let pos = t * sr
+            let c = Int(pos.rounded(.down))
+            for k in -7...8 {
+                let i = c + k
+                guard i >= 0 && i < e.count else { continue }
+                let d = Double(i) - pos
+                let w = 0.5 + 0.5 * cos(.pi * d / 8.5)
+                let s = abs(d) < 1e-12 ? 1 : sin(.pi * d) / (.pi * d)
+                e[i] += a * s * w
+            }
+            amps.append(a)
+            let p = (1 / f0At(t)) * (1 + jitter * gauss())
+            periods.append(p)
+            t += p
+        }
+        var y = Array(e[0..<n])
+        for (f, bw) in [(700.0, 80.0), (1220.0, 90.0), (2600.0, 120.0)] {
+            let r = exp(-.pi * bw / sr)
+            let a1 = 2 * r * cos(2 * .pi * f / sr), a2 = -r * r
+            let g = 1 - a1 - a2   // unity gain at DC
+            var y1 = 0.0, y2 = 0.0
+            for i in 0..<n {
+                let v = g * y[i] + a1 * y1 + a2 * y2
+                y2 = y1; y1 = v; y[i] = v
+            }
+        }
+        let peak = y.map(abs).max() ?? 1
+        return (y.map { Float(0.5 * $0 / peak) }, periods, amps)
+    }
+
+    /// Reads `x` at `factor` times its own speed (linear interpolation): a resampled ("chipmunk") copy.
+    static func resample(_ x: [Float], factor: Double) -> [Float] {
+        let n = Int(Double(x.count - 1) / factor)
+        return (0..<n).map { i in
+            let p = Double(i) * factor
+            let k = Int(p), f = Float(p - Double(k))
+            return x[k] + f * (x[min(k + 1, x.count - 1)] - x[k])
+        }
+    }
+
+    /// Local jitter / shimmer (percent) of a generated sequence, the quantity `PitchMetrics.perturbation` estimates.
+    static func localPerturbation(_ v: [Double]) -> Double {
+        var d = 0.0, s = 0.0
+        for i in 1..<v.count { d += abs(v[i] - v[i - 1]); s += 0.5 * (v[i] + v[i - 1]) }
+        return d / s * 100
+    }
+}
diff --git a/PrimaeNativeTests/SonificationBakeoff/PitchGates.swift b/PrimaeNativeTests/SonificationBakeoff/PitchGates.swift
new file mode 100644
index 00000000..75dc6a85
--- /dev/null
+++ b/PrimaeNativeTests/SonificationBakeoff/PitchGates.swift
@@ -0,0 +1,111 @@
+// PitchGates.swift
+// PrimaeNativeTests — pitch bake-off harness, phase 2 (lane BENCH-P, 2026-11-23)
+//
+// The pitch-specific acceptance gates of BAKEOFF-PITCH.md section 3
+// (CONFIRMED by the supervisor, BRIEF-pitch-lanes.md) as predicates over the
+// metric values. The bench writes one gates.csv row per (candidate, source,
+// scenario, gate); the self-tests feed known-bad renders through the SAME
+// predicates and require them to FAIL (section 4.4).
+//
+// Reference values that are not computable in the harness (Praat runs
+// offline) are FIXED here, measured by this harness's own metric code on
+// the phase-1 WAVs (scripts/pitch_bakeoff/calibrate_main.swift), so the gate
+// compares like with like.
+
+import Foundation
+
+enum PitchGates {
+
+    struct Result {
+        let gate: String
+        let value: Double
+        let threshold: String
+        let pass: Bool
+    }
+
+    // MARK: thresholds (BAKEOFF-PITCH section 3)
+
+    /// F0 accuracy: voiced, |error| <= 5 cents at +-300 / +-600, rates 0.5 / 1 / 2.
+    static let f0ToleranceCents = 5.0
+    /// Envelope held: warp alpha within pf^gamma +- 0.03 (gamma 0 = strict preservation).
+    static let warpTolerance = 0.03
+    /// Envelope distance: LSD <= 1.2 x Praat PSOLA's for the same source and cents.
+    static let lsdFactor = 1.2
+    /// Micro-variation: output jitter and shimmer within x0.6 ... x1.6 of the source's.
+    static let microVariationRange: ClosedRange<Double> = 0.6...1.6
+    /// Level flatness: steady RMS within +-1.5 dB of the 0-cent render (David may set another value, P4).
+    static let levelToleranceDB = 1.5
+    /// F: grain-rate wobble <= 1 dB; level within 0.3 dB (down) / 1.2 dB (up); comb ACF < 0.1.
+    static let fWobbleDB = 1.0
+    static let fLevelDownDB = 0.3
+    static let fLevelUpDB = 1.2
+    static let fCombACF = 0.1
+    /// Pitch control lag: a step reaches 90 % within 15 ms; trajectory pitch lag <= 10 ms.
+    static let step90MS = 15.0
+    static let trajectoryLagMS = 10.0
+    /// Clicks at pitch steps and during sweeps: ratio <= 2.5 (the r17 bench gate).
+    static let clickRatio = 2.5
+
+    /// Praat PSOLA's long-term true-envelope LSD (dB, 150-5000 Hz) per letter and cents, measured by
+    /// `PitchMetrics.envelopeCompare` on phase-1 `wav/praat_psola/<L>__<c>c.wav` (rate 1) against the gained source's
+    /// steady segment. Phase-1 scipy values agree within 0.002 dB (BENCH-P.md, calibration).
+    static let praatLSD: [String: [Int: Double]] = [
+        "A": [-600: 0.963, -300: 1.563, 0: 0.374, 300: 1.157, 600: 1.368],
+        "I": [-600: 1.839, -300: 2.888, 0: 0.097, 300: 3.226, 600: 4.099],
+        "L": [-600: 1.291, -300: 2.106, 0: 0.197, 300: 2.640, 600: 3.435],
+        "M": [-600: 1.855, -300: 1.277, 0: 0.502, 300: 1.869, 600: 1.745],
+    ]
+
+    // MARK: predicates
+
+    static func f0(errorCents e: Double) -> Result {
+        Result(gate: "f0_within_5c", value: e, threshold: "|e| <= \(f0ToleranceCents)", pass: abs(e) <= f0ToleranceCents)
+    }
+
+    static func warp(alpha: Double, pitchFactor pf: Double, gamma: Double = 0) -> Result {
+        let target = pow(pf, gamma)
+        return Result(gate: "env_warp", value: alpha, threshold: String(format: "%.3f +- %.2f", target, warpTolerance),
+                      pass: abs(alpha - target) <= warpTolerance + 1e-9)
+    }
+
+    /// Nil when there is no Praat reference for (letter, cents).
+    static func envelopeLSD(_ lsd: Double, letter: String, cents: Int) -> Result? {
+        guard let ref = praatLSD[letter]?[cents] else { return nil }
+        let bound = lsdFactor * ref
+        return Result(gate: "env_lsd_vs_praat", value: lsd, threshold: String(format: "<= %.3f", bound), pass: lsd <= bound)
+    }
+
+    static func microVariation(_ name: String, ratio: Double) -> Result {
+        Result(gate: name, value: ratio, threshold: "0.6 ... 1.6", pass: microVariationRange.contains(ratio))
+    }
+
+    static func level(reZeroDB d: Double) -> Result {
+        Result(gate: "level_flat", value: d, threshold: "|d| <= \(levelToleranceDB)", pass: abs(d) <= levelToleranceDB)
+    }
+
+    static func fWobble(_ dB: Double) -> Result {
+        Result(gate: "f_wobble", value: dB, threshold: "<= \(fWobbleDB)", pass: dB <= fWobbleDB)
+    }
+
+    static func fLevel(reZeroDB d: Double, cents: Float) -> Result {
+        let bound = cents < 0 ? fLevelDownDB : fLevelUpDB
+        return Result(gate: "f_level", value: d, threshold: "|d| <= \(bound)", pass: abs(d) <= bound)
+    }
+
+    static func fComb(_ r: Double) -> Result {
+        Result(gate: "f_comb", value: r, threshold: "|r| < \(fCombACF)", pass: abs(r) < fCombACF)
+    }
+
+    static func step90(ms: Double?) -> Result {
+        Result(gate: "pitch_step_90", value: ms ?? .nan, threshold: "<= \(step90MS) ms", pass: (ms ?? .infinity) <= step90MS)
+    }
+
+    static func trajectoryLag(ms: Double?) -> Result {
+        Result(gate: "traj_pitch_lag", value: ms ?? .nan, threshold: "<= \(trajectoryLagMS) ms",
+               pass: (ms ?? .infinity) <= trajectoryLagMS)
+    }
+
+    static func clicks(_ name: String, ratio: Double) -> Result {
+        Result(gate: name, value: ratio, threshold: "<= \(clickRatio)", pass: ratio <= clickRatio)
+    }
+}
diff --git a/PrimaeNativeTests/SonificationBakeoff/PitchMetricSelfTests.swift b/PrimaeNativeTests/SonificationBakeoff/PitchMetricSelfTests.swift
new file mode 100644
index 00000000..a7c19746
--- /dev/null
+++ b/PrimaeNativeTests/SonificationBakeoff/PitchMetricSelfTests.swift
@@ -0,0 +1,251 @@
+// PitchMetricSelfTests.swift
+// PrimaeNativeTests — pitch bake-off harness, phase 2 (lane BENCH-P, 2026-11-23)
+//
+// BAKEOFF-PITCH.md section 4.4: every new metric is an instrument, so each
+// one is checked against a signal whose true answer is known by construction
+// (a source-filter vowel shifted with its envelope held, the same vowel
+// resampled, a 20-cent detune, a level step, a known jitter, an inserted
+// click, AM noise, a comb, a late step, a lagging glide), and each GATE is
+// fed the known-bad version and must FAIL. Several tests also run the real
+// study phonemes through the shipped engine (`ours`) and the anchor
+// (`NaiveResample`), which phase 1 measured.
+//
+// Mutation-checked on the iPad (BENCH-P.md): each test goes RED when the
+// metric it guards is broken.
+//
+// XCTest, not Swift Testing: serial, and `-only-testing:PrimaeNativeTests/
+// PitchMetricSelfTests` round-trips (CLAUDE.md, Test Infrastructure 5).
+
+import XCTest
+@testable import PrimaeNative
+
+final class PitchMetricSelfTests: XCTestCase {
+    typealias P = PitchMetrics
+    let sr = LiveSonificationKernel.sampleRate
+    static let pf600 = pow(2.0, 600.0 / 1200)
+
+    func vowel(f0: Double, seconds: Double = 2.5, jitter: Double = 0, shimmer: Double = 0) -> [Float] {
+        BakeoffSynthetic.vowel(seconds: seconds, sampleRate: sr, f0At: { _ in f0 }, jitter: jitter, shimmer: shimmer).x
+    }
+
+    func region(_ x: [Float]) -> ArraySlice<Float> { x[Int(0.6 * sr)..<Int(2.4 * sr)] }
+
+    /// A synthetic "source" handed to the runner (letter A, so the Praat LSD reference applies too).
+    func syntheticSource(_ x: [Float]) -> BakeoffSource {
+        BakeoffSource(name: "synthetic", letter: "A", kind: .voicedPhoneme, sampleRate: sr, samples: x, voicedFraction: 1)
+    }
+
+    func render(_ x: [Float]) -> BakeoffRender { BakeoffRender(samples: x, cpuNanos: [], claimedLatencyFrames: 0) }
+
+    func gates(_ out: PitchRunner.Output, _ name: String) -> [PitchGates.Result] {
+        out.gates.map(\.result).filter { $0.gate == name }
+    }
+
+    // MARK: - Envelope: warp alpha, LSD, frame-wise LSD
+
+    func testWarpReadsOneForAnEnvelopePreservingShiftAndPfForAResampledCopy() {
+        let src = vowel(f0: 200)
+        let e0 = P.envelopeDB(region(src), sampleRate: sr)
+        let held = vowel(f0: 200 * Self.pf600)
+        let eh = P.envelopeDB(region(held), sampleRate: sr)
+        let held1 = P.envelopeCompare(f: e0.f, source: e0.e, output: eh.e)
+        XCTAssertEqual(held1.warp, 1, accuracy: 0.03, "an envelope-preserving +600 shift must read alpha ~ 1")
+        XCTAssertTrue(PitchGates.warp(alpha: held1.warp, pitchFactor: Self.pf600).pass)
+        for c in [-600.0, 600] {
+            let pf = pow(2, c / 1200)
+            let rs = BakeoffSynthetic.resample(vowel(f0: 200, seconds: 4), factor: pf)
+            let er = P.envelopeDB(region(rs), sampleRate: sr)
+            let cmp = P.envelopeCompare(f: e0.f, source: e0.e, output: er.e)
+            XCTAssertEqual(cmp.warp, pf, accuracy: 0.03, "a resampled copy at \(c) c must read alpha ~ pf")
+            XCTAssertFalse(PitchGates.warp(alpha: cmp.warp, pitchFactor: pf).pass, "the envelope gate must flag it")
+            XCTAssertTrue(PitchGates.warp(alpha: cmp.warp, pitchFactor: pf, gamma: 1).pass,
+                          "with gamma = 1 (full co-shift) the resample is the target")
+            XCTAssertGreaterThan(cmp.lsd, 3 * held1.lsd, "LSD at alpha 1 must see the moved formants")
+        }
+    }
+
+    @MainActor
+    func testEnvelopeMetricsOnTheStudyPhonemesThroughOursAndTheAnchor() throws {
+        // Phase 1 (results.csv): ours A +600 alpha 1.00, LSD 1.39; anchor_naive A +600 alpha 1.44, LSD 9.15.
+        let src = try XCTUnwrap(BakeoffSources.pitchSources(letters: ["A"]).first)
+        let ref = PitchSourceRef(src)
+        for (candidate, expectWarp) in [(BakeoffCandidate.ours, 1.0), (BakeoffCandidate.naive, Self.pf600)] {
+            let r = BakeoffRunner.render(candidate, source: src, scenario: PitchScenarios.held(cents: 600, rate: 1))
+            let out = PitchRunner.rows(candidate: candidate.name, render: r, ref: ref,
+                                       scenario: PitchScenarios.held(cents: 600, rate: 1))
+            let warp = try XCTUnwrap(out.rows.first { $0.metric == "env_warp" }).value
+            XCTAssertEqual(warp, expectWarp, accuracy: 0.05, "\(candidate.name) A +600: alpha")
+            let lsdGate = try XCTUnwrap(gates(out, "env_lsd_vs_praat").first)
+            XCTAssertEqual(lsdGate.pass, candidate.name == "ours", "\(candidate.name): LSD gate vs Praat (\(lsdGate.value))")
+        }
+    }
+
+    func testFramewiseLSDSeesFrameLevelFormantDrift() throws {
+        let src = vowel(f0: 200)
+        let same = try XCTUnwrap(P.framewiseEnvelopeLSD(source: region(src), output: region(vowel(f0: 200 * Self.pf600)),
+                                                        sampleRate: sr))
+        let moved = try XCTUnwrap(P.framewiseEnvelopeLSD(
+            source: region(src), output: region(BakeoffSynthetic.resample(vowel(f0: 200, seconds: 4), factor: Self.pf600)),
+            sampleRate: sr))
+        XCTAssertLessThan(same, 2.5, "envelope held: frame-wise LSD small")
+        XCTAssertGreaterThan(moved, 2 * same, "envelope moved: frame-wise LSD must grow")
+    }
+
+    // MARK: - F0
+
+    func testF0GateFailsOnATwentyCentDetunedRender() throws {
+        let srcRef = PitchSourceRef(syntheticSource(vowel(f0: 200)))
+        let scenario = PitchScenarios.held(cents: 300, rate: 1)
+        let ok = vowel(f0: 200 * pow(2, 300.0 / 1200))
+        let detuned = vowel(f0: 200 * pow(2, 320.0 / 1200))
+        let good = PitchRunner.rows(candidate: "t", render: render(ok), ref: srcRef, scenario: scenario)
+        let bad = PitchRunner.rows(candidate: "t", render: render(detuned), ref: srcRef, scenario: scenario)
+        let eGood = try XCTUnwrap(good.rows.first { $0.metric == "f0_err_c" }).value
+        let eBad = try XCTUnwrap(bad.rows.first { $0.metric == "f0_err_c" }).value
+        XCTAssertEqual(eGood, 0, accuracy: 1, "exact +300 render reads ~0 c")
+        XCTAssertEqual(eBad, 20, accuracy: 1.5, "a 20-cent detune reads ~20 c")
+        XCTAssertTrue(try XCTUnwrap(gates(good, "f0_within_5c").first).pass)
+        XCTAssertFalse(try XCTUnwrap(gates(bad, "f0_within_5c").first).pass, "the F0 gate must fail a 20-cent detune")
+    }
+
+    // MARK: - Level vs cents
+
+    func testLevelGateFailsOnALevelSteppedRender() throws {
+        let src = vowel(f0: 200)
+        let ref = PitchSourceRef(syntheticSource(src))
+        _ = PitchRunner.rows(candidate: "t", render: render(src), ref: ref, scenario: PitchScenarios.held(cents: 0, rate: 1))
+        let up = vowel(f0: 200 * Self.pf600)
+        let flat = PitchRunner.rows(candidate: "t", render: render(up), ref: ref, scenario: PitchScenarios.held(cents: 600, rate: 1))
+        let stepped = PitchRunner.rows(candidate: "t", render: render(up.map { $0 * Float(pow(10, 2.0 / 20)) }), ref: ref,
+                                       scenario: PitchScenarios.held(cents: 600, rate: 1))
+        let dFlat = try XCTUnwrap(flat.rows.first { $0.metric == "level_re_0c_db" }).value
+        let dStep = try XCTUnwrap(stepped.rows.first { $0.metric == "level_re_0c_db" }).value
+        XCTAssertEqual(dStep - dFlat, 2, accuracy: 0.01, "a +2 dB step reads +2 dB")
+        XCTAssertTrue(try XCTUnwrap(gates(flat, "level_flat").first).pass)
+        XCTAssertFalse(try XCTUnwrap(gates(stepped, "level_flat").first).pass, "the flatness gate must fail a level step")
+    }
+
+    // MARK: - Jitter / shimmer
+
+    func testPerturbationRecoversAKnownJitterAndShimmer() throws {
+        let g = BakeoffSynthetic.vowel(seconds: 2.5, sampleRate: sr, f0At: { _ in 210 }, jitter: 0.01, shimmer: 0.05)
+        let p = try XCTUnwrap(P.perturbation(region(g.x), sampleRate: sr))
+        let trueJ = BakeoffSynthetic.localPerturbation(g.periods)
+        let trueS = BakeoffSynthetic.localPerturbation(g.amps)
+        XCTAssertEqual(p.jitterPct, trueJ, accuracy: 0.25 * trueJ, "jitter: measured \(p.jitterPct) % vs generated \(trueJ) %")
+        XCTAssertEqual(p.shimmerPct, trueS, accuracy: 0.45 * trueS, "shimmer: measured \(p.shimmerPct) % vs generated \(trueS) %")
+        let clean = try XCTUnwrap(P.perturbation(region(vowel(f0: 210)), sampleRate: sr))
+        XCTAssertLessThan(clean.jitterPct, 0.1 * trueJ, "a strictly periodic vowel reads ~0 jitter")
+        XCTAssertLessThan(clean.shimmerPct, 0.1 * trueS, "and ~0 shimmer")
+    }
+
+    func testMicroVariationGateFailsWhenJitterAndShimmerAreHalved() throws {
+        // Same f0 as the source (another seed), so the ratio isolates the micro-variation: a waveform-based measure
+        // also depends on where the harmonics sit under the formants (jitter leaks into shimmer through the ringing),
+        // which is why phase-1 Praat ratios of a good PSOLA already range x0.4 ... x2.
+        let src = BakeoffSynthetic.vowel(seconds: 2.5, sampleRate: sr, f0At: { _ in 200 }, jitter: 0.01, shimmer: 0.06).x
+        let ref = PitchSourceRef(syntheticSource(src))
+        let same = BakeoffSynthetic.vowel(seconds: 2.5, sampleRate: sr, f0At: { _ in 200 },
+                                          jitter: 0.01, shimmer: 0.06, seed: 4242).x
+        let halved = BakeoffSynthetic.vowel(seconds: 2.5, sampleRate: sr, f0At: { _ in 200 },
+                                            jitter: 0.004, shimmer: 0.02, seed: 4242).x
+        let sc = PitchScenarios.held(cents: 0, rate: 1)
+        let a = PitchRunner.rows(candidate: "t", render: render(same), ref: ref, scenario: sc)
+        let b = PitchRunner.rows(candidate: "t", render: render(halved), ref: ref, scenario: sc)
+        XCTAssertTrue(try XCTUnwrap(gates(a, "jitter_ratio").first).pass, "same micro-variation passes (jitter)")
+        XCTAssertTrue(try XCTUnwrap(gates(a, "shimmer_ratio").first).pass, "same micro-variation passes (shimmer)")
+        XCTAssertFalse(try XCTUnwrap(gates(b, "jitter_ratio").first).pass, "WORLD-like regularity must fail (jitter)")
+        XCTAssertFalse(try XCTUnwrap(gates(b, "shimmer_ratio").first).pass, "WORLD-like regularity must fail (shimmer)")
+    }
+
+    // MARK: - F (unvoiced)
+
+    func testFMetricsSeeGrainRateBuzzAndAComb() {
+        let hop = P.unvoicedHop(sampleRate: sr)
+        XCTAssertEqual(hop, 221)
+        let noise = BakeoffSynthetic.noise(Int(2.1 * sr))
+        let wClean = P.grainRateWobble(noise[...], period: hop)
+        var am = noise
+        for i in am.indices { am[i] *= Float(1 + 0.3 * sin(2 * .pi * Double(i) / Double(hop))) }
+        let wAM = P.grainRateWobble(am[...], period: hop)
+        XCTAssertTrue(PitchGates.fWobble(wClean).pass, "white noise: wobble \(wClean) dB")
+        XCTAssertFalse(PitchGates.fWobble(wAM).pass, "200 Hz AM noise must fail (wobble \(wAM) dB)")
+        let lag = P.combLag(hop: hop, pitchFactor: Self.pf600)
+        let rClean = P.acf(noise[...], lag: lag)
+        var comb = noise
+        let l = Int(lag.rounded())
+        for i in l..<comb.count { comb[i] = noise[i] + 0.6 * noise[i - l] }
+        let rComb = P.acf(comb[...], lag: Double(l))
+        XCTAssertTrue(PitchGates.fComb(rClean).pass, "white noise: ACF \(rClean)")
+        XCTAssertFalse(PitchGates.fComb(rComb).pass, "a comb at the lag must fail (ACF \(rComb))")
+    }
+
+    // MARK: - Clicks
+
+    func testSweepClickRatioSeesAnInsertedDiscontinuity() throws {
+        let glide = BakeoffSynthetic.vowel(seconds: 3, sampleRate: sr, f0At: { t in 200 * pow(2, Double(PitchScenarios.sweepCents(t)) / 1200) }).x
+        let clean = try XCTUnwrap(P.localClickRatio(glide, from: Int(0.05 * sr), to: Int(2.95 * sr), sampleRate: sr))
+        var clicked = glide
+        for i in Int(1.3 * sr)..<clicked.count { clicked[i] += 0.25 }
+        let bad = try XCTUnwrap(P.localClickRatio(clicked, from: Int(0.05 * sr), to: Int(2.95 * sr), sampleRate: sr))
+        XCTAssertTrue(PitchGates.clicks("sweep_click", ratio: clean).pass, "a clean glide: ratio \(clean)")
+        XCTAssertFalse(PitchGates.clicks("sweep_click", ratio: bad).pass, "a step of 0.25 must fail (ratio \(bad))")
+    }
+
+    // MARK: - Pitch control lag
+
+    func testStepGateSeesALateStep() throws {
+        let ref = PitchSourceRef(syntheticSource(vowel(f0: 200)))
+        let scenario = PitchScenarios.step(from: 0, to: 600, rate: 1)
+        let st = Double(BakeoffRunner.appliedFrame(PitchScenarios.stepTime, sampleRate: sr)) / sr
+        func stepped(late: Double) -> [Float] {
+            BakeoffSynthetic.vowel(seconds: scenario.duration, sampleRate: sr,
+                                   f0At: { t in t < st + late ? 200 : 200 * Self.pf600 }).x
+        }
+        let prompt = PitchRunner.rows(candidate: "t", render: render(stepped(late: 0)), ref: ref, scenario: scenario)
+        let late = PitchRunner.rows(candidate: "t", render: render(stepped(late: 0.03)), ref: ref, scenario: scenario)
+        let d0 = try XCTUnwrap(prompt.rows.first { $0.metric == "pitch_step_delay90_ms" }).value
+        let d1 = try XCTUnwrap(late.rows.first { $0.metric == "pitch_step_delay90_ms" }).value
+        XCTAssertEqual(d1 - d0, 30, accuracy: 3, "a 30 ms late step reads 30 ms later")
+        XCTAssertTrue(try XCTUnwrap(gates(prompt, "pitch_step_90").first).pass, "an instant step passes (\(d0) ms)")
+        XCTAssertFalse(try XCTUnwrap(gates(late, "pitch_step_90").first).pass, "30 ms late must fail (\(d1) ms)")
+    }
+
+    func testSweepLagGateSeesALaggingGlide() throws {
+        let ref = PitchSourceRef(syntheticSource(vowel(f0: 200)))
+        let scenario = PitchScenarios.sweep(rate: 1, sampleRate: sr)
+        func glide(lag: Double) -> [Float] {
+            BakeoffSynthetic.vowel(seconds: scenario.duration, sampleRate: sr, f0At: { t in
+                200 * pow(2, Double(PitchScenarios.sweepCents(max(0, t - lag))) / 1200)
+            }).x
+        }
+        let a = PitchRunner.rows(candidate: "t", render: render(glide(lag: 0)), ref: ref, scenario: scenario)
+        let b = PitchRunner.rows(candidate: "t", render: render(glide(lag: 0.025)), ref: ref, scenario: scenario)
+        let l0 = try XCTUnwrap(a.rows.first { $0.metric == "traj_pitch_lag_ms" }).value
+        let l1 = try XCTUnwrap(b.rows.first { $0.metric == "traj_pitch_lag_ms" }).value
+        XCTAssertEqual(l1 - l0, 25, accuracy: 5, "a 25 ms lagging glide reads ~25 ms more")
+        XCTAssertTrue(try XCTUnwrap(gates(a, "traj_pitch_lag").first).pass, "no lag passes (\(l0) ms)")
+        XCTAssertFalse(try XCTUnwrap(gates(b, "traj_pitch_lag").first).pass, "25 ms lag must fail (\(l1) ms)")
+    }
+
+    // MARK: - Scenarios and export plumbing
+
+    func testScenarioSetAndExportNames() throws {
+        let s = try PitchScenarios.standard(letter: "A", sampleRate: sr)
+        XCTAssertEqual(s.count, 3 * (5 + 3 + 1) + 2, "held x5, steps x3, sweep per rate; gate cycle; height trajectory")
+        XCTAssertEqual(Set(s.map(\.name)).count, s.count, "scenario names unique")
+        let names = s.compactMap { SonificationBakeoffBench.renderName(scenario: $0, letter: "A") }
+        XCTAssertEqual(Set(names), ["A__0c.wav", "A__-600c.wav", "A__-300c.wav", "A__+300c.wav", "A__+600c.wav",
+                                    "A__traj.wav", "A__height.wav"], "the names method/build_mushra.py reads")
+        // The phase-1 triangle.
+        XCTAssertEqual(PitchScenarios.sweepCents(0.75), 600, accuracy: 0.01)
+        XCTAssertEqual(PitchScenarios.sweepCents(2.25), -600, accuracy: 0.01)
+        XCTAssertEqual(PitchScenarios.sweepCents(1.5), 0, accuracy: 0.01)
+        // The height trajectory spans the r26 one-octave mapping and drives rate.
+        let traj = try XCTUnwrap(s.first { $0.name == "traj_A_height" })
+        let cents = traj.events.compactMap { e -> Float? in if case .cents(let c) = e.kind { return c }; return nil }
+        XCTAssertLessThanOrEqual(cents.max() ?? 0, 600)
+        XCTAssertGreaterThanOrEqual(cents.min() ?? 0, -600)
+        XCTAssertGreaterThan((cents.max() ?? 0) - (cents.min() ?? 0), 600, "A spans most of the letter height")
+    }
+}
