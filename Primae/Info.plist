<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        No UIFileSharingEnabled / LSSupportsOpeningDocumentsInPlace
        (R-063, audit 2026-10-13). They published Documents/ in the
        Files app and Finder for the calibrator's capture folder; the
        calibrator is compiled out of every build (STUDY_BUILD is
        unconditional), so on the study iPad they only exposed the
        container root. Re-adding either key needs
        INFO_PLIST_EXPECTED in scripts/check_project_invariants.py
        changed in the same commit.
    -->
    <!-- No cryptography beyond the OS-exempt kind (HTTPS/system) —
         skips the export-compliance prompt on every upload. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
